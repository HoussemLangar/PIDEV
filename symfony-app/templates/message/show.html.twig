{% extends 'base.html.twig' %}

{% block title %}{{ otherUser.prenom }} {{ otherUser.nom }} — Messages{% endblock %}

{% block stylesheets %}
  {{ parent() }}
  <style>
    /* ── Chat layout ─────────────────────────────────────── */
    :root {
      --sq-primary:       #3b82f6;
      --sq-primary-dark:  #1d4ed8;
      --sq-border:        #e2e8f0;
      --sq-bg:            #f1f5f9;
      --sq-surface:       #ffffff;
      --sq-text:          #0f172a;
      --sq-muted:         #64748b;
      --sq-radius:        14px;
      --sq-shadow:        0 1px 3px rgba(0,0,0,.06), 0 4px 16px rgba(0,0,0,.08);
    }

    .chat-wrapper {
      display: flex;
      flex-direction: column;
      height: calc(100vh - 100px);
      max-width: 900px;
      margin: 0 auto;
      background: var(--sq-surface);
      border-radius: var(--sq-radius);
      box-shadow: var(--sq-shadow);
      border: 1px solid var(--sq-border);
      overflow: hidden;
    }

    /* ── Chat Header ─────────────────────────────────────── */
    .chat-header {
      background: linear-gradient(135deg, #1e40af 0%, #3b82f6 50%, #06b6d4 100%);
      padding: 18px 24px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      flex-shrink: 0;
    }

    .chat-header-left {
      display: flex;
      align-items: center;
      gap: 14px;
    }

    .chat-avatar {
      width: 46px;
      height: 46px;
      border-radius: 50%;
      background: rgba(255,255,255,.2);
      border: 2px solid rgba(255,255,255,.4);
      object-fit: cover;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.1rem;
      color: #fff;
      font-weight: 700;
      flex-shrink: 0;
      overflow: hidden;
    }

    .chat-avatar img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .chat-header-info h2 {
      margin: 0;
      font-size: 1.1rem;
      font-weight: 700;
      color: #fff;
      line-height: 1.2;
    }

    .chat-header-info p {
      margin: 2px 0 0;
      font-size: 0.8rem;
      color: rgba(255,255,255,.75);
    }

    .online-dot {
      display: inline-block;
      width: 8px;
      height: 8px;
      background: #4ade80;
      border-radius: 50%;
      margin-right: 5px;
      box-shadow: 0 0 0 2px rgba(74,222,128,.3);
    }

    .chat-header-actions {
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .chat-btn {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      padding: 8px 16px;
      border-radius: 100px;
      font-size: 0.82rem;
      font-weight: 600;
      cursor: pointer;
      border: none;
      text-decoration: none;
      transition: all .2s;
      white-space: nowrap;
    }

    .chat-btn-ghost {
      background: rgba(255,255,255,.15);
      color: #fff;
      border: 1px solid rgba(255,255,255,.3);
    }

    .chat-btn-ghost:hover {
      background: rgba(255,255,255,.25);
      color: #fff;
    }

    .chat-btn-danger {
      background: rgba(239,68,68,.2);
      color: #fca5a5;
      border: 1px solid rgba(239,68,68,.3);
    }

    .chat-btn-danger:hover {
      background: rgba(239,68,68,.35);
      color: #fff;
    }

    /* ── Messages area ───────────────────────────────────── */
    .chat-messages {
      flex: 1;
      overflow-y: auto;
      padding: 28px 28px 16px;
      display: flex;
      flex-direction: column;
      gap: 4px;
      background: #f8fafc;
    }

    .chat-messages::-webkit-scrollbar { width: 5px; }
    .chat-messages::-webkit-scrollbar-track { background: #f1f5f9; }
    .chat-messages::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 10px; }

    .chat-empty {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      height: 100%;
      gap: 12px;
      color: var(--sq-muted);
    }

    .chat-empty-icon {
      width: 72px;
      height: 72px;
      background: linear-gradient(135deg, #eff6ff, #e0f2fe);
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 2rem;
    }

    .chat-empty h3 {
      margin: 0;
      font-size: 1.05rem;
      font-weight: 700;
      color: var(--sq-text);
    }

    .chat-empty p {
      margin: 0;
      font-size: 0.88rem;
      color: var(--sq-muted);
    }

    /* ── Date separator ──────────────────────────────────── */
    .date-separator {
      display: flex;
      align-items: center;
      gap: 12px;
      margin: 16px 0 8px;
    }

    .date-separator::before,
    .date-separator::after {
      content: '';
      flex: 1;
      height: 1px;
      background: var(--sq-border);
    }

    .date-separator span {
      font-size: 0.73rem;
      font-weight: 600;
      color: var(--sq-muted);
      background: #f8fafc;
      padding: 3px 12px;
      border-radius: 100px;
      border: 1px solid var(--sq-border);
      white-space: nowrap;
    }

    /* ── Message bubble ──────────────────────────────────── */
    .msg-row {
      display: flex;
      align-items: flex-end;
      gap: 8px;
      margin-bottom: 4px;
    }

    .msg-row.sent {
      flex-direction: row-reverse;
    }

    .msg-mini-avatar {
      width: 28px;
      height: 28px;
      border-radius: 50%;
      background: linear-gradient(135deg, #e0f2fe, #bae6fd);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 0.7rem;
      font-weight: 700;
      color: var(--sq-primary);
      flex-shrink: 0;
      overflow: hidden;
    }

    .msg-mini-avatar img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .msg-mini-avatar.sent-av {
      background: linear-gradient(135deg, #3b82f6, #1d4ed8);
      color: #fff;
    }

    .msg-mini-avatar.hidden { visibility: hidden; }

    .msg-bubble {
      max-width: 68%;
      padding: 10px 15px;
      border-radius: 18px;
      font-size: 0.9rem;
      line-height: 1.5;
      position: relative;
      word-break: break-word;
    }

    .msg-row.received .msg-bubble {
      background: var(--sq-surface);
      color: var(--sq-text);
      border: 1px solid var(--sq-border);
      border-bottom-left-radius: 5px;
      box-shadow: 0 1px 2px rgba(0,0,0,.04);
    }

    .msg-row.sent .msg-bubble {
      background: linear-gradient(135deg, #3b82f6, #1d4ed8);
      color: #fff;
      border-bottom-right-radius: 5px;
      box-shadow: 0 2px 8px rgba(59,130,246,.25);
    }

    .msg-meta {
      display: flex;
      align-items: center;
      gap: 5px;
      margin-top: 4px;
      font-size: 0.7rem;
    }

    .msg-row.received .msg-meta { color: var(--sq-muted); }
    .msg-row.sent .msg-meta { color: rgba(255,255,255,.65); justify-content: flex-end; }

    .msg-read-icon { font-size: 0.75rem; }
    .msg-read-icon.read   { color: #93c5fd; }
    .msg-read-icon.unread { color: rgba(255,255,255,.4); }

    /* ── Input area ──────────────────────────────────────── */
    .chat-input-area {
      flex-shrink: 0;
      padding: 16px 20px;
      background: var(--sq-surface);
      border-top: 1px solid var(--sq-border);
    }

    .chat-form {
      display: flex;
      align-items: flex-end;
      gap: 10px;
      background: #f8fafc;
      border: 1.5px solid var(--sq-border);
      border-radius: 16px;
      padding: 8px 8px 8px 16px;
      transition: border-color .2s, box-shadow .2s;
    }

    .chat-form:focus-within {
      border-color: var(--sq-primary);
      box-shadow: 0 0 0 3px rgba(59,130,246,.1);
      background: #fff;
    }

    .chat-input {
      flex: 1;
      border: none;
      background: transparent;
      outline: none;
      font-size: 0.95rem;
      color: var(--sq-text);
      resize: none;
      min-height: 36px;
      max-height: 120px;
      padding: 6px 0;
      font-family: inherit;
      line-height: 1.4;
    }

    .chat-input::placeholder { color: #94a3b8; }

    .chat-send-btn {
      width: 40px;
      height: 40px;
      border-radius: 12px;
      background: linear-gradient(135deg, var(--sq-primary), var(--sq-primary-dark));
      color: #fff;
      border: none;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      transition: all .2s;
      box-shadow: 0 2px 8px rgba(59,130,246,.3);
    }

    .chat-send-btn:hover {
      transform: scale(1.05);
      box-shadow: 0 4px 12px rgba(59,130,246,.45);
    }

    .chat-send-btn:active { transform: scale(.97); }

    .chat-send-btn svg {
      width: 18px;
      height: 18px;
      fill: none;
      stroke: currentColor;
      stroke-width: 2.2;
      stroke-linecap: round;
      stroke-linejoin: round;
    }

    /* ── Delete modal ────────────────────────────────────── */
    .modal-backdrop-chat {
      position: fixed;
      inset: 0;
      background: rgba(15,23,42,.5);
      backdrop-filter: blur(4px);
      z-index: 9000;
      display: none;
      align-items: center;
      justify-content: center;
    }

    .modal-backdrop-chat.open { display: flex; }

    .modal-box {
      background: var(--sq-surface);
      border-radius: 20px;
      padding: 32px;
      max-width: 420px;
      width: 90%;
      text-align: center;
      box-shadow: 0 20px 60px rgba(0,0,0,.2);
      animation: modalIn .25s cubic-bezier(.34,1.56,.64,1) both;
    }

    @keyframes modalIn {
      from { opacity: 0; transform: scale(.92) translateY(12px); }
      to   { opacity: 1; transform: scale(1)  translateY(0); }
    }

    .modal-box .modal-icon {
      width: 60px;
      height: 60px;
      border-radius: 50%;
      background: #fef2f2;
      display: flex;
      align-items: center;
      justify-content: center;
      margin: 0 auto 18px;
      font-size: 1.6rem;
    }

    .modal-box h3 { margin: 0 0 8px; font-size: 1.15rem; font-weight: 700; color: var(--sq-text); }
    .modal-box p  { margin: 0 0 24px; font-size: 0.88rem; color: var(--sq-muted); line-height: 1.5; }

    .modal-box-actions { display: flex; gap: 10px; justify-content: center; }

    .mbtn {
      padding: 10px 22px;
      border-radius: 100px;
      font-size: 0.88rem;
      font-weight: 600;
      cursor: pointer;
      border: none;
      transition: all .2s;
    }

    .mbtn-cancel {
      background: #f1f5f9;
      color: var(--sq-text);
      border: 1.5px solid var(--sq-border);
    }
    .mbtn-cancel:hover { background: #e2e8f0; }

    .mbtn-delete {
      background: linear-gradient(135deg, #ef4444, #dc2626);
      color: #fff;
      box-shadow: 0 3px 10px rgba(239,68,68,.3);
    }
    .mbtn-delete:hover { box-shadow: 0 5px 16px rgba(239,68,68,.45); transform: translateY(-1px); }

    @media (max-width: 640px) {
      .chat-wrapper { height: calc(100vh - 60px); border-radius: 0; }
      .chat-btn span { display: none; }
      .chat-messages { padding: 16px; }
      .msg-bubble { max-width: 82%; }
    }
  </style>
{% endblock %}

{% block content %}
<div class="chat-wrapper" id="chatWrapper">

  {# ── Header ──────────────────────────────────────────── #}
  <div class="chat-header">
    <div class="chat-header-left">
      <div class="chat-avatar">
        {% if otherUser.avatarDataUri %}
          <img src="{{ otherUser.avatarDataUri }}" alt="{{ otherUser.username }}">
        {% else %}
          {{ otherUser.prenom|first|upper ~ otherUser.nom|first|upper }}
        {% endif %}
      </div>
      <div class="chat-header-info">
        <h2>{{ otherUser.prenom }} {{ otherUser.nom }}</h2>
        <p>
          <span class="online-dot"></span>
          {{ otherUser.email }}
        </p>
      </div>
    </div>

    <div class="chat-header-actions">
      <a href="{{ path('app_message_index') }}" class="chat-btn chat-btn-ghost">
        <i class="fas fa-arrow-left"></i>
        <span>Retour</span>
      </a>
      <button class="chat-btn chat-btn-danger" onclick="openDeleteModal()">
        <i class="fas fa-trash-alt"></i>
        <span>Supprimer</span>
      </button>
    </div>
  </div>

  {# ── Messages ────────────────────────────────────────── #}
  <div class="chat-messages" id="chatMessages">

    {% if messages is empty %}
      <div class="chat-empty">
        <div class="chat-empty-icon">💬</div>
        <h3>Commencez la conversation</h3>
        <p>Envoyez votre premier message à {{ otherUser.prenom }}.</p>
      </div>
    {% else %}

      {% set prevDate   = null %}
      {% set prevSender = null %}

      {% for message in messages %}
        {% set msgDate = message.createdAt|date('Y-m-d') %}

        {# Date separator #}
        {% if prevDate != msgDate %}
          <div class="date-separator">
            <span>
              {% set today     = 'now'|date('Y-m-d') %}
              {% set yesterday = '-1 day'|date('Y-m-d') %}
              {% if msgDate == today %}
                Aujourd'hui
              {% elseif msgDate == yesterday %}
                Hier
              {% else %}
                {{ message.createdAt|date('d/m/Y') }}
              {% endif %}
            </span>
          </div>
          {% set prevSender = null %}
        {% endif %}

        {% set isOwn     = (message.sender == app.user) %}
        {% set sameSender = (prevSender == (isOwn ? 'me' : 'them')) %}

        <div class="msg-row {{ isOwn ? 'sent' : 'received' }}">

          {% if isOwn %}
            <div class="msg-mini-avatar sent-av {{ sameSender ? 'hidden' : '' }}">
              {% if app.user.avatarDataUri %}
                <img src="{{ app.user.avatarDataUri }}" alt="Moi">
              {% else %}
                {{ app.user.prenom|first|upper }}
              {% endif %}
            </div>
          {% else %}
            <div class="msg-mini-avatar {{ sameSender ? 'hidden' : '' }}">
              {% if otherUser.avatarDataUri %}
                <img src="{{ otherUser.avatarDataUri }}" alt="{{ otherUser.prenom }}">
              {% else %}
                {{ otherUser.prenom|first|upper }}
              {% endif %}
            </div>
          {% endif %}

          <div class="msg-bubble">
            <span>{{ message.content }}</span>
            <div class="msg-meta">
              <span>{{ message.createdAt|date('H:i') }}</span>
              {% if isOwn %}
                {% if message.isRead %}
                  <i class="fas fa-check-double msg-read-icon read" title="Lu"></i>
                {% else %}
                  <i class="fas fa-check msg-read-icon unread" title="Envoyé"></i>
                {% endif %}
              {% endif %}
            </div>
          </div>
        </div>

        {% set prevDate   = msgDate %}
        {% set prevSender = isOwn ? 'me' : 'them' %}

      {% endfor %}
    {% endif %}
  </div>

  {# ── Input area ──────────────────────────────────────── #}
  <div class="chat-input-area">
    {{ form_start(form, {
      'attr': {
        'class': 'chat-form',
        'id': 'chatForm',
        'novalidate': 'novalidate'
      }
    }) }}
      {{ form_widget(form.content, {
        'attr': {
          'class': 'chat-input',
          'placeholder': 'Écrivez votre message…',
          'rows': 1,
          'id': 'messageInput'
        }
      }) }}
      <button type="submit" class="chat-send-btn" title="Envoyer">
        <svg viewBox="0 0 24 24"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
      </button>
    {{ form_end(form) }}
  </div>

</div>

{# ── Delete confirmation modal ───────────────────────── #}
<div class="modal-backdrop-chat" id="deleteModal">
  <div class="modal-box">
    <div class="modal-icon">🗑️</div>
    <h3>Supprimer la conversation ?</h3>
    <p>Cette action est irréversible. Tous les messages échangés avec <strong>{{ otherUser.prenom }}</strong> seront définitivement supprimés.</p>
    <div class="modal-box-actions">
      <button class="mbtn mbtn-cancel" onclick="closeDeleteModal()">Annuler</button>
      <form method="post" action="{{ path('app_message_delete', { id: conversation.id }) }}" style="display:inline;">
        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ conversation.id) }}">
        <button type="submit" class="mbtn mbtn-delete">Supprimer</button>
      </form>
    </div>
  </div>
</div>
{% endblock %}

{% block javascripts %}
  {{ parent() }}
  <script>
    // Auto-scroll to bottom
    const chatMessages = document.getElementById('chatMessages');
    if (chatMessages) {
      chatMessages.scrollTop = chatMessages.scrollHeight;
    }

    // Auto-resize textarea
    const messageInput = document.getElementById('messageInput');
    if (messageInput) {
      messageInput.addEventListener('input', function () {
        this.style.height = 'auto';
        this.style.height = Math.min(this.scrollHeight, 120) + 'px';
      });

      // Send on Enter, Shift+Enter = new line
      messageInput.addEventListener('keydown', function (e) {
        if (e.key === 'Enter' && !e.shiftKey) {
          e.preventDefault();
          const form = document.getElementById('chatForm');
          if (form && this.value.trim()) form.submit();
        }
      });
    }

    // Delete modal
    function openDeleteModal()  { document.getElementById('deleteModal').classList.add('open'); }
    function closeDeleteModal() { document.getElementById('deleteModal').classList.remove('open'); }

    document.getElementById('deleteModal').addEventListener('click', function (e) {
      if (e.target === this) closeDeleteModal();
    });
  </script>
{% endblock %}
