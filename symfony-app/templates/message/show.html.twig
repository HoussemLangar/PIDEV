{% extends 'base.html.twig' %}

{% block title %}{{ otherUser.prenom }} {{ otherUser.nom }} — Messages{% endblock %}

{% block stylesheets %}
  {{ parent() }}
  <style>
    :root {
      --sq-primary: #3b82f6;
      --sq-primary-dark: #1d4ed8;
      --sq-border: #e2e8f0;
      --sq-surface: #ffffff;
      --sq-text: #0f172a;
      --sq-muted: #64748b;
      --sq-radius: 14px;
      --sq-shadow: 0 1px 3px rgba(0,0,0,.06), 0 4px 16px rgba(0,0,0,.08);
    }

    .chat-wrapper {
      display: flex;
      flex-direction: column;
      height: calc(100vh - 100px);
      max-width: 900px;
      margin: 0 auto;
      background: var(--sq-surface);
      border-radius: var(--sq-radius);
      box-shadow: var(--sq-shadow);
      border: 1px solid var(--sq-border);
      overflow: hidden;
    }

    .chat-header {
      background: linear-gradient(135deg, #1e40af 0%, #3b82f6 50%, #06b6d4 100%);
      padding: 18px 24px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      flex-shrink: 0;
    }

    .chat-header-left {
      display: flex;
      align-items: center;
      gap: 14px;
    }

    .chat-avatar {
      width: 46px;
      height: 46px;
      border-radius: 50%;
      background: rgba(255,255,255,.2);
      border: 2px solid rgba(255,255,255,.4);
      display: flex;
      align-items: center;
      justify-content: center;
      color: #fff;
      font-weight: 700;
      overflow: hidden;
    }

    .chat-avatar img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .chat-header-info h2 {
      margin: 0;
      font-size: 1.1rem;
      font-weight: 700;
      color: #fff;
      line-height: 1.2;
    }

    .chat-header-info p {
      margin: 2px 0 0;
      font-size: .8rem;
      color: rgba(255,255,255,.75);
    }

    .online-dot {
      display: inline-block;
      width: 8px;
      height: 8px;
      background: #4ade80;
      border-radius: 50%;
      margin-right: 5px;
      box-shadow: 0 0 0 2px rgba(74,222,128,.3);
    }

    .chat-header-actions {
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .chat-btn {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      padding: 8px 16px;
      border-radius: 100px;
      font-size: .82rem;
      font-weight: 600;
      cursor: pointer;
      border: none;
      text-decoration: none;
      transition: all .2s;
      white-space: nowrap;
    }

    .chat-btn-ghost {
      background: rgba(255,255,255,.15);
      color: #fff;
      border: 1px solid rgba(255,255,255,.3);
    }

    .chat-btn-danger {
      background: rgba(239,68,68,.2);
      color: #fca5a5;
      border: 1px solid rgba(239,68,68,.3);
    }

    .chat-messages {
      flex: 1;
      overflow-y: auto;
      padding: 24px;
      display: flex;
      flex-direction: column;
      gap: 6px;
      background: #f8fafc;
    }

    .chat-empty {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      height: 100%;
      gap: 12px;
      color: var(--sq-muted);
    }

    .chat-empty-icon {
      width: 72px;
      height: 72px;
      background: linear-gradient(135deg, #eff6ff, #e0f2fe);
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 2rem;
    }

    .msg-row {
      display: flex;
      align-items: flex-end;
      gap: 8px;
    }

    .msg-row.sent {
      flex-direction: row-reverse;
    }

    .msg-bubble {
      max-width: 68%;
      padding: 10px 15px;
      border-radius: 18px;
      font-size: .9rem;
      line-height: 1.5;
      word-break: break-word;
    }

    .msg-row.received .msg-bubble {
      background: var(--sq-surface);
      color: var(--sq-text);
      border: 1px solid var(--sq-border);
      border-bottom-left-radius: 5px;
    }

    .msg-row.sent .msg-bubble {
      background: linear-gradient(135deg, #3b82f6, #1d4ed8);
      color: #fff;
      border-bottom-right-radius: 5px;
    }

    .msg-meta {
      display: flex;
      align-items: center;
      gap: 5px;
      margin-top: 4px;
      font-size: .7rem;
    }

    .msg-row.received .msg-meta { color: var(--sq-muted); }
    .msg-row.sent .msg-meta { color: rgba(255,255,255,.65); justify-content: flex-end; }

    .msg-read-icon.read { color: #93c5fd; }
    .msg-read-icon.unread { color: rgba(255,255,255,.4); }

    .chat-input-area {
      flex-shrink: 0;
      padding: 16px 20px;
      background: var(--sq-surface);
      border-top: 1px solid var(--sq-border);
    }

    .chat-form {
      display: flex;
      align-items: flex-end;
      gap: 10px;
      background: #f8fafc;
      border: 1.5px solid var(--sq-border);
      border-radius: 16px;
      padding: 8px 8px 8px 16px;
    }

    .chat-input {
      flex: 1;
      border: none;
      background: transparent;
      outline: none;
      font-size: .95rem;
      color: var(--sq-text);
      resize: none;
      min-height: 36px;
      max-height: 120px;
      padding: 6px 0;
      font-family: inherit;
      line-height: 1.4;
    }

    .chat-send-btn {
      width: 40px;
      height: 40px;
      border-radius: 12px;
      background: linear-gradient(135deg, var(--sq-primary), var(--sq-primary-dark));
      color: #fff;
      border: none;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }

    .chat-send-btn svg {
      width: 18px;
      height: 18px;
      fill: none;
      stroke: currentColor;
      stroke-width: 2.2;
      stroke-linecap: round;
      stroke-linejoin: round;
    }

    .modal-backdrop-chat {
      position: fixed;
      inset: 0;
      background: rgba(15,23,42,.5);
      backdrop-filter: blur(4px);
      z-index: 9000;
      display: none;
      align-items: center;
      justify-content: center;
    }

    .modal-backdrop-chat.open { display: flex; }

    .modal-box {
      background: var(--sq-surface);
      border-radius: 20px;
      padding: 32px;
      max-width: 420px;
      width: 90%;
      text-align: center;
      box-shadow: 0 20px 60px rgba(0,0,0,.2);
    }

    .modal-box-actions { display: flex; gap: 10px; justify-content: center; }

    .mbtn {
      padding: 10px 22px;
      border-radius: 100px;
      font-size: .88rem;
      font-weight: 600;
      cursor: pointer;
      border: none;
    }

    .mbtn-cancel {
      background: #f1f5f9;
      color: var(--sq-text);
      border: 1.5px solid var(--sq-border);
    }

    .mbtn-delete {
      background: linear-gradient(135deg, #ef4444, #dc2626);
      color: #fff;
    }

    @media (max-width: 640px) {
      .chat-wrapper { height: calc(100vh - 60px); border-radius: 0; }
      .chat-btn span { display: none; }
      .chat-messages { padding: 16px; }
      .msg-bubble { max-width: 82%; }
    }
  </style>
{% endblock %}

{% block content %}
<div class="chat-wrapper" id="chatWrapper">
  <div class="chat-header">
    <div class="chat-header-left">
      <div class="chat-avatar">
        {% if otherUser.avatarDataUri %}
          <img src="{{ otherUser.avatarDataUri }}" alt="{{ otherUser.username }}">
        {% else %}
          {{ otherUser.prenom|first|upper ~ otherUser.nom|first|upper }}
        {% endif %}
      </div>
      <div class="chat-header-info">
        <h2>{{ otherUser.prenom }} {{ otherUser.nom }}</h2>
        <p>
          <span class="online-dot"></span>
          {{ otherUser.email }}
        </p>
      </div>
    </div>

    <div class="chat-header-actions">
      <a href="{{ path('app_message_index') }}" class="chat-btn chat-btn-ghost">
        <i class="fas fa-arrow-left"></i>
        <span>Retour</span>
      </a>
      <button class="chat-btn chat-btn-danger" onclick="openDeleteModal()">
        <i class="fas fa-trash-alt"></i>
        <span>Supprimer</span>
      </button>
    </div>
  </div>

  {% if liveComponentEnabled %}
    {% include 'message/_live_thread.html.twig' with { conversation: conversation } %}
  {% else %}
    <div class="chat-messages">
      {% for message in messages %}
        {% set isOwn = message.sender == app.user %}
        <div class="msg-row {{ isOwn ? 'sent' : 'received' }}">
          <div class="msg-bubble">
            <span>{{ message.content }}</span>
            <div class="msg-meta">
              <span>{{ message.createdAt|date('H:i') }}</span>
            </div>
          </div>
        </div>
      {% else %}
        <div class="chat-empty">
          <div class="chat-empty-icon">💬</div>
          <h3>Commencez la conversation</h3>
          <p>Envoyez votre premier message.</p>
        </div>
      {% endfor %}
    </div>
    <div class="chat-input-area">
      {{ form_start(form, {'attr': {'class': 'chat-form'}}) }}
        {{ form_widget(form.content, {'attr': {'class': 'chat-input', 'rows': 1, 'placeholder': 'Écrivez votre message…'}}) }}
        <button type="submit" class="chat-send-btn" title="Envoyer">
          <svg viewBox="0 0 24 24"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
        </button>
      {{ form_end(form) }}
    </div>
  {% endif %}
</div>

<div class="modal-backdrop-chat" id="deleteModal">
  <div class="modal-box">
    <div class="modal-icon">🗑️</div>
    <h3>Supprimer la conversation ?</h3>
    <p>Cette action est irréversible. Tous les messages échangés avec <strong>{{ otherUser.prenom }}</strong> seront définitivement supprimés.</p>
    <div class="modal-box-actions">
      <button class="mbtn mbtn-cancel" onclick="closeDeleteModal()">Annuler</button>
      <form method="post" action="{{ path('app_message_delete', { id: conversation.id }) }}" style="display:inline;">
        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ conversation.id) }}">
        <button type="submit" class="mbtn mbtn-delete">Supprimer</button>
      </form>
    </div>
  </div>
</div>
{% endblock %}

{% block javascripts %}
  {{ parent() }}
  <script>
    function openDeleteModal() { document.getElementById('deleteModal').classList.add('open'); }
    function closeDeleteModal() { document.getElementById('deleteModal').classList.remove('open'); }

    document.getElementById('deleteModal').addEventListener('click', function (e) {
      if (e.target === this) closeDeleteModal();
    });
  </script>
{% endblock %}
