{% extends 'base.html.twig' %}

{% block title %}Mes messages{% endblock %}

{% block content %}
<div class="container mt-5">
    <div class="row">
        <div class="col-md-12">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h1>Messages</h1>
                {% if unreadCount > 0 %}
                    <span class="badge bg-danger">{{ unreadCount }} non lu(s)</span>
                {% endif %}
            </div>

            <div class="card mb-4">
                <div class="card-body">
                    <h5 class="card-title mb-3">Nouvelle discussion</h5>
                    {% if availableRecipients is empty %}
                        <div class="alert alert-warning mb-0">
                            Aucun destinataire disponible pour le moment.
                        </div>
                    {% else %}
                        <form id="startConversationForm" class="row g-2 align-items-center">
                            <div class="col-sm-8">
                                <select id="recipientSelect" class="form-select" required>
                                    <option value="" selected disabled>Choisir un destinataire</option>
                                    {% for recipient in availableRecipients %}
                                        <option value="{{ recipient.id }}">
                                            {{ recipient.prenom }} {{ recipient.nom }} ({{ recipient.email }})
                                        </option>
                                    {% endfor %}
                                </select>
                            </div>
                            <div class="col-sm-4">
                                <button type="submit" class="btn btn-primary w-100">Démarrer</button>
                            </div>
                        </form>
                    {% endif %}
                </div>
            </div>

            {% if conversations is empty %}
                <div class="alert alert-info">
                    Aucune conversation pour le moment.
                </div>
            {% else %}
                <div class="list-group">
                    {% for conversation in conversations %}
                        {% set otherUser = conversation.getOtherUser(app.user) %}
                        <a href="{{ path('app_message_show', { id: conversation.id }) }}" class="list-group-item list-group-item-action">
                            <div class="d-flex justify-content-between align-items-start">
                                <div>
                                    <h5 class="mb-1">{{ otherUser.username }}</h5>
                                    <p class="mb-0 text-muted">
                                        Dernier message: {{ conversation.lastMessageAt|date('d/m/Y H:i') }}
                                    </p>
                                </div>
                                <small class="text-muted">{{ otherUser.prenom }} {{ otherUser.nom }}</small>
                            </div>
                        </a>
                    {% endfor %}
                </div>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        const startForm = document.getElementById('startConversationForm');
        const recipientSelect = document.getElementById('recipientSelect');
        if (startForm && recipientSelect) {
            startForm.addEventListener('submit', (e) => {
                e.preventDefault();
                const recipientId = recipientSelect.value;
                if (!recipientId) return;
                window.location.href = "{{ path('app_message_start', { recipient: 'RECIPIENT_ID' }) }}".replace('RECIPIENT_ID', recipientId);
            });
        }
    </script>
{% endblock %}
