{% extends 'base.html.twig' %}

{% block title %}Uploader un document{% endblock %}

{% block content %}
<div class="content-wrapper" style="padding: 30px 40px; max-width: 900px; margin: 0 auto;">
    <div class="page-header" style="margin-bottom: 32px;">
        <div style="display: flex; align-items: center; gap: 16px;">
            <div style="width: 48px; height: 48px; background: linear-gradient(135deg, #10b981 0%, #059669 100%); border-radius: 12px; display: flex; align-items: center; justify-content: center;">
                <i class="fas fa-cloud-upload-alt" style="color: white; font-size: 24px;"></i>
            </div>
            <div>
                <h1 style="margin: 0; font-size: 28px; font-weight: 700; color: #1a1a2e;">Uploader un document</h1>
                <p style="margin: 4px 0 0 0; color: #64748b; font-size: 14px;">Ajoutez un nouveau document médical à votre dossier</p>
            </div>
        </div>
    </div>

    <div style="background: white; border-radius: 16px; padding: 32px; box-shadow: 0 2px 8px rgba(15,23,42,0.06); border: 1px solid #e2e8f0; margin-bottom: 24px;">
        {% if form_errors(form)|length > 0 %}
            <div style="background: #fee; border-left: 4px solid #ef4444; padding: 16px; border-radius: 8px; margin-bottom: 24px; color: #991b1b;">
                <h5 style="margin: 0 0 8px 0; font-weight: 600;">Erreurs de validation:</h5>
                {{ form_errors(form) }}
            </div>
        {% endif %}

        {{ form_start(form, {'attr': {'class': 'needs-validation', 'novalidate': true}, 'multipart': true}) }}

        <div style="margin-bottom: 24px;">
            <label style="display: block; margin-bottom: 8px; font-weight: 600; color: #1e293b; font-size: 14px;">
                <i class="fas fa-file-upload" style="margin-right: 6px; color: #10b981;"></i>
                Sélectionner un fichier
            </label>
            {{ form_widget(form.file, {'attr': {'style': 'width: 100%; padding: 12px 16px; border: 2px dashed #10b981; border-radius: 10px; font-size: 15px; transition: all 0.2s; background: #f0fdf4;'}}) }}
            <div style="background: #dbeafe; border-radius: 8px; padding: 12px; margin-top: 8px;">
                <small style="color: #1e40af; font-size: 13px; display: flex; align-items: center; gap: 6px;">
                    <i class="fas fa-info-circle"></i>
                    <span><strong>Formats supportés:</strong> PDF, Word, Excel, Images • <strong>Taille max:</strong> 50 MB</span>
                </small>
            </div>
            {% if form.file.vars.errors|length > 0 %}
                <div style="background: #fee; border-left: 4px solid #ef4444; padding: 12px; border-radius: 8px; margin-top: 8px; color: #991b1b;">
                    {{ form_errors(form.file) }}
                </div>
            {% endif %}
        </div>

        <div style="margin-bottom: 24px;">
            <label style="display: block; margin-bottom: 8px; font-weight: 600; color: #1e293b; font-size: 14px;">
                <i class="fas fa-align-left" style="margin-right: 6px; color: #10b981;"></i>
                {{ form.description.vars.label }}
            </label>
            {{ form_widget(form.description, {'attr': {'style': 'width: 100%; padding: 12px 16px; border: 2px solid #e2e8f0; border-radius: 10px; font-size: 15px; transition: all 0.2s; min-height: 100px;'}}) }}
            {% if form.description.vars.errors|length > 0 %}
                <div style="background: #fee; border-left: 4px solid #ef4444; padding: 12px; border-radius: 8px; margin-top: 8px; color: #991b1b;">
                    {{ form_errors(form.description) }}
                </div>
            {% endif %}
        </div>

        <div style="margin-bottom: 24px;">
            <label style="display: block; margin-bottom: 8px; font-weight: 600; color: #1e293b; font-size: 14px;">
                <i class="fas fa-folder-open" style="margin-right: 6px; color: #10b981;"></i>
                {{ form.documentType.vars.label }}
            </label>
            {{ form_widget(form.documentType, {'attr': {'style': 'width: 100%; padding: 12px 16px; border: 2px solid #e2e8f0; border-radius: 10px; font-size: 15px; transition: all 0.2s;'}}) }}
            {% if form.documentType.vars.errors|length > 0 %}
                <div style="background: #fee; border-left: 4px solid #ef4444; padding: 12px; border-radius: 8px; margin-top: 8px; color: #991b1b;">
                    {{ form_errors(form.documentType) }}
                </div>
            {% endif %}
        </div>

        <div style="margin-bottom: 28px; background: #f8fafc; padding: 16px; border-radius: 10px; border: 1px solid #e2e8f0;">
            <label style="display: flex; align-items: center; gap: 10px; cursor: pointer; font-weight: 500; color: #1e293b;">
                {{ form_widget(form.public, {'attr': {'style': 'width: 20px; height: 20px; cursor: pointer;'}}) }}
                <span><i class="fas fa-globe" style="margin-right: 6px; color: #10b981;"></i>{{ form.public.vars.label }}</span>
            </label>
            <small style="display: block; margin-top: 8px; margin-left: 30px; color: #64748b; font-size: 13px;">
                Si coché, ce document sera accessible au public
            </small>
            {% if form.public.vars.errors|length > 0 %}
                <div style="background: #fee; border-left: 4px solid #ef4444; padding: 12px; border-radius: 8px; margin-top: 8px; color: #991b1b;">
                    {{ form_errors(form.public) }}
                </div>
            {% endif %}
        </div>

        <div style="display: flex; gap: 12px; flex-wrap: wrap;">
            <button type="submit" style="padding: 12px 28px; background: linear-gradient(135deg, #10b981 0%, #059669 100%); color: white; border: none; border-radius: 10px; font-weight: 600; cursor: pointer; transition: all 0.2s; box-shadow: 0 4px 12px rgba(16,185,129,0.3); display: inline-flex; align-items: center; gap: 8px;" onmouseover="this.style.transform='translateY(-2px)'; this.style.boxShadow='0 8px 20px rgba(16,185,129,0.4)';" onmouseout="this.style.transform='translateY(0)'; this.style.boxShadow='0 4px 12px rgba(16,185,129,0.3)';">
                <i class="fas fa-upload"></i> Uploader le document
            </button>
            <a href="{{ path('app_document_index') }}" style="padding: 12px 28px; background: #f1f5f9; color: #475569; border: none; border-radius: 10px; font-weight: 600; text-decoration: none; transition: all 0.2s; display: inline-flex; align-items: center; gap: 8px;" onmouseover="this.style.background='#e2e8f0';" onmouseout="this.style.background='#f1f5f9';">
                <i class="fas fa-times"></i> Annuler
            </a>
        </div>

        {{ form_end(form) }}
    </div>

    <div style="background: linear-gradient(135deg, #d1fae5 0%, #ecfdf5 100%); border-radius: 16px; padding: 24px; border: 1px solid #a7f3d0;">
        <h3 style="margin: 0 0 16px 0; font-size: 18px; font-weight: 600; color: #065f46; display: flex; align-items: center; gap: 10px;">
            <i class="fas fa-lightbulb"></i>
            Conseils pour l'upload
        </h3>
        <ul style="margin: 0; padding-left: 24px; color: #065f46; line-height: 1.8;">
            <li>Utilisez des noms de fichier clairs et descriptifs</li>
            <li>Assurez-vous que le type de document est correctement sélectionné</li>
            <li>Vous pouvez rendre le document public pour le partager facilement</li>
            <li>Vous pourrez partager le document avec des utilisateurs spécifiques après l'upload</li>
        </ul>
    </div>
</div>
{% endblock %}
