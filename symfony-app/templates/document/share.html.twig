{% extends 'base.html.twig' %}

{% block title %}Partager {{ document.fileName }}{% endblock %}

{% block content %}
<div class="container mt-5">
    <div class="row">
        <div class="col-md-8 mx-auto">
            <h3 class="mb-4">
                <i class="bi bi-share"></i> Partager "{{ document.fileName }}"
            </h3>

            <!-- Form -->
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="mb-0">Nouveau partage</h5>
                </div>
                <div class="card-body">
                    {{ form_start(form, {'attr': {'class': 'needs-validation'}}) }}

                    <div class="mb-3">
                        {{ form_label(form.sharedWith) }}
                        {{ form_widget(form.sharedWith, {'attr': {'class': 'form-control'}}) }}
                        {% if form.sharedWith.vars.errors|length > 0 %}
                            <div class="alert alert-danger mt-2">
                                {{ form_errors(form.sharedWith) }}
                            </div>
                        {% endif %}
                    </div>

                    <div class="mb-3">
                        {{ form_label(form.permission) }}
                        {{ form_widget(form.permission, {'attr': {'class': 'form-control'}}) }}
                        <small class="text-muted d-block mt-2">
                            <strong>Affichage seulement:</strong> L'utilisateur peut seulement voir le document<br>
                            <strong>Télécharger:</strong> L'utilisateur peut télécharger le document
                        </small>
                    </div>

                    <div class="mb-3">
                        {{ form_label(form.expiresAt) }}
                        {{ form_widget(form.expiresAt, {'attr': {'class': 'form-control'}}) }}
                        <small class="text-muted d-block mt-2">
                            Laissez vide pour un accès illimité
                        </small>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-check-circle"></i> Partager
                        </button>
                        <a href="{{ path('app_document_show', {id: document.id}) }}" class="btn btn-secondary">
                            Annuler
                        </a>
                    </div>

                    {{ form_end(form) }}
                </div>
            </div>

            <!-- Current Shares -->
            {% if activeAccesses is not empty %}
                <div class="card">
                    <div class="card-header">
                        <h5 class="mb-0">Accès actifs</h5>
                    </div>
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table">
                                <thead class="table-light">
                                    <tr>
                                        <th>Utilisateur</th>
                                        <th>Permission</th>
                                        <th>Partagé le</th>
                                        <th>Expire</th>
                                        <th>Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for access in activeAccesses %}
                                        <tr>
                                            <td>
                                                <strong>{{ access.sharedWith.username }}</strong><br>
                                                <small class="text-muted">{{ access.sharedWith.email }}</small>
                                            </td>
                                            <td>
                                                {% if access.permission == 'view' %}
                                                    <span class="badge bg-info">Affichage</span>
                                                {% elseif access.permission == 'download' %}
                                                    <span class="badge bg-success">Télécharger</span>
                                                {% endif %}
                                            </td>
                                            <td>{{ access.sharedAt|date('d/m/Y H:i') }}</td>
                                            <td>
                                                {% if access.expiresAt %}
                                                    <strong>{{ access.expiresAt|date('d/m/Y') }}</strong>
                                                    {% if access.isExpired() %}
                                                        <br><span class="badge bg-danger">Expiré</span>
                                                    {% endif %}
                                                {% else %}
                                                    <span class="text-muted">Jamais</span>
                                                {% endif %}
                                            </td>
                                            <td>
                                                <form action="{{ path('app_document_revoke_access', {id: document.id, accessId: access.id}) }}" 
                                                      method="POST" style="display:inline;">
                                                    <input type="hidden" name="_token" value="{{ csrf_token('revoke' ~ access.id) }}">
                                                    <button type="submit" class="btn btn-sm btn-danger" 
                                                            onclick="return confirm('Révoquer l\'accès?')">
                                                        <i class="bi bi-x-circle"></i> Révoquer
                                                    </button>
                                                </form>
                                            </td>
                                        </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}
