{% extends 'base.html.twig' %}

{% block title %}{{ document.fileName }}{% endblock %}

{% block content %}
<div class="content-wrapper" style="padding: 30px 40px; max-width: 1200px; margin: 0 auto;">
    <!-- Breadcrumb Navigation -->
    <nav style="margin-bottom: 24px;">
        <ol style="list-style: none; display: flex; align-items: center; gap: 12px; padding: 0; margin: 0; font-size: 14px;">
            <li><a href="{{ path('app_document_index') }}" style="color: #64748b; text-decoration: none; transition: color 0.2s;" onmouseover="this.style.color='#10b981'" onmouseout="this.style.color='#64748b'">
                <i class="fas fa-file-medical"></i> Documents</a></li>
            <li style="color: #cbd5e1;"><i class="fas fa-chevron-right" style="font-size: 10px;"></i></li>
            <li style="color: #1e293b; font-weight: 600;">{{ document.fileName }}</li>
        </ol>
    </nav>

    <!-- Document Header Card -->
    <div style="background: white; border-radius: 16px; box-shadow: 0 4px 20px rgba(15,23,42,0.08); overflow: hidden; margin-bottom: 24px;">
        <div style="background: linear-gradient(135deg, #10b981 0%, #059669 100%); padding: 32px 32px 80px 32px; position: relative;">
            <div style="display: flex; justify-content: space-between; align-items: start; gap: 24px; position: relative; z-index: 1;">
                <div style="display: flex; align-items: start; gap: 20px; flex: 1;">
                    <div style="width: 72px; height: 72px; background: rgba(255,255,255,0.2); backdrop-filter: blur(10px); border-radius: 16px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; box-shadow: 0 8px 24px rgba(0,0,0,0.15);">
                        <i class="bi {{ document.mimeType|mime_icon }}" style="color: white; font-size: 36px;"></i>
                    </div>
                    <div style="flex: 1; min-width: 0;">
                        <h1 style="color: white; font-size: 28px; font-weight: 700; margin: 0 0 12px 0; word-break: break-word;">{{ document.fileName }}</h1>
                        <div style="display: flex; align-items: center; gap: 16px; flex-wrap: wrap;">
                            <span style="display: inline-flex; align-items: center; gap: 8px; color: rgba(255,255,255,0.9); font-size: 14px;">
                                <i class="fas fa-user"></i>
                                <strong>{{ document.owner.username }}</strong>
                            </span>
                            <span style="display: inline-flex; align-items: center; padding: 6px 14px; background: rgba(255,255,255,0.25); backdrop-filter: blur(10px); color: white; border-radius: 8px; font-weight: 600; font-size: 12px;">
                                <i class="fas fa-bookmark" style="margin-right: 6px;"></i>{{ document.documentType }}
                            </span>
                            {% if document.isPublic %}
                                <span style="display: inline-flex; align-items: center; padding: 6px 14px; background: rgba(255,255,255,0.25); backdrop-filter: blur(10px); color: white; border-radius: 8px; font-weight: 600; font-size: 12px;">
                                    <i class="fas fa-globe" style="margin-right: 6px;"></i>Public
                                </span>
                            {% else %}
                                <span style="display: inline-flex; align-items: center; padding: 6px 14px; background: rgba(255,255,255,0.25); backdrop-filter: blur(10px); color: white; border-radius: 8px; font-weight: 600; font-size: 12px;">
                                    <i class="fas fa-lock" style="margin-right: 6px;"></i>Privé
                                </span>
                            {% endif %}
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Stats Cards (Overlapping) -->
        <div style="padding: 0 32px; margin-top: -60px; position: relative; z-index: 2;">
            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 16px; margin-bottom: 32px;">
                <div style="background: white; border-radius: 12px; padding: 20px; box-shadow: 0 4px 16px rgba(15,23,42,0.1); border: 1px solid #e2e8f0;">
                    <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 8px;">
                        <div style="width: 40px; height: 40px; background: linear-gradient(135deg, #dbeafe 0%, #bfdbfe 100%); border-radius: 10px; display: flex; align-items: center; justify-content: center;">
                            <i class="fas fa-hdd" style="color: #3b82f6; font-size: 18px;"></i>
                        </div>
                        <div>
                            <div style="font-size: 11px; color: #64748b; text-transform: uppercase; font-weight: 600; letter-spacing: 0.5px;">Taille</div>
                            <div style="font-size: 20px; font-weight: 700; color: #1e293b;">{{ document.getFileSizeFormatted() }}</div>
                        </div>
                    </div>
                </div>
                <div style="background: white; border-radius: 12px; padding: 20px; box-shadow: 0 4px 16px rgba(15,23,42,0.1); border: 1px solid #e2e8f0;">
                    <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 8px;">
                        <div style="width: 40px; height: 40px; background: linear-gradient(135deg, #d1fae5 0%, #a7f3d0 100%); border-radius: 10px; display: flex; align-items: center; justify-content: center;">
                            <i class="fas fa-clock" style="color: #059669; font-size: 18px;"></i>
                        </div>
                        <div>
                            <div style="font-size: 11px; color: #64748b; text-transform: uppercase; font-weight: 600; letter-spacing: 0.5px;">Uploadé</div>
                            <div style="font-size: 16px; font-weight: 700; color: #1e293b;">{{ document.uploadedAt|date('d/m/Y H:i') }}</div>
                        </div>
                    </div>
                </div>
                <div style="background: white; border-radius: 12px; padding: 20px; box-shadow: 0 4px 16px rgba(15,23,42,0.1); border: 1px solid #e2e8f0;">
                    <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 8px;">
                        <div style="width: 40px; height: 40px; background: linear-gradient(135deg, #f3e8ff 0%, #e9d5ff 100%); border-radius: 10px; display: flex; align-items: center; justify-content: center;">
                            <i class="fas fa-file-code" style="color: #7c3aed; font-size: 18px;"></i>
                        </div>
                        <div style="min-width: 0;">
                            <div style="font-size: 11px; color: #64748b; text-transform: uppercase; font-weight: 600; letter-spacing: 0.5px;">Type MIME</div>
                            <div style="font-size: 13px; font-weight: 600; color: #1e293b; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">{{ document.mimeType }}</div>
                        </div>
                    </div>
                </div>
            </div>

            {% if document.description %}
                <div style="background: linear-gradient(135deg, #f0f9ff 0%, #e0f2fe 100%); border: 1px solid #bae6fd; border-radius: 12px; padding: 20px; margin-bottom: 32px;">
                    <div style="display: flex; align-items: start; gap: 12px;">
                        <i class="fas fa-info-circle" style="color: #0284c7; font-size: 18px; margin-top: 2px;"></i>
                        <div>
                            <strong style="color: #0c4a6e; display: block; margin-bottom: 8px;">Description:</strong>
                            <p style="color: #0c4a6e; margin: 0; line-height: 1.6;">{{ document.description }}</p>
                        </div>
                    </div>
                </div>
            {% endif %}

            <!-- Actions -->
            <div style="display: flex; gap: 12px; flex-wrap: wrap; padding-bottom: 32px;">
                     <a href="{{ path('app_document_download', {id: document.id}) }}" download
                   style="padding: 14px 24px; background: linear-gradient(135deg, #10b981 0%, #059669 100%); color: white; border: none; border-radius: 10px; font-weight: 600; text-decoration: none; display: inline-flex; align-items: center; gap: 10px; box-shadow: 0 4px 12px rgba(16,185,129,0.3); transition: all 0.2s;"
                   onmouseover="this.style.transform='translateY(-2px)'; this.style.boxShadow='0 8px 20px rgba(16,185,129,0.4)';"
                   onmouseout="this.style.transform='translateY(0)'; this.style.boxShadow='0 4px 12px rgba(16,185,129,0.3)';">
                    <i class="bi bi-download"></i> Télécharger
                </a>
                {% if isOwner %}
                    <a href="{{ path('app_document_share', {id: document.id}) }}" 
                       style="padding: 14px 24px; background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%); color: white; border: none; border-radius: 10px; font-weight: 600; text-decoration: none; display: inline-flex; align-items: center; gap: 10px; box-shadow: 0 4px 12px rgba(245,158,11,0.3); transition: all 0.2s;"
                       onmouseover="this.style.transform='translateY(-2px)'; this.style.boxShadow='0 8px 20px rgba(245,158,11,0.4)';"
                       onmouseout="this.style.transform='translateY(0)'; this.style.boxShadow='0 4px 12px rgba(245,158,11,0.3)';">
                        <i class="bi bi-share"></i> Partager
                    </a>
                    <form action="{{ path('app_document_delete', {id: document.id}) }}" method="POST" style="display: inline;">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ document.id) }}">
                        <button type="submit" 
                                style="padding: 14px 24px; background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%); color: white; border: none; border-radius: 10px; font-weight: 600; cursor: pointer; display: inline-flex; align-items: center; gap: 10px; box-shadow: 0 4px 12px rgba(239,68,68,0.3); transition: all 0.2s;"
                                onmouseover="this.style.transform='translateY(-2px)'; this.style.boxShadow='0 8px 20px rgba(239,68,68,0.4)';"
                                onmouseout="this.style.transform='translateY(0)'; this.style.boxShadow='0 4px 12px rgba(239,68,68,0.3)';"
                                onclick="return confirm('Êtes-vous sûr de vouloir supprimer ce document ?')">
                            <i class="bi bi-trash"></i> Supprimer
                        </button>
                    </form>
                {% endif %}
                <a href="{{ path('app_document_index') }}" 
                   style="padding: 14px 24px; background: white; color: #64748b; border: 2px solid #e2e8f0; border-radius: 10px; font-weight: 600; text-decoration: none; display: inline-flex; align-items: center; gap: 10px; transition: all 0.2s;"
                   onmouseover="this.style.borderColor='#cbd5e1'; this.style.color='#475569';"
                   onmouseout="this.style.borderColor='#e2e8f0'; this.style.color='#64748b';">
                    <i class="bi bi-arrow-left"></i> Retour
                </a>
            </div>
        </div>
    </div>

    <!-- Owner View - Statistics & Sharing Info -->
    {% if isOwner %}
        <div style="background: white; border-radius: 16px; box-shadow: 0 4px 20px rgba(15,23,42,0.08); overflow: hidden;">
            <div style="background: linear-gradient(135deg, #f8fafc 0%, #f1f5f9 100%); padding: 24px 32px; border-bottom: 2px solid #e2e8f0;">
                <div style="display: flex; align-items: center; gap: 12px;">
                    <div style="width: 40px; height: 40px; background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%); border-radius: 10px; display: flex; align-items: center; justify-content: center;">
                        <i class="fas fa-chart-bar" style="color: white; font-size: 18px;"></i>
                    </div>
                    <h2 style="margin: 0; font-size: 20px; font-weight: 700; color: #1e293b;">Informations de partage</h2>
                </div>
            </div>
            <div style="padding: 32px;">
                {% if stats %}
                    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 20px; margin-bottom: 32px;">
                        <div style="background: linear-gradient(135deg, #dbeafe 0%, #bfdbfe 100%); border-radius: 12px; padding: 24px; text-align: center;">
                            <div style="width: 56px; height: 56px; background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%); border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 16px;">
                                <i class="fas fa-users" style="color: white; font-size: 24px;"></i>
                            </div>
                            <div style="font-size: 36px; font-weight: 700; color: #1e40af; margin-bottom: 4px;">{{ stats.sharedWith }}</div>
                            <div style="color: #1e40af; font-weight: 600; font-size: 14px;">Personne(s) ayant accès</div>
                        </div>
                        <div style="background: linear-gradient(135deg, #d1fae5 0%, #a7f3d0 100%); border-radius: 12px; padding: 24px; text-align: center;">
                            <div style="width: 56px; height: 56px; background: linear-gradient(135deg, #10b981 0%, #059669 100%); border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 16px;">
                                <i class="fas fa-download" style="color: white; font-size: 24px;"></i>
                            </div>
                            <div style="font-size: 36px; font-weight: 700; color: #065f46; margin-bottom: 4px;">{{ stats.totalAccesses }}</div>
                            <div style="color: #065f46; font-weight: 600; font-size: 14px;">Téléchargement(s)</div>
                        </div>
                    </div>
                {% endif %}

                {% if accesses is empty %}
                    <div style="background: linear-gradient(135deg, #fef3c7 0%, #fde68a 100%); border: 2px dashed #f59e0b; border-radius: 12px; padding: 48px; text-align: center;">
                        <div style="width: 64px; height: 64px; background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%); border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 16px;">
                            <i class="fas fa-share-alt" style="color: white; font-size: 28px;"></i>
                        </div>
                        <h3 style="color: #92400e; font-weight: 600; margin-bottom: 8px;">Document non partagé</h3>
                        <p style="color: #92400e; margin: 0;">Ce document n'a pas encore été partagé avec d'autres utilisateurs.</p>
                    </div>
                {% else %}
                    <div style="margin-bottom: 20px;">
                        <h3 style="font-size: 18px; font-weight: 700; color: #1e293b; margin-bottom: 16px; display: flex; align-items: center; gap: 10px;">
                            <i class="fas fa-history" style="color: #64748b;"></i> Historique d'accès
                        </h3>
                    </div>
                    <div style="background: white; border-radius: 12px; border: 1px solid #e2e8f0; overflow: hidden;">
                        <table style="width: 100%; border-collapse: separate; border-spacing: 0;">
                            <thead>
                                <tr style="background: linear-gradient(135deg, #f8fafc 0%, #f1f5f9 100%); border-bottom: 2px solid #e2e8f0;">
                                    <th style="padding: 16px 20px; text-align: left; font-weight: 700; color: #1e293b; font-size: 12px; text-transform: uppercase; letter-spacing: 0.5px;">Utilisateur</th>
                                    <th style="padding: 16px 20px; text-align: left; font-weight: 700; color: #1e293b; font-size: 12px; text-transform: uppercase; letter-spacing: 0.5px;">Partagé le</th>
                                    <th style="padding: 16px 20px; text-align: center; font-weight: 700; color: #1e293b; font-size: 12px; text-transform: uppercase; letter-spacing: 0.5px;">Accès</th>
                                    <th style="padding: 16px 20px; text-align: left; font-weight: 700; color: #1e293b; font-size: 12px; text-transform: uppercase; letter-spacing: 0.5px;">Dernier accès</th>
                                    <th style="padding: 16px 20px; text-align: left; font-weight: 700; color: #1e293b; font-size: 12px; text-transform: uppercase; letter-spacing: 0.5px;">Expire</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for access in accesses %}
                                    <tr style="border-bottom: 1px solid #f1f5f9; {% if not access.isActive %}background: #fef2f2;{% else %}transition: background 0.2s;{% endif %}" 
                                        {% if access.isActive %}onmouseover="this.style.background='#f8fafc'" onmouseout="this.style.background='white'"{% endif %}>
                                        <td style="padding: 16px 20px;">
                                            <div style="display: flex; align-items: center; gap: 10px;">
                                                <div style="width: 36px; height: 36px; border-radius: 50%; background: linear-gradient(135deg, #a78bfa 0%, #8b5cf6 100%); display: flex; align-items: center; justify-content: center; color: white; font-weight: 700; font-size: 13px;">
                                                    {{ access.sharedWith.username|first|upper }}
                                                </div>
                                                <span style="color: #1e293b; font-weight: 600; font-size: 14px;">{{ access.sharedWith.username }}</span>
                                            </div>
                                        </td>
                                        <td style="padding: 16px 20px;">
                                            <span style="color: #64748b; font-size: 14px;">{{ access.sharedAt|date('d/m/Y H:i') }}</span>
                                        </td>
                                        <td style="padding: 16px 20px; text-align: center;">
                                            <span style="display: inline-flex; align-items: center; justify-content: center; min-width: 36px; padding: 6px 12px; background: linear-gradient(135deg, #dbeafe 0%, #bfdbfe 100%); color: #1e40af; border-radius: 8px; font-weight: 700; font-size: 14px;">
                                                {{ access.accessCount }}
                                            </span>
                                        </td>
                                        <td style="padding: 16px 20px;">
                                            {% if access.accessedAt %}
                                                <span style="color: #64748b; font-size: 14px;">{{ access.accessedAt|date('d/m/Y H:i') }}</span>
                                            {% else %}
                                                <span style="color: #cbd5e1; font-style: italic; font-size: 14px;">Jamais</span>
                                            {% endif %}
                                        </td>
                                        <td style="padding: 16px 20px;">
                                            {% if access.expiresAt %}
                                                <span style="display: inline-flex; align-items: center; padding: 6px 12px; background: linear-gradient(135deg, #fef3c7 0%, #fde68a 100%); color: #92400e; border-radius: 8px; font-weight: 600; font-size: 12px;">
                                                    <i class="fas fa-clock" style="margin-right: 6px; font-size: 10px;"></i>{{ access.expiresAt|date('d/m/Y H:i') }}
                                                </span>
                                            {% else %}
                                                <span style="display: inline-flex; align-items: center; padding: 6px 12px; background: linear-gradient(135deg, #d1fae5 0%, #a7f3d0 100%); color: #065f46; border-radius: 8px; font-weight: 600; font-size: 12px;">
                                                    <i class="fas fa-infinity" style="margin-right: 6px; font-size: 10px;"></i>Permanent
                                                </span>
                                            {% endif %}
                                        </td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                {% endif %}
            </div>
        </div>
    {% endif %}
</div>
{% endblock %}
