{% extends 'front/base_auth.html.twig' %}

{% block title %}Réinitialiser le mot de passe - SANTÉA{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        /* =========================================================
           RESET PASSWORD: form sizing
        ========================================================= */
        #resetForm.auth-form {
            max-width: 460px;
            width: 100%;
            animation: fadeInUp 0.55s ease-out;
        }

        /* TOP ACTIONS */
        .auth-top-actions {
            display: flex;
            justify-content: flex-end;
            margin-bottom: 18px;
        }
        .auth-home-btn {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            padding: 9px 16px;
            border: 1.5px solid #e2e8f0;
            border-radius: 10px;
            background: #f8fafc;
            color: #374151;
            font-size: 13px;
            font-weight: 600;
            text-decoration: none;
            transition: all 0.2s ease;
        }
        .auth-home-btn:hover {
            background: #e0e7ff;
            border-color: #6366f1;
            color: #4f46e5;
            transform: translateY(-1px);
        }
        .auth-home-btn i { font-size: 13px; }

        /* TITLE */
        #resetForm h1 {
            font-size: 1.75rem !important;
            margin-bottom: 6px !important;
            display: flex;
            align-items: center;
            gap: 10px;
        }
        #resetForm h1 .title-icon {
            width: 42px; height: 42px;
            background: linear-gradient(135deg, #3b82f6, #6366f1);
            border-radius: 12px;
            display: flex; align-items: center; justify-content: center;
            color: #fff;
            font-size: 18px;
            flex-shrink: 0;
            box-shadow: 0 4px 12px rgba(99,102,241,.25);
        }
        #resetForm .subtitle {
            font-size: 13px;
            color: #6b7280;
            margin-bottom: 22px;
            margin-top: 0;
        }

        /* FORM CARD */
        .login-card {
            background: #f9fafb;
            border: 1.5px solid #e5e7eb;
            border-radius: 16px;
            padding: 24px 22px 20px;
            display: flex;
            flex-direction: column;
            gap: 16px;
            margin-bottom: 18px;
            transition: border-color 0.2s;
        }
        .login-card:focus-within {
            border-color: #6366f1;
            box-shadow: 0 0 0 3px rgba(99,102,241,.06);
        }
        .card-header {
            display: flex;
            align-items: center;
            gap: 10px;
            padding-bottom: 14px;
            border-bottom: 1.5px solid #e5e7eb;
        }
        .card-header__icon {
            width: 34px; height: 34px;
            border-radius: 10px;
            background: #eef2ff;
            color: #6366f1;
            display: flex; align-items: center; justify-content: center;
            font-size: 15px;
            flex-shrink: 0;
        }
        .card-header__title { font-size: 13px; font-weight: 700; color: #374151; }
        .card-header__sub   { font-size: 11px; color: #9ca3af; }

        /* FIELDS */
        .form-group {
            display: flex;
            flex-direction: column;
            gap: 5px;
            margin-bottom: 0;
        }
        .form-group label {
            font-size: 12px;
            font-weight: 600;
            color: #374151;
            display: flex;
            align-items: center;
            gap: 5px;
        }
        .form-group label .field-icon { color: #9ca3af; font-size: 11px; }

        .input-wrapper { position: relative; }
        .input-wrapper .input-icon {
            position: absolute;
            left: 12px; top: 50%;
            transform: translateY(-50%);
            color: #9ca3af;
            font-size: 13px;
            pointer-events: none;
            transition: color 0.2s;
            z-index: 1;
        }
        .input-wrapper:focus-within .input-icon { color: #6366f1; }

        .login-card input[type="password"],
        .login-card input[type="text"] {
            width: 100%;
            padding: 11px 38px 11px 36px;
            border: 1.5px solid #d1d5db;
            border-radius: 10px;
            font-size: 13.5px;
            color: #111827;
            background: #fff;
            outline: none;
            box-sizing: border-box;
            transition: border-color 0.2s, box-shadow 0.2s;
        }
        .login-card input:focus {
            border-color: #6366f1;
            box-shadow: 0 0 0 3px rgba(99,102,241,.1);
        }

        /* Password toggle */
        .password-input { position: relative; }
        .toggle-password {
            position: absolute;
            right: 12px; top: 50%;
            transform: translateY(-50%);
            cursor: pointer;
            color: #9ca3af;
            font-size: 13px;
            transition: color 0.2s;
        }
        .toggle-password:hover { color: #6366f1; }

        /* STRENGTH BAR */
        .strength-bar-wrap {
            margin-top: 6px;
            display: flex;
            flex-direction: column;
            gap: 4px;
        }
        .strength-bar-track {
            height: 5px;
            background: #e5e7eb;
            border-radius: 99px;
            overflow: hidden;
        }
        .strength-bar {
            height: 100%;
            width: 0;
            border-radius: 99px;
            transition: width 0.35s ease, background 0.35s ease;
        }
        .strength-label {
            font-size: 11px;
            font-weight: 600;
            color: #9ca3af;
        }

        /* REQUIREMENTS BOX */
        .req-box {
            background: #eff6ff;
            border: 1.5px solid #bfdbfe;
            border-radius: 10px;
            padding: 10px 14px;
            font-size: 12px;
            color: #1e40af;
        }
        .req-box strong { display: block; margin-bottom: 5px; }
        .req-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 3px; }
        .req-list li { display: flex; align-items: center; gap: 6px; }
        .req-list li i { font-size: 10px; color: #9ca3af; transition: color 0.2s; }
        .req-list li.ok i { color: #10b981; }
        .req-list li.ok { color: #065f46; }

        /* SUBMIT */
        .login-submit {
            background: linear-gradient(135deg, #4f46e5 0%, #6366f1 100%);
            color: #fff;
            border: none;
            border-radius: 12px;
            padding: 13px 30px;
            font-size: 14.5px;
            font-weight: 700;
            cursor: pointer;
            width: 100%;
            letter-spacing: .02em;
            transition: all 0.25s ease;
            box-shadow: 0 4px 16px rgba(99,102,241,.3);
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            margin-top: 4px;
        }
        .login-submit:hover {
            background: linear-gradient(135deg, #4338ca 0%, #4f46e5 100%);
            transform: translateY(-2px);
            box-shadow: 0 8px 24px rgba(99,102,241,.35);
        }
        .login-submit:active { transform: translateY(0); }

        /* ALERTS */
        .alert {
            border-radius: 10px;
            padding: 11px 14px;
            font-size: 13px;
            display: flex;
            align-items: flex-start;
            gap: 8px;
            position: relative;
        }
        .alert-danger  { background: #fff1f2; border: 1.5px solid #fecaca; color: #b91c1c; }
        .alert-success { background: #f0fdf4; border: 1.5px solid #a7f3d0; color: #065f46; }
        .alert::before {
            font-family: 'Font Awesome 6 Free';
            font-weight: 900; font-size: 14px; flex-shrink: 0;
        }
        .alert-danger::before  { content: '\f071'; }
        .alert-success::before { content: '\f058'; }
        .close-alert {
            position: absolute; right: 10px; top: 8px;
            background: none; border: none;
            font-size: 16px; cursor: pointer;
            color: inherit; opacity: 0.6; line-height: 1;
        }
        .close-alert:hover { opacity: 1; }
    </style>
{% endblock %}

{% block auth_content %}
    <div class="auth-form" id="resetForm">

        {# ── Top action ── #}
        <div class="auth-top-actions">
            <a href="{{ path('app_home') }}" class="auth-home-btn">
                <i class="fas fa-home"></i> Accueil
            </a>
        </div>

        {# ── Title ── #}
        <h1>
            <span class="title-icon"><i class="fas fa-key"></i></span>
            Nouveau mot de passe
        </h1>
        <p class="subtitle">Choisissez un mot de passe sécurisé pour votre compte SANTÉA.</p>

        {# ── Alerts ── #}
        {% for message in app.flashes('error') %}
            <div class="alert alert-danger">{{ message }}</div>
        {% endfor %}
        {% for message in app.flashes('success') %}
            <div class="alert alert-success">{{ message }}</div>
        {% endfor %}

        {# ── Form card ── #}
        {{ form_start(resetPasswordForm) }}

            <div class="login-card">
                <div class="card-header">
                    <span class="card-header__icon"><i class="fas fa-lock"></i></span>
                    <div>
                        <div class="card-header__title">Nouveau mot de passe</div>
                        <div class="card-header__sub">Choisissez un mot de passe fort et unique</div>
                    </div>
                </div>

                {# PASSWORD 1 #}
                <div class="form-group">
                    <label>
                        <i class="fas fa-lock field-icon"></i>
                        Nouveau mot de passe&nbsp;<span style="color:#ef4444">*</span>
                    </label>
                    <div class="password-input input-wrapper">
                        <i class="fas fa-lock input-icon"></i>
                        {{ form_widget(resetPasswordForm.plainPassword.first, {
                            'attr': {
                                'id': 'password_first',
                                'placeholder': '••••••••',
                                'autofocus': 'autofocus'
                            }
                        }) }}
                        <i class="fas fa-eye-slash toggle-password" onclick="togglePassword('password_first')"></i>
                    </div>
                    {{ form_errors(resetPasswordForm.plainPassword.first) }}

                    {# STRENGTH BAR #}
                    <div class="strength-bar-wrap">
                        <div class="strength-bar-track">
                            <div class="strength-bar" id="strengthBar"></div>
                        </div>
                        <span class="strength-label" id="strengthLabel">Force du mot de passe</span>
                    </div>
                </div>

                {# REQUIREMENTS #}
                <div class="req-box">
                    <strong><i class="fas fa-shield-alt" style="margin-right:5px;"></i>Le mot de passe doit contenir :</strong>
                    <ul class="req-list">
                        <li id="req-len"><i class="fas fa-circle"></i> Au moins 8 caractères</li>
                        <li id="req-upper"><i class="fas fa-circle"></i> Une lettre majuscule</li>
                        <li id="req-lower"><i class="fas fa-circle"></i> Une lettre minuscule</li>
                        <li id="req-digit"><i class="fas fa-circle"></i> Un chiffre</li>
                    </ul>
                </div>

                {# PASSWORD 2 #}
                <div class="form-group">
                    <label>
                        <i class="fas fa-lock field-icon"></i>
                        Confirmer le mot de passe&nbsp;<span style="color:#ef4444">*</span>
                    </label>
                    <div class="password-input input-wrapper">
                        <i class="fas fa-lock input-icon"></i>
                        {{ form_widget(resetPasswordForm.plainPassword.second, {
                            'attr': {
                                'id': 'password_second',
                                'placeholder': '••••••••'
                            }
                        }) }}
                        <i class="fas fa-eye-slash toggle-password" onclick="togglePassword('password_second')"></i>
                    </div>
                    {{ form_errors(resetPasswordForm.plainPassword.second) }}
                </div>
            </div>

            <button type="submit" class="login-submit">
                <i class="fas fa-check-circle"></i>
                Réinitialiser le mot de passe
            </button>

        {{ form_end(resetPasswordForm) }}

        <p class="auth-switch" style="text-align:center; margin-top:18px;">
            <a href="{{ path('login') }}" style="color:#6366f1; font-weight:600;">
                <i class="fas fa-arrow-left" style="font-size:11px;"></i> Retour à la connexion
            </a>
        </p>

    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        function togglePassword(inputId) {
            const input = document.getElementById(inputId);
            const icon  = event.target;
            if (!input) return;
            if (input.type === 'password') {
                input.type = 'text';
                icon.classList.replace('fa-eye-slash', 'fa-eye');
            } else {
                input.type = 'password';
                icon.classList.replace('fa-eye', 'fa-eye-slash');
            }
        }

        document.addEventListener('DOMContentLoaded', function () {
            const bar    = document.getElementById('strengthBar');
            const label  = document.getElementById('strengthLabel');
            const input  = document.getElementById('password_first');
            const levels = [
                { pct: '0%',   bg: 'transparent', text: 'Force du mot de passe' },
                { pct: '25%',  bg: '#ef4444',      text: 'Faible' },
                { pct: '50%',  bg: '#f59e0b',      text: 'Moyen' },
                { pct: '75%',  bg: '#3b82f6',      text: 'Bon' },
                { pct: '100%', bg: '#10b981',       text: 'Fort' },
            ];

            const reqs = {
                len:   { el: document.getElementById('req-len'),   test: v => v.length >= 8 },
                upper: { el: document.getElementById('req-upper'), test: v => /[A-Z]/.test(v) },
                lower: { el: document.getElementById('req-lower'), test: v => /[a-z]/.test(v) },
                digit: { el: document.getElementById('req-digit'), test: v => /\d/.test(v) },
            };

            if (input) {
                input.addEventListener('input', function () {
                    const v = this.value;
                    let score = 0;
                    Object.values(reqs).forEach(r => {
                        const ok = r.test(v);
                        r.el.classList.toggle('ok', ok);
                        r.el.querySelector('i').className = ok ? 'fas fa-check-circle' : 'fas fa-circle';
                        if (ok) score++;
                    });
                    const lvl = levels[score];
                    bar.style.width      = lvl.pct;
                    bar.style.background = lvl.bg;
                    label.textContent    = lvl.text;
                    label.style.color    = score === 0 ? '#9ca3af' : lvl.bg;
                });
            }

            // Alert close buttons
            document.querySelectorAll('.alert').forEach(function (alert) {
                if (!alert.querySelector('.close-alert')) {
                    const btn = document.createElement('button');
                    btn.className = 'close-alert';
                    btn.innerHTML = '×';
                    btn.setAttribute('aria-label', 'Fermer');
                    btn.addEventListener('click', function () {
                        alert.style.transition = 'opacity 0.3s';
                        alert.style.opacity    = '0';
                        setTimeout(() => alert.remove(), 300);
                    });
                    alert.appendChild(btn);
                }
            });
        });
    </script>
{% endblock %}