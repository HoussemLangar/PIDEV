{% extends 'front/base_auth.html.twig' %}

{% block title %}Réinitialiser le mot de passe - SANTÉA{% endblock %}

{% block auth_content %}
    <div class="auth-form">
        <div style="text-align: center; margin-bottom: 20px;">
            <i class="fas fa-key" style="font-size: 48px; color: #667eea;"></i>
        </div>
        
        <h1>Nouveau mot de passe</h1>
        <p style="text-align: center; color: #666; margin-bottom: 30px;">
            Choisissez un nouveau mot de passe sécurisé pour votre compte.
        </p>

        {% for message in app.flashes('error') %}
            <div class="alert alert-danger">
                {{ message }}
            </div>
        {% endfor %}

        {{ form_start(resetPasswordForm) }}
            <div class="form-group">
                {{ form_label(resetPasswordForm.plainPassword.first) }}
                <div class="password-input">
                    {{ form_widget(resetPasswordForm.plainPassword.first, {
                        'attr': {'id': 'password_first'}
                    }) }}
                    <i class="fas fa-eye-slash toggle-password" onclick="togglePassword('password_first')"></i>
                </div>
                {{ form_errors(resetPasswordForm.plainPassword.first) }}
                
                <div class="password-requirements" style="margin-top: 10px; padding: 10px; background: #f0f7ff; border-left: 3px solid #3498db; border-radius: 4px; font-size: 12px;">
                    <strong>Le mot de passe doit contenir :</strong>
                    <ul style="margin: 5px 0 0 20px; padding: 0;">
                        <li>Au moins 8 caractères</li>
                        <li>Une lettre majuscule</li>
                        <li>Une lettre minuscule</li>
                        <li>Un chiffre</li>
                    </ul>
                </div>
            </div>

            <div class="form-group">
                {{ form_label(resetPasswordForm.plainPassword.second) }}
                <div class="password-input">
                    {{ form_widget(resetPasswordForm.plainPassword.second, {
                        'attr': {'id': 'password_second'}
                    }) }}
                    <i class="fas fa-eye-slash toggle-password" onclick="togglePassword('password_second')"></i>
                </div>
                {{ form_errors(resetPasswordForm.plainPassword.second) }}
            </div>

            <button type="submit" class="auth-submit-btn">
                <i class="fas fa-check"></i> Réinitialiser le mot de passe
            </button>
        {{ form_end(resetPasswordForm) }}
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        function togglePassword(inputId) {
            const input = document.getElementById(inputId);
            const icon = event.target;
            
            if (input) {
                if (input.type === 'password') {
                    input.type = 'text';
                    icon.classList.remove('fa-eye-slash');
                    icon.classList.add('fa-eye');
                } else {
                    input.type = 'password';
                    icon.classList.remove('fa-eye');
                    icon.classList.add('fa-eye-slash');
                }
            }
        }
    </script>
{% endblock %}