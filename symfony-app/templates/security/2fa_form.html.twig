{% extends 'front/base.html.twig' %}

{% block title %}Vérification 2FA{% endblock %}

{% block body %}
<section style="min-height:70vh;display:flex;align-items:center;justify-content:center;padding:40px 16px;background:radial-gradient(circle at top left, rgba(14,165,233,0.12), transparent 45%), #f8fafc;">
    <div style="max-width:560px;width:100%;background:#ffffff;border-radius:20px;box-shadow:0 18px 40px rgba(15,23,42,0.12);padding:32px;border:1px solid #e6edf6;">
        <div style="display:flex;align-items:center;gap:14px;margin-bottom:14px;">
            <div style="width:52px;height:52px;border-radius:16px;background:linear-gradient(135deg,#0ea5e9,#38bdf8);display:grid;place-items:center;color:#fff;font-size:1.4rem;">
                <i class="fas fa-shield-alt"></i>
            </div>
            <div>
                <h1 style="margin:0;font-size:1.6rem;color:#0f172a;">Code d’authentification</h1>
                <p style="margin:4px 0 0;color:#64748b;font-size:0.95rem;">Vérifiez votre identité avec Google Authenticator.</p>
            </div>
        </div>

        {% if authenticationError %}
            <div style="background:#fff1f2;border:1px solid #fecdd3;color:#be123c;padding:10px 12px;border-radius:12px;margin-bottom:16px;">
                {{ authenticationError|trans(authenticationErrorData, 'SchebTwoFactorBundle') }}
            </div>
        {% endif %}

        <form method="post" action="{{ path('scheb_two_factor_check') }}">
            <label for="_auth_code" style="display:block;font-weight:700;color:#0f172a;margin-bottom:6px;">Code à 6 chiffres</label>
            <div style="display:flex;gap:12px;align-items:center;margin-bottom:14px;">
                <input id="_auth_code" type="text" name="_auth_code" inputmode="numeric" pattern="[0-9]*" autocomplete="one-time-code" required
                       style="flex:1;height:52px;border-radius:14px;border:1px solid #e2e8f0;padding:0 14px;font-size:1.1rem;letter-spacing:0.12em;background:#f8fafc;">
                <button class="btn btn-primary" type="submit" style="height:52px;border-radius:14px;padding:0 18px;">Vérifier</button>
            </div>
            <p style="margin:0;color:#94a3b8;font-size:0.85rem;">Conseil : si le code ne marche pas, vérifiez l’heure du téléphone.</p>
        </form>
    </div>
</section>
{% endblock %}
