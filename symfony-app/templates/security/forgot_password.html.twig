{% extends 'front/base_auth.html.twig' %}

{% block title %}Mot de passe oublié - SANTÉA{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        /* =========================================================
           FORGOT PASSWORD: form sizing
        ========================================================= */
        #forgotForm.auth-form {
            max-width: 460px;
            width: 100%;
            animation: fadeInUp 0.55s ease-out;
        }

        /* TOP ACTIONS */
        .auth-top-actions {
            display: flex;
            justify-content: flex-end;
            margin-bottom: 18px;
        }
        .auth-home-btn {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            padding: 9px 16px;
            border: 1.5px solid #e2e8f0;
            border-radius: 10px;
            background: #f8fafc;
            color: #374151;
            font-size: 13px;
            font-weight: 600;
            text-decoration: none;
            transition: all 0.2s ease;
        }
        .auth-home-btn:hover {
            background: #e0e7ff;
            border-color: #6366f1;
            color: #4f46e5;
            transform: translateY(-1px);
        }
        .auth-home-btn i { font-size: 13px; }

        /* TITLE */
        #forgotForm h1 {
            font-size: 1.75rem !important;
            margin-bottom: 6px !important;
            display: flex;
            align-items: center;
            gap: 10px;
        }
        #forgotForm h1 .title-icon {
            width: 42px; height: 42px;
            background: linear-gradient(135deg, #3b82f6, #6366f1);
            border-radius: 12px;
            display: flex; align-items: center; justify-content: center;
            color: #fff;
            font-size: 18px;
            flex-shrink: 0;
            box-shadow: 0 4px 12px rgba(99,102,241,.25);
        }
        #forgotForm .subtitle {
            font-size: 13px;
            color: #6b7280;
            margin-bottom: 22px;
            margin-top: 0;
            line-height: 1.5;
        }

        /* FORM CARD */
        .login-card {
            background: #f9fafb;
            border: 1.5px solid #e5e7eb;
            border-radius: 16px;
            padding: 24px 22px 20px;
            display: flex;
            flex-direction: column;
            gap: 16px;
            margin-bottom: 18px;
            transition: border-color 0.2s;
        }
        .login-card:focus-within {
            border-color: #6366f1;
            box-shadow: 0 0 0 3px rgba(99,102,241,.06);
        }
        .card-header {
            display: flex;
            align-items: center;
            gap: 10px;
            padding-bottom: 14px;
            border-bottom: 1.5px solid #e5e7eb;
        }
        .card-header__icon {
            width: 34px; height: 34px;
            border-radius: 10px;
            background: #eef2ff;
            color: #6366f1;
            display: flex; align-items: center; justify-content: center;
            font-size: 15px;
            flex-shrink: 0;
        }
        .card-header__title { font-size: 13px; font-weight: 700; color: #374151; }
        .card-header__sub   { font-size: 11px; color: #9ca3af; }

        /* FIELDS */
        .form-group {
            display: flex;
            flex-direction: column;
            gap: 5px;
            margin-bottom: 0;
        }
        .form-group label {
            font-size: 12px;
            font-weight: 600;
            color: #374151;
            display: flex;
            align-items: center;
            gap: 5px;
        }
        .form-group label .field-icon { color: #9ca3af; font-size: 11px; }

        .input-wrapper { position: relative; }
        .input-wrapper .input-icon {
            position: absolute;
            left: 12px; top: 50%;
            transform: translateY(-50%);
            color: #9ca3af;
            font-size: 13px;
            pointer-events: none;
            transition: color 0.2s;
            z-index: 1;
        }
        .input-wrapper:focus-within .input-icon { color: #6366f1; }

        .login-card input[type="email"],
        .login-card input[type="text"] {
            width: 100%;
            padding: 11px 12px 11px 36px;
            border: 1.5px solid #d1d5db;
            border-radius: 10px;
            font-size: 13.5px;
            color: #111827;
            background: #fff;
            outline: none;
            box-sizing: border-box;
            transition: border-color 0.2s, box-shadow 0.2s;
        }
        .login-card input:focus {
            border-color: #6366f1;
            box-shadow: 0 0 0 3px rgba(99,102,241,.1);
        }

        /* INFO BOX */
        .info-box {
            background: #eff6ff;
            border: 1.5px solid #bfdbfe;
            border-radius: 10px;
            padding: 12px 14px;
            font-size: 12.5px;
            color: #1d4ed8;
            display: flex;
            align-items: flex-start;
            gap: 8px;
            line-height: 1.5;
        }
        .info-box i { font-size: 14px; flex-shrink: 0; margin-top: 1px; }

        /* SUBMIT */
        .login-submit {
            background: linear-gradient(135deg, #4f46e5 0%, #6366f1 100%);
            color: #fff;
            border: none;
            border-radius: 12px;
            padding: 13px 30px;
            font-size: 14.5px;
            font-weight: 700;
            cursor: pointer;
            width: 100%;
            letter-spacing: .02em;
            transition: all 0.25s ease;
            box-shadow: 0 4px 16px rgba(99,102,241,.3);
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            margin-top: 4px;
        }
        .login-submit:hover {
            background: linear-gradient(135deg, #4338ca 0%, #4f46e5 100%);
            transform: translateY(-2px);
            box-shadow: 0 8px 24px rgba(99,102,241,.35);
        }
        .login-submit:active { transform: translateY(0); }

        /* ALERTS */
        .alert {
            border-radius: 10px;
            padding: 11px 14px;
            font-size: 13px;
            display: flex;
            align-items: flex-start;
            gap: 8px;
            position: relative;
        }
        .alert-danger  { background: #fff1f2; border: 1.5px solid #fecaca; color: #b91c1c; }
        .alert-success { background: #f0fdf4; border: 1.5px solid #a7f3d0; color: #065f46; }
        .alert::before {
            font-family: 'Font Awesome 6 Free';
            font-weight: 900; font-size: 14px; flex-shrink: 0;
        }
        .alert-danger::before  { content: '\f071'; }
        .alert-success::before { content: '\f058'; }
        .close-alert {
            position: absolute; right: 10px; top: 8px;
            background: none; border: none;
            font-size: 16px; cursor: pointer;
            color: inherit; opacity: 0.6; line-height: 1;
        }
        .close-alert:hover { opacity: 1; }
    </style>
{% endblock %}

{% block auth_content %}
    <div class="auth-form" id="forgotForm">

        {# ── Top action ── #}
        <div class="auth-top-actions">
            <a href="{{ path('app_home') }}" class="auth-home-btn">
                <i class="fas fa-home"></i> Accueil
            </a>
        </div>

        {# ── Title ── #}
        <h1>
            <span class="title-icon"><i class="fas fa-unlock-alt"></i></span>
            Mot de passe oublié ?
        </h1>
        <p class="subtitle">Pas de problème ! Entrez votre email et nous vous enverrons un lien pour réinitialiser votre mot de passe.</p>

        {# ── Alerts ── #}
        {% for message in app.flashes('success') %}
            <div class="alert alert-success">{{ message }}</div>
        {% endfor %}
        {% for message in app.flashes('error') %}
            <div class="alert alert-danger">{{ message }}</div>
        {% endfor %}

        {# ── Form card ── #}
        {{ form_start(forgotPasswordForm) }}

            <div class="login-card">
                <div class="card-header">
                    <span class="card-header__icon"><i class="fas fa-envelope"></i></span>
                    <div>
                        <div class="card-header__title">Votre adresse email</div>
                        <div class="card-header__sub">Associée à votre compte SANTÉA</div>
                    </div>
                </div>

                {# INFO BOX #}
                <div class="info-box">
                    <i class="fas fa-info-circle"></i>
                    Vous recevrez un lien valable <strong>15 minutes</strong> pour créer un nouveau mot de passe.
                </div>

                {# EMAIL FIELD #}
                <div class="form-group">
                    <label for="forgot_email">
                        <i class="fas fa-envelope field-icon"></i>
                        Adresse email&nbsp;<span style="color:#ef4444">*</span>
                    </label>
                    <div class="input-wrapper">
                        <i class="fas fa-envelope input-icon"></i>
                        {{ form_widget(forgotPasswordForm.email, {
                            'attr': {
                                'id': 'forgot_email',
                                'placeholder': 'exemple@email.com',
                                'autofocus': 'autofocus'
                            }
                        }) }}
                    </div>
                    {{ form_errors(forgotPasswordForm.email) }}
                </div>
            </div>

            <button type="submit" class="login-submit">
                <i class="fas fa-paper-plane"></i>
                Envoyer le lien de réinitialisation
            </button>

        {{ form_end(forgotPasswordForm) }}

        <p class="auth-switch" style="text-align:center; margin-top:18px;">
            <a href="{{ path('login') }}" style="color:#6366f1; font-weight:600;">
                <i class="fas fa-arrow-left" style="font-size:11px;"></i> Retour à la connexion
            </a>
        </p>

    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const alerts = document.querySelectorAll('.alert');
            alerts.forEach(function (alert) {
                if (!alert.querySelector('.close-alert')) {
                    const btn = document.createElement('button');
                    btn.className = 'close-alert';
                    btn.innerHTML = '×';
                    btn.setAttribute('aria-label', 'Fermer');
                    btn.addEventListener('click', function () {
                        alert.style.transition = 'opacity 0.3s';
                        alert.style.opacity    = '0';
                        setTimeout(() => alert.remove(), 300);
                    });
                    alert.appendChild(btn);
                }
                if (alert.classList.contains('alert-success')) {
                    setTimeout(() => {
                        if (alert.parentElement) {
                            alert.style.transition = 'opacity 0.3s';
                            alert.style.opacity    = '0';
                            setTimeout(() => alert.remove(), 300);
                        }
                    }, 6000);
                }
            });
        });
    </script>
{% endblock %}