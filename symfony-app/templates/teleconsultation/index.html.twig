{% extends 'base.html.twig' %}

{% block title %}Téléconsultations{% endblock %}

{% block content %}
<div class="content-wrapper" style="padding: 30px 40px; max-width: 1400px; margin: 0 auto;">
    <div class="page-header" style="margin-bottom: 32px;">
        <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 20px;">
            <div style="display: flex; align-items: center; gap: 16px;">
                <div style="width: 48px; height: 48px; background: linear-gradient(135deg, #8b5cf6 0%, #7c3aed 100%); border-radius: 12px; display: flex; align-items: center; justify-content: center;">
                    <i class="fas fa-video" style="color: white; font-size: 24px;"></i>
                </div>
                <div>
                    <h1 style="margin: 0; font-size: 28px; font-weight: 700; color: #1a1a2e;">Téléconsultations</h1>
                    <p style="margin: 4px 0 0 0; color: #64748b; font-size: 14px;">Consultez vos médecins à distance</p>
                </div>
            </div>
            <a href="{{ path('app_teleconsultation_schedule') }}" style="padding: 12px 24px; background: linear-gradient(135deg, #8b5cf6 0%, #7c3aed 100%); color: white; border: none; border-radius: 10px; font-weight: 600; text-decoration: none; transition: all 0.2s; box-shadow: 0 4px 12px rgba(139,92,246,0.3); display: inline-flex; align-items: center; gap: 8px;" onmouseover="this.style.transform='translateY(-2px)'; this.style.boxShadow='0 8px 20px rgba(139,92,246,0.4)';" onmouseout="this.style.transform='translateY(0)'; this.style.boxShadow='0 4px 12px rgba(139,92,246,0.3)';">
                <i class="fas fa-plus-circle"></i> Planifier une consultation
            </a>
        </div>
    </div>

    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 20px; margin-bottom: 32px;">
        <div style="background: linear-gradient(135deg, #10b981 0%, #059669 100%); border-radius: 14px; padding: 24px; box-shadow: 0 4px 12px rgba(16,185,129,0.25);">
            <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 12px;">
                <i class="fas fa-check-circle" style="font-size: 32px; color: rgba(255,255,255,0.9);"></i>
                <span style="background: rgba(255,255,255,0.2); padding: 6px 12px; border-radius: 20px; font-size: 12px; font-weight: 600; color: white;">Complétées</span>
            </div>
            <h3 style="margin: 0; font-size: 32px; font-weight: 700; color: white;">{{ stats.completed }}</h3>
            <p style="margin: 4px 0 0 0; color: rgba(255,255,255,0.8); font-size: 14px;">Consultations réalisées</p>
        </div>
        <div style="background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%); border-radius: 14px; padding: 24px; box-shadow: 0 4px 12px rgba(245,158,11,0.25);">
            <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 12px;">
                <i class="fas fa-clock" style="font-size: 32px; color: rgba(255,255,255,0.9);"></i>
                <span style="background: rgba(255,255,255,0.2); padding: 6px 12px; border-radius: 20px; font-size: 12px; font-weight: 600; color: white;">En attente</span>
            </div>
            <h3 style="margin: 0; font-size: 32px; font-weight: 700; color: white;">{{ stats.pending }}</h3>
            <p style="margin: 4px 0 0 0; color: rgba(255,255,255,0.8); font-size: 14px;">Rendez-vous à venir</p>
        </div>
        <div style="background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%); border-radius: 14px; padding: 24px; box-shadow: 0 4px 12px rgba(59,130,246,0.25);">
            <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 12px;">
                <i class="fas fa-hourglass-half" style="font-size: 32px; color: rgba(255,255,255,0.9);"></i>
                <span style="background: rgba(255,255,255,0.2); padding: 6px 12px; border-radius: 20px; font-size: 12px; font-weight: 600; color: white;">Durée</span>
            </div>
            <h3 style="margin: 0; font-size: 32px; font-weight: 700; color: white;">{{ (stats.totalDuration / 3600)|round }}</h3>
            <p style="margin: 4px 0 0 0; color: rgba(255,255,255,0.8); font-size: 14px;">Heures totales</p>
        </div>
        <div style="background: linear-gradient(135deg, #ec4899 0%, #db2777 100%); border-radius: 14px; padding: 24px; box-shadow: 0 4px 12px rgba(236,72,153,0.25);">
            <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 12px;">
                <i class="fas fa-chart-line" style="font-size: 32px; color: rgba(255,255,255,0.9);"></i>
                <span style="background: rgba(255,255,255,0.2); padding: 6px 12px; border-radius: 20px; font-size: 12px; font-weight: 600; color: white;">Moyenne</span>
            </div>
            <h3 style="margin: 0; font-size: 32px; font-weight: 700; color: white;">{{ (stats.avgDuration / 60)|round }}</h3>
            <p style="margin: 4px 0 0 0; color: rgba(255,255,255,0.8); font-size: 14px;">Minutes par session</p>
        </div>
    </div>

            <div style="background: white; border-radius: 14px; padding: 8px; margin-bottom: 24px; box-shadow: 0 2px 8px rgba(15,23,42,0.06); display: inline-flex; gap: 8px;" role="tablist">
                <button class="nav-link active" id="ongoing-tab" data-bs-toggle="tab" data-bs-target="#ongoing" 
                        type="button" role="tab" aria-controls="ongoing" aria-selected="true"
                        style="padding: 10px 20px; border: none; background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%); color: white; border-radius: 10px; font-weight: 600; cursor: pointer; transition: all 0.2s;">
                    <i class="fas fa-play-circle" style="margin-right: 8px;"></i> En cours ({{ ongoing|length }})
                </button>
                <button class="nav-link" id="upcoming-tab" data-bs-toggle="tab" data-bs-target="#upcoming" 
                        type="button" role="tab" aria-controls="upcoming" aria-selected="false"
                        style="padding: 10px 20px; border: none; background: transparent; color: #64748b; border-radius: 10px; font-weight: 600; cursor: pointer; transition: all 0.2s;">
                    <i class="fas fa-calendar" style="margin-right: 8px;"></i> À venir ({{ upcoming|length }})
                </button>
                <button class="nav-link" id="past-tab" data-bs-toggle="tab" data-bs-target="#past" 
                        type="button" role="tab" aria-controls="past" aria-selected="false"
                        style="padding: 10px 20px; border: none; background: transparent; color: #64748b; border-radius: 10px; font-weight: 600; cursor: pointer; transition: all 0.2s;">
                    <i class="fas fa-history" style="margin-right: 8px;"></i> Historique ({{ past|length }})
                </button>
            </div>

            <div class="tab-content">
                <!-- Ongoing -->
                <div class="tab-pane fade show active" id="ongoing" role="tabpanel">
                    {% if ongoing is empty %}
                        <div class="alert alert-info">
                            Aucune consultation en cours.
                        </div>
                    {% else %}
                        <div class="row">
                            {% for consultation in ongoing %}
                                <div class="col-md-6 mb-3">
                                    <div class="card border-danger">
                                        <div class="card-header bg-danger text-white">
                                            <h5 class="mb-0">
                                                <span class="badge bg-light text-danger float-end">EN COURS</span>
                                                {{ consultation.type }}
                                            </h5>
                                        </div>
                                        <div class="card-body">
                                            <p class="mb-2">
                                                <strong>Avec:</strong>
                                                {{ (consultation.initiator == app.user ? consultation.recipient.username : consultation.initiator.username) }}
                                            </p>
                                            <p class="mb-2 text-muted">
                                                <i class="bi bi-clock"></i>
                                                Démarrée: {{ consultation.startedAt|date('d/m/Y H:i') }}
                                            </p>
                                            {% if consultation.description %}
                                                <p class="text-muted small">{{ consultation.description }}</p>
                                            {% endif %}
                                        </div>
                                        <div class="card-footer">
                                            <a href="{{ path('app_teleconsultation_join', {id: consultation.id}) }}" class="btn btn-sm btn-success">
                                                <i class="bi bi-camera-video"></i> Rejoindre
                                            </a>
                                            <a href="{{ path('app_teleconsultation_show', {id: consultation.id}) }}" class="btn btn-sm btn-info">
                                                <i class="bi bi-eye"></i> Détails
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            {% endfor %}
                        </div>
                    {% endif %}
                </div>

                <!-- Upcoming -->
                <div class="tab-pane fade" id="upcoming" role="tabpanel">
                    {% if upcoming is empty %}
                        <div class="alert alert-info">
                            Aucune consultation programmée.
                            <a href="{{ path('app_teleconsultation_schedule') }}">Planifier une maintenant</a>
                        </div>
                    {% else %}
                        <div class="row">
                            {% for consultation in upcoming %}
                                <div class="col-md-6 mb-3">
                                    <div class="card border-warning">
                                        <div class="card-header bg-warning">
                                            <h5 class="mb-0">
                                                <span class="badge bg-light text-warning float-end">PENDING</span>
                                                {{ consultation.type }}
                                            </h5>
                                        </div>
                                        <div class="card-body">
                                            <p class="mb-2">
                                                <strong>Avec:</strong>
                                                {{ consultation.recipient == app.user ? consultation.initiator.username : consultation.recipient.username }}
                                            </p>
                                            <p class="mb-2 text-muted">
                                                <i class="bi bi-calendar-event"></i>
                                                {{ consultation.scheduledAt|date('d/m/Y H:i') }}
                                            </p>
                                            {% if consultation.description %}
                                                <p class="text-muted small">{{ consultation.description }}</p>
                                            {% endif %}
                                        </div>
                                        <div class="card-footer">
                                            {% if canStartMap[consultation.id]|default(false) %}
                                                <a href="{{ path('app_teleconsultation_join', {id: consultation.id}) }}" class="btn btn-sm btn-success">
                                                    <i class="bi bi-camera-video"></i> Rejoindre
                                                </a>
                                            {% endif %}
                                            <a href="{{ path('app_teleconsultation_show', {id: consultation.id}) }}" class="btn btn-sm btn-info">
                                                <i class="bi bi-eye"></i> Voir
                                            </a>
                                            {% if consultation.initiator == app.user %}
                                                <form action="{{ path('app_teleconsultation_cancel', {id: consultation.id}) }}" 
                                                      method="POST" style="display:inline;">
                                                    <input type="hidden" name="_token" value="{{ csrf_token('teleconsultation_cancel' ~ consultation.id) }}">
                                                    <button type="submit" class="btn btn-sm btn-danger" 
                                                            onclick="return confirm('Annuler cette consultation?')">
                                                        <i class="bi bi-x-circle"></i> Annuler
                                                    </button>
                                                </form>
                                            {% endif %}
                                        </div>
                                    </div>
                                </div>
                            {% endfor %}
                        </div>
                    {% endif %}
                </div>

                <!-- Past -->
                <div class="tab-pane fade" id="past" role="tabpanel">
                    {% if past is empty %}
                        <div class="alert alert-info">
                            Aucune consultation passée.
                        </div>
                    {% else %}
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead class="table-light">
                                    <tr>
                                        <th>Type</th>
                                        <th>Avec</th>
                                        <th>Statut</th>
                                        <th>Durée</th>
                                        <th>Date</th>
                                        <th>Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for consultation in past %}
                                        <tr>
                                            <td>{{ consultation.type }}</td>
                                            <td>
                                                {{ consultation.recipient == app.user ? consultation.initiator.username : consultation.recipient.username }}
                                            </td>
                                            <td>
                                                {% if consultation.completed %}
                                                    <span class="badge bg-success">Complétée</span>
                                                {% elseif consultation.pending %}
                                                    <span class="badge bg-warning text-dark">En attente</span>
                                                {% else %}
                                                    <span class="badge bg-danger">Annulée</span>
                                                {% endif %}
                                            </td>
                                            <td>
                                                {{ consultation.durationFormatted }}
                                            </td>
                                            <td>
                                                {% if consultation.endedAt %}
                                                    {{ consultation.endedAt|date('d/m/Y H:i') }}
                                                {% else %}
                                                    {{ consultation.scheduledAt|date('d/m/Y H:i') }}
                                                {% endif %}
                                            </td>
                                            <td>
                                                <a href="{{ path('app_teleconsultation_show', {id: consultation.id}) }}" class="btn btn-sm btn-info">
                                                    <i class="bi bi-eye"></i>
                                                </a>
                                            </td>
                                        </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
