{% extends 'base.html.twig' %}

{% block title %}Téléconsultations{% endblock %}

{% block content %}
<div class="content-wrapper" style="padding: 30px 40px; max-width: 1400px; margin: 0 auto;">
    <div class="page-header" style="margin-bottom: 32px;">
        <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 20px;">
            <div style="display: flex; align-items: center; gap: 16px;">
                <div style="width: 48px; height: 48px; background: linear-gradient(135deg, #8b5cf6 0%, #7c3aed 100%); border-radius: 12px; display: flex; align-items: center; justify-content: center;">
                    <i class="fas fa-video" style="color: white; font-size: 24px;"></i>
                </div>
                <div>
                    <h1 style="margin: 0; font-size: 28px; font-weight: 700; color: #1a1a2e;">Téléconsultations</h1>
                    <p style="margin: 4px 0 0 0; color: #64748b; font-size: 14px;">Consultez vos médecins à distance</p>
                </div>
            </div>
            <a href="{{ path('app_teleconsultation_schedule') }}" style="padding: 12px 24px; background: linear-gradient(135deg, #8b5cf6 0%, #7c3aed 100%); color: white; border: none; border-radius: 10px; font-weight: 600; text-decoration: none; transition: all 0.2s; box-shadow: 0 4px 12px rgba(139,92,246,0.3); display: inline-flex; align-items: center; gap: 8px;" onmouseover="this.style.transform='translateY(-2px)'; this.style.boxShadow='0 8px 20px rgba(139,92,246,0.4)';" onmouseout="this.style.transform='translateY(0)'; this.style.boxShadow='0 4px 12px rgba(139,92,246,0.3)';">
                <i class="fas fa-plus-circle"></i> Planifier une consultation
            </a>
        </div>
    </div>

    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 20px; margin-bottom: 32px;">
        <div style="background: linear-gradient(135deg, #10b981 0%, #059669 100%); border-radius: 14px; padding: 24px; box-shadow: 0 4px 12px rgba(16,185,129,0.25);">
            <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 12px;">
                <i class="fas fa-check-circle" style="font-size: 32px; color: rgba(255,255,255,0.9);"></i>
                <span style="background: rgba(255,255,255,0.2); padding: 6px 12px; border-radius: 20px; font-size: 12px; font-weight: 600; color: white;">Complétées</span>
            </div>
            <h3 style="margin: 0; font-size: 32px; font-weight: 700; color: white;">{{ stats.completed }}</h3>
            <p style="margin: 4px 0 0 0; color: rgba(255,255,255,0.8); font-size: 14px;">Consultations réalisées</p>
        </div>
        <div style="background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%); border-radius: 14px; padding: 24px; box-shadow: 0 4px 12px rgba(245,158,11,0.25);">
            <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 12px;">
                <i class="fas fa-clock" style="font-size: 32px; color: rgba(255,255,255,0.9);"></i>
                <span style="background: rgba(255,255,255,0.2); padding: 6px 12px; border-radius: 20px; font-size: 12px; font-weight: 600; color: white;">En attente</span>
            </div>
            <h3 style="margin: 0; font-size: 32px; font-weight: 700; color: white;">{{ stats.pending }}</h3>
            <p style="margin: 4px 0 0 0; color: rgba(255,255,255,0.8); font-size: 14px;">Rendez-vous à venir</p>
        </div>
        <div style="background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%); border-radius: 14px; padding: 24px; box-shadow: 0 4px 12px rgba(59,130,246,0.25);">
            <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 12px;">
                <i class="fas fa-hourglass-half" style="font-size: 32px; color: rgba(255,255,255,0.9);"></i>
                <span style="background: rgba(255,255,255,0.2); padding: 6px 12px; border-radius: 20px; font-size: 12px; font-weight: 600; color: white;">Durée</span>
            </div>
            <h3 style="margin: 0; font-size: 32px; font-weight: 700; color: white;">{{ (stats.totalDuration / 3600)|round }}</h3>
            <p style="margin: 4px 0 0 0; color: rgba(255,255,255,0.8); font-size: 14px;">Heures totales</p>
        </div>
        <div style="background: linear-gradient(135deg, #ec4899 0%, #db2777 100%); border-radius: 14px; padding: 24px; box-shadow: 0 4px 12px rgba(236,72,153,0.25);">
            <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 12px;">
                <i class="fas fa-chart-line" style="font-size: 32px; color: rgba(255,255,255,0.9);"></i>
                <span style="background: rgba(255,255,255,0.2); padding: 6px 12px; border-radius: 20px; font-size: 12px; font-weight: 600; color: white;">Moyenne</span>
            </div>
            <h3 style="margin: 0; font-size: 32px; font-weight: 700; color: white;">{{ (stats.avgDuration / 60)|round }}</h3>
            <p style="margin: 4px 0 0 0; color: rgba(255,255,255,0.8); font-size: 14px;">Minutes par session</p>
        </div>
    </div>

            <div style="background: white; border-radius: 14px; padding: 8px; margin-bottom: 24px; box-shadow: 0 2px 8px rgba(15,23,42,0.06); display: inline-flex; gap: 8px;" role="tablist">
                <button class="tab-btn active" id="ongoing-tab" data-bs-toggle="tab" data-bs-target="#ongoing" 
                        type="button" role="tab" aria-controls="ongoing" aria-selected="true">
                    <i class="fas fa-play-circle"></i> En cours <span class="tab-badge">{{ ongoing|length }}</span>
                </button>
                <button class="tab-btn" id="upcoming-tab" data-bs-toggle="tab" data-bs-target="#upcoming" 
                        type="button" role="tab" aria-controls="upcoming" aria-selected="false">
                    <i class="fas fa-calendar"></i> À venir <span class="tab-badge">{{ upcoming|length }}</span>
                </button>
                <button class="tab-btn" id="past-tab" data-bs-toggle="tab" data-bs-target="#past" 
                        type="button" role="tab" aria-controls="past" aria-selected="false">
                    <i class="fas fa-history"></i> Historique <span class="tab-badge">{{ past|length }}</span>
                </button>
            </div>

            <div class="tab-content">
                <!-- Ongoing -->
                <div class="tab-pane fade show active" id="ongoing" role="tabpanel">
                    {% if ongoing is empty %}
                        <div style="background: linear-gradient(135deg, #dbeafe 0%, #eff6ff 100%); border-radius: 12px; padding: 48px; text-align: center; border: 2px dashed #60a5fa;">
                            <i class="fas fa-video-slash" style="font-size: 64px; color: #3b82f6; opacity: 0.3; margin-bottom: 16px;"></i>
                            <h3 style="margin: 0 0 8px 0; font-size: 20px; font-weight: 600; color: #1a1a2e;">Aucune consultation en cours</h3>
                            <p style="margin: 0; color: #64748b;">Les consultations actives apparaîtront ici</p>
                        </div>
                    {% else %}
                        <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(450px, 1fr)); gap: 20px;">
                            {% for consultation in ongoing %}
                                <div style="background: white; border-radius: 14px; border: 2px solid #fca5a5; box-shadow: 0 4px 12px rgba(239,68,68,0.15); overflow: hidden; transition: all 0.2s;" onmouseover="this.style.transform='translateY(-4px)'; this.style.boxShadow='0 8px 24px rgba(239,68,68,0.25)'" onmouseout="this.style.transform='translateY(0)'; this.style.boxShadow='0 4px 12px rgba(239,68,68,0.15)'">
                                    <!-- Header -->
                                    <div style="background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%); padding: 16px 20px;">
                                        <div style="display: flex; align-items: center; justify-content: space-between;">
                                            <div style="display: flex; align-items: center; gap: 10px;">
                                                <i class="fas fa-video" style="color: white; font-size: 18px;"></i>
                                                <span style="color: white; font-weight: 700; font-size: 16px;">
                                                    {% if consultation.type == 'general' %}Consultation générale
                                                    {% elseif consultation.type == 'follow_up' %}Suivi
                                                    {% elseif consultation.type == 'emergency' %}Urgence
                                                    {% elseif consultation.type == 'diagnostic' %}Diagnostic
                                                    {% else %}{{ consultation.type }}{% endif %}
                                                </span>
                                            </div>
                                            <span style="background: white; color: #dc2626; padding: 4px 12px; border-radius: 20px; font-size: 11px; font-weight: 700; display: flex; align-items: center; gap: 6px; animation: pulse 2s infinite;">
                                                <i class="fas fa-circle" style="font-size: 6px; animation: blink 1s infinite;"></i> EN COURS
                                            </span>
                                        </div>
                                    </div>
                                    
                                    <!-- Body -->
                                    <div style="padding: 20px;">
                                        <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 16px;">
                                            <div style="width: 48px; height: 48px; background: linear-gradient(135deg, #06b6d4 0%, #0891b2 100%); border-radius: 10px; display: flex; align-items: center; justify-content: center; color: white; font-weight: 700; font-size: 16px;">
                                                {{ (consultation.initiator == app.user ? consultation.recipient.username : consultation.initiator.username)|slice(0, 2)|upper }}
                                            </div>
                                            <div style="flex: 1;">
                                                <div style="font-size: 13px; color: #94a3b8; margin-bottom: 2px;">Participant</div>
                                                <div style="font-weight: 700; color: #1e293b; font-size: 15px;">
                                                    {{ (consultation.initiator == app.user ? consultation.recipient.username : consultation.initiator.username) }}
                                                </div>
                                            </div>
                                        </div>
                                        
                                        <div style="background: #fef2f2; border-radius: 8px; padding: 12px; margin-bottom: 16px; border-left: 3px solid #ef4444;">
                                            <div style="display: flex; align-items: center; gap: 8px; color: #991b1b; font-size: 13px;">
                                                <i class="fas fa-play-circle"></i>
                                                <span style="font-weight: 600;">Démarrée le {{ consultation.startedAt|date('d/m/Y à H:i') }}</span>
                                            </div>
                                        </div>
                                        
                                        {% if consultation.description %}
                                            <div style="background: #f8fafc; border-radius: 8px; padding: 12px; margin-bottom: 16px; border: 1px solid #e2e8f0;">
                                                <div style="font-size: 12px; color: #64748b; line-height: 1.5;">{{ consultation.description }}</div>
                                            </div>
                                        {% endif %}
                                    </div>
                                    
                                    <!-- Footer -->
                                    <div style="padding: 16px 20px; background: #f8fafc; border-top: 1px solid #e2e8f0; display: flex; gap: 8px;">
                                        <a href="{{ path('app_teleconsultation_join', {id: consultation.id}) }}" style="flex: 1; display: inline-flex; align-items: center; justify-content: center; gap: 6px; padding: 10px 16px; background: linear-gradient(135deg, #10b981 0%, #059669 100%); color: white; border-radius: 8px; text-decoration: none; font-weight: 600; font-size: 13px; transition: all 0.2s;">
                                            <i class="fas fa-sign-in-alt"></i> Rejoindre
                                        </a>
                                        <a href="{{ path('app_teleconsultation_show', {id: consultation.id}) }}" style="padding: 10px 16px; background: white; color: #64748b; border: 1px solid #e2e8f0; border-radius: 8px; text-decoration: none; font-weight: 600; font-size: 13px; transition: all 0.2s; display: inline-flex; align-items: center; gap: 6px;">
                                            <i class="fas fa-info-circle"></i> Détails
                                        </a>
                                    </div>
                                </div>
                            {% endfor %}
                        </div>
                    {% endif %}
                </div>

                <!-- Upcoming -->
                <div class="tab-pane fade" id="upcoming" role="tabpanel">
                    {% if upcoming is empty %}
                        <div style="background: linear-gradient(135deg, #fef3c7 0%, #fef9c3 100%); border-radius: 12px; padding: 48px; text-align: center; border: 2px dashed #fbbf24;">
                            <i class="fas fa-calendar-plus" style="font-size: 64px; color: #f59e0b; opacity: 0.3; margin-bottom: 16px;"></i>
                            <h3 style="margin: 0 0 8px 0; font-size: 20px; font-weight: 600; color: #1a1a2e;">Aucune consultation programmée</h3>
                            <p style="margin: 0 0 16px 0; color: #64748b;">Planifiez votre première consultation maintenant</p>
                            <a href="{{ path('app_teleconsultation_schedule') }}" style="display: inline-flex; align-items: center; gap: 8px; padding: 12px 24px; background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%); color: white; border-radius: 10px; text-decoration: none; font-weight: 600; transition: all 0.2s;">
                                <i class="fas fa-plus-circle"></i> Planifier une consultation
                            </a>
                        </div>
                    {% else %}
                        <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(450px, 1fr)); gap: 20px;">
                            {% for consultation in upcoming %}
                                <div style="background: white; border-radius: 14px; border: 2px solid #fbbf24; box-shadow: 0 4px 12px rgba(245,158,11,0.15); overflow: hidden; transition: all 0.2s;" onmouseover="this.style.transform='translateY(-4px)'; this.style.boxShadow='0 8px 24px rgba(245,158,11,0.25)'" onmouseout="this.style.transform='translateY(0)'; this.style.boxShadow='0 4px 12px rgba(245,158,11,0.15)'">
                                    <!-- Header -->
                                    <div style="background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%); padding: 16px 20px;">
                                        <div style="display: flex; align-items: center; justify-content: space-between;">
                                            <div style="display: flex; align-items: center; gap: 10px;">
                                                <i class="fas fa-calendar-check" style="color: white; font-size: 18px;"></i>
                                                <span style="color: white; font-weight: 700; font-size: 16px;">
                                                    {% if consultation.type == 'general' %}Consultation générale
                                                    {% elseif consultation.type == 'follow_up' %}Suivi
                                                    {% elseif consultation.type == 'emergency' %}Urgence
                                                    {% elseif consultation.type == 'diagnostic' %}Diagnostic
                                                    {% else %}{{ consultation.type }}{% endif %}
                                                </span>
                                            </div>
                                            <span style="background: white; color: #d97706; padding: 4px 12px; border-radius: 20px; font-size: 11px; font-weight: 700;">
                                                <i class="fas fa-clock"></i> EN ATTENTE
                                            </span>
                                        </div>
                                    </div>
                                    
                                    <!-- Body -->
                                    <div style="padding: 20px;">
                                        <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 16px;">
                                            <div style="width: 48px; height: 48px; background: linear-gradient(135deg, #06b6d4 0%, #0891b2 100%); border-radius: 10px; display: flex; align-items: center; justify-content: center; color: white; font-weight: 700; font-size: 16px;">
                                                {{ (consultation.recipient == app.user ? consultation.initiator.username : consultation.recipient.username)|slice(0, 2)|upper }}
                                            </div>
                                            <div style="flex: 1;">
                                                <div style="font-size: 13px; color: #94a3b8; margin-bottom: 2px;">Participant</div>
                                                <div style="font-weight: 700; color: #1e293b; font-size: 15px;">
                                                    {{ consultation.recipient == app.user ? consultation.initiator.username : consultation.recipient.username }}
                                                </div>
                                            </div>
                                        </div>
                                        
                                        <div style="background: #fffbeb; border-radius: 8px; padding: 12px; margin-bottom: 16px; border-left: 3px solid #f59e0b;">
                                            <div style="display: flex; align-items: center; gap: 8px; color: #92400e; font-size: 13px;">
                                                <i class="fas fa-calendar-alt"></i>
                                                <span style="font-weight: 600;">Programmée pour le {{ consultation.scheduledAt|date('d/m/Y à H:i') }}</span>
                                            </div>
                                        </div>
                                        
                                        {% if consultation.description %}
                                            <div style="background: #f8fafc; border-radius: 8px; padding: 12px; margin-bottom: 16px; border: 1px solid #e2e8f0;">
                                                <div style="font-size: 12px; color: #64748b; line-height: 1.5;">{{ consultation.description }}</div>
                                            </div>
                                        {% endif %}
                                    </div>
                                    
                                    <!-- Footer -->
                                    <div style="padding: 16px 20px; background: #f8fafc; border-top: 1px solid #e2e8f0; display: flex; gap: 8px;">
                                        {% if canStartMap[consultation.id]|default(false) %}
                                            <a href="{{ path('app_teleconsultation_join', {id: consultation.id}) }}" style="flex: 1; display: inline-flex; align-items: center; justify-content: center; gap: 6px; padding: 10px 16px; background: linear-gradient(135deg, #10b981 0%, #059669 100%); color: white; border-radius: 8px; text-decoration: none; font-weight: 600; font-size: 13px; transition: all 0.2s;">
                                                <i class="fas fa-sign-in-alt"></i> Rejoindre
                                            </a>
                                        {% endif %}
                                        <a href="{{ path('app_teleconsultation_show', {id: consultation.id}) }}" style="padding: 10px 16px; background: white; color: #64748b; border: 1px solid #e2e8f0; border-radius: 8px; text-decoration: none; font-weight: 600; font-size: 13px; transition: all 0.2s; display: inline-flex; align-items: center; gap: 6px;">
                                            <i class="fas fa-info-circle"></i> Voir
                                        </a>
                                        {% if consultation.initiator == app.user %}
                                            <form action="{{ path('app_teleconsultation_cancel', {id: consultation.id}) }}" method="POST" style="margin: 0;">
                                                <input type="hidden" name="_token" value="{{ csrf_token('teleconsultation_cancel' ~ consultation.id) }}">
                                                <button type="submit" onclick="return confirm('Annuler cette consultation ?')" style="padding: 10px 16px; background: white; color: #ef4444; border: 1px solid #fca5a5; border-radius: 8px; font-weight: 600; font-size: 13px; cursor: pointer; transition: all 0.2s; display: inline-flex; align-items: center; gap: 6px;">
                                                    <i class="fas fa-times-circle"></i> Annuler
                                                </button>
                                            </form>
                                        {% endif %}
                                    </div>
                                </div>
                            {% endfor %}
                        </div>
                    {% endif %}
                </div>

                <!-- Past -->
                <div class="tab-pane fade" id="past" role="tabpanel">
                    {% if past is empty %}
                        <div style="background: linear-gradient(135deg, #e0e7ff 0%, #f5f3ff 100%); border-radius: 12px; padding: 48px; text-align: center; border: 2px dashed #a78bfa;">
                            <i class="fas fa-history" style="font-size: 64px; color: #8b5cf6; opacity: 0.3; margin-bottom: 16px;"></i>
                            <h3 style="margin: 0 0 8px 0; font-size: 20px; font-weight: 600; color: #1a1a2e;">Aucune consultation passée</h3>
                            <p style="margin: 0; color: #64748b;">L'historique de vos consultations apparaîtra ici</p>
                        </div>
                    {% else %}
                        <div style="background: white; border-radius: 14px; overflow: hidden; box-shadow: 0 2px 8px rgba(15,23,42,0.06);">
                            <div style="overflow-x: auto;">
                                <table style="width: 100%; border-collapse: collapse;">
                                    <thead>
                                        <tr style="background: linear-gradient(135deg, #f8fafc 0%, #f1f5f9 100%); border-bottom: 2px solid #e2e8f0;">
                                            <th style="padding: 14px 16px; text-align: left; font-weight: 600; color: #475569; font-size: 13px; text-transform: uppercase; letter-spacing: 0.5px;">
                                                <i class="fas fa-tag" style="margin-right: 6px; color: #94a3b8;"></i>Type
                                            </th>
                                            <th style="padding: 14px 16px; text-align: left; font-weight: 600; color: #475569; font-size: 13px; text-transform: uppercase; letter-spacing: 0.5px;">
                                                <i class="fas fa-user" style="margin-right: 6px; color: #94a3b8;"></i>Participant
                                            </th>
                                            <th style="padding: 14px 16px; text-align: center; font-weight: 600; color: #475569; font-size: 13px; text-transform: uppercase; letter-spacing: 0.5px;">
                                                <i class="fas fa-flag" style="margin-right: 6px; color: #94a3b8;"></i>Statut
                                            </th>
                                            <th style="padding: 14px 16px; text-align: center; font-weight: 600; color: #475569; font-size: 13px; text-transform: uppercase; letter-spacing: 0.5px;">
                                                <i class="fas fa-hourglass-half" style="margin-right: 6px; color: #94a3b8;"></i>Durée
                                            </th>
                                            <th style="padding: 14px 16px; text-align: left; font-weight: 600; color: #475569; font-size: 13px; text-transform: uppercase; letter-spacing: 0.5px;">
                                                <i class="fas fa-calendar" style="margin-right: 6px; color: #94a3b8;"></i>Date
                                            </th>
                                            <th style="padding: 14px 16px; text-align: center; font-weight: 600; color: #475569; font-size: 13px; text-transform: uppercase; letter-spacing: 0.5px;">
                                                Action
                                            </th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        {% for consultation in past %}
                                            <tr style="border-bottom: 1px solid #f1f5f9; transition: background 0.2s;" onmouseover="this.style.background='#f8fafc'" onmouseout="this.style.background='transparent'">
                                                <td style="padding: 16px;">
                                                    <span style="font-weight: 600; color: #1e293b; font-size: 14px;">
                                                        {% if consultation.type == 'general' %}Consultation générale
                                                        {% elseif consultation.type == 'follow_up' %}Suivi
                                                        {% elseif consultation.type == 'emergency' %}Urgence
                                                        {% elseif consultation.type == 'diagnostic' %}Diagnostic
                                                        {% else %}{{ consultation.type }}{% endif %}
                                                    </span>
                                                </td>
                                                <td style="padding: 16px;">
                                                    <div style="display: flex; align-items: center; gap: 10px;">
                                                        <div style="width: 32px; height: 32px; background: linear-gradient(135deg, #06b6d4 0%, #0891b2 100%); border-radius: 8px; display: flex; align-items: center; justify-content: center; color: white; font-weight: 700; font-size: 12px;">
                                                            {{ (consultation.recipient == app.user ? consultation.initiator.username : consultation.recipient.username)|slice(0, 2)|upper }}
                                                        </div>
                                                        <span style="font-weight: 600; color: #1e293b; font-size: 14px;">
                                                            {{ consultation.recipient == app.user ? consultation.initiator.username : consultation.recipient.username }}
                                                        </span>
                                                    </div>
                                                </td>
                                                <td style="padding: 16px; text-align: center;">
                                                    {% if consultation.completed %}
                                                        <span style="display: inline-flex; align-items: center; gap: 4px; padding: 5px 12px; background: #dcfce7; color: #166534; border-radius: 20px; font-size: 12px; font-weight: 600;">
                                                            <i class="fas fa-check-circle"></i> Complétée
                                                        </span>
                                                    {% elseif consultation.pending %}
                                                        <span style="display: inline-flex; align-items: center; gap: 4px; padding: 5px 12px; background: #fef3c7; color: #92400e; border-radius: 20px; font-size: 12px; font-weight: 600;">
                                                            <i class="fas fa-clock"></i> En attente
                                                        </span>
                                                    {% else %}
                                                        <span style="display: inline-flex; align-items: center; gap: 4px; padding: 5px 12px; background: #fee2e2; color: #991b1b; border-radius: 20px; font-size: 12px; font-weight: 600;">
                                                            <i class="fas fa-times-circle"></i> Annulée
                                                        </span>
                                                    {% endif %}
                                                </td>
                                                <td style="padding: 16px; text-align: center;">
                                                    <span style="font-weight: 600; color: #1e293b; font-size: 14px;">{{ consultation.durationFormatted }}</span>
                                                </td>
                                                <td style="padding: 16px;">
                                                    <div style="font-weight: 600; color: #1e293b; font-size: 14px;">
                                                        {% if consultation.endedAt %}
                                                            {{ consultation.endedAt|date('d/m/Y') }}
                                                        {% else %}
                                                            {{ consultation.scheduledAt|date('d/m/Y') }}
                                                        {% endif %}
                                                    </div>
                                                    <div style="font-size: 12px; color: #94a3b8;">
                                                        {% if consultation.endedAt %}
                                                            {{ consultation.endedAt|date('H:i') }}
                                                        {% else %}
                                                            {{ consultation.scheduledAt|date('H:i') }}
                                                        {% endif %}
                                                    </div>
                                                </td>
                                                <td style="padding: 16px; text-align: center;">
                                                    <a href="{{ path('app_teleconsultation_show', {id: consultation.id}) }}" style="display: inline-flex; align-items: center; justify-content: center; width: 32px; height: 32px; background: #dbeafe; color: #1e40af; border-radius: 8px; text-decoration: none; transition: all 0.2s;" title="Voir les détails">
                                                        <i class="fas fa-eye"></i>
                                                    </a>
                                                </td>
                                            </tr>
                                        {% endfor %}
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
</div>

