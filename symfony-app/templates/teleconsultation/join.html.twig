{% extends 'base.html.twig' %}

{% block title %}Consultation en cours{% endblock %}

{% block content %}
<div class="container-fluid mt-3">
    <div class="row">
        <div class="col-md-12">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h3>Consultation Jitsi Meet</h3>
                <a href="{{ path('app_teleconsultation_show', {id: consultation.id}) }}" class="btn btn-secondary">
                    <i class="bi bi-arrow-left"></i> Retour
                </a>
            </div>

            <div id="meet" style="height: 600px; width: 100%; border-radius: 8px; overflow: hidden; box-shadow: 0 2px 8px rgba(0,0,0,0.1);"></div>

            <div class="alert alert-info mt-3">
                <i class="bi bi-info-circle"></i>
                <strong>Conseil:</strong> Assurez-vous que votre caméra et microphone sont activés. Pour quitter la consultation, fermez simplement la fenêtre.
            </div>
        </div>
    </div>
</div>

<script src="https://meet.jit.si/external_api.js"></script>
<script>
    // Extract room name
    const roomName = "{{ consultation.roomName }}";
    const userName = "{{ app.user.username }}";
    
    const options = {
        roomName: roomName,
        width: '100%',
        height: 600,
        parentNode: document.querySelector('#meet'),
        userInfo: {
            displayName: userName,
        },
        configOverwrite: {
            startWithAudioMuted: false,
            startWithVideoMuted: false,
            enableLobbyMode: false,
            disableSimulcast: false,
            p2p: {
                enabled: true,
            }
        },
        interfaceConfigOverwrite: {
            DEFAULT_BACKGROUND: '#000000',
            MOBILE_APP_PROMO: false,
            INVITE_OPTIONS: ['dial', 'email'],
        }
    };

    // Initialize Jitsi
    const api = new JitsiMeetExternalAPI('meet.jit.si', options);

    // Event listeners
    api.addEventListener('videoConferenceJoined', function(event) {
        console.log('User joined the video conference');
        // Send notification if needed
        notify('Vous avez rejoint la consultation');
    });

    api.addEventListener('videoConferenceLeft', function(event) {
        console.log('User left the video conference');
        // Optionally redirect
        window.setTimeout(function() {
            window.location.href = "{{ path('app_teleconsultation_show', {id: consultation.id}) }}";
        }, 2000);
    });

    api.addEventListener('readyToClose', function(event) {
        console.log('Ready to close');
    });

    api.addEventListener('screenSharingStatusChanged', function(event) {
        console.log('Screen sharing:', event.on);
    });

    function notify(message) {
        const alert = document.createElement('div');
        alert.className = 'alert alert-success alert-dismissible fade show';
        alert.innerHTML = `
            ${message}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        `;
        document.body.insertBefore(alert, document.body.firstChild);
        setTimeout(() => alert.remove(), 3000);
    }
</script>
{% endblock %}
