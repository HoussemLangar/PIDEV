<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}SANTÉA - Admin Dashboard{% endblock %}</title>
    
    {% block stylesheets %}
        <link rel="stylesheet" href="{{ asset('css/admin.css') }}">
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    {% endblock %}
</head>
<body class="admin-body">
    
    <!-- Admin Container -->
    <div class="admin-container">
        
        <!-- Sidebar Navigation -->
        <aside class="admin-sidebar">
            <div class="admin-logo">
                <i class="fas fa-heartbeat"></i>
                <span>SANTÉA</span>
            </div>
            
            <nav class="admin-nav">
                <a href="{{ path('admin_dashboard') }}" class="admin-nav-item {{ app.request.get('_route') == 'admin_dashboard' ? 'active' : '' }}">
                    <i class="fas fa-chart-line"></i>
                    <span>Dashboard</span>
                </a>
                
                <div class="nav-section-title">PHARMACIE</div>
                <a href="{{ path('admin_pharmacy_index') }}" class="admin-nav-item {{ app.request.get('_route') starts with 'admin_pharmacy' ? 'active' : '' }}">
                    <i class="fas fa-clinic-medical"></i>
                    <span>Pharmacies</span>
                </a>
            </nav>
            
            <div class="admin-user-section">
                <div class="admin-user-avatar">
                    <i class="fas fa-user-circle"></i>
                </div>
                <div class="admin-user-info">
                    {% if app.user %}
                        <div class="admin-user-name">{{ app.user.fullName ?? app.user.username ?? 'Admin' }}</div>
                        <div class="admin-user-role">Administrateur</div>
                    {% else %}
                        <div class="admin-user-name">Administrateur</div>
                    {% endif %}
                </div>
                {% if app.user %}
                    <a href="{{ path('app_logout') }}" class="admin-logout-btn" title="Se déconnecter">
                        <i class="fas fa-sign-out-alt"></i>
                    </a>
                {% endif %}
            </div>
        </aside>
        
        <!-- Main Content -->
        <main class="admin-main">
            <!-- Top Bar -->
            <div class="admin-topbar">
                <div class="admin-search">
                    <i class="fas fa-search"></i>
                    <input type="text" placeholder="Rechercher...">
                </div>
                <div class="admin-actions">
                    <button class="admin-icon-btn" title="Notifications">
                        <i class="fas fa-bell"></i>
                        <span class="notification-badge">3</span>
                    </button>
                    <button class="admin-icon-btn" title="Messages">
                        <i class="fas fa-envelope"></i>
                    </button>
                    <button class="admin-icon-btn" title="Paramètres">
                        <i class="fas fa-cog"></i>
                    </button>
                </div>
            </div>
            
            <!-- Content Area -->
            <div class="admin-content">
                {% block content %}{% endblock %}
            </div>
        </main>
    </div>
    
    {% block javascripts %}
        <script src="{{ asset('js/admin.js') }}"></script>
    {% endblock %}
</body>
</html>
