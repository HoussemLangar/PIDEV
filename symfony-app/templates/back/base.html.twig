<!DOCTYPE html>
<html lang="{{ app.request.locale }}" dir="{{ app.request.locale == 'ar' ? 'rtl' : 'ltr' }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}SANTÉA - Admin Dashboard{% endblock %}</title>
    
    {% block stylesheets %}
        <link rel="stylesheet" href="{{ asset('style.css') }}">
        <link rel="stylesheet" href="{{ asset('css/santea-3d.css') }}?v=1">
        <link rel="SHORTCUT ICON" type="image/x-icon" href="{{ asset('logo.png') }}">
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
        <style>
        /* ── Admin 3D Sidebar Enhancement ───────────────────────── */
        .admin-sidebar {
            background: linear-gradient(180deg, rgba(8,98,160,.97) 0%, rgba(13,138,188,.95) 60%, rgba(0,201,167,.92) 100%) !important;
            backdrop-filter: blur(20px) saturate(180%) !important;
            box-shadow: 4px 0 40px rgba(13,138,188,.25) !important;
        }
        .admin-logo {
            filter: drop-shadow(0 0 12px rgba(255,255,255,.3)) !important;
            animation: s3d-badge-pulse 4s ease-in-out infinite !important;
        }
        .admin-nav-item {
            transition: all .25s cubic-bezier(.4,0,.2,1) !important;
            border-radius: 12px !important;
            margin: 2px 8px !important;
        }
        .admin-nav-item:hover, .admin-nav-item.active {
            background: rgba(255,255,255,.18) !important;
            transform: translateX(5px) !important;
            box-shadow: inset 0 0 0 1px rgba(255,255,255,.25), 0 4px 16px rgba(0,0,0,.15) !important;
        }
        .admin-main {
            background: transparent !important;
        }
        /* ── Section title labels ──────────────────────────────── */
        .nav-section-title {
            color: rgba(255,255,255,.55) !important;
            font-size: .68rem !important;
            font-weight: 700 !important;
            letter-spacing: .12em !important;
            text-transform: uppercase !important;
            padding: 16px 16px 4px !important;
            margin-top: 4px !important;
            display: flex !important;
            align-items: center !important;
            gap: 6px !important;
        }
        .nav-section-title::before {
            content: '';
            flex: 1;
            height: 1px;
            background: rgba(255,255,255,.18);
            display: block;
        }
        /* ── Nav items text & icon ─────────────────────────────── */
        .admin-nav-item span {
            color: rgba(255,255,255,.92) !important;
            font-weight: 500 !important;
        }
        .admin-nav-item i {
            color: rgba(255,255,255,.75) !important;
            width: 18px !important;
            text-align: center !important;
        }
        .admin-nav-item.active span,
        .admin-nav-item:hover span { color: #fff !important; }
        .admin-nav-item.active i,
        .admin-nav-item:hover i { color: #fff !important; }
        /* ── Sidebar scrollbar ─────────────────────────────────── */
        .admin-sidebar { overflow-y: auto !important; scrollbar-width: thin !important; scrollbar-color: rgba(255,255,255,.2) transparent !important; }
        .admin-sidebar::-webkit-scrollbar { width: 4px !important; }
        .admin-sidebar::-webkit-scrollbar-track { background: transparent !important; }
        .admin-sidebar::-webkit-scrollbar-thumb { background: rgba(255,255,255,.2) !important; border-radius: 4px !important; }
        /* Admin stat cards */
        .stats-grid .stat-card,
        .admin-stat-card,
        [class*="stat-card"] {
            background: var(--s3d-glass-bg) !important;
            backdrop-filter: blur(16px) !important;
            border: 1px solid var(--s3d-glass-border) !important;
            border-radius: 20px !important;
            box-shadow: 0 8px 32px rgba(13,138,188,.12) !important;
            transition: transform .35s cubic-bezier(.4,0,.2,1), box-shadow .35s !important;
            will-change: transform;
        }
        .stats-grid .stat-card:hover,
        .admin-stat-card:hover,
        [class*="stat-card"]:hover {
            transform: translateY(-6px) scale(1.02) !important;
            box-shadow: 0 20px 50px rgba(13,138,188,.22) !important;
        }
        </style>
    {% endblock %}
</head>
{% set theme = app.user ? app.user.themePreference : (app.session ? app.session.get('theme') : 'light') %}
<body class="admin-body" data-theme="{{ theme ?: 'light' }}" data-turbo="false">

    <!-- 3D Scroll Progress Bar -->
    <div id="s3d-scroll-progress" aria-hidden="true"></div>
    
    <!-- Admin Container -->
    <div class="admin-container">
        
        <!-- Sidebar Navigation -->
        <aside class="admin-sidebar">
            <div class="admin-logo">
                <i class="fas fa-heartbeat"></i>
                <span>SANTÉA</span>
            </div>
            
            <nav class="admin-nav">
                <a href="{{ path('admin_dashboard') }}" class="admin-nav-item {{ app.request.get('_route') == 'admin_dashboard' ? 'active' : '' }}">
                    <i class="fas fa-chart-line"></i>
                    <span>{{ 'nav.dashboard'|trans }}</span>
                </a>
                
                <div class="nav-section-title">{{ 'nav.users_section'|trans }}</div>
                <a href="{{ path('admin_users') }}" class="admin-nav-item {{ app.request.get('_route') starts with 'admin_users' ? 'active' : '' }}">
                    <i class="fas fa-users"></i>
                    <span>{{ 'nav.users'|trans }}</span>
                </a>
                <a href="{{ path('admin_validation') }}" class="admin-nav-item {{ app.request.get('_route') starts with 'admin_validation' ? 'active' : '' }}">
                    <i class="fas fa-user-check"></i>
                    <span>{{ 'nav.validation'|trans }}</span>
                </a>
                <a href="{{ path('admin_security_sessions') }}" class="admin-nav-item {{ app.request.get('_route') starts with 'admin_security_sessions' ? 'active' : '' }}">
                    <i class="fas fa-user-shield"></i>
                    <span>{{ 'nav.sessions'|trans }}</span>
                </a>
                <a href="{{ path('admin_security_suspicious') }}" class="admin-nav-item {{ app.request.get('_route') starts with 'admin_security_suspicious' ? 'active' : '' }}">
                    <i class="fas fa-shield-alt"></i>
                    <span>{{ 'nav.suspicious'|trans }}</span>
                </a>
                
                <div class="nav-section-title">{{ 'nav.subscriptions_section'|trans }}</div>
                <a href="{{ path('admin_subscriptions') }}" class="admin-nav-item {{ app.request.get('_route') starts with 'admin_subscriptions' ? 'active' : '' }}">
                    <i class="fas fa-credit-card"></i>
                    <span>{{ 'nav.subscriptions'|trans }}</span>
                </a>
                <a href="{{ path('admin_payments') }}" class="admin-nav-item {{ app.request.get('_route') starts with 'admin_payments' ? 'active' : '' }}">
                    <i class="fas fa-money-bill-wave"></i>
                    <span>{{ 'nav.payments'|trans }}</span>
                </a>
                
                <div class="nav-section-title">{{ 'nav.medical_section'|trans }}</div>
                <a href="{{ path('admin_accompaniments') }}" class="admin-nav-item {{ app.request.get('_route') starts with 'admin_accompaniments' ? 'active' : '' }}">
                    <i class="fas fa-hands-helping"></i>
                    <span>{{ 'nav.accompaniments'|trans }}</span>
                </a>
                <a href="{{ path('admin_appointments') }}" class="admin-nav-item {{ app.request.get('_route') starts with 'admin_appointments' ? 'active' : '' }}">
                    <i class="fas fa-calendar-check"></i>
                    <span>{{ 'nav.appointments'|trans }}</span>
                </a>
                
                <div class="nav-section-title">{{ 'nav.pharmacy_section'|trans }}</div>
                <a href="{{ path('admin_pharmacies') }}" class="admin-nav-item {{ app.request.get('_route') starts with 'admin_pharmacies' ? 'active' : '' }}">
                    <i class="fas fa-clinic-medical"></i>
                    <span>{{ 'nav.pharmacies'|trans }}</span>
                </a>
                <a href="{{ path('admin_medications') }}" class="admin-nav-item {{ app.request.get('_route') starts with 'admin_medications' ? 'active' : '' }}">
                    <i class="fas fa-pills"></i>
                    <span>{{ 'nav.medications'|trans }}</span>
                </a>
                <a href="{{ path('admin_stocks') }}" class="admin-nav-item {{ app.request.get('_route') starts with 'admin_stocks' ? 'active' : '' }}">
                    <i class="fas fa-warehouse"></i>
                    <span>Stocks</span>
                </a>
                
                <div class="nav-section-title">{{ 'nav.tracker_section'|trans }}</div>
                <a href="{{ path('admin_tracker') }}" class="admin-nav-item {{ app.request.get('_route') starts with 'admin_tracker' ? 'active' : '' }}">
                    <i class="fas fa-chart-area"></i>
                    <span>{{ 'nav.tracker_stats'|trans }}</span>
                </a>
                
                <div class="nav-section-title">{{ 'nav.content_section'|trans }}</div>
                <a href="{{ path('admin_content') }}" class="admin-nav-item {{ app.request.get('_route') starts with 'admin_content' ? 'active' : '' }}">
                    <i class="fas fa-newspaper"></i>
                    <span>{{ 'nav.content'|trans }}</span>
                </a>
                
                <div class="nav-section-title">{{ 'nav.system_section'|trans }}</div>
                
                <a href="{{ path('admin_settings') }}" class="admin-nav-item {{ app.request.get('_route') starts with 'admin_settings' ? 'active' : '' }}">
                    <i class="fas fa-cog"></i>
                    <span>{{ 'nav.settings'|trans }}</span>
                </a>
            </nav>
            
            <div class="admin-user-section">
                <div class="admin-user-avatar">
                    {% if app.user and app.user.avatarDataUri %}
                        <img src="{{ app.user.avatarDataUri }}" alt="Avatar">
                    {% else %}
                        <i class="fas fa-user-circle"></i>
                    {% endif %}
                </div>
                <div class="admin-user-info">
                    <div class="admin-user-name">{{ app.user.fullName ?? app.user.email }}</div>
                    <div class="admin-user-role">{{ 'nav.admin'|trans }}</div>
                </div>
                <a href="{{ path('app_logout') }}" class="admin-logout-btn" title="Se déconnecter">
                    <i class="fas fa-sign-out-alt"></i>
                </a>
            </div>
            <div class="admin-preferences">
                <div class="pref-row">
                    <span>{{ 'nav.theme'|trans }}</span>
                    <div class="inline-actions">
                        <a href="{{ path('app_theme', {theme: 'light'}) }}" class="mini-pill">{{ 'theme.light'|trans }}</a>
                        <a href="{{ path('app_theme', {theme: 'dark'}) }}" class="mini-pill">{{ 'theme.dark'|trans }}</a>
                    </div>
                </div>
                <div class="pref-row">
                    <span>{{ 'nav.language'|trans }}</span>
                    <div class="inline-actions">
                        <a href="{{ path('app_locale', {_locale: 'fr'}) }}" class="mini-pill">FR</a>
                        <a href="{{ path('app_locale', {_locale: 'en'}) }}" class="mini-pill">EN</a>
                        <a href="{{ path('app_locale', {_locale: 'ar'}) }}" class="mini-pill">AR</a>
                    </div>
                </div>
            </div>
        </aside>
        
        <!-- Main Content -->
        <main class="admin-main">
            <!-- Content Area -->
            <div class="admin-content">
                {% block admin_content %}{% endblock %}
            </div>
        </main>
    </div>
    
    <div class="global-loader" id="globalLoader" aria-hidden="true">
        <div class="loader-card">
            <div class="loader-spinner"></div>
            <div class="loader-text">Chargement…</div>
        </div>
    </div>
    
    {% block javascripts %}
        <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js" integrity="sha384-e6nUZLBkQ86NJ6TVVKAeSaK8jWa3NhkYWZFomE39AvDbQWeie9PlQqM3pmYW5d1g" crossorigin="anonymous"></script>
        <script src="{{ asset('js/admin.js') }}"></script>
        {# SANTÉA 3D Interactions for admin (no WebGL engine — lighter) #}
        <script defer src="{{ asset('js/santea-3d-interactions.js') }}?v=1"></script>
        <script>
            (function () {
                const loader = document.getElementById('globalLoader');
                if (!loader) return;
                const show = () => {
                    loader.classList.add('show');
                    loader.setAttribute('aria-hidden', 'false');
                };
                const hide = () => {
                    loader.classList.remove('show');
                    loader.setAttribute('aria-hidden', 'true');
                };

                document.querySelectorAll('form').forEach((form) => {
                    if (form.dataset.ajax === '1') return;
                    form.addEventListener('submit', () => {
                        show();
                    });
                });

                document.querySelectorAll('a[href]').forEach((link) => {
                    if (link.target === '_blank' || link.hasAttribute('download')) return;
                    link.addEventListener('click', () => {
                        const href = link.getAttribute('href');
                        if (!href || href.startsWith('#') || href.startsWith('javascript:')) return;
                        show();
                    });
                });

                window.addEventListener('pageshow', (e) => {
                    if (e.persisted) hide();
                });

                window.addEventListener('load', hide);
            })();
            (function () {
                const disableHtml5Validation = (root = document) => {
                    root.querySelectorAll('form').forEach((formEl) => {
                        formEl.setAttribute('novalidate', 'novalidate');
                        formEl.noValidate = true;
                    });
                };
                disableHtml5Validation();
                document.addEventListener('invalid', (e) => e.preventDefault(), true);
                const observer = new MutationObserver((mutations) => {
                    mutations.forEach((mutation) => {
                        mutation.addedNodes.forEach((node) => {
                            if (!(node instanceof HTMLElement)) return;
                            if (node.tagName === 'FORM') {
                                node.setAttribute('novalidate', 'novalidate');
                                node.noValidate = true;
                            } else {
                                disableHtml5Validation(node);
                            }
                        });
                    });
                });
                observer.observe(document.documentElement, { childList: true, subtree: true });
            })();
        </script>
    {% endblock %}
</body>
</html>
