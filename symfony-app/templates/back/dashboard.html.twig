{% extends 'back/base.html.twig' %}

{% block title %}Dashboard Admin - SANTÉA{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .admin-voice-launcher {
            position: fixed;
            right: 22px;
            bottom: 22px;
            z-index: 10020;
            border: none;
            border-radius: 999px;
            padding: 12px 16px;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            font-weight: 700;
            color: #fff;
            background: linear-gradient(135deg, #0ea5e9, #2563eb);
            box-shadow: 0 10px 26px rgba(37, 99, 235, .35);
            cursor: pointer;
        }
        .admin-voice-overlay {
            position: fixed;
            inset: 0;
            background: rgba(2, 6, 23, .55);
            backdrop-filter: blur(2px);
            z-index: 10030;
            display: none;
        }
        .admin-voice-overlay.open { display: block; }
        .admin-voice-panel {
            position: fixed;
            right: 0;
            top: 0;
            width: min(420px, 100vw);
            height: 100dvh;
            z-index: 10031;
            background: linear-gradient(160deg, #0b1220 0%, #12243f 60%, #0a4a73 100%);
            color: #fff;
            display: flex;
            flex-direction: column;
            transform: translateX(100%);
            transition: transform .26s ease;
            box-shadow: -20px 0 60px rgba(0,0,0,.4);
        }
        .admin-voice-panel.open { transform: translateX(0); }
        .admin-voice-head {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 14px;
            border-bottom: 1px solid rgba(255,255,255,.12);
        }
        .admin-voice-avatar {
            width: 40px;
            height: 40px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: linear-gradient(135deg, #06b6d4, #2563eb);
        }
        .admin-voice-close {
            margin-left: auto;
            background: rgba(255,255,255,.12);
            border: 0;
            color: #fff;
            width: 34px;
            height: 34px;
            border-radius: 10px;
            cursor: pointer;
        }
        .admin-voice-log {
            flex: 1;
            overflow: auto;
            padding: 14px;
            display: flex;
            flex-direction: column;
            gap: 10px;
        }
        .admin-voice-msg {
            max-width: 85%;
            border-radius: 14px;
            padding: 9px 12px;
            font-size: 13px;
            line-height: 1.45;
        }
        .admin-voice-msg.bot {
            background: rgba(255,255,255,.12);
            border-bottom-left-radius: 4px;
            color: rgba(255,255,255,.95);
        }
        .admin-voice-msg.user {
            margin-left: auto;
            background: linear-gradient(135deg, #0ea5e9, #22c55e);
            border-bottom-right-radius: 4px;
            color: #fff;
        }
        .admin-voice-input-wrap {
            padding: 12px;
            border-top: 1px solid rgba(255,255,255,.12);
        }
        .admin-voice-row {
            display: flex;
            align-items: center;
            gap: 8px;
            background: rgba(255,255,255,.1);
            border: 1px solid rgba(255,255,255,.16);
            border-radius: 12px;
            padding: 6px;
        }
        .admin-voice-input {
            flex: 1;
            border: none;
            background: transparent;
            color: #fff;
            outline: none;
            font-size: 13px;
            padding: 8px 10px;
        }
        .admin-voice-input::placeholder { color: rgba(255,255,255,.55); }
        .admin-voice-btn {
            width: 36px;
            height: 36px;
            border: 0;
            border-radius: 10px;
            color: #fff;
            cursor: pointer;
        }
        .admin-voice-btn.mic { background: linear-gradient(135deg, #0ea5e9, #2563eb); }
        .admin-voice-btn.send { background: rgba(255,255,255,.2); }
        .admin-voice-status {
            margin-top: 8px;
            font-size: 11px;
            color: rgba(255,255,255,.72);
            text-align: center;
        }
    </style>
{% endblock %}

{% block admin_content %}
    <!-- Header Section -->
    <div class="dashboard-header-modern">
        <div class="dashboard-header-left">
            <div class="dashboard-title-group">
                <h1><i class="fas fa-chart-line"></i> Dashboard Admin</h1>
                <p class="header-subtitle">Vue d'ensemble de la plateforme SANTÉA</p>
            </div>
            <div class="dashboard-quick-stats">
                <span class="quick-stat-pill"><i class="fas fa-check-circle"></i> Système opérationnel</span>
                <span class="quick-stat-pill"><i class="fas fa-clock"></i> {{ "now"|date("d/m/Y H:i") }}</span>
            </div>
        </div>
        <div class="dashboard-header-actions">
            <a href="{{ path('admin_validation') }}" class="btn-action-header" title="Validations en attente">
                <i class="fas fa-user-check"></i>
                {% if stats.adminPending > 0 %}
                    <span class="badge-notification">{{ stats.adminPending }}</span>
                {% endif %}
            </a>
            <a href="{{ path('admin_security_suspicious') }}" class="btn-action-header" title="Sécurité">
                <i class="fas fa-shield-alt"></i>
                {% if suspiciousCount > 0 %}
                    <span class="badge-notification warning">{{ suspiciousCount }}</span>
                {% endif %}
            </a>
            <a class="btn-export-modern" href="{{ path('admin_dashboard_export') }}">
                <i class="fas fa-download"></i> Exporter
            </a>
        </div>
    </div>
    
    <!-- Statistics Cards -->
    <section class="dashboard-stats-modern">
        <div class="stat-card-modern gradient-blue">
            <div class="stat-card-header">
                <div class="stat-icon-modern">
                    <i class="fas fa-users"></i>
                </div>
                <span class="stat-trend-badge up"><i class="fas fa-arrow-up"></i> +12%</span>
            </div>
            <div class="stat-card-body">
                <p class="stat-label-modern">Utilisateurs Total</p>
                <h2 class="stat-value-modern">{{ stats.totalUsers|number_format(0, ',', ' ') }}</h2>
                <div class="stat-details-row">
                    <span class="stat-detail"><i class="fas fa-check-circle"></i> {{ stats.activeUsers }} actifs</span>
                    <span class="stat-detail"><i class="fas fa-ban"></i> {{ stats.bannedUsers }} bannis</span>
                </div>
            </div>
            <div class="stat-card-footer">
                <a href="{{ path('admin_users') }}"><i class="fas fa-arrow-right"></i> Gérer les utilisateurs</a>
            </div>
        </div>

        <div class="stat-card-modern gradient-green">
            <div class="stat-card-header">
                <div class="stat-icon-modern">
                    <i class="fas fa-credit-card"></i>
                </div>
                <span class="stat-trend-badge up"><i class="fas fa-arrow-up"></i> +8%</span>
            </div>
            <div class="stat-card-body">
                <p class="stat-label-modern">Abonnements Actifs</p>
                <h2 class="stat-value-modern">{{ stats.activeSubscriptions|number_format(0, ',', ' ') }}</h2>
                <div class="stat-details-row">
                    <span class="stat-detail"><i class="fas fa-hourglass-half"></i> {{ stats.expiredSubscriptions }} expirés</span>
                    <span class="stat-detail"><i class="fas fa-times-circle"></i> {{ stats.cancelledSubscriptions }} annulés</span>
                </div>
            </div>
            <div class="stat-card-footer">
                <a href="{{ path('admin_subscriptions') }}"><i class="fas fa-arrow-right"></i> Voir les abonnements</a>
            </div>
        </div>

        <div class="stat-card-modern gradient-orange">
            <div class="stat-card-header">
                <div class="stat-icon-modern">
                    <i class="fas fa-coins"></i>
                </div>
                <span class="stat-trend-badge up"><i class="fas fa-arrow-up"></i> +15%</span>
            </div>
            <div class="stat-card-body">
                <p class="stat-label-modern">Revenus du Mois</p>
                <h2 class="stat-value-modern">{{ stats.monthlyRevenue|number_format(0, ',', ' ') }} <small>TND</small></h2>
                <div class="stat-details-row">
                    <span class="stat-detail"><i class="fas fa-chart-line"></i> Total: {{ stats.totalRevenue|number_format(0, ',', ' ') }} TND</span>
                </div>
            </div>
            <div class="stat-card-footer">
                <a href="{{ path('admin_revenues') }}"><i class="fas fa-arrow-right"></i> Détails des revenus</a>
            </div>
        </div>

        <div class="stat-card-modern gradient-purple">
            <div class="stat-card-header">
                <div class="stat-icon-modern">
                    <i class="fas fa-file-invoice-dollar"></i>
                </div>
                <span class="stat-trend-badge warning"><i class="fas fa-exclamation"></i> {{ stats.pendingPayments }}</span>
            </div>
            <div class="stat-card-body">
                <p class="stat-label-modern">Paiements en Attente</p>
                <h2 class="stat-value-modern">{{ stats.pendingPayments|number_format(0, ',', ' ') }}</h2>
                <div class="stat-details-row">
                    <span class="stat-detail"><i class="fas fa-file-invoice"></i> {{ stats.totalInvoices }} factures total</span>
                </div>
            </div>
            <div class="stat-card-footer">
                <a href="{{ path('admin_revenues') }}"><i class="fas fa-arrow-right"></i> Gérer les factures</a>
            </div>
        </div>
    </section>

    <!-- Charts Section -->
    <section class="dashboard-charts-section">
        <div class="chart-card-large">
            <div class="chart-card-header">
                <div>
                    <h3><i class="fas fa-chart-area"></i> Inscriptions (30 derniers jours)</h3>
                    <p>Évolution des nouvelles inscriptions sur le mois</p>
                </div>
                <div class="chart-legend">
                    <span class="legend-item"><span class="legend-dot" style="background: #40C4FF;"></span> Inscriptions</span>
                </div>
            </div>
            <div class="chart-card-body">
                <canvas id="registrationsChart" height="80"></canvas>
            </div>
        </div>

        <div class="chart-card-medium">
            <div class="chart-card-header">
                <div>
                    <h3><i class="fas fa-chart-pie"></i> Revenus par Type</h3>
                    <p>Répartition des revenus par rôle</p>
                </div>
            </div>
            <div class="chart-card-body" style="display: flex; align-items: center; justify-content: center;">
                <canvas id="revenueChart" height="200"></canvas>
            </div>
            <div class="chart-stats-grid">
                <div class="chart-stat-item">
                    <span class="chart-stat-label">Total</span>
                    <span class="chart-stat-value">{{ stats.totalRevenue|number_format(0, ',', ' ') }} TND</span>
                </div>
                <div class="chart-stat-item">
                    <span class="chart-stat-label">Ce mois</span>
                    <span class="chart-stat-value">{{ stats.monthlyRevenue|number_format(0, ',', ' ') }} TND</span>
                </div>
            </div>
        </div>
    </section>

    <!-- Mini Stats Grid -->
    <section class="mini-stats-grid">
        <div class="mini-stat-card">
            <div class="mini-stat-icon success">
                <i class="fas fa-envelope-circle-check"></i>
            </div>
            <div class="mini-stat-content">
                <p>Emails Confirmés</p>
                <h4>{{ stats.emailVerified|number_format(0, ',', ' ') }}</h4>
            </div>
        </div>
        <div class="mini-stat-card">
            <div class="mini-stat-icon warning">
                <i class="fas fa-user-clock"></i>
            </div>
            <div class="mini-stat-content">
                <p>En Attente Validation</p>
                <h4>{{ stats.adminPending|number_format(0, ',', ' ') }}</h4>
            </div>
        </div>
        <div class="mini-stat-card">
            <div class="mini-stat-icon danger">
                <i class="fas fa-user-xmark"></i>
            </div>
            <div class="mini-stat-content">
                <p>Abonnements Annulés</p>
                <h4>{{ stats.cancelledSubscriptions|number_format(0, ',', ' ') }}</h4>
            </div>
        </div>
        <div class="mini-stat-card">
            <div class="mini-stat-icon info">
                <i class="fas fa-wallet"></i>
            </div>
            <div class="mini-stat-content">
                <p>Revenus Total</p>
                <h4>{{ stats.totalRevenue|number_format(0, ',', ' ') }} TND</h4>
            </div>
        </div>
    </section>
    
    <!-- Quick Stats Grid -->
    <section class="quick-stats-grid">
        <div class="quick-stat-card">
            <div class="quick-stat-header">
                <h3>Utilisateurs par rôle</h3>
                <button class="quick-stat-btn"><i class="fas fa-ellipsis-h"></i></button>
            </div>
            <div class="quick-stat-list">
                {% for role in usersByRole %}
                    <div class="quick-stat-item">
                        <span><i class="{{ role.icon }}"></i> {{ role.name }}</span>
                        <strong>{{ role.count|number_format(0, ',', ' ') }}</strong>
                    </div>
                {% endfor %}
            </div>
        </div>
        
        <div class="quick-stat-card">
            <div class="quick-stat-header">
                <h3>Validation en attente</h3>
                <a href="{{ path('admin_validation') }}" class="quick-stat-btn">Voir tout</a>
            </div>
            <div class="quick-stat-list">
                <div class="quick-stat-item {{ pendingValidations.professionals > 0 ? 'alert' : '' }}">
                    <span><i class="fas fa-user-check"></i> Comptes professionnels</span>
                    <strong class="{{ pendingValidations.professionals > 0 ? 'alert-badge' : '' }}">
                        {{ pendingValidations.professionals }}
                    </strong>
                </div>
                <div class="quick-stat-item">
                    <span><i class="fas fa-clinic-medical"></i> Nouvelles pharmacies</span>
                    <strong>{{ pendingValidations.pharmacies }}</strong>
                </div>
                <div class="quick-stat-item {{ pendingValidations.articles > 0 ? 'alert' : '' }}">
                    <span><i class="fas fa-newspaper"></i> Articles à valider</span>
                    <strong class="{{ pendingValidations.articles > 0 ? 'alert-badge' : '' }}">
                        {{ pendingValidations.articles }}
                    </strong>
                </div>
                <div class="quick-stat-item">
                    <span><i class="fas fa-flag"></i> Signalements</span>
                    <strong>{{ pendingValidations.reports }}</strong>
                </div>
            </div>
        </div>

        <div class="quick-stat-card">
            <div class="quick-stat-header">
                <h3>Connexions suspectes</h3>
                <a href="{{ path('admin_security_suspicious') }}" class="quick-stat-btn">Voir tout</a>
            </div>
            <div class="quick-stat-list">
                {% if suspiciousRecent is not empty %}
                    {% for item in suspiciousRecent %}
                        <div class="quick-stat-item {{ item.blocked ? 'alert' : '' }}">
                            <span><i class="fas fa-shield-alt"></i> {{ item.user.email }}</span>
                            <strong>{{ item.createdAt|date('d/m H:i') }}</strong>
                        </div>
                    {% endfor %}
                {% else %}
                    <div class="quick-stat-item">
                        <span><i class="fas fa-shield-alt"></i> Aucune alerte</span>
                        <strong>0</strong>
                    </div>
                {% endif %}
            </div>
        </div>
        
        <div class="quick-stat-card">
            <div class="quick-stat-header">
                <h3>Activité récente</h3>
                <button class="quick-stat-btn"><i class="fas fa-ellipsis-h"></i></button>
            </div>
            <div class="quick-stat-list">
                <div class="quick-stat-item">
                    <span><i class="fas fa-user-plus"></i> Nouvelles inscriptions (24h)</span>
                    <strong>{{ recentActivity.newUsers }}</strong>
                </div>
                <div class="quick-stat-item">
                    <span><i class="fas fa-calendar-plus"></i> Rendez-vous créés (24h)</span>
                    <strong>{{ recentActivity.newAppointments }}</strong>
                </div>
                <div class="quick-stat-item">
                    <span><i class="fas fa-pills"></i> Recherches médicaments</span>
                    <strong>{{ recentActivity.medicationSearches }}</strong>
                </div>
                <div class="quick-stat-item">
                    <span><i class="fas fa-heartbeat"></i> Données tracker ajoutées</span>
                    <strong>{{ recentActivity.trackerEntries }}</strong>
                </div>
            </div>
        </div>

        <div class="quick-stat-card">
            <div class="quick-stat-header">
                <h3>Gestion Score IA</h3>
                <a href="{{ path('admin_users') }}" class="quick-stat-btn">Gérer</a>
            </div>
            <div class="quick-stat-list">
                <div class="quick-stat-item">
                    <span><i class="fas fa-brain"></i> Score moyen</span>
                    <strong>{{ aiScoreStats.averageScore }}/100</strong>
                </div>
                <div class="quick-stat-item">
                    <span><i class="fas fa-crown"></i> Éligibles premium (≥70)</span>
                    <strong>{{ aiScoreStats.premiumEligibleCount }}</strong>
                </div>
                <div class="quick-stat-item {{ aiScoreStats.freeMonthEligibleCount > 0 ? 'alert' : '' }}">
                    <span><i class="fas fa-gift"></i> Éligibles mois gratuit (≥95)</span>
                    <strong class="{{ aiScoreStats.freeMonthEligibleCount > 0 ? 'alert-badge' : '' }}">{{ aiScoreStats.freeMonthEligibleCount }}</strong>
                </div>
                <div class="quick-stat-item">
                    <span><i class="fas fa-calendar-check"></i> Mois gratuit actif</span>
                    <strong>{{ aiScoreStats.freeMonthActiveCount }}</strong>
                </div>

                {% for row in topAiUsers %}
                    <div class="quick-stat-item">
                        <span>
                            <i class="fas fa-user"></i>
                            {{ row.user.prenom }} {{ row.user.nom }}
                            <small style="opacity:.7;">({{ row.supportPriorityLabel }})</small>
                        </span>
                        <strong>{{ row.score }}/100</strong>
                    </div>
                {% else %}
                    <div class="quick-stat-item">
                        <span><i class="fas fa-user"></i> Aucun utilisateur</span>
                        <strong>0</strong>
                    </div>
                {% endfor %}
            </div>
        </div>
    </section>

    {% set trackerEntries = recentActivity.trackerEntries ?? 0 %}
    {% set trackerUsers = stats.activeUsers ?? 0 %}
    {% set trackerCoverage = stats.totalUsers > 0 ? (trackerUsers / stats.totalUsers * 100)|round(1, 'floor') : 0 %}
    {% set syncRate = trackerUsers > 0 ? min((trackerEntries / trackerUsers * 100)|round(1, 'floor'), 100) : 0 %}
    {% set adoptionRate = stats.totalUsers > 0 ? (stats.activeSubscriptions / stats.totalUsers * 100)|round(1, 'floor') : 0 %}

    <section class="tracker-stats-section">
        <article class="admin-card tracker-hero-card">
            <div class="tracker-hero-left">
                <p class="tracker-badge">Tracker santé</p>
                <h2>Suivi temps réel des indicateurs bien-être</h2>
                <p class="tracker-hero-copy">
                    Analysez la vitalité des modules connectés et priorisez les actions d'engagement ou de support quand un signal faiblit.
                </p>
                <ul class="tracker-hero-stats">
                    <li>
                        <span class="label">Entrées (24h)</span>
                        <span class="value">{{ trackerEntries|number_format(0, ',', ' ') }}</span>
                    </li>
                    <li>
                        <span class="label">Taux de synchro</span>
                        <span class="value">{{ syncRate }}%</span>
                    </li>
                    <li>
                        <span class="label">Couverture active</span>
                        <span class="value">{{ trackerCoverage }}%</span>
                    </li>
                </ul>
            </div>
            <div class="tracker-hero-right">
                <div class="tracker-hero-value">{{ trackerCoverage }}%</div>
                <small>Utilisateurs actifs suivis</small>
                <div class="tracker-hero-progress"><span style="width: {{ trackerCoverage }}%"></span></div>
                <div class="tracker-sparkline" aria-hidden="true">
                    <span></span>
                </div>
            </div>
        </article>

        <div class="tracker-metrics-grid">
            <article class="admin-card tracker-metric-card accent-blue">
                <div class="metric-icon"><i class="fas fa-heartbeat"></i></div>
                <div>
                    <p>Entrées synchronisées</p>
                    <h3>{{ trackerEntries|number_format(0, ',', ' ') }}</h3>
                    <small class="metric-trend {{ trackerEntries > 0 ? 'positive' : '' }}">
                        {{ trackerEntries > 0 ? '+ Flux actif aujourd\'hui' : 'En attente de synchro' }}
                    </small>
                </div>
            </article>
            <article class="admin-card tracker-metric-card accent-green">
                <div class="metric-icon"><i class="fas fa-signal"></i></div>
                <div>
                    <p>Taux de synchronisation</p>
                    <h3>{{ syncRate }}%</h3>
                    <small class="metric-trend">{{ trackerUsers|number_format(0, ',', ' ') }} utilisateurs actifs</small>
                </div>
            </article>
            <article class="admin-card tracker-metric-card accent-gold">
                <div class="metric-icon"><i class="fas fa-user-shield"></i></div>
                <div>
                    <p>Couverture globale</p>
                    <h3>{{ trackerCoverage }}%</h3>
                    <small class="metric-trend">{{ stats.totalUsers|number_format(0, ',', ' ') }} comptes existants</small>
                </div>
            </article>
            <article class="admin-card tracker-metric-card accent-indigo">
                <div class="metric-icon"><i class="fas fa-crown"></i></div>
                <div>
                    <p>Abonnés engagés</p>
                    <h3>{{ adoptionRate }}%</h3>
                    <small class="metric-trend">{{ stats.activeSubscriptions|number_format(0, ',', ' ') }} abonnements actifs</small>
                </div>
            </article>
        </div>

        <div class="tracker-detail-grid">
            <article class="admin-card tracker-progress-card">
                <header>
                    <div>
                        <p class="tracker-subtitle">Vue opérationnelle</p>
                        <h4>Taux de synchronisation</h4>
                    </div>
                    <span>{{ syncRate }}%</span>
                </header>
                <div class="tracker-progress-bar"><span style="width: {{ syncRate }}%"></span></div>
                <p class="tracker-progress-copy">
                    Part des utilisateurs actifs ayant transmis une donnée dans les dernières 24 heures.
                </p>
                <ul class="tracker-progress-meta">
                    <li>
                        <span>Utilisateurs actifs</span>
                        <strong>{{ trackerUsers|number_format(0, ',', ' ') }}</strong>
                    </li>
                    <li>
                        <span>Population totale</span>
                        <strong>{{ stats.totalUsers|number_format(0, ',', ' ') }}</strong>
                    </li>
                </ul>
            </article>
            <article class="admin-card tracker-insights-card">
                <header>
                    <div>
                        <p class="tracker-subtitle">Insights</p>
                        <h4>Actions à prioriser</h4>
                    </div>
                    <button class="tracker-action-btn">Voir les détails</button>
                </header>
                <ul class="tracker-insights-list">
                    <li>
                        <div>
                            <span>Couverture globale</span>
                            <p>{{ trackerCoverage }}% des comptes suivent au moins un indicateur connecté.</p>
                        </div>
                        <strong>{{ trackerCoverage }}%</strong>
                    </li>
                    <li>
                        <div>
                            <span>Adoption premium</span>
                            <p>{{ adoptionRate }}% des abonnés actifs exploitent le tracker Santé Quotidienne.</p>
                        </div>
                        <strong>{{ adoptionRate }}%</strong>
                    </li>
                    <li>
                        <div>
                            <span>Nouveaux comptes</span>
                            <p>Préparer un onboarding pour {{ recentActivity.newUsers|number_format(0, ',', ' ') }} nouvelles inscriptions (24h).</p>
                        </div>
                        <strong>{{ recentActivity.newUsers|number_format(0, ',', ' ') }}</strong>
                    </li>
                </ul>
            </article>
        </div>
    </section>

    <button type="button" id="adminVoiceLauncher" class="admin-voice-launcher">
        <i class="fas fa-microphone-alt"></i>
        Assistant IA vocal
    </button>

    <div id="adminVoiceOverlay" class="admin-voice-overlay"></div>
    <aside id="adminVoicePanel" class="admin-voice-panel" aria-modal="true" role="dialog" aria-label="Assistant IA vocal admin">
        <div class="admin-voice-head">
            <div class="admin-voice-avatar"><i class="fas fa-robot"></i></div>
            <div>
                <div style="font-weight:800;">Assistant IA vocal</div>
                <div style="font-size:12px;opacity:.75;">Commandes admin rapides</div>
            </div>
            <button type="button" id="adminVoiceClose" class="admin-voice-close" aria-label="Fermer">
                <i class="fas fa-times"></i>
            </button>
        </div>

        <div id="adminVoiceLog" class="admin-voice-log">
            <div class="admin-voice-msg bot">Bonjour 👋 Dites par exemple : « ouvre utilisateurs », « ouvre abonnements », « ouvre historique scoring », « export dashboard ».</div>
        </div>

        <div class="admin-voice-input-wrap">
            <div class="admin-voice-row">
                <button type="button" id="adminVoiceMic" class="admin-voice-btn mic" title="Parler">
                    <i class="fas fa-microphone" id="adminVoiceMicIcon"></i>
                </button>
                <input id="adminVoiceInput" class="admin-voice-input" type="text" placeholder="Dites ou écrivez une commande...">
                <button type="button" id="adminVoiceSend" class="admin-voice-btn send" title="Envoyer">
                    <i class="fas fa-paper-plane"></i>
                </button>
            </div>
            <div id="adminVoiceStatus" class="admin-voice-status">🎙️ Prêt à écouter</div>
        </div>
    </aside>
    
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        // Chart.js configurations for dashboard charts
        document.addEventListener('DOMContentLoaded', function() {
            // Registrations Chart
            const regCtx = document.getElementById('registrationsChart');
            if (regCtx) {
                new Chart(regCtx, {
                    type: 'line',
                    data: {
                        labels: {{ chartData.registrations.labels|json_encode|raw }},
                        datasets: [{
                            label: 'Inscriptions',
                            data: {{ chartData.registrations.data|json_encode|raw }},
                            borderColor: '#40C4FF',
                            backgroundColor: 'rgba(64, 196, 255, 0.1)',
                            tension: 0.4
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false
                    }
                });
            }
            
            // Revenue Chart
            const revCtx = document.getElementById('revenueChart');
            if (revCtx) {
                new Chart(revCtx, {
                    type: 'doughnut',
                    data: {
                        labels: {{ chartData.revenue.labels|json_encode|raw }},
                        datasets: [{
                            data: {{ chartData.revenue.data|json_encode|raw }},
                            backgroundColor: ['#40C4FF', '#4CAF50', '#FF9800', '#9C27B0']
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false
                    }
                });
            }

            const adminRoutes = {
                dashboard: '{{ path('admin_dashboard')|e('js') }}',
                users: '{{ path('admin_users')|e('js') }}',
                usersStats: '{{ path('admin_users_stats')|e('js') }}',
                scoreHistory: '{{ path('admin_users_score_history')|e('js') }}',
                subscriptions: '{{ path('admin_subscriptions')|e('js') }}',
                revenues: '{{ path('admin_revenues')|e('js') }}',
                appointments: '{{ path('admin_appointments')|e('js') }}',
                validation: '{{ path('admin_validation')|e('js') }}',
                security: '{{ path('admin_security_suspicious')|e('js') }}',
                exportDashboard: '{{ path('admin_dashboard_export')|e('js') }}',
                voiceExecute: '{{ path('admin_voice_assistant_execute')|e('js') }}'
            };

            const launcher = document.getElementById('adminVoiceLauncher');
            const panel = document.getElementById('adminVoicePanel');
            const overlay = document.getElementById('adminVoiceOverlay');
            const closeBtn = document.getElementById('adminVoiceClose');
            const input = document.getElementById('adminVoiceInput');
            const sendBtn = document.getElementById('adminVoiceSend');
            const micBtn = document.getElementById('adminVoiceMic');
            const micIcon = document.getElementById('adminVoiceMicIcon');
            const status = document.getElementById('adminVoiceStatus');
            const log = document.getElementById('adminVoiceLog');

            const openPanel = () => {
                panel?.classList.add('open');
                overlay?.classList.add('open');
                document.body.style.overflow = 'hidden';
                input?.focus();
            };
            const closePanel = () => {
                panel?.classList.remove('open');
                overlay?.classList.remove('open');
                document.body.style.overflow = '';
            };

            const appendMsg = (role, text) => {
                if (!log || !text) return;
                const div = document.createElement('div');
                div.className = `admin-voice-msg ${role}`;
                div.textContent = text;
                log.appendChild(div);
                log.scrollTop = log.scrollHeight;
            };

            const normalize = (txt) => (txt || '')
                .toLowerCase()
                .normalize('NFD').replace(/[\u0300-\u036f]/g, '')
                .replace(/\s+/g, ' ')
                .trim();

            const goTo = (url, message) => {
                appendMsg('bot', message || 'Ouverture de la page demandée.');
                setTimeout(() => { window.location.href = url; }, 250);
            };

            const runServerCommand = async (rawText) => {
                try {
                    if (status) status.textContent = '🧠 Analyse et exécution en cours...';
                    const res = await fetch(adminRoutes.voiceExecute, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'X-Requested-With': 'XMLHttpRequest'
                        },
                        body: JSON.stringify({ command: rawText })
                    });

                    const data = await res.json();
                    if (!data.success) {
                        appendMsg('bot', data.message || 'Impossible d\'exécuter la commande.');
                        if (status) status.textContent = 'Commande non exécutée.';
                        return;
                    }

                    appendMsg('bot', data.message || 'Commande exécutée.');

                    if (data.type === 'navigate' && data.url) {
                        setTimeout(() => { window.location.href = data.url; }, 250);
                        return;
                    }
                    if (data.type === 'download' && data.url) {
                        setTimeout(() => { window.location.href = data.url; }, 250);
                        return;
                    }
                    if (data.type === 'reload') {
                        setTimeout(() => window.location.reload(), 250);
                        return;
                    }

                    if (status) status.textContent = '✅ Exécution terminée.';
                } catch (e) {
                    appendMsg('bot', 'Erreur lors de l\'exécution automatique.');
                    if (status) status.textContent = 'Erreur réseau.';
                }
            };

            const executeCommand = async (rawText) => {
                const text = normalize(rawText);
                if (!text) return;
                appendMsg('user', rawText);

                if (text.includes('fais tout automatiquement') || text.includes('faire tout automatiquement') || text.includes('tout automatiquement') || text.includes('auto pilote') || text.includes('autopilot')) {
                    await runServerCommand(rawText);
                    return;
                }

                if (text.includes('ban') || text.includes('bannir') || text.includes('debannir') || text.includes('suspendre') || text.includes('modifier') || text.includes('changer role') || text.includes('changer le role')) {
                    await runServerCommand(rawText);
                    return;
                }

                if (text.includes('aide') || text.includes('help') || text.includes('commande')) {
                    appendMsg('bot', 'Commandes: ouvre utilisateurs, ouvre abonnements, ouvre revenus, ouvre rendez vous, ouvre validation, ouvre securite, ouvre historique scoring, export dashboard, rafraichir, bannir utilisateur <email>, debannir utilisateur <email>, modifier role utilisateur <email> en admin/patient/...');
                    return;
                }
                if (text.includes('utilisateur')) return goTo(adminRoutes.users, 'J’ouvre la gestion des utilisateurs.');
                if (text.includes('historique') && text.includes('scor')) return goTo(adminRoutes.scoreHistory, 'J’ouvre l’historique de scoring.');
                if (text.includes('abonnement')) return goTo(adminRoutes.subscriptions, 'J’ouvre les abonnements.');
                if (text.includes('revenu') || text.includes('facture')) return goTo(adminRoutes.revenues, 'J’ouvre les revenus et factures.');
                if (text.includes('rendez') || text.includes('appointment')) return goTo(adminRoutes.appointments, 'J’ouvre les rendez-vous.');
                if (text.includes('validation')) return goTo(adminRoutes.validation, 'J’ouvre les validations.');
                if (text.includes('securite') || text.includes('suspect') || text.includes('session')) return goTo(adminRoutes.security, 'J’ouvre la sécurité admin.');
                if (text.includes('export')) return goTo(adminRoutes.exportDashboard, 'J’exporte le dashboard.');
                if (text.includes('dashboard') || text.includes('accueil admin')) return goTo(adminRoutes.dashboard, 'Retour au dashboard.');
                if (text.includes('rafraichir') || text.includes('actualise') || text.includes('refresh')) {
                    appendMsg('bot', 'Je recharge le dashboard.');
                    setTimeout(() => window.location.reload(), 250);
                    return;
                }

                await runServerCommand(rawText);
            };

            launcher?.addEventListener('click', openPanel);
            closeBtn?.addEventListener('click', closePanel);
            overlay?.addEventListener('click', closePanel);
            document.addEventListener('keydown', (e) => {
                if (e.key === 'Escape') closePanel();
            });

            sendBtn?.addEventListener('click', () => {
                const text = input?.value || '';
                input.value = '';
                executeCommand(text);
            });
            input?.addEventListener('keydown', (e) => {
                if (e.key !== 'Enter') return;
                e.preventDefault();
                const text = input.value || '';
                input.value = '';
                executeCommand(text);
            });

            const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
            if (!SpeechRecognition) {
                if (status) status.textContent = 'Reconnaissance vocale indisponible sur ce navigateur.';
                if (micBtn) micBtn.disabled = true;
            } else {
                const recognition = new SpeechRecognition();
                recognition.lang = 'fr-FR';
                recognition.interimResults = false;
                recognition.continuous = false;

                let listening = false;

                recognition.onstart = () => {
                    listening = true;
                    if (status) status.textContent = '🔴 Écoute en cours...';
                    if (micIcon) micIcon.className = 'fas fa-stop';
                };
                recognition.onend = () => {
                    listening = false;
                    if (status) status.textContent = '🎙️ Prêt à écouter';
                    if (micIcon) micIcon.className = 'fas fa-microphone';
                };
                recognition.onerror = () => {
                    if (status) status.textContent = 'Erreur de reconnaissance vocale.';
                };
                recognition.onresult = (event) => {
                    const spoken = event?.results?.[0]?.[0]?.transcript || '';
                    appendMsg('user', spoken);
                    runServerCommand(spoken);
                };

                micBtn?.addEventListener('click', () => {
                    if (listening) {
                        recognition.stop();
                        return;
                    }
                    try {
                        recognition.start();
                    } catch (_) {}
                });
            }
        });
    </script>
{% endblock %}
