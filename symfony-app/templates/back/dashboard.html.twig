{% extends 'back/base.html.twig' %}

{% block title %}Dashboard Admin - SANTÉA{% endblock %}

{% block admin_content %}
    <!-- Header Section -->
    <div class="admin-header">
        <div class="admin-header-left">
            <h1>Dashboard Admin</h1>
            <p class="header-subtitle">Vue d'ensemble de la plateforme SANTÉA</p>
        </div>
        <div class="admin-header-right">
            <a class="btn-export" href="{{ path('admin_dashboard_export') }}">
                <i class="fas fa-download"></i> Exporter les données
            </a>
        </div>
    </div>
    
    <!-- Statistics Cards -->
    <section class="admin-stats">
        <div class="stat-card-admin">
            <div class="stat-icon-box" style="background: linear-gradient(135deg, #40C4FF, #0288D1);">
                <i class="fas fa-users"></i>
            </div>
            <div class="stat-content">
                <span class="stat-label">Utilisateurs total</span>
                <span class="stat-value">{{ stats.totalUsers|number_format(0, ',', ' ') }}</span>
                <span class="stat-change positive">
                    <i class="fas fa-user-check"></i> Actifs: {{ stats.activeUsers|number_format(0, ',', ' ') }}
                </span>
            </div>
        </div>

        <div class="stat-card-admin">
            <div class="stat-icon-box" style="background: linear-gradient(135deg, #4CAF50, #388E3C);">
                <i class="fas fa-credit-card"></i>
            </div>
            <div class="stat-content">
                <span class="stat-label">Abonnements actifs</span>
                <span class="stat-value">{{ stats.activeSubscriptions|number_format(0, ',', ' ') }}</span>
                <span class="stat-change positive">
                    <i class="fas fa-sync"></i> Expirés: {{ stats.expiredSubscriptions|number_format(0, ',', ' ') }}
                </span>
            </div>
        </div>

        <div class="stat-card-admin">
            <div class="stat-icon-box" style="background: linear-gradient(135deg, #FF9800, #F57C00);">
                <i class="fas fa-coins"></i>
            </div>
            <div class="stat-content">
                <span class="stat-label">Revenus du mois</span>
                <span class="stat-value">{{ stats.monthlyRevenue|number_format(0, ',', ' ') }} TND</span>
                <span class="stat-change positive">
                    <i class="fas fa-file-invoice"></i> Factures: {{ stats.totalInvoices|number_format(0, ',', ' ') }}
                </span>
            </div>
        </div>

        <div class="stat-card-admin">
            <div class="stat-icon-box" style="background: linear-gradient(135deg, #9C27B0, #7B1FA2);">
                <i class="fas fa-hourglass-half"></i>
            </div>
            <div class="stat-content">
                <span class="stat-label">Paiements en attente</span>
                <span class="stat-value">{{ stats.pendingPayments|number_format(0, ',', ' ') }}</span>
                <span class="stat-change negative">
                    <i class="fas fa-ban"></i> Bannies: {{ stats.bannedUsers|number_format(0, ',', ' ') }}
                </span>
            </div>
        </div>
    </section>

    <section class="admin-grid cards-4" style="margin-bottom: 30px;">
        <div class="admin-card">
            <div class="admin-badge">Email confirmés</div>
            <h2>{{ stats.emailVerified|number_format(0, ',', ' ') }}</h2>
        </div>
        <div class="admin-card">
            <div class="admin-badge warning">Admin en attente</div>
            <h2>{{ stats.adminPending|number_format(0, ',', ' ') }}</h2>
        </div>
        <div class="admin-card">
            <div class="admin-badge danger">Abonnements annulés</div>
            <h2>{{ stats.cancelledSubscriptions|number_format(0, ',', ' ') }}</h2>
        </div>
        <div class="admin-card">
            <div class="admin-badge">Revenus total</div>
            <h2>{{ stats.totalRevenue|number_format(0, ',', ' ') }} TND</h2>
        </div>
    </section>
    
    <!-- Quick Stats Grid -->
    <section class="quick-stats-grid">
        <div class="quick-stat-card">
            <div class="quick-stat-header">
                <h3>Utilisateurs par rôle</h3>
                <button class="quick-stat-btn"><i class="fas fa-ellipsis-h"></i></button>
            </div>
            <div class="quick-stat-list">
                {% for role in usersByRole %}
                    <div class="quick-stat-item">
                        <span><i class="{{ role.icon }}"></i> {{ role.name }}</span>
                        <strong>{{ role.count|number_format(0, ',', ' ') }}</strong>
                    </div>
                {% endfor %}
            </div>
        </div>
        
        <div class="quick-stat-card">
            <div class="quick-stat-header">
                <h3>Validation en attente</h3>
                <a href="{{ path('admin_validation') }}" class="quick-stat-btn">Voir tout</a>
            </div>
            <div class="quick-stat-list">
                <div class="quick-stat-item {{ pendingValidations.professionals > 0 ? 'alert' : '' }}">
                    <span><i class="fas fa-user-check"></i> Comptes professionnels</span>
                    <strong class="{{ pendingValidations.professionals > 0 ? 'alert-badge' : '' }}">
                        {{ pendingValidations.professionals }}
                    </strong>
                </div>
                <div class="quick-stat-item">
                    <span><i class="fas fa-clinic-medical"></i> Nouvelles pharmacies</span>
                    <strong>{{ pendingValidations.pharmacies }}</strong>
                </div>
                <div class="quick-stat-item {{ pendingValidations.articles > 0 ? 'alert' : '' }}">
                    <span><i class="fas fa-newspaper"></i> Articles à valider</span>
                    <strong class="{{ pendingValidations.articles > 0 ? 'alert-badge' : '' }}">
                        {{ pendingValidations.articles }}
                    </strong>
                </div>
                <div class="quick-stat-item">
                    <span><i class="fas fa-flag"></i> Signalements</span>
                    <strong>{{ pendingValidations.reports }}</strong>
                </div>
            </div>
        </div>
        
        <div class="quick-stat-card">
            <div class="quick-stat-header">
                <h3>Activité récente</h3>
                <button class="quick-stat-btn"><i class="fas fa-ellipsis-h"></i></button>
            </div>
            <div class="quick-stat-list">
                <div class="quick-stat-item">
                    <span><i class="fas fa-user-plus"></i> Nouvelles inscriptions (24h)</span>
                    <strong>{{ recentActivity.newUsers }}</strong>
                </div>
                <div class="quick-stat-item">
                    <span><i class="fas fa-calendar-plus"></i> Rendez-vous créés (24h)</span>
                    <strong>{{ recentActivity.newAppointments }}</strong>
                </div>
                <div class="quick-stat-item">
                    <span><i class="fas fa-pills"></i> Recherches médicaments</span>
                    <strong>{{ recentActivity.medicationSearches }}</strong>
                </div>
                <div class="quick-stat-item">
                    <span><i class="fas fa-heartbeat"></i> Données tracker ajoutées</span>
                    <strong>{{ recentActivity.trackerEntries }}</strong>
                </div>
            </div>
        </div>
    </section>
    
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        // Chart.js configurations for dashboard charts
        document.addEventListener('DOMContentLoaded', function() {
            // Registrations Chart
            const regCtx = document.getElementById('registrationsChart');
            if (regCtx) {
                new Chart(regCtx, {
                    type: 'line',
                    data: {
                        labels: {{ chartData.registrations.labels|json_encode|raw }},
                        datasets: [{
                            label: 'Inscriptions',
                            data: {{ chartData.registrations.data|json_encode|raw }},
                            borderColor: '#40C4FF',
                            backgroundColor: 'rgba(64, 196, 255, 0.1)',
                            tension: 0.4
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false
                    }
                });
            }
            
            // Revenue Chart
            const revCtx = document.getElementById('revenueChart');
            if (revCtx) {
                new Chart(revCtx, {
                    type: 'doughnut',
                    data: {
                        labels: {{ chartData.revenue.labels|json_encode|raw }},
                        datasets: [{
                            data: {{ chartData.revenue.data|json_encode|raw }},
                            backgroundColor: ['#40C4FF', '#4CAF50', '#FF9800', '#9C27B0']
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false
                    }
                });
            }
        });
    </script>
{% endblock %}
