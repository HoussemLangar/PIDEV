{% extends 'admin/base.html.twig' %}

{% block title %}Dashboard Admin - SANTÉA{% endblock %}

{% block admin_content %}
    <!-- Header Section -->
    <div class="admin-header">
        <div class="admin-header-left">
            <h1>Dashboard Admin</h1>
            <p class="header-subtitle">Vue d'ensemble de la plateforme SANTÉA</p>
        </div>
        <div class="admin-header-right">
            <button class="btn-export">
                <i class="fas fa-download"></i> Exporter les données
            </button>
        </div>
    </div>
    
    <!-- Statistics Cards -->
    <section class="admin-stats">
        <div class="stat-card-admin">
            <div class="stat-icon-box" style="background: linear-gradient(135deg, #40C4FF, #0288D1);">
                <i class="fas fa-users"></i>
            </div>
            <div class="stat-content">
                <span class="stat-label">Utilisateurs totaux</span>
                <span class="stat-value">{{ stats.totalUsers|number_format(0, ',', ' ') }}</span>
                <span class="stat-change {{ stats.usersGrowth > 0 ? 'positive' : 'negative' }}">
                    <i class="fas fa-arrow-{{ stats.usersGrowth > 0 ? 'up' : 'down' }}"></i> 
                    {{ stats.usersGrowth > 0 ? '+' : '' }}{{ stats.usersGrowth }}% ce mois
                </span>
            </div>
        </div>
        
        <div class="stat-card-admin">
            <div class="stat-icon-box" style="background: linear-gradient(135deg, #4CAF50, #388E3C);">
                <i class="fas fa-credit-card"></i>
            </div>
            <div class="stat-content">
                <span class="stat-label">Abonnements actifs</span>
                <span class="stat-value">{{ stats.activeSubscriptions|number_format(0, ',', ' ') }}</span>
                <span class="stat-change {{ stats.subscriptionsGrowth > 0 ? 'positive' : 'negative' }}">
                    <i class="fas fa-arrow-{{ stats.subscriptionsGrowth > 0 ? 'up' : 'down' }}"></i> 
                    {{ stats.subscriptionsGrowth > 0 ? '+' : '' }}{{ stats.subscriptionsGrowth }}% ce mois
                </span>
            </div>
        </div>
        
        <div class="stat-card-admin">
            <div class="stat-icon-box" style="background: linear-gradient(135deg, #FF9800, #F57C00);">
                <i class="fas fa-calendar-check"></i>
            </div>
            <div class="stat-content">
                <span class="stat-label">Rendez-vous ce mois</span>
                <span class="stat-value">{{ stats.monthlyAppointments|number_format(0, ',', ' ') }}</span>
                <span class="stat-change {{ stats.appointmentsGrowth > 0 ? 'positive' : 'negative' }}">
                    <i class="fas fa-arrow-{{ stats.appointmentsGrowth > 0 ? 'up' : 'down' }}"></i> 
                    {{ stats.appointmentsGrowth > 0 ? '+' : '' }}{{ stats.appointmentsGrowth }}% ce mois
                </span>
            </div>
        </div>
        
        <div class="stat-card-admin">
            <div class="stat-icon-box" style="background: linear-gradient(135deg, #9C27B0, #7B1FA2);">
                <i class="fas fa-euro-sign"></i>
            </div>
            <div class="stat-content">
                <span class="stat-label">Revenus mensuels</span>
                <span class="stat-value">{{ stats.monthlyRevenue|number_format(0, ',', ' ') }}€</span>
                <span class="stat-change {{ stats.revenueGrowth > 0 ? 'positive' : 'negative' }}">
                    <i class="fas fa-arrow-{{ stats.revenueGrowth > 0 ? 'up' : 'down' }}"></i> 
                    {{ stats.revenueGrowth > 0 ? '+' : '' }}{{ stats.revenueGrowth }}% ce mois
                </span>
            </div>
        </div>
    </section>
    
    <!-- Quick Stats Grid -->
    <section class="quick-stats-grid">
        <div class="quick-stat-card">
            <div class="quick-stat-header">
                <h3>Utilisateurs par rôle</h3>
                <button class="quick-stat-btn"><i class="fas fa-ellipsis-h"></i></button>
            </div>
            <div class="quick-stat-list">
                {% for role in usersByRole %}
                    <div class="quick-stat-item">
                        <span><i class="{{ role.icon }}"></i> {{ role.name }}</span>
                        <strong>{{ role.count|number_format(0, ',', ' ') }}</strong>
                    </div>
                {% endfor %}
            </div>
        </div>
        
        <div class="quick-stat-card">
            <div class="quick-stat-header">
                <h3>Validation en attente</h3>
                <a href="{{ path('admin_validation') }}" class="quick-stat-btn">Voir tout</a>
            </div>
            <div class="quick-stat-list">
                <div class="quick-stat-item {{ pendingValidations.professionals > 0 ? 'alert' : '' }}">
                    <span><i class="fas fa-user-check"></i> Comptes professionnels</span>
                    <strong class="{{ pendingValidations.professionals > 0 ? 'alert-badge' : '' }}">
                        {{ pendingValidations.professionals }}
                    </strong>
                </div>
                <div class="quick-stat-item">
                    <span><i class="fas fa-clinic-medical"></i> Nouvelles pharmacies</span>
                    <strong>{{ pendingValidations.pharmacies }}</strong>
                </div>
                <div class="quick-stat-item {{ pendingValidations.articles > 0 ? 'alert' : '' }}">
                    <span><i class="fas fa-newspaper"></i> Articles à valider</span>
                    <strong class="{{ pendingValidations.articles > 0 ? 'alert-badge' : '' }}">
                        {{ pendingValidations.articles }}
                    </strong>
                </div>
                <div class="quick-stat-item">
                    <span><i class="fas fa-flag"></i> Signalements</span>
                    <strong>{{ pendingValidations.reports }}</strong>
                </div>
            </div>
        </div>
        
        <div class="quick-stat-card">
            <div class="quick-stat-header">
                <h3>Activité récente</h3>
                <button class="quick-stat-btn"><i class="fas fa-ellipsis-h"></i></button>
            </div>
            <div class="quick-stat-list">
                <div class="quick-stat-item">
                    <span><i class="fas fa-user-plus"></i> Nouvelles inscriptions (24h)</span>
                    <strong>{{ recentActivity.newUsers }}</strong>
                </div>
                <div class="quick-stat-item">
                    <span><i class="fas fa-calendar-plus"></i> Rendez-vous créés (24h)</span>
                    <strong>{{ recentActivity.newAppointments }}</strong>
                </div>
                <div class="quick-stat-item">
                    <span><i class="fas fa-pills"></i> Recherches médicaments</span>
                    <strong>{{ recentActivity.medicationSearches }}</strong>
                </div>
                <div class="quick-stat-item">
                    <span><i class="fas fa-heartbeat"></i> Données tracker ajoutées</span>
                    <strong>{{ recentActivity.trackerEntries }}</strong>
                </div>
            </div>
        </div>
    </section>
    
    <!-- Charts Section -->
    <section class="admin-charts">
        <div class="chart-card">
            <div class="chart-header">
                <h3>Évolution des inscriptions</h3>
                <select class="chart-filter">
                    <option>7 derniers jours</option>
                    <option>30 derniers jours</option>
                    <option>3 derniers mois</option>
                    <option>12 derniers mois</option>
                </select>
            </div>
            <div class="chart-container">
                <canvas id="registrationsChart"></canvas>
            </div>
        </div>
        
        <div class="chart-card">
            <div class="chart-header">
                <h3>Revenus par catégorie</h3>
                <button class="chart-export-btn"><i class="fas fa-download"></i></button>
            </div>
            <div class="chart-container">
                <canvas id="revenueChart"></canvas>
            </div>
        </div>
    </section>
    
    <!-- Recent Activity Table -->
    <section class="admin-table-section">
        <div class="table-header">
            <h3>Dernières activités</h3>
            <div class="table-actions">
                <input type="text" placeholder="Rechercher..." class="table-search">
                <button class="btn-filter"><i class="fas fa-filter"></i> Filtrer</button>
            </div>
        </div>
        <div class="admin-table-wrapper">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th>Date & Heure</th>
                        <th>Type</th>
                        <th>Utilisateur</th>
                        <th>Action</th>
                        <th>Statut</th>
                    </tr>
                </thead>
                <tbody>
                    {% for activity in recentActivities %}
                        <tr>
                            <td>{{ activity.createdAt|date('d/m/Y H:i') }}</td>
                            <td>
                                <span class="activity-type {{ activity.type }}">
                                    <i class="{{ activity.icon }}"></i> {{ activity.typeName }}
                                </span>
                            </td>
                            <td>
                                <div class="user-cell">
                                    <img src="{{ activity.user.avatar ?? 'https://i.pravatar.cc/40?img=' ~ loop.index }}" alt="{{ activity.user.name }}">
                                    <span>{{ activity.user.name }}</span>
                                </div>
                            </td>
                            <td>{{ activity.description }}</td>
                            <td>
                                <span class="status-badge {{ activity.status }}">{{ activity.statusText }}</span>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </section>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        // Chart.js configurations for dashboard charts
        document.addEventListener('DOMContentLoaded', function() {
            // Registrations Chart
            const regCtx = document.getElementById('registrationsChart');
            if (regCtx) {
                new Chart(regCtx, {
                    type: 'line',
                    data: {
                        labels: {{ chartData.registrations.labels|json_encode|raw }},
                        datasets: [{
                            label: 'Inscriptions',
                            data: {{ chartData.registrations.data|json_encode|raw }},
                            borderColor: '#40C4FF',
                            backgroundColor: 'rgba(64, 196, 255, 0.1)',
                            tension: 0.4
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false
                    }
                });
            }
            
            // Revenue Chart
            const revCtx = document.getElementById('revenueChart');
            if (revCtx) {
                new Chart(revCtx, {
                    type: 'doughnut',
                    data: {
                        labels: {{ chartData.revenue.labels|json_encode|raw }},
                        datasets: [{
                            data: {{ chartData.revenue.data|json_encode|raw }},
                            backgroundColor: ['#40C4FF', '#4CAF50', '#FF9800', '#9C27B0']
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false
                    }
                });
            }
        });
    </script>
{% endblock %}
