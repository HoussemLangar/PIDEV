{% extends 'base.html.twig' %}

{% block title %}Outils IA – SANTÉA{% endblock %}

{% block stylesheets %}
{{ parent() }}
<style>
/* ═══════════════════════════════════════════
   AI TOOLS — Page styles
═══════════════════════════════════════════ */
.ait-page {
    min-height: 80vh;
    background: #f6f8fb;
    padding-bottom: 60px;
}

/* ── Hero ── */
.ait-hero {
    background: linear-gradient(135deg, #0a3d5c 0%, #0D8ABC 55%, #10b8d4 100%);
    color: #fff;
    padding: 60px 40px 80px;
    text-align: center;
    position: relative;
    overflow: hidden;
}
.ait-hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background: url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23ffffff' fill-opacity='0.04'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E");
    pointer-events: none;
}
.ait-hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: rgba(255,255,255,0.18);
    border: 1px solid rgba(255,255,255,0.3);
    border-radius: 100px;
    padding: 5px 14px;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: .8px;
    text-transform: uppercase;
    margin-bottom: 18px;
    backdrop-filter: blur(6px);
}
.ait-hero h1 {
    margin: 0 0 14px;
    font-size: clamp(26px, 4vw, 42px);
    font-weight: 800;
    letter-spacing: -.5px;
    text-shadow: 0 2px 12px rgba(0,0,0,.18);
}
.ait-hero p {
    margin: 0 auto;
    max-width: 560px;
    font-size: 16px;
    opacity: .88;
    line-height: 1.6;
}
.ait-hero-icon {
    width: 72px;
    height: 72px;
    background: rgba(255,255,255,.18);
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 32px;
    margin-bottom: 20px;
    backdrop-filter: blur(6px);
    border: 2px solid rgba(255,255,255,.3);
    animation: ait-pulse 3s ease-in-out infinite;
}
@keyframes ait-pulse {
    0%,100% { box-shadow: 0 0 0 0 rgba(255,255,255,.3); }
    50%      { box-shadow: 0 0 0 14px rgba(255,255,255,0); }
}

/* ── Wave separator ── */
.ait-hero-wave {
    display: block;
    margin-top: -2px;
    width: 100%;
    color: #f6f8fb;
}

/* ── Cards grid ── */
.ait-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 24px;
    max-width: 1100px;
    margin: -32px auto 0;
    padding: 0 32px;
    position: relative;
    z-index: 10;
}

/* ── Single card ── */
.ait-card {
    background: #fff;
    border-radius: 20px;
    box-shadow: 0 4px 20px rgba(13,138,188,.08), 0 1px 4px rgba(0,0,0,.06);
    overflow: hidden;
    text-decoration: none;
    display: flex;
    flex-direction: column;
    transition: transform .25s ease, box-shadow .25s ease;
    position: relative;
}
.ait-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 16px 40px rgba(13,138,188,.18), 0 4px 12px rgba(0,0,0,.08);
    text-decoration: none;
}
.ait-card-accent {
    height: 5px;
    width: 100%;
}
.ait-card-body {
    padding: 24px 22px 20px;
    flex: 1;
    display: flex;
    flex-direction: column;
}
.ait-card-icon-wrap {
    width: 52px;
    height: 52px;
    border-radius: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 22px;
    margin-bottom: 14px;
    flex-shrink: 0;
}
.ait-card-title {
    font-size: 16px;
    font-weight: 700;
    color: #0f172a;
    margin: 0 0 7px;
}
.ait-card-desc {
    font-size: 13.5px;
    color: #64748b;
    line-height: 1.55;
    flex: 1;
    margin: 0 0 18px;
}
.ait-card-cta {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 13px;
    font-weight: 600;
    padding: 7px 14px;
    border-radius: 9px;
    align-self: flex-start;
    transition: opacity .2s;
}
.ait-card:hover .ait-card-cta { opacity: .85; }

/* ── Features strip ── */
.ait-features {
    max-width: 1100px;
    margin: 40px auto 0;
    padding: 0 32px;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 16px;
}
.ait-feat {
    background: #fff;
    border: 1px solid #e9edf4;
    border-radius: 14px;
    padding: 18px 16px;
    display: flex;
    align-items: center;
    gap: 12px;
}
.ait-feat-icon {
    width: 38px;
    height: 38px;
    border-radius: 10px;
    background: rgba(13,138,188,.1);
    color: #0D8ABC;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 16px;
    flex-shrink: 0;
}
.ait-feat-label {
    font-size: 13px;
    font-weight: 600;
    color: #334155;
    line-height: 1.4;
}
.ait-feat-sub {
    font-size: 11.5px;
    color: #94a3b8;
    margin-top: 2px;
}

/* ── Responsive ── */
@media (max-width: 640px) {
    .ait-hero { padding: 44px 20px 70px; }
    .ait-grid, .ait-features { padding: 0 16px; gap: 14px; }
    .ait-grid { margin-top: -24px; }
}
</style>
{% endblock %}

{% block content %}
<div class="ait-page">

    <!-- ══ HERO ══════════════════════════════════════════════ -->
    <div class="ait-hero">
        <div class="ait-hero-icon">
            <i class="fas fa-robot"></i>
        </div>
        <div class="ait-hero-badge">
            <i class="fas fa-sparkles"></i> Intelligence Artificielle
        </div>
        <h1>Outils IA SANTÉA</h1>
        <p>Des assistants intelligents pour analyser vos documents médicaux, planifier votre nutrition, optimiser vos entraînements et comprendre vos résultats.</p>
    </div>
    <svg class="ait-hero-wave" viewBox="0 0 1440 40" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M0,40 C360,0 1080,0 1440,40 L1440,40 L0,40 Z" fill="currentColor"/>
    </svg>

    <!-- ══ CARDS ══════════════════════════════════════════════ -->
    <div class="ait-grid">

        <!-- Scanner document -->
        <a href="{{ path('app_ai_tools_document_scanner') }}" class="ait-card">
            <div class="ait-card-accent" style="background: linear-gradient(90deg,#6366f1,#8b5cf6);"></div>
            <div class="ait-card-body">
                <div class="ait-card-icon-wrap" style="background:rgba(99,102,241,.12); color:#6366f1;">
                    <i class="fas fa-file-medical-alt"></i>
                </div>
                <div class="ait-card-title">Scanner de document</div>
                <div class="ait-card-desc">Analysez une ordonnance, un bilan biologique ou tout document médical. L'IA extrait et interprète les valeurs clés pour vous.</div>
                <span class="ait-card-cta" style="background:rgba(99,102,241,.1); color:#6366f1;">
                    Ouvrir <i class="fas fa-arrow-right" style="font-size:11px;"></i>
                </span>
            </div>
        </a>

        <!-- Assistant nutrition -->
        <a href="{{ path('app_ai_tools_nutrition_planner') }}" class="ait-card">
            <div class="ait-card-accent" style="background: linear-gradient(90deg,#10b981,#059669);"></div>
            <div class="ait-card-body">
                <div class="ait-card-icon-wrap" style="background:rgba(16,185,129,.12); color:#10b981;">
                    <i class="fas fa-apple-alt"></i>
                </div>
                <div class="ait-card-title">Assistant Nutrition</div>
                <div class="ait-card-desc">Obtenez un plan alimentaire personnalisé selon votre objectif, votre style alimentaire et vos intolérances, sur plusieurs jours.</div>
                <span class="ait-card-cta" style="background:rgba(16,185,129,.1); color:#10b981;">
                    Ouvrir <i class="fas fa-arrow-right" style="font-size:11px;"></i>
                </span>
            </div>
        </a>

        <!-- Assistant exercice -->
        <a href="{{ path('app_ai_tools_workout_planner') }}" class="ait-card">
            <div class="ait-card-accent" style="background: linear-gradient(90deg,#f59e0b,#d97706);"></div>
            <div class="ait-card-body">
                <div class="ait-card-icon-wrap" style="background:rgba(245,158,11,.12); color:#f59e0b;">
                    <i class="fas fa-dumbbell"></i>
                </div>
                <div class="ait-card-title">Assistant Exercice</div>
                <div class="ait-card-desc">Générez un programme d'entraînement sur mesure adapté à votre niveau, vos objectifs et le temps dont vous disposez.</div>
                <span class="ait-card-cta" style="background:rgba(245,158,11,.1); color:#d97706;">
                    Ouvrir <i class="fas fa-arrow-right" style="font-size:11px;"></i>
                </span>
            </div>
        </a>

        <!-- Explain AI -->
        <a href="{{ path('app_ai_tools_result_explainer') }}" class="ait-card">
            <div class="ait-card-accent" style="background: linear-gradient(90deg,#0D8ABC,#0ea5e9);"></div>
            <div class="ait-card-body">
                <div class="ait-card-icon-wrap" style="background:rgba(13,138,188,.12); color:#0D8ABC;">
                    <i class="fas fa-microscope"></i>
                </div>
                <div class="ait-card-title">Explicateur de résultat</div>
                <div class="ait-card-desc">Collez un résultat médical ou biologique, et l'IA vous l'explique en langage simple, avec les informations essentielles à retenir.</div>
                <span class="ait-card-cta" style="background:rgba(13,138,188,.1); color:#0D8ABC;">
                    Ouvrir <i class="fas fa-arrow-right" style="font-size:11px;"></i>
                </span>
            </div>
        </a>

    </div>

    <!-- ══ FEATURES STRIP ══════════════════════════════════════ -->
    <div class="ait-features">
        <div class="ait-feat">
            <div class="ait-feat-icon"><i class="fas fa-bolt"></i></div>
            <div>
                <div class="ait-feat-label">Réponses rapides</div>
                <div class="ait-feat-sub">Résultats en quelques secondes</div>
            </div>
        </div>
        <div class="ait-feat">
            <div class="ait-feat-icon"><i class="fas fa-lock"></i></div>
            <div>
                <div class="ait-feat-label">100 % confidentiel</div>
                <div class="ait-feat-sub">Données non stockées</div>
            </div>
        </div>
        <div class="ait-feat">
            <div class="ait-feat-icon"><i class="fas fa-user-md"></i></div>
            <div>
                <div class="ait-feat-label">Contexte médical</div>
                <div class="ait-feat-sub">Adapté au domaine santé</div>
            </div>
        </div>
        <div class="ait-feat">
            <div class="ait-feat-icon"><i class="fas fa-sync-alt"></i></div>
            <div>
                <div class="ait-feat-label">Toujours disponible</div>
                <div class="ait-feat-sub">Accessible 24 h / 24</div>
            </div>
        </div>
    </div>

</div>
{% endblock %}

