{% extends 'base.html.twig' %}

{% block title %}Éditer un plan d'accompagnement{% endblock %}

{% block content %}
<div class="container mt-5">
    <div class="row">
        <div class="col-md-8 mx-auto">
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0"><i class="bi bi-pencil"></i> Éditer: {{ form.vars.data.title }}</h4>
                </div>
                <div class="card-body">
                    {{ form_start(form, { attr: { novalidate: 'novalidate' } }) }}
                    {{ form_errors(form) }}
                    
                    <div class="mb-3">
                        {{ form_label(form.title) }}
                        {{ form_widget(form.title, {'attr': {'class': 'form-control'}}) }}
                        {{ form_errors(form.title) }}
                    </div>

                    <div class="mb-3">
                        {{ form_label(form.objectives) }}
                        {{ form_widget(form.objectives, {'attr': {'class': 'form-control', 'rows': '4'}}) }}
                        {{ form_errors(form.objectives) }}
                    </div>

                    <div class="mb-3">
                        {{ form_label(form.description) }}
                        {{ form_widget(form.description, {'attr': {'class': 'form-control', 'rows': '3'}}) }}
                        {{ form_errors(form.description) }}
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            {{ form_label(form.durationWeeks) }}
                            {{ form_widget(form.durationWeeks, {'attr': {'class': 'form-control'}}) }}
                            {{ form_errors(form.durationWeeks) }}
                        </div>

                        <div class="col-md-6 mb-3">
                            {{ form_label(form.status) }}
                            {{ form_widget(form.status, {'attr': {'class': 'form-select'}}) }}
                            {{ form_errors(form.status) }}
                        </div>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-check-circle"></i> Enregistrer
                        </button>
                        <a href="{{ path('app_plan_show', {id: form.vars.data.id}) }}" class="btn btn-secondary">
                            <i class="bi bi-x-circle"></i> Annuler
                        </a>
                    </div>

                    {{ form_end(form) }}

                    {{ component('AccompanimentAiAssistant', {
                        goal: form.vars.data.objectives,
                        constraints: form.vars.data.description ?? ''
                    }) }}
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
