{% extends 'base.html.twig' %}

{% block title %}{{ plan.title }}{% endblock %}

{% block content %}
<div class="content-wrapper" style="padding: 30px 40px; max-width: 1200px; margin: 0 auto;">
    <!-- Page Header -->
    <div class="page-header" style="margin-bottom: 32px;">
        <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 16px;">
            <div style="display: flex; align-items: center; gap: 16px;">
                <div style="width: 48px; height: 48px; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); border-radius: 12px; display: flex; align-items: center; justify-content: center;">
                    <i class="fas fa-calendar-check" style="color: white; font-size: 24px;"></i>
                </div>
                <div>
                    <h1 style="margin: 0; font-size: 28px; font-weight: 700; color: #1a1a2e;">{{ plan.title }}</h1>
                    <p style="margin: 4px 0 0 0; color: #64748b; font-size: 14px;">Plan d'accompagnement personnalisé</p>
                </div>
            </div>
            {% if plan.status == 'active' %}
                <span style="display: inline-flex; align-items: center; gap: 6px; padding: 8px 16px; background: #dcfce7; color: #166534; border-radius: 20px; font-size: 14px; font-weight: 600;">
                    <i class="fas fa-circle" style="font-size: 8px;"></i> Actif
                </span>
            {% elseif plan.status == 'completed' %}
                <span style="display: inline-flex; align-items: center; gap: 6px; padding: 8px 16px; background: #dbeafe; color: #1e40af; border-radius: 20px; font-size: 14px; font-weight: 600;">
                    <i class="fas fa-check-circle"></i> Terminé
                </span>
            {% else %}
                <span style="display: inline-flex; align-items: center; gap: 6px; padding: 8px 16px; background: #fef3c7; color: #92400e; border-radius: 20px; font-size: 14px; font-weight: 600;">
                    <i class="fas fa-pause-circle"></i> {{ plan.status }}
                </span>
            {% endif %}
        </div>
    </div>

    <!-- Patient Info -->
    <div style="background: linear-gradient(135deg, #e0f2fe 0%, #f0f9ff 100%); border-radius: 14px; padding: 20px 24px; margin-bottom: 24px; border: 1px solid #bae6fd;">
        <div style="display: flex; align-items: center; gap: 16px;">
            <div style="width: 56px; height: 56px; background: linear-gradient(135deg, #06b6d4 0%, #0891b2 100%); border-radius: 12px; display: flex; align-items: center; justify-content: center; color: white; font-weight: 700; font-size: 20px;">
                {{ plan.patient.user.username|slice(0, 2)|upper }}
            </div>
            <div style="flex: 1;">
                <div style="font-weight: 700; font-size: 18px; color: #1e293b; margin-bottom: 4px;">
                    <i class="fas fa-user" style="color: #06b6d4; margin-right: 6px;"></i>
                    {{ plan.patient.user.nom }} {{ plan.patient.user.prenom }}
                </div>
                <div style="display: flex; gap: 20px; color: #64748b; font-size: 14px;">
                    <span><i class="fas fa-envelope" style="color: #94a3b8; margin-right: 6px;"></i>{{ plan.patient.user.email }}</span>
                </div>
            </div>
        </div>
    </div>

    <div style="display: grid; grid-template-columns: 2fr 1fr; gap: 24px; margin-bottom: 24px;">
        <!-- Main Content -->
        <div>
            <!-- Progress Card -->
            <div style="background: white; border-radius: 16px; padding: 24px; box-shadow: 0 2px 8px rgba(15,23,42,0.06); margin-bottom: 24px;">
                <h2 style="font-size: 18px; font-weight: 700; color: #1a1a2e; margin-bottom: 20px; display: flex; align-items: center; gap: 10px;">
                    <div style="width: 32px; height: 32px; background: linear-gradient(135deg, #10b981 0%, #059669 100%); border-radius: 8px; display: flex; align-items: center; justify-content: center;">
                        <i class="fas fa-chart-line" style="color: white; font-size: 14px;"></i>
                    </div>
                    Progression
                </h2>
                
                <div style="margin-bottom: 16px;">
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px;">
                        <span style="font-size: 14px; color: #64748b;">Avancement du plan</span>
                        <span style="font-size: 24px; font-weight: 700; color: #10b981;">{{ plan.progressPercentage }}%</span>
                    </div>
                    <div style="background: #e2e8f0; border-radius: 10px; height: 12px; overflow: hidden;">
                        <div style="height: 100%; background: linear-gradient(90deg, #10b981, #059669); border-radius: 10px; width: {{ plan.progressPercentage }}%; transition: width 0.3s;"></div>
                    </div>
                </div>

                <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 16px; padding-top: 16px; border-top: 1px solid #f1f5f9;">
                    <div style="text-align: center;">
                        <div style="font-size: 12px; color: #94a3b8; margin-bottom: 4px;">Durée</div>
                        <div style="font-size: 18px; font-weight: 700; color: #1e293b;">{{ plan.durationWeeks }}</div>
                        <div style="font-size: 11px; color: #cbd5e1;">semaines</div>
                    </div>
                    <div style="text-align: center;">
                        <div style="font-size: 12px; color: #94a3b8; margin-bottom: 4px;">Démarré le</div>
                        <div style="font-size: 18px; font-weight: 700; color: #1e293b;">{{ plan.startDate|date('d/m') }}</div>
                        <div style="font-size: 11px; color: #cbd5e1;">{{ plan.startDate|date('Y') }}</div>
                    </div>
                    <div style="text-align: center;">
                        <div style="font-size: 12px; color: #94a3b8; margin-bottom: 4px;">Fin prévue</div>
                        {% if plan.endDate %}
                            <div style="font-size: 18px; font-weight: 700; color: #1e293b;">{{ plan.endDate|date('d/m') }}</div>
                            <div style="font-size: 11px; color: #cbd5e1;">{{ plan.endDate|date('Y') }}</div>
                        {% else %}
                            <div style="font-size: 14px; color: #cbd5e1;">—</div>
                        {% endif %}
                    </div>
                </div>
            </div>

            <!-- Objectives Card -->
            <div style="background: white; border-radius: 16px; padding: 24px; box-shadow: 0 2px 8px rgba(15,23,42,0.06); margin-bottom: 24px;">
                <h2 style="font-size: 18px; font-weight: 700; color: #1a1a2e; margin-bottom: 16px; display: flex; align-items: center; gap: 10px;">
                    <div style="width: 32px; height: 32px; background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%); border-radius: 8px; display: flex; align-items: center; justify-content: center;">
                        <i class="fas fa-bullseye" style="color: white; font-size: 14px;"></i>
                    </div>
                    Objectifs
                </h2>
                <p style="color: #475569; line-height: 1.6; margin: 0;">{{ plan.objectives }}</p>
            </div>

            {% if plan.description %}
                <div style="background: white; border-radius: 16px; padding: 24px; box-shadow: 0 2px 8px rgba(15,23,42,0.06); margin-bottom: 24px;">
                    <h2 style="font-size: 18px; font-weight: 700; color: #1a1a2e; margin-bottom: 16px; display: flex; align-items: center; gap: 10px;">
                        <div style="width: 32px; height: 32px; background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%); border-radius: 8px; display: flex; align-items: center; justify-content: center;">
                            <i class="fas fa-file-alt" style="color: white; font-size: 14px;"></i>
                        </div>
                        Description
                    </h2>
                    <p style="color: #475569; line-height: 1.6; margin: 0;">{{ plan.description }}</p>
                </div>
            {% endif %}

            <!-- Exercise Plans -->
            {% if plan.exercisePlans is not empty %}
                <div style="background: white; border-radius: 16px; padding: 24px; box-shadow: 0 2px 8px rgba(15,23,42,0.06); margin-bottom: 24px;">
                    <h2 style="font-size: 18px; font-weight: 700; color: #1a1a2e; margin-bottom: 16px; display: flex; align-items: center; gap: 10px;">
                        <div style="width: 32px; height: 32px; background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%); border-radius: 8px; display: flex; align-items: center; justify-content: center;">
                            <i class="fas fa-dumbbell" style="color: white; font-size: 14px;"></i>
                        </div>
                        Plans d'exercice
                        <span style="background: #fee2e2; color: #991b1b; padding: 4px 10px; border-radius: 12px; font-size: 12px; font-weight: 600; margin-left: auto;">{{ plan.exercisePlans|length }}</span>
                    </h2>
                    <div style="display: flex; flex-direction: column; gap: 12px;">
                        {% for exercise in plan.exercisePlans %}
                            <div style="background: #f8fafc; border-radius: 10px; padding: 16px; border: 1px solid #e2e8f0; transition: all 0.2s;" onmouseover="this.style.borderColor='#ef4444'" onmouseout="this.style.borderColor='#e2e8f0'">
                                <div style="font-weight: 600; color: #1e293b; margin-bottom: 6px; font-size: 15px;">{{ exercise.titre }}</div>
                                <div style="display: flex; gap: 16px; font-size: 13px; color: #64748b;">
                                    <span><i class="fas fa-repeat" style="color: #94a3b8; margin-right: 4px;"></i>{{ exercise.frequence }}</span>
                                    <span><i class="fas fa-clock" style="color: #94a3b8; margin-right: 4px;"></i>{{ exercise.dureMinutes }} min</span>
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                </div>
            {% endif %}

            <!-- Diet Plans -->
            {% if plan.dietPlans is not empty %}
                <div style="background: white; border-radius: 16px; padding: 24px; box-shadow: 0 2px 8px rgba(15,23,42,0.06); margin-bottom: 24px;">
                    <h2 style="font-size: 18px; font-weight: 700; color: #1a1a2e; margin-bottom: 16px; display: flex; align-items: center; gap: 10px;">
                        <div style="width: 32px; height: 32px; background: linear-gradient(135deg, #10b981 0%, #059669 100%); border-radius: 8px; display: flex; align-items: center; justify-content: center;">
                            <i class="fas fa-apple-alt" style="color: white; font-size: 14px;"></i>
                        </div>
                        Plans nutritionnels
                        <span style="background: #d1fae5; color: #065f46; padding: 4px 10px; border-radius: 12px; font-size: 12px; font-weight: 600; margin-left: auto;">{{ plan.dietPlans|length }}</span>
                    </h2>
                    <div style="display: flex; flex-direction: column; gap: 12px;">
                        {% for diet in plan.dietPlans %}
                            <div style="background: #f8fafc; border-radius: 10px; padding: 16px; border: 1px solid #e2e8f0; transition: all 0.2s;" onmouseover="this.style.borderColor='#10b981'" onmouseout="this.style.borderColor='#e2e8f0'">
                                <div style="font-weight: 600; color: #1e293b; margin-bottom: 6px; font-size: 15px;">{{ diet.titre }}</div>
                                <div style="display: flex; gap: 16px; font-size: 13px; color: #64748b;">
                                    <span><i class="fas fa-utensils" style="color: #94a3b8; margin-right: 4px;"></i>{{ diet.typeRegime }}</span>
                                    {% if diet.caloriesJour %}
                                        <span><i class="fas fa-fire" style="color: #94a3b8; margin-right: 4px;"></i>{{ diet.caloriesJour }} cal/jour</span>
                                    {% endif %}
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                </div>
            {% endif %}

            {% if not (app.user and (app.user.subscriptionType ?? app.user.role) == 'ROLE_MEDECIN') %}
            {{ component('AccompanimentAiAssistant', {
                goal: plan.objectives,
                constraints: plan.description ?? ''
            }) }}
            {% endif %}
        </div>

        <!-- Sidebar -->
        <div>
            <!-- Professionals Card -->
            <div style="background: white; border-radius: 16px; padding: 24px; box-shadow: 0 2px 8px rgba(15,23,42,0.06); margin-bottom: 24px;">
                <h3 style="font-size: 16px; font-weight: 700; color: #1a1a2e; margin-bottom: 20px; display: flex; align-items: center; gap: 8px;">
                    <i class="fas fa-user-md" style="color: #667eea;"></i>
                    Professionnels
                </h3>

                {% if plan.coach %}
                    <div style="background: linear-gradient(135deg, #fef3c7 0%, #fef9c3 100%); border-radius: 10px; padding: 16px; margin-bottom: 12px; border: 1px solid #fde68a;">
                        <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 8px;">
                            <div style="width: 32px; height: 32px; background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%); border-radius: 8px; display: flex; align-items: center; justify-content: center;">
                                <i class="fas fa-dumbbell" style="color: white; font-size: 12px;"></i>
                            </div>
                            <div style="font-weight: 600; color: #78350f; font-size: 13px;">Coach Sportif</div>
                        </div>
                        <div style="font-weight: 600; color: #1e293b; font-size: 14px; margin-bottom: 4px;">{{ plan.coach.user.username }}</div>
                        <div style="font-size: 12px; color: #92400e;">{{ plan.coach.user.email }}</div>
                    </div>
                {% endif %}

                {% if plan.nutritionist %}
                    <div style="background: linear-gradient(135deg, #d1fae5 0%, #dcfce7 100%); border-radius: 10px; padding: 16px; margin-bottom: 12px; border: 1px solid #86efac;">
                        <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 8px;">
                            <div style="width: 32px; height: 32px; background: linear-gradient(135deg, #10b981 0%, #059669 100%); border-radius: 8px; display: flex; align-items: center; justify-content: center;">
                                <i class="fas fa-apple-alt" style="color: white; font-size: 12px;"></i>
                            </div>
                            <div style="font-weight: 600; color: #065f46; font-size: 13px;">Nutritionniste</div>
                        </div>
                        <div style="font-weight: 600; color: #1e293b; font-size: 14px; margin-bottom: 4px;">{{ plan.nutritionist.user.username }}</div>
                        <div style="font-size: 12px; color: #065f46;">{{ plan.nutritionist.user.email }}</div>
                    </div>
                {% endif %}

                {% if not plan.coach and not plan.nutritionist %}
                    <div style="text-align: center; padding: 20px; color: #94a3b8;">
                        <i class="fas fa-user-slash" style="font-size: 32px; opacity: 0.3; margin-bottom: 8px;"></i>
                        <p style="margin: 0; font-size: 13px;">Aucun professionnel assigné</p>
                    </div>
                {% endif %}
            </div>

            <!-- Actions Card -->
            <div style="background: white; border-radius: 16px; padding: 24px; box-shadow: 0 2px 8px rgba(15,23,42,0.06);">
                <h3 style="font-size: 16px; font-weight: 700; color: #1a1a2e; margin-bottom: 20px; display: flex; align-items: center; gap: 8px;">
                    <i class="fas fa-cog" style="color: #667eea;"></i>
                    Actions
                </h3>

                <div style="display: flex; flex-direction: column; gap: 10px;">
                    {% set _isMedecin = app.user and (app.user.subscriptionType ?? app.user.role) == 'ROLE_MEDECIN' %}
                    {% if not _isMedecin %}
                    <a href="{{ path('app_plan_edit', {id: plan.id}) }}" style="display: flex; align-items: center; justify-content: center; gap: 8px; padding: 12px 16px; background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%); color: white; border-radius: 10px; text-decoration: none; font-weight: 600; font-size: 14px; transition: all 0.2s;">
                        <i class="fas fa-edit"></i>
                        Modifier le plan
                    </a>

                    <form action="{{ path('app_plan_delete', {id: plan.id}) }}" method="POST" style="margin: 0;">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ plan.id) }}">
                        <button type="submit" onclick="return confirm('Êtes-vous sûr de vouloir supprimer ce plan ?')" style="width: 100%; display: flex; align-items: center; justify-content: center; gap: 8px; padding: 12px 16px; background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%); color: white; border: none; border-radius: 10px; font-weight: 600; font-size: 14px; cursor: pointer; transition: all 0.2s;">
                            <i class="fas fa-trash"></i>
                            Supprimer
                        </button>
                    </form>
                    {% endif %}{# /not _isMedecin #}

                    <a href="{{ path('app_plan_professional_plans') }}" style="display: flex; align-items: center; justify-content: center; gap: 8px; padding: 12px 16px; background: #f1f5f9; color: #475569; border: 1px solid #e2e8f0; border-radius: 10px; text-decoration: none; font-weight: 600; font-size: 14px; transition: all 0.2s;">
                        <i class="fas fa-arrow-left"></i>
                        Retour à la liste
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
@keyframes fadeInUp {
    from {
        opacity: 0;
        transform: translateY(20px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

.content-wrapper {
    animation: fadeInUp 0.5s ease-out;
}

a[style*="background: linear-gradient"]:hover,
button[style*="background: linear-gradient"]:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.15);
}

a[style*="background: #f1f5f9"]:hover {
    background: #e2e8f0 !important;
    transform: translateY(-2px);
}

/* Responsive Design */
@media (max-width: 1024px) {
    .content-wrapper > div[style*="grid-template-columns: 2fr 1fr"] {
        grid-template-columns: 1fr !important;
    }
}

@media (max-width: 768px) {
    .content-wrapper {
        padding: 20px !important;
    }
    
    .page-header h1 {
        font-size: 22px !important;
    }
    
    div[style*="grid-template-columns: 1fr 1fr 1fr"] {
        grid-template-columns: 1fr !important;
    }
}
</style>
{% endblock %}
