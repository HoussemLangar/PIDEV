{% extends 'base.html.twig' %}

{% block title %}Mes plans d'accompagnement{% endblock %}

{% block content %}
<div class="content-wrapper" style="padding: 30px 40px; max-width: 1400px; margin: 0 auto;">
    <div class="page-header" style="margin-bottom: 32px;">
        <div style="display: flex; align-items: center; gap: 16px;">
            <div style="width: 48px; height: 48px; background: linear-gradient(135deg, #06b6d4 0%, #0891b2 100%); border-radius: 12px; display: flex; align-items: center; justify-content: center;">
                <i class="fas fa-calendar-check" style="color: white; font-size: 24px;"></i>
            </div>
            <div>
                <h1 style="margin: 0; font-size: 28px; font-weight: 700; color: #1a1a2e;">Plans d'accompagnement</h1>
                <p style="margin: 4px 0 0 0; color: #64748b; font-size: 14px;">Suivez vos programmes personnalisés</p>
            </div>
        </div>
    </div>

    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 20px; margin-bottom: 32px;">
        <div style="background: linear-gradient(135deg, #10b981 0%, #059669 100%); border-radius: 14px; padding: 24px; box-shadow: 0 4px 12px rgba(16,185,129,0.25);">
            <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 12px;">
                <i class="fas fa-play-circle" style="font-size: 32px; color: rgba(255,255,255,0.9);"></i>
                <span style="background: rgba(255,255,255,0.2); padding: 6px 12px; border-radius: 20px; font-size: 12px; font-weight: 600; color: white;">Actifs</span>
            </div>
            <h3 style="margin: 0; font-size: 32px; font-weight: 700; color: white;">{{ stats.active }}</h3>
            <p style="margin: 4px 0 0 0; color: rgba(255,255,255,0.8); font-size: 14px;">Plans en cours</p>
        </div>
        <div style="background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%); border-radius: 14px; padding: 24px; box-shadow: 0 4px 12px rgba(59,130,246,0.25);">
            <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 12px;">
                <i class="fas fa-check-circle" style="font-size: 32px; color: rgba(255,255,255,0.9);"></i>
                <span style="background: rgba(255,255,255,0.2); padding: 6px 12px; border-radius: 20px; font-size: 12px; font-weight: 600; color: white;">Terminés</span>
            </div>
            <h3 style="margin: 0; font-size: 32px; font-weight: 700; color: white;">{{ stats.completed }}</h3>
            <p style="margin: 4px 0 0 0; color: rgba(255,255,255,0.8); font-size: 14px;">Plans complétés</p>
        </div>
        <div style="background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%); border-radius: 14px; padding: 24px; box-shadow: 0 4px 12px rgba(239,68,68,0.25);">
            <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 12px;">
                <i class="fas fa-times-circle" style="font-size: 32px; color: rgba(255,255,255,0.9);"></i>
                <span style="background: rgba(255,255,255,0.2); padding: 6px 12px; border-radius: 20px; font-size: 12px; font-weight: 600; color: white;">Annulés</span>
            </div>
            <h3 style="margin: 0; font-size: 32px; font-weight: 700; color: white;">{{ stats.cancelled }}</h3>
            <p style="margin: 4px 0 0 0; color: rgba(255,255,255,0.8); font-size: 14px;">Plans interrompus</p>
        </div>
    </div>

            <!-- Plans List -->
            {% if plans is empty %}
                <div style="background: linear-gradient(135deg, #e0f2fe 0%, #f0f9ff 100%); border-radius: 16px; padding: 48px; text-align: center; border: 2px dashed #06b6d4;">
                    <i class="fas fa-calendar-plus" style="font-size: 64px; color: #06b6d4; opacity: 0.3; margin-bottom: 16px;"></i>
                    <h3 style="margin: 0 0 8px 0; font-size: 20px; font-weight: 600; color: #1a1a2e;">Aucun plan d'accompagnement</h3>
                    <p style="margin: 0; color: #64748b;">Commencez un nouveau programme personnalisé</p>
                </div>
            {% else %}
                <div class="row">
                    {% for plan in plans %}
                        <div class="col-md-6 mb-3">
                            <div class="card {% if plan.active %}border-success{% else %}border-secondary{% endif %}">
                                <div class="card-header {% if plan.active %}bg-success text-white{% else %}bg-secondary text-white{% endif %}">
                                    <h5 class="mb-0">
                                        {{ plan.title }}
                                        <span class="badge bg-light float-end text-dark">{{ plan.status }}</span>
                                    </h5>
                                </div>
                                <div class="card-body">
                                    <p class="mb-2">{{ plan.objectives }}</p>
                                    <div class="mb-3">
                                        <small class="text-muted">Progression</small>
                                        <div class="progress">
                                            <div class="progress-bar" style="width: {{ plan.progressPercentage }}%">
                                                {{ plan.progressPercentage }}%
                                            </div>
                                        </div>
                                    </div>
                                    
                                    {% if plan.coach %}
                                        <p class="mb-1">
                                            <i class="bi bi-person-badge"></i>
                                            <strong>Coach:</strong> {{ plan.coach.user.username }}
                                        </p>
                                    {% endif %}
                                    
                                    {% if plan.nutritionist %}
                                        <p class="mb-2">
                                            <i class="bi bi-person-badge"></i>
                                            <strong>Nutritionniste:</strong> {{ plan.nutritionist.user.username }}
                                        </p>
                                    {% endif %}

                                    <p class="text-muted small">
                                        <i class="bi bi-calendar"></i>
                                        Démarré: {{ plan.startDate|date('d/m/Y') }}
                                        | Durée: {{ plan.durationWeeks }} semaines
                                    </p>
                                </div>
                                <div class="card-footer">
                                    <a href="{{ path('app_plan_show', {id: plan.id}) }}" class="btn btn-sm btn-info">
                                        <i class="bi bi-eye"></i> Voir
                                    </a>
                                    <a href="{{ path('app_plan_edit', {id: plan.id}) }}" class="btn btn-sm btn-warning">
                                        <i class="bi bi-pencil"></i> Éditer
                                    </a>
                                    <form action="{{ path('app_plan_delete', {id: plan.id}) }}" method="POST" style="display:inline;">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ plan.id) }}">
                                        <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Êtes-vous sûr?')">
                                            <i class="bi bi-trash"></i> Supprimer
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    {% endfor %}
                </div>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}
