{% extends 'base.html.twig' %}

{% block title %}Mes plans d'accompagnement{% endblock %}

{% block content %}
<div class="container mt-5">
    <div class="row">
        <div class="col-md-12">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h1><i class="bi bi-calendar-check"></i> Plans d'accompagnement</h1>
            </div>

            <!-- Statistics -->
            <div class="row mb-4">
                <div class="col-md-4">
                    <div class="card bg-light">
                        <div class="card-body text-center">
                            <h4>{{ stats.active }}</h4>
                            <small class="text-muted">Plans actifs</small>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card bg-light">
                        <div class="card-body text-center">
                            <h4>{{ stats.completed }}</h4>
                            <small class="text-muted">Complétés</small>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card bg-light">
                        <div class="card-body text-center">
                            <h4>{{ stats.cancelled }}</h4>
                            <small class="text-muted">Annulés</small>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Plans List -->
            {% if plans is empty %}
                <div class="alert alert-info">
                    Vous n'avez pas encore de plan d'accompagnement.
                </div>
            {% else %}
                <div class="row">
                    {% for plan in plans %}
                        <div class="col-md-6 mb-3">
                            <div class="card {% if plan.active %}border-success{% else %}border-secondary{% endif %}">
                                <div class="card-header {% if plan.active %}bg-success text-white{% else %}bg-secondary text-white{% endif %}">
                                    <h5 class="mb-0">
                                        {{ plan.title }}
                                        <span class="badge bg-light float-end text-dark">{{ plan.status }}</span>
                                    </h5>
                                </div>
                                <div class="card-body">
                                    <p class="mb-2">{{ plan.objectives }}</p>
                                    <div class="mb-3">
                                        <small class="text-muted">Progression</small>
                                        <div class="progress">
                                            <div class="progress-bar" style="width: {{ plan.progressPercentage }}%">
                                                {{ plan.progressPercentage }}%
                                            </div>
                                        </div>
                                    </div>
                                    
                                    {% if plan.coach %}
                                        <p class="mb-1">
                                            <i class="bi bi-person-badge"></i>
                                            <strong>Coach:</strong> {{ plan.coach.user.username }}
                                        </p>
                                    {% endif %}
                                    
                                    {% if plan.nutritionist %}
                                        <p class="mb-2">
                                            <i class="bi bi-person-badge"></i>
                                            <strong>Nutritionniste:</strong> {{ plan.nutritionist.user.username }}
                                        </p>
                                    {% endif %}

                                    <p class="text-muted small">
                                        <i class="bi bi-calendar"></i>
                                        Démarré: {{ plan.startDate|date('d/m/Y') }}
                                        | Durée: {{ plan.durationWeeks }} semaines
                                    </p>
                                </div>
                                <div class="card-footer">
                                    <a href="{{ path('app_plan_show', {id: plan.id}) }}" class="btn btn-sm btn-info">
                                        <i class="bi bi-eye"></i> Voir
                                    </a>
                                    <a href="{{ path('app_plan_edit', {id: plan.id}) }}" class="btn btn-sm btn-warning">
                                        <i class="bi bi-pencil"></i> Éditer
                                    </a>
                                    <form action="{{ path('app_plan_delete', {id: plan.id}) }}" method="POST" style="display:inline;">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ plan.id) }}">
                                        <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Êtes-vous sûr?')">
                                            <i class="bi bi-trash"></i> Supprimer
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    {% endfor %}
                </div>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}
