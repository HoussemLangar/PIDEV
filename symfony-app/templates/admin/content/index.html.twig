{% extends 'back/base.html.twig' %}

{% block title %}Validation contenus{% endblock %}

{% block admin_content %}
<div class="admin-page-header">
    <div class="admin-page-title">
        <h1>Validation des contenus</h1>
        <p>Validez, rejetez ou supprimez les contenus soumis par les professionnels.</p>
    </div>
    <div class="admin-actions-row">
        <span class="admin-badge warning">Total: {{ stats.total }}</span>
    </div>
</div>

<div class="admin-grid cards-4 validation-stats">
    <div class="admin-card">
        <div class="admin-badge">En attente</div>
        <h2>{{ stats.en_attente }}</h2>
    </div>
    <div class="admin-card">
        <div class="admin-badge success">Validés</div>
        <h2>{{ stats.valide }}</h2>
    </div>
    <div class="admin-card">
        <div class="admin-badge">Publiés</div>
        <h2>{{ stats.publie }}</h2>
    </div>
    <div class="admin-card">
        <div class="admin-badge danger">Rejetés</div>
        <h2>{{ stats.rejete }}</h2>
    </div>
</div>

<div class="admin-card">
    <form method="get" class="admin-form" style="margin-bottom: 12px;">
        <div class="form-row filters-inline filters-modern">
            <div class="filter-search filter-field">
                <label>Recherche</label>
                <i class="fas fa-search"></i>
                <input type="text" name="q" value="{{ q }}" placeholder="Titre, tags...">
            </div>
            <div class="filter-field">
                <label>Statut</label>
                <select name="status">
                    <option value="" {{ status is empty ? 'selected' : '' }}>Tous</option>
                    <option value="en_attente" {{ status == 'en_attente' ? 'selected' : '' }}>En attente</option>
                    <option value="valide" {{ status == 'valide' ? 'selected' : '' }}>Validé</option>
                    <option value="publie" {{ status == 'publie' ? 'selected' : '' }}>Publié</option>
                    <option value="rejete" {{ status == 'rejete' ? 'selected' : '' }}>Rejeté</option>
                </select>
            </div>
            <div class="filter-field">
                <label>Type</label>
                <select name="type">
                    <option value="" {{ type is empty ? 'selected' : '' }}>Tous</option>
                    <option value="article" {{ type == 'article' ? 'selected' : '' }}>Article</option>
                    <option value="video" {{ type == 'video' ? 'selected' : '' }}>Vidéo</option>
                    <option value="pdf" {{ type == 'pdf' ? 'selected' : '' }}>PDF</option>
                    <option value="lien" {{ type == 'lien' ? 'selected' : '' }}>Lien</option>
                </select>
            </div>
            <div class="filter-actions">
                <a class="btn btn-secondary" href="{{ path('admin_content') }}">Réinitialiser</a>
            </div>
        </div>
    </form>
    <div style="overflow-x:auto;">
        <table class="admin-table">
            <thead>
                <tr>
                    <th>Titre</th>
                    <th>Type</th>
                    <th>Auteur</th>
                    <th>Date</th>
                    <th>Statut</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody id="contentTableBody">
            {% for contenu in contents %}
                <tr data-content-id="{{ contenu.id }}">
                    <td>{{ contenu.titre }}</td>
                    <td><span class="content-status-badge status-draft">{{ contenu.type|upper }}</span></td>
                    <td>{{ contenu.auteur ? (contenu.auteur.fullName ?? contenu.auteur.email) : 'Anonyme' }}</td>
                    <td>{{ contenu.createdAt|date('d/m/Y H:i') }}</td>
                    <td>
                        {% set statusLabel = contenu.statut == 'valide' ? 'Validé' : (contenu.statut == 'publie' ? 'Publié' : (contenu.statut == 'rejete' ? 'Rejeté' : 'En attente')) %}
                        {% set statusClass = contenu.statut == 'valide' or contenu.statut == 'publie' ? 'status-published' : (contenu.statut == 'rejete' ? 'status-archived' : 'status-draft') %}
                        <span class="content-status-badge {{ statusClass }}" data-status>{{ statusLabel }}</span>
                    </td>
                    <td>
                        <div class="admin-actions-row">
                            {% if contenu.statut == 'en_attente' %}
                                <button class="btn btn-primary btn-xs action-validate" data-token="{{ csrf_token('content_action_' ~ contenu.id) }}">Valider</button>
                                <button class="btn btn-secondary btn-xs action-reject" data-token="{{ csrf_token('content_action_' ~ contenu.id) }}">Rejeter</button>
                            {% endif %}
                            <button class="btn btn-danger btn-xs action-delete" data-token="{{ csrf_token('content_action_' ~ contenu.id) }}">Supprimer</button>
                        </div>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="6" style="text-align:center; color: var(--admin-muted);">Aucun contenu.</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        (function () {
            const table = document.getElementById('contentTableBody');
            if (!table) return;

            const postAction = async (url, token) => {
                const res = await fetch(url, {
                    method: 'POST',
                    headers: { 'X-Requested-With': 'XMLHttpRequest' },
                    body: new URLSearchParams({ _token: token }),
                });
                return res.json();
            };

            table.addEventListener('click', async (e) => {
                const row = e.target.closest('tr[data-content-id]');
                if (!row) return;
                const id = row.dataset.contentId;
                const token = e.target.dataset.token;
                if (!token) return;

                if (e.target.classList.contains('action-validate')) {
                    if (!confirm('Valider ce contenu ?')) return;
                    const data = await postAction(`/admin/content/${id}/validate`, token);
                    if (data.success) {
                        row.querySelector('[data-status]').textContent = 'Validé';
                        row.querySelector('[data-status]').className = 'content-status-badge status-published';
                    }
                }
                if (e.target.classList.contains('action-reject')) {
                    if (!confirm('Rejeter ce contenu ?')) return;
                    const data = await postAction(`/admin/content/${id}/reject`, token);
                    if (data.success) {
                        row.querySelector('[data-status]').textContent = 'Rejeté';
                        row.querySelector('[data-status]').className = 'content-status-badge status-archived';
                    }
                }
                if (e.target.classList.contains('action-delete')) {
                    if (!confirm('Supprimer définitivement ce contenu ?')) return;
                    const data = await postAction(`/admin/content/${id}/delete`, token);
                    if (data.success) {
                        row.remove();
                    }
                }
            });
        })();
    </script>
{% endblock %}
