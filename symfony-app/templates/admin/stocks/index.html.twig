{% extends 'back/base.html.twig' %}

{% block title %}Stocks{% endblock %}

{% block admin_content %}
<div class="admin-page-header">
    <div class="admin-page-title">
        <h1>Stocks</h1>
        <p>Quantités et prix par pharmacie avec filtres dynamiques.</p>
    </div>
</div>

<div class="admin-card" id="stocks">
    <div class="admin-page-title" style="margin-bottom:12px;">
        <h2>Gestion des stocks</h2>
        <p>Créer, modifier, supprimer.</p>
    </div>
    <div class="admin-actions-row" style="margin-bottom:12px;">
        <button class="btn btn-primary btn-sm admin-panel-toggle" data-target="stock-add">Ajouter</button>
        <button class="btn btn-secondary btn-sm admin-panel-toggle" data-target="stock-list">Liste</button>
    </div>
    <div class="admin-form form-row filters-inline filters-modern" style="margin-bottom: 10px;">
        <div class="filter-search filter-field">
            <label>Recherche</label>
            <i class="fas fa-search"></i>
            <input type="text" id="stockFilterText" placeholder="Pharmacie ou médicament">
        </div>
        <div class="filter-field">
            <label>Stock</label>
            <select id="stockFilterLevel">
                <option value="">Tous</option>
                <option value="low">Faible (≤5)</option>
                <option value="ok">Normal</option>
            </select>
        </div>
    </div>
    <div class="admin-panel is-active" id="stock-add">
        <div class="admin-panel-title">Ajouter un stock</div>
        <div class="admin-form form-row">
            <select id="adminStockPharmacy">
                <option value="">Pharmacie</option>
                {% for p in pharmacies %}
                    <option value="{{ p.id }}">{{ p.nom }}</option>
                {% endfor %}
            </select>
            <select id="adminStockMed">
                <option value="">Médicament</option>
                {% for m in medicaments %}
                    <option value="{{ m.id }}">{{ m.nom }}</option>
                {% endfor %}
            </select>
            <input type="number" id="adminStockQty" placeholder="Quantité">
            <input type="number" step="0.01" id="adminStockPrice" placeholder="Prix">
            <button class="btn btn-primary btn-sm" id="adminCreateStock" type="button">Créer</button>
        </div>
    </div>
    <div class="admin-panel" id="stock-edit">
        <div class="admin-panel-title">Mettre à jour un stock</div>
        <div class="admin-form form-row">
            <input type="hidden" id="adminStockEditId">
            <input type="number" id="adminStockEditQty" placeholder="Quantité">
            <input type="number" step="0.01" id="adminStockEditPrice" placeholder="Prix">
            <button class="btn btn-secondary btn-sm" id="adminUpdateStock" type="button">Enregistrer</button>
        </div>
    </div>
    <div class="admin-panel" id="stock-list">
        <div class="admin-panel-title">Liste des stocks</div>
        <div style="overflow-x:auto;">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th>Pharmacie</th>
                        <th>Médicament</th>
                        <th>Quantité</th>
                        <th>Prix</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody id="stockTable">
                {% for s in stocks %}
                    <tr class="stock-row" data-text="{{ (s.pharmecie.nom ~ ' ' ~ s.medicament.nom)|lower }}" data-level="{{ s.quantite <= 5 ? 'low' : 'ok' }}" data-id="{{ s.id }}">
                        <td>{{ s.pharmecie.nom }}</td>
                        <td>{{ s.medicament.nom }}</td>
                        <td><input type="number" class="admin-input" data-field="quantite" value="{{ s.quantite }}"></td>
                        <td><input type="number" step="0.01" class="admin-input" data-field="prix" value="{{ s.prixVente }}"></td>
                        <td>
                            <div class="admin-actions-row">
                                <button class="btn btn-secondary btn-xs admin-stock-edit" type="button">Modifier</button>
                                <button class="btn btn-danger btn-xs admin-stock-delete" type="button">Supprimer</button>
                            </div>
                        </td>
                    </tr>
                {% else %}
                    <tr><td colspan="5" style="text-align:center;">Aucun stock.</td></tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        (function () {
            const csrf = '{{ csrf_token('admin_pharmacy') }}';
            const loader = document.getElementById('globalLoader');
            const show = () => loader?.classList.add('show');
            const hide = () => loader?.classList.remove('show');
            const api = async (url, payload) => {
                show();
                try {
                    const res = await fetch(url, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json', 'X-CSRF-TOKEN': csrf },
                        body: JSON.stringify(payload || {}),
                    });
                    return res;
                } finally {
                    hide();
                }
            };

            const panels = document.querySelectorAll('.admin-panel');
            const panelToggles = document.querySelectorAll('.admin-panel-toggle');
            const openPanel = (id) => {
                panels.forEach((p) => p.classList.toggle('is-active', p.id === id));
                const target = document.getElementById(id);
                if (target) target.scrollIntoView({ behavior: 'smooth', block: 'start' });
            };
            panelToggles.forEach((btn) => btn.addEventListener('click', () => openPanel(btn.dataset.target)));

            const filterRows = (rows, predicate) => {
                rows.forEach((row) => row.style.display = predicate(row) ? '' : 'none');
            };

            const stockRows = Array.from(document.querySelectorAll('.stock-row'));
            const stockFilterText = document.getElementById('stockFilterText');
            const stockFilterLevel = document.getElementById('stockFilterLevel');
            const applyStockFilter = () => {
                const q = (stockFilterText.value || '').toLowerCase();
                const level = (stockFilterLevel.value || '').toLowerCase();
                filterRows(stockRows, (row) => {
                    const matchQ = !q || row.dataset.text.includes(q);
                    const matchLevel = !level || row.dataset.level === level;
                    return matchQ && matchLevel;
                });
            };
            stockFilterText.addEventListener('input', applyStockFilter);
            stockFilterLevel.addEventListener('change', applyStockFilter);

            document.getElementById('adminCreateStock')?.addEventListener('click', async () => {
                const payload = {
                    pharmacy_id: document.getElementById('adminStockPharmacy').value,
                    medicament_id: document.getElementById('adminStockMed').value,
                    quantite: document.getElementById('adminStockQty').value,
                    prix: document.getElementById('adminStockPrice').value,
                };
                await api('/admin/pharmacy/stocks', payload);
                location.reload();
            });

            document.getElementById('adminUpdateStock')?.addEventListener('click', async () => {
                const id = document.getElementById('adminStockEditId').value;
                if (!id) return;
                const payload = {
                    quantite: document.getElementById('adminStockEditQty').value,
                    prix: document.getElementById('adminStockEditPrice').value,
                };
                await api(`/admin/pharmacy/stocks/${id}`, payload);
                location.reload();
            });

            document.addEventListener('click', async (e) => {
                const row = e.target.closest('tr');
                if (!row) return;

                if (e.target.classList.contains('admin-stock-edit')) {
                    document.getElementById('adminStockEditId').value = row.dataset.id;
                    document.getElementById('adminStockEditQty').value = row.querySelector('[data-field="quantite"]').value;
                    document.getElementById('adminStockEditPrice').value = row.querySelector('[data-field="prix"]').value;
                    openPanel('stock-edit');
                }
                if (e.target.classList.contains('admin-stock-delete')) {
                    if (!confirm('Supprimer ce stock ?')) return;
                    await api(`/admin/pharmacy/stocks/${row.dataset.id}/delete`);
                    location.reload();
                }
            });
        })();
    </script>
{% endblock %}
