{% extends 'back/base.html.twig' %}

{% block title %}Statistiques utilisateurs{% endblock %}

{% block admin_content %}
<div class="admin-page-header">
    <div class="admin-page-title">
        <h1>Statistiques utilisateurs</h1>
        <p>Vue globale des comptes et de l'évolution des inscriptions.</p>
    </div>
    <div class="admin-actions-row">
        <a class="btn btn-secondary" href="{{ path('admin_users') }}">Retour</a>
    </div>
</div>

<div class="admin-grid cards-4">
    <div class="admin-card">
        <div class="admin-badge">Total</div>
        <h2>{{ stats.total }}</h2>
    </div>
    <div class="admin-card">
        <div class="admin-badge success">Actifs</div>
        <h2>{{ stats.active }}</h2>
    </div>
    <div class="admin-card">
        <div class="admin-badge warning">Bannis</div>
        <h2>{{ stats.banned }}</h2>
    </div>
    <div class="admin-card">
        <div class="admin-badge">Rôles</div>
        <h2>{{ stats.roles|length }}</h2>
    </div>
</div>

<div class="admin-card">
    <h3 style="margin-bottom: 12px;">Répartition par rôle</h3>
    <div style="display: grid; gap: 10px;">
        {% for row in stats.roles %}
            <div style="display: flex; justify-content: space-between; align-items: center;">
                <span>{{ row.role }}</span>
                <span class="admin-badge">{{ row.count }}</span>
            </div>
        {% endfor %}
    </div>
</div>

<div class="admin-card">
    <h3 style="margin-bottom: 12px;">Inscriptions (30 derniers jours)</h3>
    <canvas id="usersChart" height="110"></canvas>
</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        const ctx = document.getElementById('usersChart');
        if (ctx) {
            new Chart(ctx, {
                type: 'line',
                data: {
                    labels: {{ chart.labels|json_encode|raw }},
                    datasets: [{
                        label: 'Inscriptions',
                        data: {{ chart.data|json_encode|raw }},
                        borderColor: '#0ea5e9',
                        backgroundColor: 'rgba(14, 165, 233, 0.2)',
                        fill: true,
                        tension: 0.35
                    }]
                },
                options: {
                    responsive: true,
                    plugins: {
                        legend: { display: false }
                    },
                    scales: {
                        x: { grid: { display: false } },
                        y: { beginAtZero: true }
                    }
                }
            });
        }
    </script>
{% endblock %}
