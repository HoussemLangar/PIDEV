{% extends 'back/base.html.twig' %}

{% block title %}Médicaments{% endblock %}

{% block admin_content %}
<div class="admin-page-header">
    <div class="admin-page-title">
        <h1>Médicaments</h1>
        <p>Catalogue global avec CRUD complet et filtres dynamiques.</p>
    </div>
</div>

<div class="admin-card" id="medicaments">
    <div class="admin-page-title" style="margin-bottom:12px;">
        <h2>Gestion des médicaments</h2>
        <p>Créer, modifier, supprimer.</p>
    </div>
    <div class="admin-actions-row" style="margin-bottom:12px;">
        <button class="btn btn-primary btn-sm admin-panel-toggle" data-target="med-add">Ajouter</button>
        <button class="btn btn-secondary btn-sm admin-panel-toggle" data-target="med-list">Liste</button>
    </div>
    <div class="admin-form form-row filters-inline filters-modern" style="margin-bottom: 10px;">
        <div class="filter-search filter-field">
            <label>Recherche</label>
            <i class="fas fa-search"></i>
            <input type="text" id="medFilterName" placeholder="Nom ou code-barres">
        </div>
        <div class="filter-field">
            <label>Type</label>
            <input type="text" id="medFilterType" placeholder="Type">
        </div>
    </div>
    <div class="admin-panel is-active" id="med-add">
        <div class="admin-panel-title">Ajouter un médicament</div>
        <div class="admin-form form-row">
            <input type="text" id="adminMedName" placeholder="Nom">
            <input type="text" id="adminMedType" placeholder="Type">
            <input type="text" id="adminMedForme" placeholder="Forme">
            <input type="text" id="adminMedDosage" placeholder="Dosage">
            <input type="text" id="adminMedLab" placeholder="Laboratoire">
            <input type="text" id="adminMedCode" placeholder="Code-barres">
            <input type="number" step="0.01" id="adminMedPrice" placeholder="Prix">
            <button class="btn btn-primary btn-sm" id="adminCreateMed" type="button">Créer</button>
        </div>
    </div>
    <div class="admin-panel" id="med-edit">
        <div class="admin-panel-title">Mettre à jour un médicament</div>
        <div class="admin-form form-row">
            <input type="hidden" id="adminMedEditId">
            <input type="text" id="adminMedEditName" placeholder="Nom">
            <input type="text" id="adminMedEditType" placeholder="Type">
            <input type="text" id="adminMedEditForme" placeholder="Forme">
            <input type="text" id="adminMedEditDosage" placeholder="Dosage">
            <input type="text" id="adminMedEditLab" placeholder="Laboratoire">
            <input type="text" id="adminMedEditCode" placeholder="Code-barres">
            <input type="number" step="0.01" id="adminMedEditPrice" placeholder="Prix">
            <button class="btn btn-secondary btn-sm" id="adminUpdateMed" type="button">Enregistrer</button>
        </div>
    </div>
    <div class="admin-panel" id="med-list">
        <div class="admin-panel-title">Liste des médicaments</div>
        <div style="overflow-x:auto;">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th>Nom</th>
                        <th>Type</th>
                        <th>Forme/Dosage</th>
                        <th>Laboratoire</th>
                        <th>Code</th>
                        <th>Prix</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody id="medTable">
                {% for m in medicaments %}
                    <tr class="med-row" data-name="{{ m.nom|lower }}" data-type="{{ (m.type ?? '')|lower }}" data-code="{{ (m.codeBarre ?? '')|lower }}" data-id="{{ m.id }}">
                        <td><input type="text" class="admin-input" data-field="nom" value="{{ m.nom }}"></td>
                        <td><input type="text" class="admin-input" data-field="type" value="{{ m.type }}"></td>
                        <td>
                            <input type="text" class="admin-input" data-field="forme" value="{{ m.forme }}">
                            <input type="text" class="admin-input" data-field="dosage" value="{{ m.dosage }}">
                        </td>
                        <td><input type="text" class="admin-input" data-field="laboratoire" value="{{ m.laboratoire }}"></td>
                        <td><input type="text" class="admin-input" data-field="code_barre" value="{{ m.codeBarre }}"></td>
                        <td><input type="number" step="0.01" class="admin-input" data-field="prix" value="{{ m.prix }}"></td>
                        <td>
                            <div class="admin-actions-row">
                                <button class="btn btn-secondary btn-xs admin-med-edit" type="button">Modifier</button>
                                <button class="btn btn-danger btn-xs admin-med-delete" type="button">Supprimer</button>
                            </div>
                        </td>
                    </tr>
                {% else %}
                    <tr><td colspan="7" style="text-align:center;">Aucun médicament.</td></tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        (function () {
            const csrf = '{{ csrf_token('admin_pharmacy') }}';
            const loader = document.getElementById('globalLoader');
            const show = () => loader?.classList.add('show');
            const hide = () => loader?.classList.remove('show');
            const api = async (url, payload) => {
                show();
                try {
                    const res = await fetch(url, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json', 'X-CSRF-TOKEN': csrf },
                        body: JSON.stringify(payload || {}),
                    });
                    return res;
                } finally {
                    hide();
                }
            };

            const panels = document.querySelectorAll('.admin-panel');
            const panelToggles = document.querySelectorAll('.admin-panel-toggle');
            const openPanel = (id) => {
                panels.forEach((p) => p.classList.toggle('is-active', p.id === id));
                const target = document.getElementById(id);
                if (target) target.scrollIntoView({ behavior: 'smooth', block: 'start' });
            };
            panelToggles.forEach((btn) => btn.addEventListener('click', () => openPanel(btn.dataset.target)));

            const filterRows = (rows, predicate) => {
                rows.forEach((row) => row.style.display = predicate(row) ? '' : 'none');
            };

            const medRows = Array.from(document.querySelectorAll('.med-row'));
            const medFilterName = document.getElementById('medFilterName');
            const medFilterType = document.getElementById('medFilterType');
            const applyMedFilter = () => {
                const q = (medFilterName.value || '').toLowerCase();
                const type = (medFilterType.value || '').toLowerCase();
                filterRows(medRows, (row) => {
                    const matchQ = !q || row.dataset.name.includes(q) || row.dataset.code.includes(q);
                    const matchType = !type || row.dataset.type.includes(type);
                    return matchQ && matchType;
                });
            };
            medFilterName.addEventListener('input', applyMedFilter);
            medFilterType.addEventListener('input', applyMedFilter);

            document.getElementById('adminCreateMed')?.addEventListener('click', async () => {
                const payload = {
                    nom: document.getElementById('adminMedName').value,
                    type: document.getElementById('adminMedType').value,
                    forme: document.getElementById('adminMedForme').value,
                    dosage: document.getElementById('adminMedDosage').value,
                    laboratoire: document.getElementById('adminMedLab').value,
                    code_barre: document.getElementById('adminMedCode').value,
                    prix: document.getElementById('adminMedPrice').value,
                };
                await api('/admin/pharmacy/medicaments', payload);
                location.reload();
            });

            document.getElementById('adminUpdateMed')?.addEventListener('click', async () => {
                const id = document.getElementById('adminMedEditId').value;
                if (!id) return;
                const payload = {
                    nom: document.getElementById('adminMedEditName').value,
                    type: document.getElementById('adminMedEditType').value,
                    forme: document.getElementById('adminMedEditForme').value,
                    dosage: document.getElementById('adminMedEditDosage').value,
                    laboratoire: document.getElementById('adminMedEditLab').value,
                    code_barre: document.getElementById('adminMedEditCode').value,
                    prix: document.getElementById('adminMedEditPrice').value,
                };
                await api(`/admin/pharmacy/medicaments/${id}`, payload);
                location.reload();
            });

            document.addEventListener('click', async (e) => {
                const row = e.target.closest('tr');
                if (!row) return;

                if (e.target.classList.contains('admin-med-edit')) {
                    document.getElementById('adminMedEditId').value = row.dataset.id;
                    document.getElementById('adminMedEditName').value = row.querySelector('[data-field="nom"]').value;
                    document.getElementById('adminMedEditType').value = row.querySelector('[data-field="type"]').value;
                    document.getElementById('adminMedEditForme').value = row.querySelector('[data-field="forme"]').value;
                    document.getElementById('adminMedEditDosage').value = row.querySelector('[data-field="dosage"]').value;
                    document.getElementById('adminMedEditLab').value = row.querySelector('[data-field="laboratoire"]').value;
                    document.getElementById('adminMedEditCode').value = row.querySelector('[data-field="code_barre"]').value;
                    document.getElementById('adminMedEditPrice').value = row.querySelector('[data-field="prix"]').value;
                    openPanel('med-edit');
                }
                if (e.target.classList.contains('admin-med-delete')) {
                    if (!confirm('Supprimer ce médicament ?')) return;
                    await api(`/admin/pharmacy/medicaments/${row.dataset.id}/delete`);
                    location.reload();
                }
            });
        })();
    </script>
{% endblock %}
