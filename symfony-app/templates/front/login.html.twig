{% extends 'front/base_auth.html.twig' %}

{% block title %}Connexion - SANTÉA{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        /* =========================================================
           LOGIN: form sizing
        ========================================================= */
        #signInForm.auth-form {
            max-width: 460px;
            width: 100%;
            animation: fadeInUp 0.55s ease-out;
        }

        /* =========================================================
           TOP ACTIONS
        ========================================================= */
        .auth-top-actions {
            display: flex;
            justify-content: flex-end;
            margin-bottom: 18px;
        }

        .auth-home-btn {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            padding: 9px 16px;
            border: 1.5px solid #e2e8f0;
            border-radius: 10px;
            background: #f8fafc;
            color: #374151;
            font-size: 13px;
            font-weight: 600;
            text-decoration: none;
            transition: all 0.2s ease;
        }
        .auth-home-btn:hover {
            background: #e0e7ff;
            border-color: #6366f1;
            color: #4f46e5;
            transform: translateY(-1px);
        }
        .auth-home-btn i { font-size: 13px; }

        /* =========================================================
           TITLE
        ========================================================= */
        #signInForm h1 {
            font-size: 1.75rem !important;
            margin-bottom: 6px !important;
            display: flex;
            align-items: center;
            gap: 10px;
        }
        #signInForm h1 .title-icon {
            width: 42px; height: 42px;
            background: linear-gradient(135deg, #3b82f6, #6366f1);
            border-radius: 12px;
            display: flex; align-items: center; justify-content: center;
            color: #fff;
            font-size: 18px;
            flex-shrink: 0;
            box-shadow: 0 4px 12px rgba(99,102,241,.25);
        }
        #signInForm .subtitle {
            font-size: 13px;
            color: #6b7280;
            margin-bottom: 22px;
            margin-top: 0;
        }

        /* =========================================================
           FORM CARD
        ========================================================= */
        .login-card {
            background: #f9fafb;
            border: 1.5px solid #e5e7eb;
            border-radius: 16px;
            padding: 24px 22px 20px;
            display: flex;
            flex-direction: column;
            gap: 16px;
            margin-bottom: 18px;
            transition: border-color 0.2s;
        }
        .login-card:focus-within {
            border-color: #6366f1;
            box-shadow: 0 0 0 3px rgba(99,102,241,.06);
        }

        .card-header {
            display: flex;
            align-items: center;
            gap: 10px;
            padding-bottom: 14px;
            border-bottom: 1.5px solid #e5e7eb;
        }
        .card-header__icon {
            width: 34px; height: 34px;
            border-radius: 10px;
            background: #eef2ff;
            color: #6366f1;
            display: flex; align-items: center; justify-content: center;
            font-size: 15px;
            flex-shrink: 0;
        }
        .card-header__title {
            font-size: 13px;
            font-weight: 700;
            color: #374151;
        }
        .card-header__sub {
            font-size: 11px;
            color: #9ca3af;
        }

        /* =========================================================
           FORM FIELDS
        ========================================================= */
        .form-group {
            display: flex;
            flex-direction: column;
            gap: 5px;
            margin-bottom: 0;
        }

        .form-group label {
            font-size: 12px;
            font-weight: 600;
            color: #374151;
            display: flex;
            align-items: center;
            gap: 5px;
        }
        .form-group label .field-icon {
            color: #9ca3af;
            font-size: 11px;
        }

        .input-wrapper {
            position: relative;
        }
        .input-wrapper .input-icon {
            position: absolute;
            left: 12px;
            top: 50%;
            transform: translateY(-50%);
            color: #9ca3af;
            font-size: 13px;
            pointer-events: none;
            transition: color 0.2s;
            z-index: 1;
        }
        .input-wrapper:focus-within .input-icon { color: #6366f1; }

        .login-card input[type="email"],
        .login-card input[type="text"],
        .login-card input[type="password"] {
            width: 100%;
            padding: 11px 12px 11px 36px;
            border: 1.5px solid #d1d5db;
            border-radius: 10px;
            font-size: 13.5px;
            color: #111827;
            background: #fff;
            outline: none;
            box-sizing: border-box;
            transition: border-color 0.2s, box-shadow 0.2s;
        }
        .login-card input:focus {
            border-color: #6366f1;
            box-shadow: 0 0 0 3px rgba(99,102,241,.1);
        }

        /* Password toggle */
        .password-input {
            position: relative;
        }
        .password-input input {
            padding-right: 38px !important;
        }
        .toggle-password {
            position: absolute;
            right: 12px;
            top: 50%;
            transform: translateY(-50%);
            cursor: pointer;
            color: #9ca3af;
            font-size: 13px;
            transition: color 0.2s;
        }
        .toggle-password:hover { color: #6366f1; }

        /* =========================================================
           OPTIONS ROW (remember + forgot)
        ========================================================= */
        .form-options {
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 8px;
        }
        .remember-me {
            display: flex;
            align-items: center;
            gap: 7px;
            font-size: 12.5px;
            color: #374151;
            cursor: pointer;
            font-weight: 500;
        }
        .remember-me input[type="checkbox"] {
            width: 15px; height: 15px;
            accent-color: #6366f1;
            cursor: pointer;
        }
        .forgot-password {
            font-size: 12.5px;
            color: #6366f1;
            font-weight: 600;
            text-decoration: none;
            transition: color 0.2s;
        }
        .forgot-password:hover { color: #4f46e5; text-decoration: underline; }

        /* =========================================================
           SUBMIT BUTTON
        ========================================================= */
        .login-submit {
            background: linear-gradient(135deg, #4f46e5 0%, #6366f1 100%);
            color: #fff;
            border: none;
            border-radius: 12px;
            padding: 13px 30px;
            font-size: 14.5px;
            font-weight: 700;
            cursor: pointer;
            width: 100%;
            letter-spacing: .02em;
            transition: all 0.25s ease;
            box-shadow: 0 4px 16px rgba(99,102,241,.3);
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            margin-top: 4px;
        }
        .login-submit:hover {
            background: linear-gradient(135deg, #4338ca 0%, #4f46e5 100%);
            transform: translateY(-2px);
            box-shadow: 0 8px 24px rgba(99,102,241,.35);
        }
        .login-submit:active { transform: translateY(0); }

        /* =========================================================
           ALERT OVERRIDES
        ========================================================= */
        .alert {
            border-radius: 10px;
            padding: 11px 14px;
            font-size: 13px;
            display: flex;
            align-items: flex-start;
            gap: 8px;
            position: relative;
        }
        .alert-danger  { background: #fff1f2; border: 1.5px solid #fecaca; color: #b91c1c; }
        .alert-success { background: #f0fdf4; border: 1.5px solid #a7f3d0; color: #065f46; }
        .alert::before {
            font-family: 'Font Awesome 6 Free';
            font-weight: 900;
            font-size: 14px;
            flex-shrink: 0;
        }
        .alert-danger::before  { content: '\f071'; }
        .alert-success::before { content: '\f058'; }

        .close-alert {
            position: absolute;
            right: 10px; top: 8px;
            background: none; border: none;
            font-size: 16px; cursor: pointer;
            color: inherit; opacity: 0.6;
            line-height: 1;
        }
        .close-alert:hover { opacity: 1; }
    </style>
{% endblock %}

{% block auth_content %}
    <div class="auth-form" id="signInForm">

        {# ── Top action ── #}
        <div class="auth-top-actions">
            <a href="{{ path('app_home') }}" class="auth-home-btn">
                <i class="fas fa-home"></i> Accueil
            </a>
        </div>

        {# ── Title ── #}
        <h1>
            <span class="title-icon"><i class="fas fa-sign-in-alt"></i></span>
            Se Connecter
        </h1>
        <p class="subtitle">Bon retour ! Connectez-vous à votre espace SANTÉA.</p>

        {# ── Social login ── #}
        <div class="social-buttons">
            <a href="{{ path('connect_google_start') }}" class="social-btn google-btn">
                <i class="fab fa-google"></i> Se connecter avec Google
            </a>
            <a href="{{ path('connect_facebook_start') }}" class="social-btn facebook-btn">
                <i class="fab fa-facebook-f"></i> Se connecter avec Facebook
            </a>
        </div>

        <div class="divider"><span>OU</span></div>

        {# ── Alerts ── #}
        {% if error %}
            <div class="alert alert-danger">
                {{ error.messageKey|trans(error.messageData, 'security') }}
            </div>
        {% endif %}
        {% for message in app.flashes('success') %}
            <div class="alert alert-success">{{ message }}</div>
        {% endfor %}

        {# ── Login form card ── #}
        <form method="post" action="{{ path('login') }}">

            <div class="login-card">
                <div class="card-header">
                    <span class="card-header__icon"><i class="fas fa-shield-alt"></i></span>
                    <div>
                        <div class="card-header__title">Vos identifiants</div>
                        <div class="card-header__sub">Email et mot de passe de votre compte</div>
                    </div>
                </div>

                {# EMAIL #}
                <div class="form-group">
                    <label for="username">
                        <i class="fas fa-envelope field-icon"></i>
                        Adresse email&nbsp;<span style="color:#ef4444">*</span>
                    </label>
                    <div class="input-wrapper">
                        <i class="fas fa-envelope input-icon"></i>
                        <input type="email"
                               id="username"
                               name="_username"
                               value="{{ last_username }}"
                               placeholder="exemple@email.com"
                               required
                               autofocus>
                    </div>
                </div>

                {# PASSWORD #}
                <div class="form-group">
                    <label for="password">
                        <i class="fas fa-lock field-icon"></i>
                        Mot de passe&nbsp;<span style="color:#ef4444">*</span>
                    </label>
                    <div class="password-input input-wrapper">
                        <i class="fas fa-lock input-icon"></i>
                        <input type="password"
                               id="password"
                               name="_password"
                               placeholder="••••••••"
                               required>
                        <i class="fas fa-eye-slash toggle-password" onclick="togglePassword('password')"></i>
                    </div>
                </div>

                {# OPTIONS #}
                <div class="form-options">
                    <label class="remember-me">
                        <input type="checkbox" name="_remember_me">
                        Se souvenir de moi
                    </label>
                    <a href="{{ path('app_forgot_password') }}" class="forgot-password">
                        <i class="fas fa-key" style="font-size:11px;"></i> Mot de passe oublié ?
                    </a>
                </div>
            </div>

            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

            <button type="submit" class="login-submit">
                <i class="fas fa-sign-in-alt"></i>
                Se Connecter
            </button>
        </form>

        <p class="auth-switch" style="text-align:center; margin-top:18px;">
            Vous n'avez pas de compte ?
            <a href="{{ path('app_register') }}" style="color:#6366f1; font-weight:700;">Créer un compte</a>
        </p>

    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        function togglePassword(inputId) {
            const input = document.getElementById(inputId);
            const icon  = event.target;
            if (!input) return;
            if (input.type === 'password') {
                input.type = 'text';
                icon.classList.replace('fa-eye-slash', 'fa-eye');
            } else {
                input.type = 'password';
                icon.classList.replace('fa-eye', 'fa-eye-slash');
            }
        }

        document.addEventListener('DOMContentLoaded', function () {
            const alerts = document.querySelectorAll('.alert');

            alerts.forEach(function (alert) {
                if (!alert.querySelector('.close-alert')) {
                    const btn = document.createElement('button');
                    btn.className = 'close-alert';
                    btn.innerHTML = '×';
                    btn.setAttribute('aria-label', 'Fermer');
                    btn.addEventListener('click', function () {
                        alert.style.transition = 'opacity 0.3s';
                        alert.style.opacity    = '0';
                        setTimeout(() => alert.remove(), 300);
                    });
                    alert.appendChild(btn);
                }

                if (alert.classList.contains('alert-success')) {
                    setTimeout(() => {
                        if (alert.parentElement) {
                            alert.style.transition = 'opacity 0.3s';
                            alert.style.opacity    = '0';
                            setTimeout(() => alert.remove(), 300);
                        }
                    }, 5000);
                }
            });
        });
    </script>
{% endblock %}