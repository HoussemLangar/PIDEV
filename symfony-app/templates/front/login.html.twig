{% extends 'front/base_auth.html.twig' %}

{% block title %}Connexion - SANTÉA{% endblock %}

{% block auth_content %}
    <div class="auth-form" id="signInForm">
        <h1>Se Connecter</h1>
        
        <div class="social-buttons">
            <button class="social-btn google-btn">
                <i class="fab fa-google"></i>
                Se connecter avec Google
            </button>
            <button class="social-btn facebook-btn">
                <i class="fab fa-facebook-f"></i>
                Se connecter avec Facebook
            </button>
        </div>

        <div class="divider">
            <span>OU</span>
        </div>

        {% if error %}
            <div class="alert alert-danger">
                {{ error.messageKey|trans(error.messageData, 'security') }}
            </div>
        {% endif %}

        {% for message in app.flashes('success') %}
            <div class="alert alert-success">
                {{ message }}
            </div>
        {% endfor %}

        <form method="post" action="{{ path('login') }}">
            <div class="form-group">
                <label for="username">Email:</label>
                <input type="email" 
                       id="username" 
                       name="_username" 
                       value="{{ last_username }}" 
                       placeholder="Entrez votre email" 
                       required 
                       autofocus>
            </div>

            <div class="form-group">
                <label for="password">Mot de passe:</label>
                <div class="password-input">
                    <input type="password" 
                           id="password" 
                           name="_password" 
                           placeholder="Entrez votre mot de passe" 
                           required>
                    <i class="fas fa-eye-slash toggle-password" onclick="togglePassword('password')"></i>
                </div>
            </div>

            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

            <div class="form-options">
                <label class="remember-me">
                    <input type="checkbox" name="_remember_me"> Se souvenir de moi
                </label>
                <a href="{{ path('app_forgot_password') }}" class="forgot-password">Mot de passe oublié?</a>
            </div>

            <button type="submit" class="auth-submit-btn">Se Connecter</button>
        </form>

        <p class="auth-switch">
            Vous n'avez pas de compte? <a href="{{ path('app_register') }}">Créer un compte</a>
        </p>
    </div>
{% endblock %}
