{% extends 'base.html.twig' %}

{% block title %}Tracker Santé - SANTÉA{% endblock %}

{% block body %}
    <main class="health-tracker-page-v2">
        <!-- Sidebar (inchangée) -->
        <aside class="health-sidebar">
            <div class="sidebar-logo">
                <i class="fas fa-heart-pulse"></i>
                <span>Ma Santé</span>
            </div>
            <nav class="sidebar-nav">
                <a href="{{ path('app_sante_quotidienne_index') }}" class="sidebar-link active">
                    <i class="fas fa-book-medical"></i>
                    <span>Mon journal santé</span>
                </a>
                <a href="#" class="sidebar-link">
                    <i class="fas fa-stethoscope"></i>
                    <span>Mes symptômes</span>
                </a>
                <a href="#" class="sidebar-link">
                    <i class="fas fa-calendar-days"></i>
                    <span>Mon historique</span>
                </a>
            </nav>
        </aside>

        <div class="container-wide">
            <!-- Header animé (inchangé) -->
            <div class="page-header-animated">
                <div class="header-content">
                    <div class="title-with-emoji">
                        <span class="emoji-float">💪</span>
                        <div>
                            <h1>Mon Journal Santé</h1>
                            <p>Prenez soin de vous jour après jour</p>
                        </div>
                    </div>
                    <button class="btn-add-fun" id="btn-quick-add">
                        <span class="btn-icon">✨</span>
                        <span>Ajouter aujourd'hui</span>
                    </button>
                </div>
            </div>

            <!-- Résumé rapide (tu pourras le remplir avec Twig plus tard) -->
            <div class="summary-cards">
                <div class="summary-card card-pulse">
                    <div class="card-emoji">⚖️</div>
                    <div class="card-info">
                        <span class="card-label">Mon Poids</span>
                        <span class="card-value" id="current-weight">--</span>
                        <span class="card-unit">kg</span>
                    </div>
                </div>
                <!-- Les autres cards restent identiques -->
            </div>

            <!-- Contenu principal en 2 colonnes -->
            <div class="main-content-grid">
                <!-- Colonne gauche - Formulaire -->
                <div class="form-section-beautiful" id="form-section">
                    <div class="form-card-beautiful">
                        <div class="form-header-beautiful">
                            <h2>📝 Comment allez-vous aujourd'hui ?</h2>
                        </div>

                        {# Formulaire Symfony intégré ici #}
                        {{ form_start(form, {'attr': {'novalidate': 'novalidate', 'id': 'health-form', 'class': 'form-beautiful'}}) }}

                        <div class="form-group-beautiful">
                            {{ form_label(form.date, "📅 Date", {'label_attr': {'class': 'form-label'}}) }}
                            {{ form_widget(form.date, {'attr': {'class': 'form-control', 'id': 'date'}}) }}
                            {{ form_errors(form.date) }}
                        </div>

                        <div class="form-group-beautiful">
                            {{ form_label(form.poids, "⚖️ Poids (kg)", {'label_attr': {'class': 'form-label'}}) }}
                            {{ form_widget(form.poids, {'attr': {'class': 'form-control', 'id': 'poids', 'placeholder': 'Ex: 70.5'}}) }}
                            {{ form_errors(form.poids) }}
                        </div>

                        <div class="form-group-beautiful">
                            {{ form_label(form.taille, "📏 Taille (cm)", {'label_attr': {'class': 'form-label'}}) }}
                            {{ form_widget(form.taille, {'attr': {'class': 'form-control', 'id': 'taille', 'placeholder': 'Ex: 175'}}) }}
                            {{ form_errors(form.taille) }}
                        </div>

                        <div class="imc-display" id="imc-display" style="display: none;">
                            <div class="imc-emoji" id="imc-emoji">📊</div>
                            <div class="imc-text">
                                <span class="imc-label">Votre IMC</span>
                                <span class="imc-value" id="imc-value">--</span>
                                <span class="imc-status" id="imc-status">--</span>
                            </div>
                        </div>

                        <div class="form-group-beautiful">
                            {{ form_label(form.tensionArterielle, "❤️ Tension (optionnel)", {'label_attr': {'class': 'form-label'}}) }}
                            {{ form_widget(form.tensionArterielle, {'attr': {'class': 'form-control', 'id': 'tension_arterielle', 'placeholder': 'Ex: 120/80'}}) }}
                            {{ form_errors(form.tensionArterielle) }}
                        </div>

                        <div class="form-row-beautiful">
                            <div class="form-group-beautiful">
                                {{ form_label(form.sommeil, "😴 Sommeil (h)", {'label_attr': {'class': 'form-label'}}) }}
                                {{ form_widget(form.sommeil, {'attr': {'class': 'form-control', 'id': 'sommeil', 'placeholder': '8'}}) }}
                                {{ form_errors(form.sommeil) }}
                            </div>
                            <div class="form-group-beautiful">
                                {{ form_label(form.activitePhysique, "🏃 Sport (min)", {'label_attr': {'class': 'form-label'}}) }}
                                {{ form_widget(form.activitePhysique, {'attr': {'class': 'form-control', 'id': 'activite_physique', 'placeholder': '30'}}) }}
                                {{ form_errors(form.activitePhysique) }}
                            </div>
                        </div>

                        <div class="form-group-beautiful">
                            {{ form_label(form.humeur, "😊 Comment vous sentez-vous ?", {'label_attr': {'class': 'form-label'}}) }}
                            <div class="mood-buttons">
                                {{ form_widget(form.humeur) }}  {# Twig affiche les checkboxes #}
                            </div>
                            {{ form_errors(form.humeur) }}
                        </div>

                        <div class="form-group-beautiful">
                            {{ form_label(form.alimentation, "🍎 Alimentation", {'label_attr': {'class': 'form-label'}}) }}
                            {{ form_widget(form.alimentation, {'attr': {'class': 'form-select', 'id': 'alimentation'}}) }}
                            {{ form_errors(form.alimentation) }}
                        </div>

                        <div class="form-group-beautiful">
                            {{ form_label(form.eauBue, "💧 Eau bue (litres)", {'label_attr': {'class': 'form-label'}}) }}
                            {{ form_widget(form.eauBue, {'attr': {'class': 'form-control', 'id': 'eau_bue', 'placeholder': '2.0'}}) }}
                            {{ form_errors(form.eauBue) }}
                        </div>

                        <button type="submit" class="btn-save-beautiful">
                            <span>💾</span>
                            <span>Enregistrer ma journée</span>
                        </button>

                        {{ form_end(form) }}
                    </div>
                </div>

                {# Le reste de ton page (graph, historique, conseils) reste inchangé #}
                <!-- Colonne droite - Historique & Stats -->
                <div class="history-section-beautiful">
                    <!-- Graphique simple -->
                    <div class="chart-beautiful">
                        <h3>📈 Évolution de mon poids</h3>
                        <canvas id="chart-weight" height="200"></canvas>
                    </div>

                    <!-- Mes dernières entrées -->
                    <div class="recent-entries-beautiful">
                        <div class="section-header-beautiful">
                            <h3>📔 Mes dernières journées</h3>
                            <button class="btn-view-all" id="btn-view-all">Voir tout</button>
                        </div>
                        <div class="entries-list" id="entries-list">
                            <div class="empty-state">
                                <!-- emoji supprimé -->
                                <p>Commencez votre journal santé<br>en ajoutant votre première journée !</p>
                            </div>
                        </div>
                    </div>

                    <!-- Conseils du jour -->
                    <div class="tips-beautiful" id="tips-section">
                        <h3>💡 Conseil du jour</h3>
                        <div class="tip-card" id="tip-content">
                            <p>🌟 Buvez un grand verre d'eau au réveil pour bien commencer la journée !</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </main>

    {# Modal historique (inchangé, ton JS le gère) #}
    <div class="modal-modern" id="history-modal">
        <!-- ... ton modal reste identique ... -->
    </div>

    {# Toast (inchangé) #}
    <div class="toast-container" id="toast-container"></div>

    {# Footer (inchangé) #}
    <footer>
        <div class="container">
            <p>2026 SANTÉA - All Rights Reserved</p>
        </div>
    </footer>
{% endblock %}