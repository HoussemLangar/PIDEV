{% extends 'front/base.html.twig' %}

{% block title %}Mes Symptômes - SANTÉA{% endblock %}

{% block stylesheets %}
  {{ parent() }}
  <link rel="stylesheet" href="{{ asset('assets/css/santet.css') }}"/>
{% endblock %}

{% block body %}
  <main class="health-tracker-page-v2">
    
    <section class="content-page">
    <div class="container-wide">
      
      <section class="content-hero" style="padding-bottom: 28px; margin-bottom: 24px;">
        <div class="content-header">
          <div>
            <div class="profile-badge">Tracker Santé</div>
            <h1>Mes Symptômes</h1>
            <p>Suivez et gérez vos symptômes au quotidien.</p>
          </div>
          <div style="display:flex; gap:10px; flex-wrap:wrap; align-items:center;">
            <a href="{{ path('app_sante_quotidienne_index') }}" class="btn btn-secondary">
              <i class="fas fa-heartbeat"></i> Mon Journal Santé
            </a>
          </div>
        </div>
      </section>

      <!-- Messages flash -->
      {% for type, messages in app.flashes %}
        {% for message in messages %}
          <div class="alert alert-{{ type }} flash-message-auto" id="flash-{{ loop.parent.loop.index0 }}-{{ loop.index0 }}">
            {{ message }}
          </div>
        {% endfor %}
      {% endfor %}

      <!-- Contenu principal en 2 colonnes -->
      <div class="main-content-grid">
        
        <!-- Colonne gauche - Formulaire symptômes -->
        <div class="form-section-beautiful">
          <div class="form-card-beautiful">
          <div class="form-header-beautiful">
            <h2>📋 Ajouter un symptôme</h2>
          </div>
          
          {{ form_start(form, {
            'attr': {
              'class': 'form-beautiful',
              'id': 'symptom-form',
              'locale': 'fr',
              'novalidate': 'novalidate'
            }
          }) }}

            <div class="form-group-beautiful">
              {{ form_label(form.dateSymptome) }}
              {{ form_widget(form.dateSymptome, {
                'attr': {
                  'class': 'form-control'
                }
              }) }}
              {{ form_errors(form.dateSymptome) }}
            </div>

            <div class="form-group-beautiful">
              {{ form_label(form.categorie) }}
              {{ form_widget(form.categorie, {
                'attr': {
                  'class': 'form-control'
                }
              }) }}
              {{ form_errors(form.categorie) }}
            </div>

            <div class="form-group-beautiful">
              {{ form_label(form.symptome) }}
              {{ form_widget(form.symptome, {
                'attr': {
                  'class': 'form-control'
                }
              }) }}
              {{ form_errors(form.symptome) }}
            </div>

            <div class="form-group-beautiful">
              {{ form_label(form.intensite) }}
              <div class="intensity-selector">
                {{ form_widget(form.intensite, {
                  'attr': {
                    'class': 'intensity-slider'
                  }
                }) }}
                <span class="intensity-value" id="intensity-display">5</span>
              </div>
              {{ form_errors(form.intensite) }}
            </div>

            <div class="form-group-beautiful">
              {{ form_label(form.duree) }}
              {{ form_widget(form.duree, {
                'attr': {
                  'class': 'form-control',
                  'placeholder': 'Ex: 30 minutes, 2 heures...'
                }
              }) }}
              {{ form_errors(form.duree) }}
            </div>

            <div class="form-group-beautiful">
              {{ form_label(form.notes) }}
              {{ form_widget(form.notes, {
                'attr': {
                  'class': 'form-control',
                  'rows': 3
                }
              }) }}
              {{ form_errors(form.notes) }}
            </div>

            <div style="display: flex; gap: 10px; margin-top: 8px;">
              <button type="button" class="btn-cancel-form" onclick="clearForm()">
                <i class="fas fa-times"></i> Annuler
              </button>
              {{ form_widget(form.submit, {'attr': {'class': 'btn-save-beautiful'}}) }}
            </div>

          {{ form_end(form) }}
          </div>
        </div>

        <!-- Colonne droite - Calendrier des Symptômes -->
        <div class="history-section-beautiful">
          
          <!-- Calendrier des Symptômes -->
          <div class="chart-beautiful">
            <div class="feature-header">
              <i class="fas fa-calendar-alt feature-icon"></i>
              <h3>📅 Calendrier des Symptômes</h3>
            </div>
            <div id="symptom-calendar" class="calendar-container">
              <!-- Le calendrier sera généré ici -->
            </div>
          </div>

          <!-- Détails des symptômes sélectionnés -->
          <div id="symptom-details" class="chart-beautiful" style="display: none;">
            <div class="feature-header">
              <i class="fas fa-info-circle feature-icon"></i>
              <h3 id="details-title">📊 Détails des symptômes</h3>
            </div>
            <div id="symptom-details-content">
              <!-- Les détails seront chargés ici -->
            </div>
          </div>

        </div>
      </div>

      <!-- Section Statistiques et Export -->
      <div class="stats-export-section">
        
        <!-- Statistiques des symptômes -->
        <div class="chart-beautiful" style="margin-bottom: 20px;">
          <div class="feature-header">
            <i class="fas fa-chart-pie feature-icon"></i>
            <h3>📊 Mes symptômes les plus courants</h3>
          </div>
          <div class="symptoms-stats-grid">
            {% if top_symptoms is defined and top_symptoms|length > 0 %}
              {% for stat in top_symptoms %}
                <div class="symptom-stat-circle">
                  <div class="circle-progress-wrapper">
                    <svg class="progress-ring" width="120" height="120">
                      <circle class="progress-ring-circle-bg" stroke="#e9ecef" stroke-width="8" fill="transparent" r="52" cx="60" cy="60"/>
                      <circle class="progress-ring-circle" stroke="#3b82f6" stroke-width="8" fill="transparent" r="52" cx="60" cy="60"
                              style="stroke-dasharray: {{ 2 * 3.14159 * 52 }}; stroke-dashoffset: {{ 2 * 3.14159 * 52 * (1 - stat.count / top_symptoms[0].count) }};"/>
                    </svg>
                    <div class="circle-center">
                      <span class="circle-count">{{ stat.count }}</span>
                      <span class="circle-label">fois</span>
                    </div>
                  </div>
                  <div class="circle-info">
                    <h4 class="symptom-name">{{ stat.symptome_nom }}</h4>
                    <div class="stat-category">
                      <i class="fas fa-tag"></i> {{ stat.categorie_nom }}
                    </div>
                    <div class="stat-details">
                      <i class="fas fa-thermometer-half"></i>
                      Intensité: <strong>{{ stat.avg_intensite|number_format(1) }}/10</strong>
                    </div>
                  </div>
                </div>
              {% endfor %}
            {% else %}
              <div class="no-stats">
                <i class="fas fa-chart-line" style="font-size: 3rem; color: #ccc; margin-bottom: 15px;"></i>
                <p>Aucune donnée disponible pour le moment.<br>Ajoutez quelques symptômes pour voir vos statistiques !</p>
              </div>
            {% endif %}
          </div>
        </div>

        

      </div>
    </div>
    </section>
  </main>

  <!-- Modal d'édition -->
  <div id="edit-modal" class="modal-overlay" style="display: none;">
    <div class="modal-content">
      <div class="modal-header">
        <h3 class="modal-title">✏️ Modifier le symptôme</h3>
        <button class="modal-close" onclick="closeEditModal()">&times;</button>
      </div>
      <div class="modal-body">
      <div id="edit-form-error" class="field-error" style="display:none;"></div>
      <form id="edit-form" class="modal-form" novalidate onsubmit="return false;" data-ajax="1">
        <input type="hidden" id="edit-symptom-id">
        <div class="form-group">
          <label for="edit-intensite">Intensité (1-10):</label>
          <input type="range" id="edit-intensite" min="1" max="10" value="5">
          <span id="edit-intensite-value">5</span>
        </div>
        <div class="form-group">
          <label for="edit-duree">Durée:</label>
          <input type="text" id="edit-duree" placeholder="Ex: 30 minutes, 2 heures...">
        </div>
        <div class="form-group">
          <label for="edit-notes">Notes:</label>
          <textarea id="edit-notes" rows="3" placeholder="Notes complémentaires..."></textarea>
        </div>
        <div class="modal-actions">
          <button type="button" class="btn-cancel" onclick="closeEditModal()">Annuler</button>
          <button type="button" class="btn-save" onclick="saveSymptom()" formnovalidate>Enregistrer</button>
        </div>
      </form>
      </div>
    </div>
  </div>

{% endblock %}

{% block javascripts %}
  {{ parent() }}
  <script>
    // Dates des symptômes depuis le serveur
    const datesSymptomes = {{ dates_symptomes|json_encode|raw }};
    
    document.addEventListener('DOMContentLoaded', function() {
      const editForm = document.getElementById('edit-form');
      if (editForm) {
        editForm.noValidate = true;
        editForm.addEventListener('submit', (e) => e.preventDefault());
      }
      const disableHtml5ValidationForForm = (form) => {
        if (!form) return;
        form.setAttribute('novalidate', 'novalidate');
        form.noValidate = true;
        form.querySelectorAll('[required]').forEach((el) => el.removeAttribute('required'));
        form.querySelectorAll('input, textarea, select').forEach((el) => {
          if (typeof el.setCustomValidity === 'function') el.setCustomValidity('');
        });
      };
      disableHtml5ValidationForForm(document.querySelector('form[name="symptome_quotidien"]'));
      disableHtml5ValidationForForm(editForm);
      document.addEventListener('invalid', (e) => {
        if (e.target && e.target.closest && e.target.closest('#edit-form')) {
          e.preventDefault();
        }
      }, true);
      // Vérifier s'il y a des messages de succès pour savoir s'il faut nettoyer
      const successMessage = document.querySelector('.alert-success');
      const hasFormErrors = document.querySelector('form .invalid-feedback, form .form-error, form ul li');
      
      // Ne nettoyer le formulaire QUE s'il y a un message de succès (soumission réussie)
      // ou si on arrive d'une actualisation manuelle (F5) sans erreurs
      if (successMessage && !hasFormErrors) {
        setTimeout(function() {
          const form = document.querySelector('form[name="symptome_quotidien"]');
          console.log('Form trouvé après succès:', form);
          
          if (form) {
            // Force le nettoyage complet du formulaire SEULEMENT après succès
            form.reset();
            
            // Nettoyer les valeurs des champs spécifiquement
            const categorySelect = document.querySelector('[name="symptome_quotidien[categorie]"]');
            const symptomSelect = document.querySelector('[name="symptome_quotidien[symptome]"]');
            const intensitySlider = document.querySelector('[name="symptome_quotidien[intensite]"]');
            const intensityDisplay = document.getElementById('intensity-display');
            const notesField = document.querySelector('[name="symptome_quotidien[notes]"]');
            const dureeField = document.querySelector('[name="symptome_quotidien[duree]"]');
            const dateField = document.querySelector('[name="symptome_quotidien[dateSymptome]"]');
            
            if (categorySelect) {
              categorySelect.selectedIndex = 0;
              categorySelect.value = '';
            }
            if (symptomSelect) {
              symptomSelect.innerHTML = '<option value="">-- Choisir un symptôme --</option>';
              symptomSelect.selectedIndex = 0;
            }
            if (intensitySlider) {
              intensitySlider.value = 5;
              if (intensityDisplay) {
                intensityDisplay.textContent = '5';
                intensityDisplay.style.color = '#FF9800';
              }
            }
            if (notesField) notesField.value = '';
            if (dureeField) dureeField.value = '';
            
            // Remettre la date d'aujourd'hui
            if (dateField) {
              const today = new Date();
              const year = today.getFullYear();
              const month = String(today.getMonth() + 1).padStart(2, '0');
              const day = String(today.getDate()).padStart(2, '0');
              const dateString = `${year}-${month}-${day}`;
              dateField.value = dateString;
            }
            
            console.log('Formulaire nettoyé après soumission réussie');
          }
        }, 100);
      } else if (hasFormErrors) {
        console.log('Messages d\'erreur détectés - formulaire non nettoyé pour afficher les erreurs');
      }
      
      // Fonction pour nettoyer lors d'actualisation manuelle (touche F5)
      let isManualRefresh = false;
      
      // Détecter si c'est une actualisation manuelle
      if (performance.navigation.type === performance.navigation.TYPE_RELOAD) {
        isManualRefresh = true;
      }
      
      // Si c'est une actualisation manuelle ET qu'il n'y a pas de messages d'erreur
      if (isManualRefresh && !hasFormErrors) {
        setTimeout(function() {
          const form = document.querySelector('form[name="symptome_quotidien"]');
          if (form) {
            // Nettoyer tous les messages d'erreur résiduels lors d'actualisation manuelle
            const errorMessages = form.querySelectorAll('.invalid-feedback, .form-error, .help-block, ul li, .text-danger, [class*="error"]');
            errorMessages.forEach(function(errorMsg) {
              if (errorMsg.textContent.includes('ne doit pas être vide') || 
                  errorMsg.textContent.includes('Cette valeur n\'est pas valide') ||
                  errorMsg.textContent.includes('doit être') ||
                  errorMsg.textContent.includes('La date') ||
                  errorMsg.textContent.includes('trop long') ||
                  errorMsg.textContent.includes('Les notes ne peuvent pas dépasser') ||
                  errorMsg.textContent.includes('Veuillez sélectionner un symptôme') ||
                  errorMsg.textContent.includes('caractères') ||
                  errorMsg.textContent.includes('sélectionner')) {
                errorMsg.remove();
              }
            });
            
            // Retirer les classes d'erreur des champs lors d'actualisation manuelle
            const inputsWithError = form.querySelectorAll('.is-invalid, .form-control.is-invalid');
            inputsWithError.forEach(function(input) {
              input.classList.remove('is-invalid');
              input.classList.remove('form-control.is-invalid');
            });
            
            console.log('Formulaire nettoyé après actualisation manuelle');
          }
        }, 100);
      }
      
      // Auto-hide flash messages after 2 seconds
      const flashMessages = document.querySelectorAll('.flash-message-auto');
      flashMessages.forEach(function(message) {
        setTimeout(function() {
          message.classList.add('fade-out');
          setTimeout(function() {
            message.remove();
          }, 500); // Wait for fade-out animation to complete
        }, 2000); // Show for 2 seconds
      });
      
      // Nettoyer le formulaire après soumission réussie
      if (successMessage) {
        console.log('Message de succès détecté - formulaire sera nettoyé');
      }
      
      // Date par défaut pour le formulaire (correction décalage horaire)
      if (document.getElementById('symptome_quotidien_dateSymptome')) {
        const today = new Date();
        const year = today.getFullYear();
        const month = String(today.getMonth() + 1).padStart(2, '0');
        const day = String(today.getDate()).padStart(2, '0');
        const dateString = `${year}-${month}-${day}`;
        document.getElementById('symptome_quotidien_dateSymptome').value = dateString;
      }

      // Charger les statistiques des symptômes
      // Filtrage des symptômes par catégorie via AJAX
      const categorySelect = document.getElementById('symptome_quotidien_categorie');
      const symptomSelect = document.getElementById('symptome_quotidien_symptome');
      
      console.log('Category select found:', categorySelect);
      console.log('Symptom select found:', symptomSelect);
      
      if (categorySelect && symptomSelect) {
        categorySelect.addEventListener('change', async function(e) {
          const selectedCategory = this.value;
          console.log('Catégorie sélectionnée:', selectedCategory);
          
          try {
            // Requête AJAX pour récupérer les symptômes de la catégorie
            const response = await fetch('/symptomes/filter-by-category', {
              method: 'POST',
              headers: {
                'Content-Type': 'application/x-www-form-urlencoded',
              },
              body: 'categorie=' + encodeURIComponent(selectedCategory)
            });
            
            console.log('Response status:', response.status);
            
            if (!response.ok) {
              throw new Error(`HTTP error! status: ${response.status}`);
            }
            
            const symptomes = await response.json();
            console.log('Symptômes reçus:', symptomes);
            
            // Vider le select des symptômes et ajouter l'option par défaut
            symptomSelect.innerHTML = '';
            const defaultOption = document.createElement('option');
            defaultOption.value = '';
            defaultOption.textContent = '-- Choisir un symptôme --';
            symptomSelect.appendChild(defaultOption);
            
            // Ajouter les nouveaux symptômes
            symptomes.forEach(symptome => {
              const option = document.createElement('option');
              option.value = symptome.id;
              option.textContent = symptome.nom;
              symptomSelect.appendChild(option);
            });
            
            console.log('Select mis à jour avec', symptomes.length, 'symptômes');
            
          } catch (error) {
            console.error('Erreur lors du filtrage:', error);
            alert('Erreur lors du chargement des symptômes: ' + error.message);
          }
        });
        
        // Charger tous les symptômes au début si aucune catégorie sélectionnée
        if (!categorySelect.value) {
          categorySelect.dispatchEvent(new Event('change'));
        }
      } else {
        console.error('Éléments non trouvés - Category:', categorySelect, 'Symptom:', symptomSelect);
      }
      
      // Slider intensité - recherche plus robuste
      const slider = document.getElementById('symptome_quotidien_intensite');
      const display = document.getElementById('intensity-display');
      
      console.log('Slider found:', slider);
      console.log('Display found:', display);
      
      if (slider && display) {
        // Initialiser l'affichage avec la valeur actuelle
        display.textContent = slider.value;
        console.log('Initial value:', slider.value);
        
        slider.addEventListener('input', function() {
          console.log('Slider moved to:', this.value);
          display.textContent = this.value;
          
          // Changer la couleur selon l'intensité
          const intensity = parseInt(this.value);
          if (intensity <= 3) {
            display.style.color = '#4CAF50';
          } else if (intensity <= 6) {
            display.style.color = '#FF9800';
          } else {
            display.style.color = '#F44336';
          }
        });
      } else {
        console.error('Slider or display element not found');
        console.log('Available elements with intensity-slider class:', document.querySelectorAll('.intensity-slider'));
      }
    });

    // Calendrier des symptômes
    class SymptomCalendar {
      constructor(containerId, symptomsData) {
        this.container = document.getElementById(containerId);
        this.symptoms = symptomsData || [];
        this.currentDate = new Date();
        this.init();
      }

      init() {
        if (!this.container) return;
        this.render();
      }

      render() {
        const year = this.currentDate.getFullYear();
        const month = this.currentDate.getMonth();
        
        this.container.innerHTML = `
          <div class="calendar-header">
            <button class="calendar-nav-btn" onclick="symptomCalendar.previousMonth()">
              <i class="fas fa-chevron-left"></i>
            </button>
            <div class="calendar-month-year">
              ${this.getMonthName(month)} ${year}
            </div>
            <button class="calendar-nav-btn" onclick="symptomCalendar.nextMonth()">
              <i class="fas fa-chevron-right"></i>
            </button>
          </div>
          <div class="calendar-grid">
            ${this.renderDayHeaders()}
            ${this.renderDays()}
          </div>
        `;
      }

      renderDayHeaders() {
        const days = ['Dim', 'Lun', 'Mar', 'Mer', 'Jeu', 'Ven', 'Sam'];
        return days.map(day => `<div class="calendar-day-header">${day}</div>`).join('');
      }

      renderDays() {
        const year = this.currentDate.getFullYear();
        const month = this.currentDate.getMonth();
        const firstDay = new Date(year, month, 1);
        const lastDay = new Date(year, month + 1, 0);
        const startDate = new Date(firstDay);
        startDate.setDate(startDate.getDate() - firstDay.getDay());
        
        const today = new Date();
        let html = '';
        
        for (let i = 0; i < 42; i++) {
          const currentDay = new Date(startDate);
          currentDay.setDate(startDate.getDate() + i);
          
          // Correction du décalage horaire pour l'affichage
          const year = currentDay.getFullYear();
          const month = currentDay.getMonth();
          const day = currentDay.getDate();
          const dateStr = `${year}-${String(month + 1).padStart(2, '0')}-${String(day).padStart(2, '0')}`;
          
          const isToday = currentDay.toDateString() === today.toDateString();
          const isCurrentMonth = currentDay.getMonth() === month;
          const hasSymptom = this.symptoms.includes(dateStr);
          
          let classes = ['calendar-day'];
          if (!isCurrentMonth) classes.push('other-month');
          if (isToday) classes.push('today');
          if (hasSymptom) classes.push('has-symptom');
          
          html += `<div class="${classes.join(' ')}" data-date="${dateStr}" ${hasSymptom ? 'onclick="showSymptomDetails(\'' + dateStr + '\')"' : ''}>${currentDay.getDate()}</div>`;
        }
        
        return html;
      }

      getMonthName(monthIndex) {
        const months = [
          'Janvier', 'Février', 'Mars', 'Avril', 'Mai', 'Juin',
          'Juillet', 'Août', 'Septembre', 'Octobre', 'Novembre', 'Décembre'
        ];
        return months[monthIndex];
      }

      previousMonth() {
        this.currentDate.setMonth(this.currentDate.getMonth() - 1);
        this.render();
      }

      nextMonth() {
        this.currentDate.setMonth(this.currentDate.getMonth() + 1);
        this.render();
      }
    }

    // Initialiser le calendrier
    let symptomCalendar;
    document.addEventListener('DOMContentLoaded', function() {
      symptomCalendar = new SymptomCalendar('symptom-calendar', datesSymptomes);
    });

    // Fonction pour afficher les détails des symptômes d'une date
    async function showSymptomDetails(dateStr) {
      try {
        const response = await fetch(`/symptomes/by-date/${dateStr}`);
        const symptomes = await response.json();
        
        const detailsContainer = document.getElementById('symptom-details');
        const detailsTitle = document.getElementById('details-title');
        const detailsContent = document.getElementById('symptom-details-content');
        
        // Stocker la date actuelle dans l'attribut data pour pouvoir recharger
        detailsContainer.setAttribute('data-current-date', dateStr);
        
        // Formater la date pour l'affichage
        const date = new Date(dateStr);
        const formattedDate = date.toLocaleDateString('fr-FR', {
          weekday: 'long',
          year: 'numeric',
          month: 'long',
          day: 'numeric'
        });
        
        detailsTitle.textContent = `📊 Symptômes du ${formattedDate}`;
        
        if (symptomes.length === 0) {
          detailsContent.innerHTML = '<p>Aucun symptôme enregistré pour cette date.</p>';
        } else {
          let html = `
            <table class="symptoms-table">
              <thead>
                <tr>
                  <th>Symptôme</th>
                  <th>Intensité</th>
                  <th>Durée</th>
                  <th>Notes</th>
                  <th>Actions</th>
                </tr>
              </thead>
              <tbody>
          `;
          
          symptomes.forEach(symptome => {
            const intensityClass = symptome.intensite <= 3 ? 'intensity-low' : 
                                 symptome.intensite <= 6 ? 'intensity-medium' : 'intensity-high';
            
            html += `
              <tr>
                <td><strong>${symptome.symptome}</strong></td>
                <td><span class="intensity-badge ${intensityClass}">${symptome.intensite}/10</span></td>
                <td>${symptome.duree || '-'}</td>
                <td>${symptome.notes ? symptome.notes.substring(0, 50) + (symptome.notes.length > 50 ? '...' : '') : '-'}</td>
                <td>
                  <div class="action-buttons">
                    <button class="btn-edit" onclick="editSymptom(${symptome.id}, '${symptome.symptome}', ${symptome.intensite}, '${symptome.duree || ''}', '${symptome.notes || ''}')">
                      <i class="fas fa-edit"></i> Éditer
                    </button>
                    <button class="btn-delete" onclick="deleteSymptom(${symptome.id})">
                      <i class="fas fa-trash"></i> Supprimer
                    </button>
                  </div>
                </td>
              </tr>
            `;
          });
          
          html += '</tbody></table>';
          detailsContent.innerHTML = html;
        }
        
        // Afficher la section des détails
        detailsContainer.style.display = 'block';
        detailsContainer.scrollIntoView({ behavior: 'smooth' });
        
      } catch (error) {
        console.error('Erreur lors du chargement des symptômes:', error);
      }
    }

    // Fonction pour éditer un symptôme
    function editSymptom(id, nom, intensite, duree, notes) {
      const editForm = document.getElementById('edit-form');
      if (editForm) {
        editForm.noValidate = true;
        editForm.querySelectorAll('[required]').forEach((el) => el.removeAttribute('required'));
        editForm.querySelectorAll('input, textarea, select').forEach((el) => {
          if (typeof el.setCustomValidity === 'function') el.setCustomValidity('');
        });
      }
      const globalLoader = document.getElementById('globalLoader');
      if (globalLoader) {
        globalLoader.classList.remove('show');
        globalLoader.setAttribute('aria-hidden', 'true');
      }
      const formError = document.getElementById('edit-form-error');
      if (formError) {
        formError.textContent = '';
        formError.style.display = 'none';
      }
      document.getElementById('edit-symptom-id').value = id;
      document.getElementById('edit-intensite').value = intensite;
      document.getElementById('edit-intensite-value').textContent = intensite;
      document.getElementById('edit-duree').value = duree;
      document.getElementById('edit-notes').value = notes;
      
      document.getElementById('edit-modal').style.display = 'flex';
    }

    // Fonction pour fermer le modal d'édition
    function closeEditModal() {
      document.getElementById('edit-modal').style.display = 'none';
    }

    // Fonction pour sauvegarder les modifications
    async function saveSymptom() {
      const id = document.getElementById('edit-symptom-id').value;
      const intensite = document.getElementById('edit-intensite').value;
      const duree = document.getElementById('edit-duree').value;
      const notes = document.getElementById('edit-notes').value;
      
      // Effacer les anciens messages d'erreur
      document.querySelectorAll('#edit-form .field-error').forEach((el) => el.remove());
      document.querySelectorAll('#edit-form .input-error').forEach((el) => el.classList.remove('input-error'));
      const formError = document.getElementById('edit-form-error');
      if (formError) {
        formError.textContent = '';
        formError.style.display = 'none';
      }
      const addFieldError = (fieldId, message) => {
        const target = document.getElementById(fieldId);
        if (!target || !target.parentNode) return;
        target.classList.add('input-error');
        const errorDiv = document.createElement('div');
        errorDiv.className = 'field-error';
        errorDiv.style.cssText = 'color: #dc3545; font-size: 0.9rem; margin-top: 5px;';
        errorDiv.textContent = message;
        target.parentNode.appendChild(errorDiv);
      };
      const showFormError = (message) => {
        if (formError) {
          formError.textContent = message;
          formError.style.display = 'block';
        }
      };

      const validationMessages = [];
      if (!intensite || Number(intensite) < 1 || Number(intensite) > 10) {
        addFieldError('edit-intensite', 'Veuillez renseigner ce champ.');
        validationMessages.push('Intensité');
      }
      if (!duree || !duree.trim()) {
        addFieldError('edit-duree', 'Veuillez renseigner ce champ.');
        validationMessages.push('Durée');
      }
      if (notes && notes.length > 100) {
        addFieldError('edit-notes', 'Les notes ne peuvent pas dépasser 100 caractères.');
        validationMessages.push('Notes');
      }
      if (validationMessages.length > 0) {
        showFormError('Veuillez corriger les champs indiqués.');
        if (typeof showNotification === 'function') {
          showNotification('Veuillez corriger les champs indiqués.', 'error');
        } else if (window.showToast) {
          window.showToast('error', 'Veuillez corriger les champs indiqués.');
        }
        return;
      }

      if (typeof window.setLoading === 'function') {
        window.setLoading(true);
      }
      const globalLoader = document.getElementById('globalLoader');
      if (globalLoader) {
        globalLoader.classList.add('show');
        globalLoader.setAttribute('aria-hidden', 'false');
      }
      
      try {
        const response = await fetch(`/symptomes/edit/${id}`, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          toast: false,
          loading: false,
          body: JSON.stringify({
            intensite: intensite,
            duree: duree,
            notes: notes
          })
        });
        
        let result = {};
        try {
          result = await response.json();
        } catch (_) {
          result = { success: false, error: 'Erreur de validation.' };
        }
        
        if (response.ok && result.success) {
          closeEditModal();
          
          // Recharger les détails via AJAX si une date est affichée
          const detailsContainer = document.getElementById('symptom-details');
          if (detailsContainer && detailsContainer.style.display !== 'none') {
            const currentDate = detailsContainer.getAttribute('data-current-date');
            if (currentDate) {
              await showSymptomDetails(currentDate);
            }
          }
        } else {
          const message = result.error || result.message || 'Erreur de validation.';
          showFormError(message);
          if (typeof showNotification === 'function') {
            showNotification(message, 'error');
          } else if (window.showToast) {
            window.showToast('error', message);
          }

          const fieldMap = {
            intensite: 'edit-intensite',
            duree: 'edit-duree',
            notes: 'edit-notes',
          };

          if (result.errors) {
            Object.keys(result.errors).forEach((field) => {
              const targetId = fieldMap[field];
              if (!targetId) return;
              const target = document.getElementById(targetId);
              if (!target || !target.parentNode) return;
              result.errors[field].forEach((msg) => {
                addFieldError(targetId, msg);
              });
            });
          } else {
            addFieldError('edit-notes', message);
          }
        }
      } catch (error) {
        console.error('Erreur:', error);
        const notesField = document.getElementById('edit-notes');
        const errorDiv = document.createElement('div');
        errorDiv.className = 'field-error';
        errorDiv.style.cssText = 'color: #dc3545; font-size: 0.9rem; margin-top: 5px;';
        errorDiv.textContent = 'Erreur lors de la modification';
        if (notesField && notesField.parentNode) {
          notesField.parentNode.appendChild(errorDiv);
        }
        if (typeof showNotification === 'function') {
          showNotification('Erreur lors de la modification', 'error');
        } else if (window.showToast) {
          window.showToast('error', 'Erreur lors de la modification');
        }
      } finally {
        if (typeof window.setLoading === 'function') {
          window.setLoading(false);
        }
        const gl = document.getElementById('globalLoader');
        if (gl) {
          gl.classList.remove('show');
          gl.setAttribute('aria-hidden', 'true');
        }
      }
    }

    // Fonction pour supprimer un symptôme
    async function deleteSymptom(id) {
      if (!confirm('Êtes-vous sûr de vouloir supprimer ce symptôme ?')) {
        return;
      }
      
      try {
        const response = await fetch(`/symptomes/delete/${id}`, {
          method: 'DELETE'
        });
        
        const result = await response.json();
        
        if (result.success) {
          // Supprimer la ligne du tableau au lieu de recharger la page
          const button = event.target.closest('button');
          const row = button.closest('tr');
          if (row) {
            row.remove();
          }
          
          // Mettre à jour le calendrier
          if (symptomCalendar) {
            symptomCalendar.render();
          }
          
          alert('✅ ' + result.message);
        } else {
          alert('❌ Erreur: ' + result.error);
        }
      } catch (error) {
        console.error('Erreur:', error);
        alert('❌ Erreur lors de la suppression');
      }
    }

    // Slider du modal d'édition
    document.addEventListener('DOMContentLoaded', function() {
      const editSlider = document.getElementById('edit-intensite');
      const editDisplay = document.getElementById('edit-intensite-value');
      
      if (editSlider && editDisplay) {
        editSlider.addEventListener('input', function() {
          editDisplay.textContent = this.value;
        });
      }
    });

    // Fonction pour nettoyer le formulaire
    function clearForm() {
      const form = document.querySelector('form[name="symptome_quotidien"]');
      if (form) {
        // Nettoyer tous les champs
        const categorySelect = document.querySelector('[name="symptome_quotidien[categorie]"]');
        const symptomSelect = document.querySelector('[name="symptome_quotidien[symptome]"]');
        const intensitySlider = document.querySelector('[name="symptome_quotidien[intensite]"]');
        const intensityDisplay = document.getElementById('intensity-display');
        const notesField = document.querySelector('[name="symptome_quotidien[notes]"]');
        const dureeField = document.querySelector('[name="symptome_quotidien[duree]"]');
        const dateField = document.querySelector('[name="symptome_quotidien[dateSymptome]"]');
        
        // Remettre les valeurs par défaut
        if (categorySelect) {
          categorySelect.selectedIndex = 0;
          categorySelect.value = '';
        }
        if (symptomSelect) {
          symptomSelect.innerHTML = '<option value="">-- Choisir un symptôme --</option>';
          symptomSelect.selectedIndex = 0;
        }
        if (intensitySlider) {
          intensitySlider.value = 5;
          if (intensityDisplay) {
            intensityDisplay.textContent = '5';
            intensityDisplay.style.color = '#FF9800';
          }
        }
        if (notesField) notesField.value = '';
        if (dureeField) dureeField.value = '';
        
        // Remettre la date d'aujourd'hui
        if (dateField) {
          const today = new Date();
          const year = today.getFullYear();
          const month = String(today.getMonth() + 1).padStart(2, '0');
          const day = String(today.getDate()).padStart(2, '0');
          const dateString = `${year}-${month}-${day}`;
          dateField.value = dateString;
        }
        
        // Supprimer les messages d'erreur éventuels
        const errorMessages = form.querySelectorAll('.invalid-feedback, .form-error, ul li');
        errorMessages.forEach(function(errorMsg) {
          errorMsg.style.display = 'none';
        });
        
        // Retirer les classes d'erreur des champs
        const inputsWithError = form.querySelectorAll('.is-invalid');
        inputsWithError.forEach(function(input) {
          input.classList.remove('is-invalid');
        });
        
        console.log('Formulaire nettoyé manuellement');
      }
    }

    // Fonction pour exporter en PDF
    async function exportToPDF() {
      const exportBtn = document.querySelector('.btn-export-pdf');
      const originalText = exportBtn.innerHTML;
      
      // Changer le texte du bouton pendant le téléchargement
      exportBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Génération...';
      exportBtn.disabled = true;
      
      try {
        // Faire la requête pour générer le PDF
        const response = await fetch('/symptomes/export-pdf', {
          method: 'GET',
          headers: {
            'Accept': 'application/pdf'
          }
        });
        
        if (!response.ok) {
          throw new Error('Erreur lors de la génération du PDF');
        }
        
        // Créer un lien de téléchargement
        const blob = await response.blob();
        const url = window.URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        
        // Nom du fichier avec la date actuelle
        const today = new Date();
        const dateStr = today.toISOString().split('T')[0];
        a.download = `mes-symptomes-${dateStr}.pdf`;
        
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
        
        // Libérer l'URL
        window.URL.revokeObjectURL(url);
        
        // Message de succès
        alert('✅ PDF téléchargé avec succès !');
        
      } catch (error) {
        console.error('Erreur:', error);
        alert('❌ Erreur lors de la génération du PDF: ' + error.message);
      } finally {
        // Remettre le bouton dans son état initial
        exportBtn.innerHTML = originalText;
        exportBtn.disabled = false;
      }
    }

    // Fonction d'export PDF
    async function exportToPDF() {
      const exportBtn = document.querySelector('.btn-export-pdf');
      const originalText = exportBtn.innerHTML;
      
      try {
        // Désactiver le bouton et montrer un indicateur de chargement
        exportBtn.disabled = true;
        exportBtn.innerHTML = `
          <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
          Génération en cours...
        `;
        
        const response = await fetch('/symptomes/export-pdf', {
          method: 'GET',
          headers: {
            'Content-Type': 'application/json',
          }
        });
        
        if (!response.ok) {
          throw new Error(`HTTP error! status: ${response.status}`);
        }
        
        // Créer un blob avec le contenu PDF
        const blob = await response.blob();
        
        // Créer un lien de téléchargement
        const url = window.URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.style.display = 'none';
        a.href = url;
        
        // Nom du fichier avec la date actuelle
        const today = new Date();
        const dateStr = today.toISOString().split('T')[0];
        a.download = `mes-symptomes-${dateStr}.pdf`;
        
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
        
        // Libérer l'URL
        window.URL.revokeObjectURL(url);
        
        // Message de succès
        showNotification('✅ PDF téléchargé avec succès !', 'success');
        
      } catch (error) {
        console.error('Erreur:', error);
        showNotification('❌ Erreur lors de la génération du PDF: ' + error.message, 'error');
      } finally {
        // Remettre le bouton dans son état initial
        exportBtn.innerHTML = originalText;
        exportBtn.disabled = false;
      }
    }

    // Fonction pour afficher les notifications
    function showNotification(message, type = 'info') {
      // Créer l'élément de notification
      const notification = document.createElement('div');
      notification.className = `alert alert-${type === 'success' ? 'success' : 'danger'} notification-toast`;
      notification.innerHTML = `
        <i class="fas fa-${type === 'success' ? 'check-circle' : 'exclamation-circle'} me-2"></i>
        ${message}
      `;
      
      // Ajouter des styles pour l'animation
      notification.style.cssText = `
        position: fixed;
        top: 20px;
        right: 20px;
        z-index: 9999;
        min-width: 300px;
        max-width: 500px;
        animation: slideInRight 0.3s ease-out;
        box-shadow: 0 4px 15px rgba(0,0,0,0.2);
        border: none;
        border-radius: 8px;
      `;
      
      // Ajouter au body
      document.body.appendChild(notification);
      
      // Supprimer automatiquement après 4 secondes
      setTimeout(() => {
        notification.style.animation = 'slideOutRight 0.3s ease-in forwards';
        setTimeout(() => {
          if (notification.parentNode) {
            document.body.removeChild(notification);
          }
        }, 300);
      }, 4000);
    }

    // Ajouter les styles d'animation pour les notifications
    const notificationStyles = document.createElement('style');
    notificationStyles.textContent = `
      @keyframes slideInRight {
        from {
          transform: translateX(100%);
          opacity: 0;
        }
        to {
          transform: translateX(0);
          opacity: 1;
        }
      }
      
      @keyframes slideOutRight {
        from {
          transform: translateX(0);
          opacity: 1;
        }
        to {
          transform: translateX(100%);
          opacity: 0;
        }
      }
    `;
    document.head.appendChild(notificationStyles);
  </script>
