<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>Rapport total de santé</title>
    <style>
        body { font-family: DejaVu Sans, Arial, sans-serif; color: #0f172a; font-size: 12px; }
        h1 { font-size: 20px; margin: 0 0 6px; }
        h2 { font-size: 15px; margin: 20px 0 8px; border-bottom: 1px solid #cbd5e1; padding-bottom: 4px; }
        .muted { color: #64748b; }
        .grid { width: 100%; border-collapse: collapse; }
        .grid td { border: 1px solid #e2e8f0; padding: 8px; vertical-align: top; }
        .kpi { font-size: 16px; font-weight: 700; color: #0D8ABC; }
        table.data { width: 100%; border-collapse: collapse; margin-top: 8px; }
        table.data th, table.data td { border: 1px solid #e2e8f0; padding: 6px; text-align: left; font-size: 11px; }
        table.data th { background: #f8fafc; }
    </style>
</head>
<body>
    <h1>Rapport total de santé</h1>
    <div class="muted">
        Patient: {{ user.nom }} {{ user.prenom }}<br>
        Généré le: {{ generatedAt|date('d/m/Y H:i') }}<br>
        Nombre total d'entrées: {{ totalEntries }}
    </div>

    <h2>Résumé global</h2>
    <table class="grid">
        <tr>
            <td>
                <div class="muted">Poids actuel</div>
                <div class="kpi">{{ summaryStats.latestWeight is not null ? summaryStats.latestWeight|number_format(1, '.', ' ') ~ ' kg' : '--' }}</div>
            </td>
            <td>
                <div class="muted">Sommeil moyen</div>
                <div class="kpi">{{ averageSommeil is not null ? averageSommeil|number_format(1, '.', ' ') ~ ' h' : '--' }}</div>
            </td>
            <td>
                <div class="muted">Activité (7j)</div>
                <div class="kpi">{{ summaryStats.weeklyActivityMinutes|default(0) }} min</div>
            </td>
            <td>
                <div class="muted">Hydratation moyenne</div>
                <div class="kpi">{{ summaryStats.averageWater is not null ? summaryStats.averageWater|number_format(1, '.', ' ') ~ ' L' : '--' }}</div>
            </td>
        </tr>
    </table>

    <h2>Risques estimés</h2>
    <table class="data">
        <thead>
            <tr>
                <th>Indicateur</th>
                <th>Score</th>
                <th>Niveau</th>
            </tr>
        </thead>
        <tbody>
            <tr><td>Hypertension</td><td>{{ riskPrediction.htn.score|number_format(1, '.', ' ') }}/100</td><td>{{ riskPrediction.htn.level }}</td></tr>
            <tr><td>Diabète</td><td>{{ riskPrediction.diabetes.score|number_format(1, '.', ' ') }}/100</td><td>{{ riskPrediction.diabetes.level }}</td></tr>
            <tr><td>Dépression</td><td>{{ riskPrediction.depression.score|number_format(1, '.', ' ') }}/100</td><td>{{ riskPrediction.depression.level }}</td></tr>
            <tr><td>Nutrition</td><td>{{ riskPrediction.nutrition.score|number_format(1, '.', ' ') }}/100</td><td>{{ riskPrediction.nutrition.level }}</td></tr>
        </tbody>
    </table>

    <h2>Historique récent (60 dernières entrées)</h2>
    <table class="data">
        <thead>
            <tr>
                <th>Date</th>
                <th>Poids</th>
                <th>IMC</th>
                <th>Tension</th>
                <th>Sommeil</th>
                <th>Eau</th>
                <th>Activité</th>
                <th>Alimentation</th>
                <th>Humeurs</th>
            </tr>
        </thead>
        <tbody>
            {% for entry in entries %}
                <tr>
                    <td>{{ entry.date }}</td>
                    <td>{{ entry.poids is not null ? entry.poids|number_format(1, '.', ' ') ~ ' kg' : '--' }}</td>
                    <td>{{ entry.imc is not null ? entry.imc|number_format(1, '.', ' ') : '--' }}</td>
                    <td>{{ entry.tension is not null ? entry.tension|number_format(1, '.', ' ') : '--' }}</td>
                    <td>{{ entry.sommeil is not null ? entry.sommeil|number_format(1, '.', ' ') ~ ' h' : '--' }}</td>
                    <td>{{ entry.eauBue is not null ? entry.eauBue|number_format(1, '.', ' ') ~ ' L' : '--' }}</td>
                    <td>{{ entry.activite ?: '--' }}</td>
                    <td>{{ entry.alimentation ?: '--' }}</td>
                    <td>{{ entry.humeurs is not empty ? entry.humeurs|join(', ') : '--' }}</td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="9">Aucune donnée disponible.</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
</body>
</html>
