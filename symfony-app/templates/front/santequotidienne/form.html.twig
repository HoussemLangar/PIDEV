  <script>
    let currentEntryDate = '';
    
    function showEditModal(dataString) {
      // Si on reçoit un ID au lieu de données complètes, charger les données depuis l'API
      let data;
      try {
        data = JSON.parse(dataString);
      } catch (e) {
        console.error('Invalid data string:', dataString);
        return;
      }
      
      // Si on n'a qu'un ID, charger les données fraîches depuis l'API
      if (data.id && !data.humeur) {
        fetch(`/sante-quotidienne/api/by-date?date=${data.dateFormatted || data.date}`)
          .then(response => response.json())
          .then(apiData => {
            if (apiData.ok) {
              showEditModalWithData(apiData);
            } else {
              console.error('Failed to load fresh data');
              showEditModalWithData(data); // Fallback
            }
          })
          .catch(err => {
            console.error('Error loading fresh data:', err);
            showEditModalWithData(data); // Fallback
          });
      } else {
        showEditModalWithData(data);
      }
    }
    
    function showEditModalByDate(date, entryId) {
      console.log('showEditModalByDate called with:', date, entryId);
      fetch(`/sante-quotidienne/api/by-date?date=${date}`)
        .then(response => response.json())
        .then(data => {
          console.log('Data received from API:', data);
          console.log('Humeur data type:', typeof data.humeur);
          console.log('Humeur data:', data.humeur);
          console.log('Is Array:', Array.isArray(data.humeur));
          if (data.ok) {
            showEditModalWithData(data);
          } else {
            alert('Aucune donnée trouvée pour cette date');
          }
        })
        .catch(err => {
          console.error('Error loading data:', err);
          alert('Erreur lors du chargement des données');
        });
    }
    
    function showEditModalWithData(data) {
      console.log('showEditModalWithData called with:', data);
      window.currentEntryId = data.id;
      window.currentEntryDate = data.dateFormatted || data.date;
      if (data.deleteCsrf) {
        window.csrfToken = data.deleteCsrf;
      }
      if (data.editCsrf) {
        document.getElementById('editCsrfToken').value = data.editCsrf;
      }

      renderEditErrors(null);
      
      // Réinitialiser tous les styles des boutons d'humeur
      document.querySelectorAll('.mood-button').forEach(button => {
        button.style.border = '2px solid transparent';
        button.style.background = '';
      });
      document.querySelectorAll('input[name="sante_quotidienne[humeur][]"]').forEach(input => {
        input.checked = false;
      });
      
      // Remplir tous les champs
      document.getElementById('editDate').value = data.dateFormatted || data.date;
      document.getElementById('editPoids').value = data.poids || '';
      document.getElementById('editTaille').value = data.taille || '';
      document.getElementById('editImc').value = data.imc || '-';
      
      // Tension artérielle
      document.getElementById('editTension').value = data.tensionArterielle || '';
      
      // Autres champs
      document.getElementById('editSommeil').value = data.sommeil || '';
      
      // Activité physique (select)
      const activiteSelect = document.getElementById('editActivite');
      if(activiteSelect && data.activitePhysique) {
        activiteSelect.value = data.activitePhysique;
      }
      
      // Humeur (checkboxes multiples)
      // Reset all mood buttons first - SEULEMENT dans le modal
      const modalElement = document.getElementById('editModal');
      modalElement.querySelectorAll('input[name="sante_quotidienne[humeur][]"]').forEach(input => {
        input.checked = false;
        input.closest('.mood-button-label').querySelector('.mood-button').style.border = '2px solid transparent';
        input.closest('.mood-button-label').querySelector('.mood-button').style.background = '#ecf0f1';
      });
      
      // Set selected moods
      console.log('=== Setting humeurs ===');
      console.log('data.humeur:', data.humeur);
      console.log('Type:', typeof data.humeur);
      console.log('Is Array:', Array.isArray(data.humeur));
      
      if(data.humeur) {
        // Convertir en tableau si ce n'est pas déjà le cas
        let humeursArray = Array.isArray(data.humeur) ? data.humeur : [data.humeur];
        
        console.log('humeursArray:', humeursArray);
        
        humeursArray.forEach((humeurValue, index) => {
          console.log(`Processing humeur ${index}:`, humeurValue, 'Type:', typeof humeurValue);
          // Chercher SEULEMENT dans le modal
          const humeurInput = modalElement.querySelector(`input[name="sante_quotidienne[humeur][]"][value="${humeurValue}"]`);
          console.log(`Looking for checkbox with value "${humeurValue}":`, humeurInput);
          if (humeurInput) {
            console.log('Found! Checking checkbox for:', humeurValue);
            humeurInput.checked = true;
            humeurInput.closest('.mood-button-label').querySelector('.mood-button').style.border = '2px solid #3498db';
            humeurInput.closest('.mood-button-label').querySelector('.mood-button').style.background = '#e8f4fd';
          } else {
            console.log('NOT FOUND! Checkbox with value:', humeurValue);
          }
        });
      } else {
        console.log('No humeur data');
      }
      
      // Alimentation (select)
      const alimentationSelect = document.getElementById('editAlimentation');
      if(alimentationSelect && data.alimentation) {
        alimentationSelect.value = data.alimentation;
      }
      
      document.getElementById('editEau').value = data.eauBue || '';
        console.log('Affichage du modal avec données:', data);
        const modal = document.getElementById('editModal');
        modal.style.display = 'flex';
        modal.style.zIndex = '9999';
        modal.style.opacity = '1';
    }
    
    // Système de rotation des conseils toutes les 2 minutes
    const tips = [
      "🌟 Buvez un grand verre d'eau au réveil pour bien commencer la journée !",
      "🏃‍♂️ Marchez au moins 10 000 pas par jour pour rester en forme",
      "😴 Dormez entre 7 et 9 heures par nuit pour récupérer",
      "🥗 Mangez équilibré : légumes, protéines et glucides à chaque repas",
      "🧘 Prenez 5 minutes par jour pour méditer et vous détendre",
      "⚖️ Surveillez votre poids régulièrement pour une meilleure santé",
      "💧 Buvez au moins 1,5 litre d'eau par jour",
      "🏋️‍♀️ Pratiquez une activité physique 30 minutes par jour",
      "🍎 Privilégiez les fruits et légumes frais dans votre alimentation",
      "📱 Évitez les écrans 1 heure avant le coucher",
      "🫁 Pratiquez des exercices de respiration profonde",
      "🌞 Profitez de la lumière naturelle le matin",
      "🛌 Respectez des horaires de sommeil réguliers",
      "🥤 Limitez les boissons sucrées et caféinées en soirée",
      "📝 Tenez un journal de vos habitudes pour mieux les suivre"
    ];
    
    let currentTipIndex = 0;
    
    function changeTip() {
      const tipContent = document.getElementById('tip-content');
      console.log('changeTip appelé - tipContent trouvé:', tipContent);
      if (tipContent) {
        console.log('Changement de conseil, index actuel:', currentTipIndex);
        // Animation de fade out
        tipContent.style.opacity = '0';
        
        setTimeout(() => {
          const newTip = tips[currentTipIndex];
          console.log('Nouveau conseil:', newTip);
          tipContent.innerHTML = `<p style="font-size: 0.9em;">${newTip}</p>`;
          currentTipIndex = (currentTipIndex + 1) % tips.length;
          
          // Animation de fade in
          tipContent.style.opacity = '1';
          console.log('Conseil changé avec succès');
        }, 500);
      } else {
        console.error('Element tip-content non trouvé dans changeTip !');
      }
    }
    
    // Initialiser la rotation des conseils
    document.addEventListener('DOMContentLoaded', function() {
      const tipContent = document.getElementById('tip-content');
      console.log('Initialisation conseils - tipContent trouvé:', tipContent);
      if (tipContent) {
        tipContent.style.transition = 'opacity 0.5s ease';
        // Afficher le premier conseil immédiatement
        tipContent.innerHTML = `<p style="font-size: 0.9em;">${tips[0]}</p>`;
        tipContent.style.opacity = '1';
        console.log('Premier conseil affiché:', tips[0]);
        
        // Changer de conseil toutes les 2 minutes (120 000 ms)
        setInterval(changeTip, 120000);
        console.log('Timer démarré pour changer les conseils');
      } else {
        console.error('Element tip-content non trouvé !');
      }
    });
    
    function closeEditModal() {
      document.getElementById('editModal').style.display = 'none';
    }
    
    function openSleepStatsModal() {
      document.getElementById('sleepStatsModal').style.display = 'flex';
    }
    
    function closeSleepStatsModal() {
      document.getElementById('sleepStatsModal').style.display = 'none';
    }

    function renderEditErrors(errors) {
      const container = document.getElementById('editFormErrors');
      if (!container) {
        return;
      }

      container.innerHTML = '';
      if (!errors || Object.keys(errors).length === 0) {
        container.style.display = 'none';
        return;
      }

      const list = document.createElement('ul');
      list.style.margin = '0';
      list.style.paddingLeft = '18px';

      Object.values(errors).forEach(messages => {
        const msgs = Array.isArray(messages) ? messages : [messages];
        msgs.forEach(message => {
          const li = document.createElement('li');
          li.textContent = message;
          list.appendChild(li);
        });
      });

      container.appendChild(list);
      container.style.display = 'block';
    }
    
    function deleteEntry() {
      if (!window.currentEntryId) {
        alert('Aucune entrée sélectionnée.');
        return;
      }
      if (confirm('Êtes-vous sûr de vouloir supprimer cette entrée ?')) {
        fetch(`/sante-quotidienne/${window.currentEntryId}`, {
          method: 'POST',
          headers: {
            'X-Requested-With': 'XMLHttpRequest',
            'Content-Type': 'application/x-www-form-urlencoded',
          },
          body: `_token=${window.csrfToken || ''}`
        })
        .then(res => {
          if (res.ok) {
            location.reload();
          } else {
            alert('Erreur lors de la suppression.');
          }
        });
      }
    }

    // Calcul automatique de l'IMC dans la modal
    function updateModalImc() {
      const poids = parseFloat(document.getElementById('editPoids').value);
      const taille = parseFloat(document.getElementById('editTaille').value);
      if (!isNaN(poids) && !isNaN(taille) && poids > 0 && taille > 0) {
        const tm = taille / 100.0;
        const imc = (poids / (tm * tm)).toFixed(2);
        document.getElementById('editImc').value = imc;
      } else {
        document.getElementById('editImc').value = '-';
      }
    }

    // Gestion du submit du formulaire modal
    document.addEventListener('DOMContentLoaded', function() {
      // Attach IMC calculators to modal inputs
      const editPoids = document.getElementById('editPoids');
      const editTaille = document.getElementById('editTaille');
      if (editPoids) editPoids.addEventListener('input', updateModalImc);
      if (editTaille) editTaille.addEventListener('input', updateModalImc);

      // Permettre de cliquer sur les boutons d'humeur dans le modal pour cocher/décocher
      document.addEventListener('click', function(e) {
        // Vérifier si le clic est sur un bouton d'humeur dans le modal
        const moodButton = e.target.closest('.mood-button');
        if (!moodButton) return;
        
        const modal = moodButton.closest('#editModal');
        if (!modal) return; // Seulement dans le modal d'édition
        
        e.preventDefault();
        e.stopPropagation();
        
        const label = moodButton.closest('.mood-button-label');
        const checkbox = label.querySelector('input[type="checkbox"]');
        
        if (checkbox) {
          console.log('Avant toggle:', checkbox.value, 'checked:', checkbox.checked);
          // Toggle checkbox
          checkbox.checked = !checkbox.checked;
          console.log('Après toggle:', checkbox.value, 'checked:', checkbox.checked);
          
          // Update visual style
          if (checkbox.checked) {
            moodButton.style.border = '2px solid #3498db';
            moodButton.style.background = '#e8f4fd';
          } else {
            moodButton.style.border = '2px solid transparent';
            moodButton.style.background = '#ecf0f1';
          }
        }
      });

      // Handle modal form submit
      const editForm = document.getElementById('editForm');
      if (editForm) {
        editForm.addEventListener('submit', function(e) {
          e.preventDefault();
          console.log('Form submit intercepted');
          console.log('currentEntryId:', window.currentEntryId);
          console.log('currentEntryDate:', window.currentEntryDate);
          
          if (!window.currentEntryId) {
            alert('Aucune entrée sélectionnée.');
            return;
          }

          // Collect all form data using FormData constructor
          const formData = new FormData(editForm);
          // Set the date separately since it's not visible
          formData.set('sante_quotidienne[date]', window.currentEntryDate);
          
          // Collect all selected humeurs SEULEMENT du modal
          const modalElement = document.getElementById('editModal');
          const humeurs = modalElement.querySelectorAll('input[name="sante_quotidienne[humeur][]"]:checked');
          console.log('Humeurs cochées dans le modal:', humeurs.length);
          humeurs.forEach((humeur, index) => {
            console.log('Ajout humeur:', humeur.value);
            formData.append(`sante_quotidienne[humeur][${index}]`, humeur.value);
          });

          // Log form data for debugging
          console.log('Form data being sent:');
          for (let [key, value] of formData.entries()) {
            console.log(key + ':', value);
          }

          const url = `/sante-quotidienne/${window.currentEntryId}/edit`;
          console.log('Sending to URL:', url);

          fetch(url, {
            method: 'POST',
            body: formData,
            headers: {
              'X-Requested-With': 'XMLHttpRequest'
            }
          })
          .then(async res => {
            let payload = null;
            try {
              payload = await res.json();
            } catch (jsonError) {
              console.warn('Réponse non JSON:', jsonError);
            }

            console.log('Response status:', res.status);
            console.log('Response payload:', payload);

            if (res.ok && payload && payload.ok) {
              renderEditErrors(null);
              closeEditModal();
              location.reload();
              return;
            }

            const fallbackMessage = payload && payload.message ? payload.message : 'Une erreur est survenue.';
            const errors = payload && payload.errors ? payload.errors : { '_form': [fallbackMessage] };
            renderEditErrors(errors);
          })
          .catch(err => {
            console.error('Erreur détaillée:', err);
            renderEditErrors({ '_form': ['Erreur de connexion: ' + err.message] });
          });
        });
      }
    });
  </script>
    </div>
  </footer>

  <script>
    (function(){
      const poids = document.querySelector('input[name*="[poids]"]');
      const taille = document.querySelector('input[name*="[taille]"]');
      const imcSummary = document.getElementById('imc-summary');
      const serverImc = document.getElementById('server-imc');

      let timer = null;
      function fetchImc(){
        const p = poids?.value;
        const t = taille?.value;
        if (!p || !t) {
          if (imcSummary) imcSummary.style.display = 'none';
          if (serverImc) serverImc.textContent = '-';
          return;
        }

        const url = '{{ path('app_sante_quotidienne_calc_imc') }}?poids=' + encodeURIComponent(p) + '&taille=' + encodeURIComponent(t);
        fetch(url, { headers: { 'Accept': 'application/json' } })
          .then(res => res.json())
          .then(data => {
            if (data && data.ok) {
              serverImc.textContent = data.imc;
              // status
              const statusEl = document.getElementById('server-imc-status');
              const emojiEl = document.getElementById('server-imc-emoji');
              if (statusEl) {
                statusEl.textContent = data.label || '';
                statusEl.style.color = data.color || '';
              }
              if (emojiEl) {
                emojiEl.textContent = data.emoji || '📊';
              }
              imcSummary.style.display = 'block';
            } else {
              serverImc.textContent = '-';
              imcSummary.style.display = 'none';
            }
          })
          .catch(() => {
            serverImc.textContent = '-';
            imcSummary.style.display = 'none';
          });
      }

      function schedule(){
        clearTimeout(timer);
        timer = setTimeout(fetchImc, 300);
      }

      ['input','change'].forEach(evt => {
        poids?.addEventListener(evt, schedule);
        taille?.addEventListener(evt, schedule);
      });

      document.addEventListener('DOMContentLoaded', fetchImc);
    })();
  </script>

  <script>
    // Build a JS array of the user's sante entries (JSON-encoded per entry to handle enums/objects)
    const santeEntries = [
      {% for item in santes %}
        {% set canEdit = is_granted('SANTE_EDIT', item) %}
        {% set canDelete = is_granted('SANTE_DELETE', item) %}
        {% set actPhysique = 
          (item.activitePhysique is iterable and item.activitePhysique.value is defined) ? item.activitePhysique.value
          : (item.activitePhysique is iterable and item.activitePhysique[0] is defined) ? item.activitePhysique[0]
          : (item.activitePhysique is not null and item.activitePhysique.value is defined) ? item.activitePhysique.value
          : item.activitePhysique
        %}
        {% set humeurVal = 
          (item.humeur is iterable and item.humeur is not empty) ? 
            (item.humeur[0].value is defined ? (item.humeur|map(h => h.value)|join(', ')) : (item.humeur|join(', ')))
          : (item.humeur is not null and item.humeur.value is defined) ? item.humeur.value
          : item.humeur
        %}
        {{ ({
          id: item.id,
          date: item.date ? item.date|date('Y-m-d') : '',
          poids: item.poids,
          taille: item.taille,
          imc: item.imc,
          tensionArterielle: item.tensionArterielle,
          sommeil: item.sommeil,
          activitePhysique: actPhysique,
          humeur: humeurVal,
          alimentation: item.alimentation,
          eauBue: item.eauBue,
          editUrl: canEdit ? path('app_sante_quotidienne_edit', {'id': item.id}) : null,
          deleteUrl: canDelete ? path('app_sante_quotidienne_delete', {'id': item.id}) : null,
          deleteCsrf: canDelete ? csrf_token('delete' ~ item.id) : null
        } )|json_encode() }}{{ not loop.last ? ',' : '' }}
      {% endfor %}
    ];

    (function(){
      const calendarEl = document.getElementById('mini-calendar');
      const formEl = document.querySelector('form.form-beautiful');
      const saveButton = formEl.querySelector('button[type="submit"]');

      if (!calendarEl || !formEl) return;

      function formatDate(d){
        return d;
      }

      function clearSelection(){
        const chips = calendarEl.querySelectorAll('.cal-chip');
        chips.forEach(c => c.classList.remove('active'));
        // reset form action to default new
        formEl.action = '{{ path('app_sante_quotidienne_new') }}';
        saveButton.textContent = '💾 Enregistrer ma journée';

        // remove inline delete form if present
        const existing = document.getElementById('inline-delete-form');
        if (existing) existing.remove();
      }

      function renderCalendar(){
        calendarEl.innerHTML = '';
        if (!santeEntries || santeEntries.length === 0){
          calendarEl.innerHTML = '<div class="cal-empty">Aucune entrée</div>';
          return;
        }

        // Sort by date desc
        const entries = santeEntries.slice().sort((a,b)=> a.date < b.date ? 1 : -1);

        entries.forEach(e => {
          const btn = document.createElement('button');
          btn.type = 'button';
          btn.className = 'cal-chip';
          btn.title = e.date;
          btn.innerHTML = '<div class="cal-date">' + e.date + '</div>' + (e.imc ? '<div class="cal-imc">IMC ' + e.imc + '</div>' : '');
          btn.addEventListener('click', ()=> selectEntry(e, btn));
          calendarEl.appendChild(btn);
        });
      }

      function selectEntry(entry, chip){
        // highlight
        clearSelection();
        chip.classList.add('active');

        // populate form fields
        const find = (selector) => document.querySelector(selector);

        const dateInput = find('input[name*="[date]"]') || find('input[name*="[date]"]');
        const poidsInput = find('input[name*="[poids]"]');
        const tailleInput = find('input[name*="[taille]"]');
        const tensionInput = find('input[name*="[tensionArterielle]"]');
        const sommeilInput = find('input[name*="[sommeil]"]');
        const activiteInput = find('input[name*="[activitePhysique]"]');
        const alimentationInput = find('input[name*="[alimentation]"]') || find('textarea[name*="[alimentation]"]');
        const eauInput = find('input[name*="[eauBue]"]');

        if (dateInput) dateInput.value = entry.date || '';
        if (poidsInput) poidsInput.value = entry.poids !== null ? entry.poids : '';
        if (tailleInput) tailleInput.value = entry.taille !== null ? entry.taille : '';
        if (tensionInput) tensionInput.value = entry.tensionArterielle || '';
        if (sommeilInput) sommeilInput.value = entry.sommeil !== null ? entry.sommeil : '';
        if (activiteInput) activiteInput.value = entry.activitePhysique || '';
        if (alimentationInput) alimentationInput.value = entry.alimentation || '';
        if (eauInput) eauInput.value = entry.eauBue !== null ? entry.eauBue : '';

        // select humeur checkboxes if present
        if (entry.humeur && Array.isArray(entry.humeur)){
          entry.humeur.forEach(humeurValue => {
            const moodInput = document.querySelector('input[type="checkbox"][name*="[humeur]"][value="' + humeurValue + '"]');
            if (moodInput) moodInput.checked = true;
          });
        } else if (entry.humeur) {
          // Si c'est une seule valeur (compatibilité)
          const moodInput = document.querySelector('input[type="checkbox"][name*="[humeur]"][value="' + entry.humeur + '"]');
          if (moodInput) moodInput.checked = true;
        }

        // change form action to edit URL
        if (entry.editUrl){
          formEl.action = entry.editUrl;
          saveButton.textContent = '✏️ Mettre à jour';
        }

        // add delete inline button/form (only if allowed)
        const existing = document.getElementById('inline-delete-form');
        if (existing) existing.remove();

        if (entry.deleteUrl) {
          const delForm = document.createElement('form');
          delForm.id = 'inline-delete-form';
          delForm.method = 'post';
          delForm.action = entry.deleteUrl;
          delForm.style.display = 'inline-block';
          delForm.style.marginLeft = '8px';

          const tokenInput = document.createElement('input');
          tokenInput.type = 'hidden';
          tokenInput.name = '_token';
          tokenInput.value = entry.deleteCsrf || '';
          delForm.appendChild(tokenInput);

          const delBtn = document.createElement('button');
          delBtn.type = 'submit';
          delBtn.className = 'btn-small btn-danger';
          delBtn.textContent = 'Supprimer';
          delBtn.addEventListener('click', function(e){
            if (!confirm('Supprimer cette entrée ?')) e.preventDefault();
          });
          delForm.appendChild(delBtn);

          // append next to save button
          saveButton.parentNode.insertBefore(delForm, saveButton.nextSibling);
        }

        // scroll form into view
        formEl.scrollIntoView({ behavior: 'smooth', block: 'center' });
      }

      // click outside to clear selection
      document.addEventListener('click', function(e){
        if (!calendarEl.contains(e.target) && !formEl.contains(e.target)){
          // do not clear when clicking inside form
          // keep selection
        }
      });

      renderCalendar();
    })();

  </script>

  <!-- JavaScript pour les boîtes de recommandations -->
  <script>
    document.addEventListener('DOMContentLoaded', function() {
      // Gestionnaire pour le bouton chatbot
      const chatbotBtn = document.querySelector('.btn-chatbot');
      const chatbotModalOverlay = document.getElementById('chatbotModalOverlay');
      const chatbotCloseBtn = document.getElementById('chatbotCloseBtn');
      const chatbotForm = document.getElementById('chatbotForm');
      const chatbotInput = document.getElementById('chatbotInput');
      const chatbotMessages = document.getElementById('chatbotMessages');
      const chatbotEndpoint = '{{ path('app_sante_quotidienne_chatbot_empathy') }}';

      function appendChatMessage(text, type, meta) {
        if (!chatbotMessages) return;
        const el = document.createElement('div');
        el.className = 'chatbot-msg ' + type;
        el.textContent = text;
        if (meta) {
          const metaEl = document.createElement('span');
          metaEl.className = 'chatbot-meta';
          metaEl.textContent = meta;
          el.appendChild(metaEl);
        }
        chatbotMessages.appendChild(el);
        chatbotMessages.scrollTop = chatbotMessages.scrollHeight;
      }

      function setChatOpen(open) {
        if (!chatbotModalOverlay) return;
        chatbotModalOverlay.style.display = open ? 'flex' : 'none';
        if (open && chatbotInput) chatbotInput.focus();
      }

      if (chatbotBtn) chatbotBtn.addEventListener('click', () => setChatOpen(true));
      if (chatbotCloseBtn) chatbotCloseBtn.addEventListener('click', () => setChatOpen(false));
      if (chatbotModalOverlay) {
        chatbotModalOverlay.addEventListener('click', (e) => {
          if (e.target === chatbotModalOverlay) setChatOpen(false);
        });
      }
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && chatbotModalOverlay && chatbotModalOverlay.style.display === 'flex') {
          setChatOpen(false);
        }
      });

      if (chatbotForm) {
        chatbotForm.addEventListener('submit', async function(e) {
          e.preventDefault();
          const message = chatbotInput ? chatbotInput.value.trim() : '';
          if (!message) return;
          appendChatMessage(message, 'user');
          if (chatbotInput) chatbotInput.value = '';

          try {
            const res = await fetch(chatbotEndpoint, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ message })
            });
            const data = await res.json();
            if (!res.ok || !data.ok) {
              appendChatMessage(data.message || 'Erreur de traitement.', 'bot');
              return;
            }
            const meta = `emotion: ${data.emotion} | intent: ${data.intent}`;
            appendChatMessage(data.response || 'Je suis la pour vous aider.', 'bot', meta);
          } catch (err) {
            appendChatMessage('Erreur reseau. Veuillez reessayer.', 'bot');
          }
        });
      }

      // Gestionnaire pour le bouton activité
      const activityBtn = document.querySelector('.btn-activity');
      if (activityBtn) {
        activityBtn.addEventListener('click', function() {
          // Rediriger vers la page des programmes sportifs
          alert('Redirection vers les programmes sportifs - fonctionnalité en développement');
        });
      }

      // Gestionnaire pour le bouton nutrition
      const nutritionBtn = document.querySelector('.btn-nutrition');
      if (nutritionBtn) {
        nutritionBtn.addEventListener('click', function() {
          // Rediriger vers la page des nutritionnistes
          alert('Redirection vers les conseils nutritionnels - fonctionnalité en développement');
        });
      }

      // Gestionnaire pour le bouton d'abonnement
      const subscribeBtns = document.querySelectorAll('.btn-subscribe');
      subscribeBtns.forEach(btn => {
        btn.addEventListener('click', function() {
          alert('Fonctionnalité d\'abonnement bientôt disponible ! Contactez-nous pour un accompagnement personnalisé.');
        });
      });
    });
  </script>
