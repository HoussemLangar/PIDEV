{% extends 'front/base.html.twig' %}

{% block title %}Tracker Santé - SANTÉA{% endblock %}

{% block stylesheets %}
  {{ parent() }}
  <link rel="stylesheet" href="{{ asset('assets/css/santet.css') }}"/>
  <style>
    .health-tracker-page-neutral {
      background: #f5f7fb;
      padding-left: 0;
    }
    .health-tracker-page-neutral::before,
    .health-tracker-page-neutral::after {
      content: none;
    }
    body {
      background: #f5f7fb;
    }
    .content-hero {
      background: #f5f7fb;
      border-color: #e5e7eb;
      box-shadow: none;
      width: 100%;
    }
    .content-page {
      padding-left: 0.15vw;
      padding-right: 0.15vw;
      width: 85%;
    }
    .container-wide {
      max-width: 1600px;
      margin: 0 auto;
      padding: 0 20px 28px;
    }
    .summary-cards {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 14px;
      margin-bottom: 14px;
    }
    .main-content-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 20px;
      align-items: start;
      margin-top: 10px;
    }
    .form-section-beautiful {
      background: white;
      border-radius: 12px;
      padding: 20px;
      box-shadow: 0 3px 15px rgba(0,0,0,0.1);
      height: fit-content;
      margin-top: 0 !important;
    }
    .form-card-beautiful {
      max-width: 100% !important;
      width: 100% !important;
      margin: 0 !important;
    }
    .recent-entries-beautiful {
      margin-top: 0 !important;
      height: auto !important;
      max-height: none !important;
    }
    .recommendations-section {
      margin-top: 22px;
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 16px;
    }
    .recommendation-box {
      color: #fff;
      padding: 14px 16px;
      border-radius: 12px;
      box-shadow: 0 4px 15px rgba(0,0,0,0.1);
      background: var(--rec-grad, linear-gradient(135deg, #4facfe 0%, #00f2fe 100%));
    }
    .form-header-beautiful {
      margin-bottom: 18px;
      padding-bottom: 15px;
      border-bottom: 2px solid #f0f0f0;
    }
    .form-header-beautiful h2 {
      font-size: 1.3rem;
      color: #2c3e50;
      margin: 0;
      font-weight: 700;
    }
    .form-beautiful {
      display: flex;
      flex-direction: column;
      gap: 15px;
    }
    .form-group-beautiful {
      display: flex;
      flex-direction: column;
    }
    .form-group-beautiful label {
      font-size: 0.9rem;
      color: #2c3e50;
      font-weight: 600;
      margin-bottom: 6px;
    }
    .form-group-beautiful input,
    .form-group-beautiful select,
    .form-group-beautiful textarea {
      padding: 10px 12px;
      border: 2px solid #e0e0e0;
      border-radius: 10px;
      font-size: 0.9rem;
      transition: all 0.3s ease;
      background: #f8f9fa;
    }
    .form-group-beautiful input:focus,
    .form-group-beautiful select:focus,
    .form-group-beautiful textarea:focus {
      outline: none;
      border-color: #4ecdc4;
      box-shadow: 0 0 0 3px rgba(78, 205, 196, 0.1);
      background: white;
    }
    .form-row-beautiful {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 12px;
    }
    .btn-save-beautiful {
      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      color: white;
      border: none;
      padding: 12px;
      border-radius: 10px;
      font-size: 1rem;
      font-weight: 700;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      box-shadow: 0 3px 15px rgba(102, 126, 234, 0.4);
      transition: all 0.3s ease;
      flex: 1;
    }
    .btn-save-beautiful:hover {
      transform: translateY(-2px);
      box-shadow: 0 5px 20px rgba(102, 126, 234, 0.5);
    }
    .history-section-beautiful {
      display: flex;
      flex-direction: column;
      gap: 15px;
      height: fit-content;
    }
    .chart-beautiful {
      background: white;
      border-radius: 12px;
      padding: 18px;
      box-shadow: 0 3px 15px rgba(0,0,0,0.1);
      height: fit-content;
    }
    .stats-visual {
      margin: 14px 0 22px;
    }
    .stats-visual .chart-beautiful h3 {
      margin: 0 0 10px;
      font-size: 1rem;
      color: #2c3e50;
      font-weight: 700;
    }
    .stats-visual canvas {
      width: 100% !important;
      height: 250px !important;
    }
    .risk-widget {
      background: #fff;
      border-radius: 12px;
      box-shadow: 0 3px 15px rgba(0,0,0,0.08);
      padding: 16px;
      margin: 8px 0 20px;
      border-left: 4px solid #2563eb;
    }
    .risk-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 12px;
      margin-top: 10px;
    }
    .risk-item {
      border: 1px solid #e5e7eb;
      border-radius: 10px;
      padding: 10px;
      background: #f9fafb;
    }
    .risk-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 8px;
      margin-bottom: 6px;
    }
    .risk-badge {
      font-size: 11px;
      font-weight: 700;
      padding: 3px 8px;
      border-radius: 999px;
      text-transform: uppercase;
    }
    .risk-badge.low {
      background: #dcfce7;
      color: #166534;
    }
    .risk-badge.moderate {
      background: #fef3c7;
      color: #92400e;
    }
    .risk-badge.high {
      background: #fee2e2;
      color: #991b1b;
    }
    .risk-score {
      font-weight: 700;
      color: #1f2937;
      margin-bottom: 4px;
    }
    .risk-note {
      font-size: 12px;
      color: #4b5563;
      margin: 0;
    }
    .chatbot-modal-overlay {
      position: fixed;
      inset: 0;
      background: rgba(17, 24, 39, 0.55);
      z-index: 9000;
      display: none;
      align-items: center;
      justify-content: center;
      padding: 16px;
    }
    .chatbot-modal {
      width: min(680px, 100%);
      background: #ffffff;
      border-radius: 14px;
      overflow: hidden;
      box-shadow: 0 16px 44px rgba(15, 23, 42, 0.28);
      display: flex;
      flex-direction: column;
      max-height: 80vh;
    }
    .chatbot-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 14px 16px;
      background: #eef2ff;
      border-bottom: 1px solid #dbe2ff;
    }
    .chatbot-close {
      border: none;
      background: transparent;
      font-size: 20px;
      cursor: pointer;
      color: #334155;
    }
    .chatbot-messages {
      padding: 14px;
      overflow-y: auto;
      flex: 1;
      background: #f8fafc;
      display: flex;
      flex-direction: column;
      gap: 8px;
    }
    .chatbot-msg {
      max-width: 86%;
      padding: 9px 12px;
      border-radius: 12px;
      line-height: 1.35;
      font-size: 14px;
    }
    .chatbot-msg.user {
      align-self: flex-end;
      background: #dbeafe;
      color: #1e3a8a;
    }
    .chatbot-msg.bot {
      align-self: flex-start;
      background: #ffffff;
      color: #0f172a;
      border: 1px solid #e2e8f0;
    }
    .chatbot-meta {
      display: block;
      margin-top: 6px;
      font-size: 11px;
      color: #64748b;
      text-transform: uppercase;
      letter-spacing: 0.03em;
    }
    .chatbot-input-wrap {
      display: flex;
      gap: 8px;
      padding: 12px;
      border-top: 1px solid #e2e8f0;
      background: #ffffff;
    }
    .chatbot-input-wrap textarea {
      flex: 1;
      resize: none;
      min-height: 44px;
      max-height: 120px;
      border: 1px solid #cbd5e1;
      border-radius: 10px;
      padding: 10px;
      font-size: 14px;
      font-family: inherit;
    }
    .chatbot-send {
      border: none;
      border-radius: 10px;
      background: #1d4ed8;
      color: #ffffff;
      font-weight: 700;
      padding: 0 14px;
      cursor: pointer;
    }
    @media (max-width: 1100px) {
      .summary-cards {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
      .main-content-grid {
        grid-template-columns: 1fr;
      }
      .form-row-beautiful {
        grid-template-columns: 1fr;
      }
      .recommendations-section {
        grid-template-columns: 1fr;
      }
    }
    @media (max-width: 640px) {
      .summary-cards {
        grid-template-columns: 1fr;
      }
    }
  </style>
{% endblock %}

{% block body %}
  <main class="health-tracker-page-v2 health-tracker-page-neutral" style="position:relative; background:#f5f7fb; background-image:none;">
    
    <section class="content-page">
    <div class="container-wide" style="position:relative; z-index:2;">
      
      <!-- Messages flash -->
      {% for message in app.flashes('success') %}
        <div class="alert alert-success flash-success" style="margin-bottom:15px; padding:12px; background:#d4edda; border:1px solid #c3e6cb; border-radius:4px; color:#155724;">
          ✅ {{ message }}
        </div>
      {% endfor %}
      <script>
        document.addEventListener('DOMContentLoaded', function() {
          const notif = document.querySelector('.flash-success');
          if (notif) {
            setTimeout(() => {
              notif.style.transition = 'opacity 0.5s';
              notif.style.opacity = 0;
              setTimeout(() => notif.remove(), 600);
            }, 2000);
          }
        });
      </script>
      {% for message in app.flashes('error') %}
        <div class="alert alert-danger" style="margin-bottom:15px; padding:12px; background:#f8d7da; border:1px solid #f5c6cb; border-radius:4px; color:#721c24;">
          ❌ {{ message }}
        </div>
      {% endfor %}

      <section class="content-hero">
        <div class="content-header">
          <div>
            <div class="profile-badge">Tracker Santé</div>
            <h1>Mon Journal Santé</h1>
            <p>Prenez soin de vous jour après jour.</p>
          </div>
          <div style="display:flex; gap:10px; flex-wrap:wrap;">
            {% if app.user and app.user.googleFitAccount %}
              <form method="post" action="{{ path('google_fit_sync') }}" data-ajax="1">
                <input type="hidden" name="days" value="7">
                <button type="submit" class="btn btn-secondary">Synchroniser Google Fit</button>
              </form>
              <form method="post" action="{{ path('google_fit_disconnect') }}" data-ajax="1">
                <button type="submit" class="btn btn-secondary">Déconnecter Google Fit</button>
              </form>
            {% else %}
              <a href="{{ path('google_fit_connect') }}" class="btn btn-primary">Connecter Google Fit</a>
            {% endif %}
          </div>
        </div>
      </section>

      <!-- Résumé rapide avec emojis -->
      <div class="summary-cards">
        <div class="summary-card card-pulse">
          <div class="card-emoji">⚖️</div>
          <div class="card-info">
            <span class="card-label">Mon Poids</span>
            <span class="card-value" id="current-weight">{{ summaryStats.latestWeight is not null ? summaryStats.latestWeight|number_format(1, '.', ' ') : '--' }}</span>
            <span class="card-unit">kg</span>
          </div>
        </div>

        <div class="summary-card card-pulse">
          <div class="card-emoji">😴</div>
          <div class="card-info">
            <span class="card-label">Sommeil</span>
            <span class="card-value" id="avg-sleep">{{ averageSommeil is not null ? averageSommeil|number_format(1, '.', ' ') : '--' }}</span>
            <span class="card-unit">heures/nuit</span>
          </div>
        </div>

        <div class="summary-card card-pulse">
          <div class="card-emoji">🏃</div>
          <div class="card-info">
            <span class="card-label">Activité</span>
            <span class="card-value" id="total-activity">{{ summaryStats.weeklyActivityMinutes > 0 ? summaryStats.weeklyActivityMinutes|number_format(0, '.', ' ') : '--' }}</span>
            <span class="card-unit">min/semaine</span>
          </div>
        </div>

        <div class="summary-card card-pulse">
          <div class="card-emoji">💧</div>
          <div class="card-info">
            <span class="card-label">Hydratation</span>
            <span class="card-value" id="total-water">{{ summaryStats.averageWater is not null ? summaryStats.averageWater|number_format(1, '.', ' ') : '--' }}</span>
            <span class="card-unit">L/jour</span>
          </div>
        </div>
      </div>

      {% if app.user and app.user.googleFitAccount %}
      <div class="summary-cards">
        <div class="summary-card card-pulse">
          <div class="card-emoji">👣</div>
          <div class="card-info">
            <span class="card-label">Pas (Google Fit)</span>
            <span class="card-value">{{ googleFitLatest.pas is not null ? googleFitLatest.pas : '--' }}</span>
            <span class="card-unit">aujourd'hui</span>
          </div>
        </div>

        <div class="summary-card card-pulse">
          <div class="card-emoji">🔥</div>
          <div class="card-info">
            <span class="card-label">Calories</span>
            <span class="card-value">{{ googleFitLatest.calories is not null ? googleFitLatest.calories|number_format(0) : '--' }}</span>
            <span class="card-unit">kcal</span>
          </div>
        </div>

        <div class="summary-card card-pulse">
          <div class="card-emoji">⏱️</div>
          <div class="card-info">
            <span class="card-label">Minutes actives</span>
            <span class="card-value">{{ googleFitLatest.dureeActiviteMinutes is not null ? googleFitLatest.dureeActiviteMinutes : '--' }}</span>
            <span class="card-unit">min</span>
          </div>
        </div>

        <div class="summary-card card-pulse">
          <div class="card-emoji">📈</div>
          <div class="card-info">
            <span class="card-label">Moyenne 7j</span>
            <span class="card-value">{{ googleFitAvgSteps is not null ? googleFitAvgSteps|number_format(0) : '--' }}</span>
            <span class="card-unit">pas/jour</span>
          </div>
        </div>
      </div>
      <div style="margin-top:6px; color:#6b7280; font-size:0.85rem;">
        Dernière synchronisation :
        {{ app.user.googleFitAccount.lastSyncAt ? app.user.googleFitAccount.lastSyncAt|date('d/m/Y H:i') : '—' }}
      </div>
      {% endif %}

      {% if riskPrediction is defined %}
      <section class="risk-widget">
        <h3 style="margin:0; font-size:1.05rem; color:#1f2937;">Risque santé aujourd'hui</h3>
        <p style="margin:6px 0 0; color:#6b7280; font-size:0.9rem;">
          Aide à l'orientation (pas un diagnostic). Mise à jour: {{ riskPrediction.updatedAt }}
        </p>
        <div class="risk-grid">
          {% set riskItems = [
            {'label':'Hypertension (HTA)','key':'htn'},
            {'label':'Risque diabète','key':'diabetes'},
            {'label':'Dépression légère','key':'depression'},
            {'label':'Risque déséquilibre alimentaire','key':'nutrition'}
          ] %}
          {% for item in riskItems %}
            {% set data = attribute(riskPrediction, item.key) %}
            {% set lvl = data.level|lower %}
            <article class="risk-item">
              <div class="risk-head">
                <strong style="font-size:0.92rem;">{{ item.label }}</strong>
                <span class="risk-badge {{ lvl == 'low' ? 'low' : (lvl == 'moderate' ? 'moderate' : 'high') }}">
                  {{ lvl == 'low' ? 'faible' : (lvl == 'moderate' ? 'modéré' : 'élevé') }}
                </span>
              </div>
              <div class="risk-score">{{ data.score|number_format(1, '.', ' ') }} / 100</div>
              <p class="risk-note">
                {{ data.explanations is defined and data.explanations|length > 0 ? data.explanations|first : '' }}
              </p>
              {% if data.details is defined and data.details|length > 0 %}
                <div class="risk-note" style="margin-top:6px; font-size:0.82rem;">
                  {{ data.details|slice(0, 3)|join(' | ') }}
                </div>
              {% endif %}
            </article>
          {% endfor %}
        </div>
      </section>
      {% endif %}

      <section class="stats-visual">
        <div class="chart-beautiful">
          <h3>Tension (7 derniers jours)</h3>
          <canvas id="weeklySimpleChart"></canvas>
        </div>
      </section>

      <!-- Contenu principal en 2 colonnes -->
      <div class="main-content-grid">
        <!-- Colonne gauche - Formulaire Symfony -->
        <div class="form-section-beautiful" id="form-section" style="grid-column: 1;">
          <div class="form-card-beautiful">
            <div class="form-header-beautiful">
              <h2>📝 Comment allez-vous aujourd'hui ?</h2>
              <p style="font-size:0.9em; color:#666; margin-top:5px;">
                <span style="color:#e74c3c; font-weight:bold;">*</span> = Champ obligatoire
                <span style="margin-left:20px; color:#95a5a6;">○</span> = Optionnel
              </p>
            </div>
            
            {{ form_start(form, {
              'action': form.vars.data.id ? path('app_sante_quotidienne_edit', {'id': form.vars.data.id}) : path('app_sante_quotidienne_new'),
              'method': 'POST',
              'attr': {
                'class': 'form-beautiful',
                'id': 'sante-form',
                'novalidate': 'novalidate'
              }
            }) }}
      <script>
        console.log('Form action URL:', document.getElementById('sante-form') ? document.getElementById('sante-form').action : 'form not found');
        document.getElementById('sante-form')?.addEventListener('submit', function(e) {
          console.log('Form is being submitted!');
          console.log('Form data:', new FormData(this));
          const formData = new FormData(this);
          for (let pair of formData.entries()) {
            console.log(pair[0] + ': ' + pair[1]);
          }
        });
      </script>
      <script>
        document.addEventListener('DOMContentLoaded', function() {
          var form = document.getElementById('sante-form');
          if (form) {
            // Reset complet du formulaire à chaque chargement de page
            form.reset();
            
            // Force la date d'aujourd'hui
            var dateInput = form.querySelector('input[name*="[date]"]');
            if (dateInput) {
              var today = new Date();
              var dd = String(today.getDate()).padStart(2, '0');
              var mm = String(today.getMonth() + 1).padStart(2, '0');
              var yyyy = today.getFullYear();
              dateInput.value = yyyy + '-' + mm + '-' + dd;
            }
            
            // Force tous les autres champs à être vides
            var inputs = form.querySelectorAll('input[type="text"], input[type="number"], input[type="email"], textarea, select');
            inputs.forEach(function(input) {
              if (!input.name.includes('[date]')) {
                input.value = '';
              }
            });
            
            // Décoche tous les radio/checkbox
            var radios = form.querySelectorAll('input[type="radio"], input[type="checkbox"]');
            radios.forEach(function(radio) {
              radio.checked = false;
            });
          }
        });
      </script>

              {# Affichage des erreurs globales du formulaire #}
              {% if form.vars.errors|length > 0 %}
                <div class="alert alert-danger" style="margin-bottom:15px; padding:14px; background:linear-gradient(135deg, #fff5f5 0%, #ffe0e0 100%); border-left:4px solid #e74c3c; border-radius:4px; color:#721c24;">
                  <strong style="font-size:1.1em;">⚠️ Erreurs de validation</strong>
                  <ul style="margin-top:10px; margin-bottom:0; padding-left:20px;">
                    {% for error in form.vars.errors %}
                      <li style="margin-bottom:5px;">{{ error.message }}</li>
                    {% endfor %}
                  </ul>
                </div>
              {% endif %}

              {# Date & Poids côte à côte #}
              <div class="form-row-beautiful">
                <div class="form-group-beautiful">
                  <label style="display:flex; align-items:center; gap:8px;">
                    {{ form_label(form.date, '📅 Date', {'label_attr': {'class': ''}}) }}
                    <span style="color:#e74c3c; font-weight:bold; font-size:1.2em;">*</span>
                  </label>
                  {{ form_widget(form.date, {'attr': {'class': 'form-control'}}) }}
                  {{ form_errors(form.date) }}
                </div>

                <div class="form-group-beautiful">
                  <label style="display:flex; align-items:center; gap:8px;">
                    {{ form_label(form.poids, '⚖️ Poids (kg)', {'label_attr': {'class': ''}}) }}
                    <span style="color:#e74c3c; font-weight:bold; font-size:1.2em;">*</span>
                  </label>
                  {{ form_widget(form.poids, {'attr': {'step': '0.1', 'placeholder': 'Ex: 70.5', 'class': 'form-control'}}) }}
                  {{ form_errors(form.poids) }}
                </div>
              </div>

              {# Taille & Tension côte à côte #}
              <div class="form-row-beautiful">
                <div class="form-group-beautiful">
                  <label style="display:flex; align-items:center; gap:8px;">
                    {{ form_label(form.taille, '📏 Taille (cm)', {'label_attr': {'class': ''}}) }}
                    <span style="color:#e74c3c; font-weight:bold; font-size:1.2em;">*</span>
                  </label>
                  {{ form_widget(form.taille, {'attr': {'step': '0.1', 'placeholder': 'Ex: 175', 'class': 'form-control'}}) }}
                  {{ form_errors(form.taille) }}
                </div>

                <div class="form-group-beautiful">
                  <label style="display:flex; align-items:center; gap:8px;">
                    {{ form_label(form.tensionArterielle, '❤️ Tension', {'label_attr': {'class': ''}}) }}
                    <span style="color:#95a5a6; font-size:0.85em;">○ optionnel</span>
                  </label>
                  {{ form_widget(form.tensionArterielle, {'attr': {'placeholder': 'Ex: 14 (ou 140)', 'class': 'form-control'}}) }}
                  {{ form_errors(form.tensionArterielle) }}
                </div>
              </div>

              {# IMC calculé côté serveur via l'entité; affichage client utilisant endpoint serveur #}
              <div class="imc-summary" id="imc-summary" style="margin-top:10px; display:none; font-weight:600;">
                IMC : <span id="server-imc">-</span>
                &nbsp;•&nbsp;
                <span id="server-imc-emoji">📊</span>
                <span id="server-imc-status" style="margin-left:6px;">-</span>
              </div>

              {# Tension artérielle #}
              {# (déplacée avec Taille ci-dessus) #}

              {# Sommeil & Activité #}
              <div class="form-row-beautiful">
                <div class="form-group-beautiful">
                  <label style="display:flex; align-items:center; gap:8px;">
                    {{ form_label(form.sommeil, '😴 Sommeil (h)', {'label_attr': {'class': ''}}) }}
                    <span style="color:#95a5a6; font-size:0.85em;">○ optionnel</span>
                  </label>
                  {{ form_widget(form.sommeil, {'attr': {'step': '0.5', 'placeholder': '8', 'class': 'form-control'}}) }}
