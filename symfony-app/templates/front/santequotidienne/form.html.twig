          </div>
          <div class="mini-calendar-container" style="margin:10px 0 16px; display:flex; justify-content:center; align-items:center;">
            <div id="mini-calendar" class="mini-calendar"></div>
            <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
            <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
            <script>
              document.addEventListener('DOMContentLoaded', function() {
                var dates = [
                  {% for item in santes %}
                    "{{ item.date|date('Y-m-d') }}"{% if not loop.last %},{% endif %}
                  {% endfor %}
                ];
                
                const details = document.getElementById('entry-details-placeholder');
                
                flatpickr("#mini-calendar", {
                  inline: true,
                  locale: 'fr',
                  disableMobile: true,
                  onDayCreate: function(dObj, dStr, fp, dayElem) {
                    // Format local YYYY-MM-DD sans UTC
                    const pad = n => n < 10 ? '0'+n : n;
                    const localDate = dayElem.dateObj.getFullYear() + '-' + pad(dayElem.dateObj.getMonth()+1) + '-' + pad(dayElem.dateObj.getDate());
                    if (dates.includes(localDate)) {
                      dayElem.classList.add('has-entry');
                    }
                  },
                  onChange: function(selectedDates, dateStr, instance) {
                    if (selectedDates.length === 0) return;
                    
                    const pad = n => n < 10 ? '0'+n : n;
                    const selectedDate = selectedDates[0];
                    const dateFormatted = selectedDate.getFullYear() + '-' + pad(selectedDate.getMonth()+1) + '-' + pad(selectedDate.getDate());
                    
                    // Vérifie si c'est une date enregistrée
                    if (!dates.includes(dateFormatted)) {
                      details.innerHTML = '<div class="empty-state"><p>Aucune donnée pour cette journée.</p></div>';
                      return;
                    }
                    
                    // Affiche un loader
                    details.innerHTML = '<div class="empty-state"><span class="empty-emoji">⏳</span><p>Chargement...</p></div>';
                    
                    // Requête AJAX vers l'API
                    fetch('{{ path('app_sante_quotidienne_by_date') }}?date=' + encodeURIComponent(dateFormatted))
                      .then(response => {
                        console.log('Statut réponse:', response.status);
                        if (!response.ok) {
                          throw new Error(`HTTP error! status: ${response.status}`);
                        }
                        return response.json();
                      })
                      .then(data => {
                        console.log('Données reçues:', data);
                        if (data.ok) {
                          details.innerHTML = `
                            <div class="entry-item">
                              <div class="entry-main">
                                <div><strong>${data.date}</strong></div>
                                <div>Poids: ${data.poids} kg — Taille: ${data.taille} cm — IMC: ${data.imc || '-'}</div>
                              </div>
                              <div class="entry-actions">
                                <button class="btn-small btn-view" onclick='showEditModalByDate("${data.dateFormatted}", ${data.id})'>Voir</button>
                              </div>
                            </div>
                          `;
                        } else {
                          details.innerHTML = '<div class="empty-state"><p>' + (data.message || 'Aucune donnée pour cette journée.') + '</p></div>';
                        }
                      })
                      .catch(error => {
                        console.error('Erreur détaillée:', error);
                        details.innerHTML = '<div class="empty-state"><span class="empty-emoji">❌</span><p>Erreur de chargement: ' + error.message + '</p></div>';
                      });
                  }
                });
              });
            </script>
