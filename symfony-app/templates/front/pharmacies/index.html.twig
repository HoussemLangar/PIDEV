{% extends 'front/base.html.twig' %}

{% block title %}Pharmacies{% endblock %}

{% block body %}
<section class="container">
    <h1 class="section-title">Pharmacies</h1>
    <div class="pharmacy-grid">
        {% for pharmacy in pharmacies %}
            <div class="card pharmacy-card">
                <h3>{{ pharmacy.nom }}</h3>
                <p>{{ pharmacy.adresse }}{% if pharmacy.ville %}, {{ pharmacy.ville }}{% endif %}</p>
                <a class="btn-primary" href="{{ path('front_pharmacies_show', {id: pharmacy.id}) }}">Voir</a>
            </div>
        {% else %}
            <div class="empty-state">Aucune pharmacie.</div>
        {% endfor %}
    </div>
</section>
{% endblock %}
