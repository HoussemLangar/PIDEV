{% extends 'front/base.html.twig' %}

{% block title %}{{ pharmacy.nom }}{% endblock %}

{% block body %}
<section class="container">
    <h1 class="section-title">{{ pharmacy.nom }}</h1>
    <p>{{ pharmacy.adresse }}{% if pharmacy.ville %}, {{ pharmacy.ville }}{% endif %}</p>
    <p>Téléphone: {{ pharmacy.telephone }}</p>
    <p>Email: {{ pharmacy.email }}</p>
    <p>Horaires: {{ pharmacy.horaires }}</p>
</section>
{% endblock %}
