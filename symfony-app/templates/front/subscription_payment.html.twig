{% extends 'front/base.html.twig' %}

{% block title %}Paiement{% endblock %}

{% block body %}
<section class="payment-page">
    <div class="payment-shell">
        <div class="payment-left">
            <div class="payment-title">
                <div class="payment-badge">Paiement sécurisé</div>
                <h1>Finalisez votre abonnement</h1>
                <p>Abonnement sélectionné : <strong>{{ type }}</strong> — 10 DT / mois</p>
            </div>

            {% for message in app.flashes('error') %}
                <div class="alert alert-danger">{{ message }}</div>
            {% endfor %}
            {% for message in app.flashes('success') %}
                <div class="alert alert-success">{{ message }}</div>
            {% endfor %}

            <form method="post" class="payment-form">
                <div class="payment-field">
                    <label>Nom du titulaire</label>
                    <input type="text" name="card_name" placeholder="Ex: Iheb Hadded" required>
                </div>
                <div class="payment-field">
                    <label>Numéro de carte</label>
                    <input type="text" name="card_number" inputmode="numeric" maxlength="19" placeholder="1234 5678 9012 3456" required>
                </div>
                <div class="payment-grid">
                    <div class="payment-field">
                        <label>Mois</label>
                        <input type="number" name="exp_month" min="1" max="12" placeholder="MM" required>
                    </div>
                    <div class="payment-field">
                        <label>Année</label>
                        <input type="number" name="exp_year" min="2024" max="2100" placeholder="YYYY" required>
                    </div>
                    <div class="payment-field">
                        <label>CVV</label>
                        <input type="password" name="cvv" minlength="3" maxlength="4" placeholder="***" required>
                    </div>
                </div>
                <div class="payment-actions">
                    <button class="btn-appointment" type="submit">Payer 10 DT</button>
                    <a class="btn-ghost" href="{{ path('app_subscription') }}">Retour</a>
                </div>
            </form>
        </div>
        <aside class="payment-right">
            <div class="payment-summary">
                <h3>Résumé</h3>
                <div class="summary-row">
                    <span>Plan</span>
                    <strong>{{ type }}</strong>
                </div>
                <div class="summary-row">
                    <span>Durée</span>
                    <strong>1 mois</strong>
                </div>
                <div class="summary-row">
                    <span>Renouvellement</span>
                    <strong>Mensuel</strong>
                </div>
                <div class="summary-total">
                    <span>Total</span>
                    <strong>10 DT</strong>
                </div>
            </div>
            <div class="payment-trust">
                <div class="trust-item">🔒 Paiement sécurisé</div>
                <div class="trust-item">✅ Annulation possible</div>
                <div class="trust-item">⚡ Activation immédiate</div>
            </div>
        </aside>
    </div>
</section>
{% endblock %}
