{% block javascripts %}
    {{ parent() }}
    <script src="{{ asset('js/form-validation.js') }}"></script>
    <script src="{{ asset('js/date-input-script.js') }}"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            
            console.log('🔍 Initialisation du gestionnaire de validation...');
            
            // ============================================
            // 1. DÉTECTION AUTOMATIQUE DES ERREURS
            // ============================================
            
            /**
            * Ajoute la classe 'has-error' aux form-groups contenant des erreurs
            */
            function markErrorFields() {
                // Sélectionner tous les messages d'erreur Symfony
                const errorMessages = document.querySelectorAll('.form-error, .invalid-feedback, ul.form-errors');
                
                errorMessages.forEach(function(errorMsg) {
                    // Trouver le form-group parent
                    const formGroup = errorMsg.closest('.form-group');
                    
                    if (formGroup) {
                        // Ajouter la classe d'erreur au groupe
                        formGroup.classList.add('has-error');
                        
                        // Trouver l'input dans ce groupe
                        const input = formGroup.querySelector('input, select, textarea');
                        
                        if (input) {
                            // Ajouter la classe d'erreur à l'input
                            input.classList.add('is-invalid');
                            
                            // Marquer le label comme erreur
                            const label = formGroup.querySelector('label');
                            if (label) {
                                label.classList.add('error-label');
                            }
                            
                            // Pour les champs de mot de passe
                            const passwordWrapper = input.closest('.password-input');
                            if (passwordWrapper) {
                                passwordWrapper.classList.add('has-error');
                            }
                            
                            console.log(`❌ Erreur détectée sur: ${input.name || input.id}`);
                        }
                    }
                });
            }
            
            // ============================================
            // 2. AMÉLIORATION DES ALERTES
            // ============================================
            
            /**
            * Ajoute un bouton de fermeture aux alertes
            */
            function enhanceAlerts() {
                const alerts = document.querySelectorAll('.alert');
                
                alerts.forEach(function(alert) {
                    // Vérifier si le bouton de fermeture n'existe pas déjà
                    if (!alert.querySelector('.close-alert')) {
                        // Créer le bouton de fermeture
                        const closeBtn = document.createElement('button');
                        closeBtn.className = 'close-alert';
                        closeBtn.innerHTML = '×';
                        closeBtn.setAttribute('aria-label', 'Fermer');
                        
                        // Ajouter l'événement de fermeture
                        closeBtn.addEventListener('click', function() {
                            alert.style.animation = 'fadeOut 0.3s ease';
                            setTimeout(() => {
                                alert.remove();
                            }, 300);
                        });
                        
                        // Ajouter le bouton à l'alerte
                        alert.appendChild(closeBtn);
                    }
                    
                    // Auto-fermeture après 5 secondes pour les alertes de succès
                    if (alert.classList.contains('alert-success')) {
                        setTimeout(() => {
                            if (alert.parentElement) {
                                alert.style.animation = 'fadeOut 0.3s ease';
                                setTimeout(() => {
                                    alert.remove();
                                }, 300);
                            }
                        }, 5000);
                    }
                });
            }
            
            // Animation de sortie
            const style = document.createElement('style');
            style.textContent = `
                @keyframes fadeOut {
                    from {
                        opacity: 1;
                        transform: translateY(0);
                    }
                    to {
                        opacity: 0;
                        transform: translateY(-20px);
                    }
                }
            `;
            document.head.appendChild(style);
            
            // ============================================
            // 3. VALIDATION EN TEMPS RÉEL
            // ============================================
            
            /**
            * Valide un champ en temps réel
            */
            function validateField(input) {
                const formGroup = input.closest('.form-group');
                if (!formGroup) return;
                
                // Vérifier si le champ est requis
                const isRequired = input.hasAttribute('required') || 
                                input.classList.contains('required');
                
                // Vérifier si le champ a une valeur
                const hasValue = input.value.trim() !== '';
                
                // Pour les champs requis vides
                if (isRequired && !hasValue) {
                    formGroup.classList.add('has-error');
                    formGroup.classList.remove('is-valid');
                    input.classList.add('is-invalid');
                    input.classList.remove('is-valid');
                    return false;
                }
                
                // Validation spécifique par type
                let isValid = true;
                
                switch(input.type) {
                    case 'email':
                        const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
                        isValid = emailRegex.test(input.value);
                        break;
                        
                    case 'tel':
                        const telRegex = /^[\d\s\+\-\(\)]{8,20}$/;
                        isValid = telRegex.test(input.value);
                        break;
                        
                    case 'date':
                        if (hasValue) {
                            const selectedDate = new Date(input.value);
                            const today = new Date();
                            const minDate = new Date();
                            minDate.setFullYear(minDate.getFullYear() - 120);
                            
                            isValid = selectedDate < today && selectedDate > minDate;
                        }
                        break;
                        
                    case 'password':
                        if (hasValue) {
                            // Au moins 8 caractères, 1 majuscule, 1 minuscule, 1 chiffre
                            const passwordRegex = /^(?=.*[a-z])(?=.*[A-Z])(?=.*\d).{8,}$/;
                            isValid = passwordRegex.test(input.value);
                        }
                        break;
                }
                
                // Appliquer les classes appropriées
                if (hasValue) {
                    if (isValid) {
                        formGroup.classList.remove('has-error');
                        formGroup.classList.add('is-valid');
                        input.classList.remove('is-invalid');
                        input.classList.add('is-valid');
                    } else {
                        formGroup.classList.add('has-error');
                        formGroup.classList.remove('is-valid');
                        input.classList.add('is-invalid');
                        input.classList.remove('is-valid');
                    }
                } else {
                    // Réinitialiser si vide et non requis
                    if (!isRequired) {
                        formGroup.classList.remove('has-error', 'is-valid');
                        input.classList.remove('is-invalid', 'is-valid');
                    }
                }
                
                return isValid;
            }
            
            /**
            * Ajoute les écouteurs de validation en temps réel
            */
            function addRealtimeValidation() {
                const inputs = document.querySelectorAll('.form-group input, .form-group select, .form-group textarea');
                
                inputs.forEach(function(input) {
                    // Validation à la perte de focus
                    input.addEventListener('blur', function() {
                        validateField(this);
                    });
                    
                    // Retirer l'erreur lors de la saisie
                    input.addEventListener('input', function() {
                        const formGroup = this.closest('.form-group');
                        if (formGroup && formGroup.classList.contains('has-error')) {
                            // Retirer temporairement l'erreur pour encourager l'utilisateur
                            if (this.value.trim() !== '') {
                                formGroup.classList.remove('has-error');
                                this.classList.remove('is-invalid');
                            }
                        }
                    });
                });
            }
            
            // ============================================
            // 4. VALIDATION DES MOTS DE PASSE IDENTIQUES
            // ============================================
            
            /**
            * Vérifie que les deux mots de passe sont identiques
            */
            function validatePasswordMatch() {
                const password1 = document.querySelector('input[name*="plainPassword"][name*="first"]');
                const password2 = document.querySelector('input[name*="plainPassword"][name*="second"]');
                
                if (password1 && password2) {
                    password2.addEventListener('blur', function() {
                        const formGroup = this.closest('.form-group');
                        
                        if (this.value && this.value !== password1.value) {
                            formGroup.classList.add('has-error');
                            this.classList.add('is-invalid');
                            
                            // Créer un message d'erreur s'il n'existe pas
                            if (!formGroup.querySelector('.password-match-error')) {
                                const errorMsg = document.createElement('div');
                                errorMsg.className = 'form-error password-match-error';
                                errorMsg.textContent = 'Les mots de passe ne correspondent pas';
                                formGroup.appendChild(errorMsg);
                            }
                        } else if (this.value === password1.value && this.value !== '') {
                            formGroup.classList.remove('has-error');
                            formGroup.classList.add('is-valid');
                            this.classList.remove('is-invalid');
                            this.classList.add('is-valid');
                            
                            // Supprimer le message d'erreur
                            const errorMsg = formGroup.querySelector('.password-match-error');
                            if (errorMsg) {
                                errorMsg.remove();
                            }
                        }
                    });
                    
                    password1.addEventListener('input', function() {
                        // Réinitialiser la validation du second champ si le premier change
                        const formGroup2 = password2.closest('.form-group');
                        if (formGroup2) {
                            formGroup2.classList.remove('has-error', 'is-valid');
                            password2.classList.remove('is-invalid', 'is-valid');
                            const errorMsg = formGroup2.querySelector('.password-match-error');
                            if (errorMsg) errorMsg.remove();
                        }
                    });
                }
            }
            
            // ============================================
            // 5. SCROLL VERS LA PREMIÈRE ERREUR
            // ============================================
            
            /**
            * Fait défiler la page jusqu'à la première erreur
            */
            function scrollToFirstError() {
                const firstError = document.querySelector('.form-group.has-error, .alert-danger');
                
                if (firstError) {
                    setTimeout(() => {
                        firstError.scrollIntoView({
                            behavior: 'smooth',
                            block: 'center'
                        });
                        
                        // Focus sur le premier input en erreur
                        const firstInput = firstError.querySelector('input, select, textarea');
                        if (firstInput) {
                            firstInput.focus();
                        }
                    }, 100);
                }
            }
            
            // ============================================
            // 6. VALIDATION AVANT SOUMISSION
            // ============================================
            
            /**
            * Valide tous les champs avant la soumission
            */
            function validateFormBeforeSubmit(form) {
                let isValid = true;
                const inputs = form.querySelectorAll('input[required], select[required], textarea[required]');
                
                inputs.forEach(function(input) {
                    if (!validateField(input)) {
                        isValid = false;
                    }
                });
                
                return isValid;
            }
            
            // Ajouter la validation à tous les formulaires
            const forms = document.querySelectorAll('form');
            forms.forEach(function(form) {
                form.addEventListener('submit', function(e) {
                    if (this.dataset.skipClientValidation === '1') {
                        return;
                    }
                    if (!validateFormBeforeSubmit(this)) {
                        e.preventDefault();
                        scrollToFirstError();
                        
                        // Afficher une alerte générale
                        const existingAlert = document.querySelector('.validation-error-alert');
                        if (!existingAlert) {
                            const alert = document.createElement('div');
                            alert.className = 'alert alert-danger validation-error-alert';
                            alert.textContent = 'Veuillez corriger les erreurs dans le formulaire avant de continuer.';
                            
                            form.insertBefore(alert, form.firstChild);
                            enhanceAlerts();
                        }
                    }
                });
            });
            
            // ============================================
            // 7. INITIALISATION
            // ============================================

            // Marquer les champs avec erreur au chargement
            markErrorFields();
            enhanceAlerts();
            addRealtimeValidation();
            validatePasswordMatch();
            scrollToFirstError();

            // ============================================
            // PASSWORD STRENGTH METER
            // ============================================
            (function () {
                const pwInput   = document.getElementById('users_plainPassword_first');
                const bar       = document.getElementById('strengthBar');
                const lbl       = document.getElementById('strengthLabel');
                if (!pwInput || !bar || !lbl) return;

                const levels = [
                    { cls: 'strength-weak',   txt: 'Faible',  labelCls: 'weak'   },
                    { cls: 'strength-fair',   txt: 'Moyen',   labelCls: 'fair'   },
                    { cls: 'strength-good',   txt: 'Bon',     labelCls: 'good'   },
                    { cls: 'strength-strong', txt: 'Fort ✓',  labelCls: 'strong' },
                ];

                pwInput.addEventListener('input', function () {
                    const v = this.value;
                    let score = 0;
                    if (v.length >= 8)             score++;
                    if (/[A-Z]/.test(v))            score++;
                    if (/[a-z]/.test(v))            score++;
                    if (/\d/.test(v))               score++;
                    if (/[^A-Za-z0-9]/.test(v))     score++;

                    const level = score <= 1 ? 0 : score === 2 ? 1 : score === 3 ? 2 : 3;
                    bar.className = 'password-strength__bar ' + levels[level].cls;
                    lbl.className = 'strength-label '          + levels[level].labelCls;
                    lbl.textContent = v.length > 0 ? 'Force : ' + levels[level].txt : '';
                });
            })();
            
            // Gestion de la modale des conditions
            const termsModal     = document.getElementById('termsModal');
            const openTermsBtn   = document.getElementById('openTermsModal');
            const closeTermsBtn  = document.getElementById('closeTermsModal');
            const termsAcceptBtn = document.getElementById('termsAcceptBtn');
            const termsScrollBody = document.getElementById('termsScrollBody');
            const termsScrollHint = document.getElementById('termsScrollHint');
            const termsCheckbox  = document.getElementById('{{ registration_form.termsAccepted.vars.id }}');

            const toggleTermsModal = (shouldOpen) => {
                if (!termsModal) return;
                termsModal.classList.toggle('is-open', shouldOpen);
                termsModal.setAttribute('aria-hidden', shouldOpen ? 'false' : 'true');

                if (shouldOpen) {
                    // Evaluate if we need scroll-to-accept
                    checkTermsScroll();
                }
            };

            // Scroll-to-accept: enable "Accept" button only after reading to bottom
            function checkTermsScroll() {
                if (!termsScrollBody || !termsAcceptBtn) return;

                const fullyScrolled = termsScrollBody.scrollTop + termsScrollBody.clientHeight >= termsScrollBody.scrollHeight - 8;
                termsAcceptBtn.disabled = !fullyScrolled;

                if (!fullyScrolled && termsScrollHint) {
                    termsScrollHint.style.display = 'block';
                } else if (termsScrollHint) {
                    termsScrollHint.style.display = 'none';
                }
            }

            if (termsScrollBody) {
                termsScrollBody.addEventListener('scroll', checkTermsScroll);
                // If content fits without scrolling, enable immediately
                setTimeout(checkTermsScroll, 80);
            }

            if (openTermsBtn) {
                openTermsBtn.addEventListener('click', () => toggleTermsModal(true));
            }

            if (closeTermsBtn) {
                closeTermsBtn.addEventListener('click', () => toggleTermsModal(false));
            }

            // "J'accepte" inside modal: tick checkbox + close modal
            if (termsAcceptBtn) {
                termsAcceptBtn.addEventListener('click', () => {
                    if (termsCheckbox) {
                        termsCheckbox.checked = true;
                        // Trigger change event for any listeners
                        termsCheckbox.dispatchEvent(new Event('change', { bubbles: true }));
                    }
                    toggleTermsModal(false);
                });
            }

            if (termsModal) {
                termsModal.addEventListener('click', (event) => {
                    if (event.target === termsModal) toggleTermsModal(false);
                });
            }

            document.addEventListener('keydown', (event) => {
                if (event.key === 'Escape') toggleTermsModal(false);
            });

            // ============================================
            // CAPTCHA CANVAS
            // ============================================
            const CAPTCHA_REFRESH_URL = "{{ path('captcha_refresh') }}";
            let currentCaptchaQuestion = "{{ captcha_question|default('?')|e('js') }}";

            function drawCaptcha(question) {
                const canvas = document.getElementById('captchaCanvas');
                if (!canvas) return;
                const ctx = canvas.getContext('2d');
                const W = canvas.width;
                const H = canvas.height;

                // Background gradient
                const bg = ctx.createLinearGradient(0, 0, W, H);
                bg.addColorStop(0, '#0f172a');
                bg.addColorStop(1, '#1e3a5f');
                ctx.fillStyle = bg;
                ctx.fillRect(0, 0, W, H);

                // Noise: random dots
                for (let i = 0; i < 180; i++) {
                    ctx.beginPath();
                    ctx.arc(Math.random() * W, Math.random() * H, Math.random() * 2, 0, Math.PI * 2);
                    ctx.fillStyle = `rgba(255,255,255,${(Math.random() * 0.3 + 0.05).toFixed(2)})`;
                    ctx.fill();
                }

                // Noise: random lines
                for (let i = 0; i < 6; i++) {
                    ctx.beginPath();
                    ctx.moveTo(Math.random() * W, Math.random() * H);
                    ctx.lineTo(Math.random() * W, Math.random() * H);
                    ctx.strokeStyle = `rgba(${Math.floor(Math.random()*200+55)},${Math.floor(Math.random()*200+55)},255,0.26)`;
                    ctx.lineWidth = Math.random() * 1.5 + 0.5;
                    ctx.stroke();
                }

                // Draw each character with slight random rotation and offset
                const chars  = question.split('');
                const cellW  = W / (chars.length + 1);
                const baseY  = H / 2 + 14;
                const colors = ['#60a5fa', '#34d399', '#fbbf24', '#f472b6', '#a78bfa', '#fff'];

                chars.forEach((ch, idx) => {
                    ctx.save();
                    const x  = cellW * (idx + 0.8) + (Math.random() * 6 - 3);
                    const y  = baseY + (Math.random() * 10 - 5);
                    const angle = (Math.random() * 0.4 - 0.2);
                    const size = Math.floor(Math.random() * 8 + 26);

                    ctx.translate(x, y);
                    ctx.rotate(angle);
                    ctx.font = `bold ${size}px 'Courier New', monospace`;
                    ctx.fillStyle = colors[idx % colors.length];
                    ctx.shadowColor = 'rgba(0,0,0,0.6)';
                    ctx.shadowBlur  = 4;
                    ctx.fillText(ch, 0, 0);
                    ctx.restore();
                });
            }

            // Initial draw
            drawCaptcha(currentCaptchaQuestion);

            // Refresh button
            const captchaRefreshBtn = document.getElementById('captchaRefreshBtn');
            const captchaInput      = document.getElementById('captchaAnswer');

            if (captchaRefreshBtn) {
                captchaRefreshBtn.addEventListener('click', () => {
                    captchaRefreshBtn.disabled = true;
                    fetch(CAPTCHA_REFRESH_URL, { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
                        .then(r => r.json())
                        .then(data => {
                            currentCaptchaQuestion = data.question;
                            drawCaptcha(currentCaptchaQuestion);
                            if (captchaInput) { captchaInput.value = ''; captchaInput.focus(); }
                        })
                        .catch(() => {})
                        .finally(() => { captchaRefreshBtn.disabled = false; });
                });
            }

            console.log('✅ Gestionnaire de validation initialisé avec succès');
        });

        /**
        * Fonction pour basculer la visibilité du mot de passe
        * (utilisée dans le template)
        */
        function togglePassword(inputId) {
            const input = document.getElementById(inputId);
            const icon = event.target;
            
            if (input) {
                if (input.type === 'password') {
                    input.type = 'text';
                    icon.classList.remove('fa-eye-slash');
                    icon.classList.add('fa-eye');
                } else {
                    input.type = 'password';
                    icon.classList.remove('fa-eye');
                    icon.classList.add('fa-eye-slash');
                }
            }
        }
    </script>
{% endblock %}