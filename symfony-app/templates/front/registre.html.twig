                        </div>
                        {{ form_errors(registration_form.plainPassword.second) }}
                    </div>

                    {# ADRESSE #}
                    <div class="form-group">
                        <label for="{{ registration_form.adresse.vars.id }}">
                            <i class="fas fa-map-marker-alt field-icon"></i>
                            {{ registration_form.adresse.vars.label }}
                        </label>
                        <div class="input-wrapper">
                            <i class="fas fa-map-pin input-icon"></i>
                            {{ form_widget(registration_form.adresse, {'attr': {'class': 'form-control', 'placeholder': 'Rue, ville, code postal'}}) }}
                        </div>
                        {{ form_errors(registration_form.adresse) }}
                    </div>

                    {# TELEPHONE #}
                    <div class="form-group">
                        <label for="{{ registration_form.telephone.vars.id }}">
                            <i class="fas fa-phone field-icon"></i>
                            {{ registration_form.telephone.vars.label }}
                        </label>
                        <div class="input-wrapper">
                            <i class="fas fa-phone-alt input-icon"></i>
                            {{ form_widget(registration_form.telephone, {'attr': {'class': 'form-control', 'placeholder': '+216 XX XXX XXX'}}) }}
                        </div>
                        {{ form_errors(registration_form.telephone) }}
                    </div>
                </div>

            </div>{# /form-columns #}

            {# ════════════════════ BOTTOM: CAPTCHA + TERMS ════════════════════ #}
            <div class="form-bottom">
                <div class="bottom-row">

                    {# CAPTCHA #}
                    <div class="form-group">
                        <div class="captcha-section-label">
                            <i class="fas fa-robot"></i> Vérification anti-robot
                            <span class="captcha-lbl">(calcul mental)</span>
                        </div>
                        <div class="captcha-widget">
                            <div class="captcha-canvas-row">
                                <div class="captcha-canvas-container">
                                    <canvas id="captchaCanvas" width="220" height="64"></canvas>
                                </div>
                                <button type="button" class="captcha-refresh-btn" id="captchaRefreshBtn" title="Nouveau captcha">
                                    <i class="fas fa-sync-alt"></i>
                                </button>
                            </div>
                            <div class="captcha-input-row">
                                <span class="captcha-eq">= ?</span>
                                {{ form_widget(registration_form.captcha, {
                                    'attr': {'class': 'form-control', 'autocomplete': 'off', 'inputmode': 'numeric', 'placeholder': '…', 'id': 'captchaAnswer'}
                                }) }}
                            </div>
                        </div>
                        {{ form_errors(registration_form.captcha) }}
                    </div>

                    {# TERMS #}
                    <div class="form-group terms-group">
                        <div class="terms-section-label">
                            <i class="fas fa-file-contract"></i> Conditions d'utilisation
                        </div>
                        <div class="terms-card">
                            <div class="terms-line">
                                {{ form_widget(registration_form.termsAccepted) }}
                                <label for="{{ registration_form.termsAccepted.vars.id }}">
                                    J'ai lu et j'accepte les <strong>conditions d'utilisation</strong> et la politique de confidentialité de SANTÉA.
                                </label>
                            </div>
                            <button type="button" class="terms-link" id="openTermsModal">
                                <i class="fas fa-external-link-alt"></i> Lire les conditions complètes
                            </button>
                        </div>
                        {{ form_errors(registration_form.termsAccepted) }}
                    </div>

                </div>

                {# SUBMIT #}
                <button type="submit" class="signup-submit">
                    <i class="fas fa-user-plus"></i>
                    Créer mon compte SANTÉA
                </button>
            </div>

        {{ form_end(registration_form) }}

        {# ════════════════════ TERMS MODAL ════════════════════ #}
        <div class="terms-modal" id="termsModal" aria-hidden="true" role="dialog" aria-labelledby="termsModalTitle">
            <div class="terms-modal__dialog">
                <div class="terms-modal__header">
                    <h3 id="termsModalTitle"><i class="fas fa-file-contract" style="color:#6366f1;margin-right:8px;"></i>Conditions d'utilisation — SANTÉA</h3>
                    <button type="button" class="terms-modal__close" id="closeTermsModal" aria-label="Fermer">×</button>
                </div>

                <div class="terms-modal__body" id="termsScrollBody">
                    <p>En créant un compte sur la plateforme <strong>SANTÉA</strong>, vous acceptez l'ensemble des conditions ci-dessous. Veuillez les lire attentivement avant de valider votre inscription.</p>

