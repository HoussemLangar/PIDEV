{% extends 'front/base_auth.html.twig' %}

{% block title %}Inscription - SANTÉA{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/form-validation-styles.css') }}">
    <style>

        /* =========================================================
           SIGNUP: widen the form panel + adjust auth layout
        ========================================================= */
        #signUpForm.auth-form {
            max-width: 880px;
            width: 100%;
            animation: fadeInUp 0.55s ease-out;
        }

        /* Give the right panel more room on signup */
        .auth-right {
            flex: 1.8 !important;
            padding: 40px 36px !important;
            overflow-y: auto;
        }
        .auth-left {
            flex: 1 !important;
        }

        @media (max-width: 900px) {
            .auth-left { display: none !important; }
            .auth-right { flex: 1 !important; padding: 30px 20px !important; }
            #signUpForm.auth-form { max-width: 100%; }
        }

        /* =========================================================
           TOP ACTIONS: home button
        ========================================================= */
        .auth-top-actions {
            display: flex;
            justify-content: flex-end;
            margin-bottom: 16px;
        }

        .auth-home-btn {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            padding: 9px 16px;
            border: 1.5px solid #e2e8f0;
            border-radius: 10px;
            background: #f8fafc;
            color: #374151;
            font-size: 13px;
            font-weight: 600;
            text-decoration: none;
            transition: all 0.2s ease;
        }
        .auth-home-btn:hover {
            background: #e0e7ff;
            border-color: #6366f1;
            color: #4f46e5;
            transform: translateY(-1px);
        }
        .auth-home-btn i { font-size: 14px; }

        /* =========================================================
           PAGE TITLE
        ========================================================= */
        #signUpForm h1 {
            font-size: 1.75rem !important;
            margin-bottom: 18px !important;
            display: flex;
            align-items: center;
            gap: 10px;
        }
        #signUpForm h1 .title-icon {
            width: 42px; height: 42px;
            background: linear-gradient(135deg, #3b82f6, #6366f1);
            border-radius: 12px;
            display: flex; align-items: center; justify-content: center;
            color: #fff;
            font-size: 18px;
            flex-shrink: 0;
            box-shadow: 0 4px 12px rgba(99,102,241,.25);
        }
        #signUpForm .subtitle {
            font-size: 13px;
            color: #6b7280;
            margin-top: -10px;
            margin-bottom: 20px;
        }

        /* =========================================================
           TWO COLUMN WRAPPER
        ========================================================= */
        .form-columns {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
            margin-bottom: 20px;
        }
        @media (max-width: 680px) {
            .form-columns { grid-template-columns: 1fr; }
        }

        .form-column {
            background: #f9fafb;
            border: 1.5px solid #e5e7eb;
            border-radius: 16px;
            padding: 22px 20px 18px;
            display: flex;
            flex-direction: column;
            gap: 14px;
            transition: border-color 0.2s;
        }
        .form-column:focus-within {
            border-color: #6366f1;
            box-shadow: 0 0 0 3px rgba(99,102,241,.06);
        }

        .column-header {
            display: flex;
            align-items: center;
            gap: 10px;
            padding-bottom: 12px;
            border-bottom: 1.5px solid #e5e7eb;
            margin-bottom: 2px;
        }
        .column-header__icon {
            width: 34px; height: 34px;
            border-radius: 10px;
            display: flex; align-items: center; justify-content: center;
            font-size: 15px;
            flex-shrink: 0;
        }
        .column-header__icon.blue  { background: #eff6ff; color: #3b82f6; }
        .column-header__icon.indigo{ background: #eef2ff; color: #6366f1; }
        .column-header__title {
            font-size: 13px;
            font-weight: 700;
            color: #374151;
            line-height: 1.3;
        }
        .column-header__sub {
            font-size: 11px;
            color: #9ca3af;
            font-weight: 400;
        }

        /* =========================================================
           FORM FIELDS
        ========================================================= */
        .form-group {
            margin-bottom: 0;
            display: flex;
            flex-direction: column;
            gap: 5px;
        }

        .form-group label {
            font-size: 12px;
            font-weight: 600;
            color: #374151;
            letter-spacing: .02em;
            display: flex;
            align-items: center;
            gap: 5px;
        }
        .form-group label .field-icon {
            color: #9ca3af;
            font-size: 11px;
        }

        /* Input wrapper with icon */
        .input-wrapper {
            position: relative;
        }
        .input-wrapper .input-icon {
            position: absolute;
            left: 12px;
            top: 50%;
            transform: translateY(-50%);
            color: #9ca3af;
            font-size: 13px;
            pointer-events: none;
            transition: color 0.2s;
            z-index: 1;
        }
        .input-wrapper input,
        .input-wrapper .form-control {
            padding-left: 36px !important;
        }
        .input-wrapper:focus-within .input-icon {
            color: #6366f1;
        }

        /* Override Symfony form-control inside columns */
        .form-column .form-control,
        .form-column input[type="text"],
        .form-column input[type="email"],
        .form-column input[type="password"],
        .form-column input[type="tel"],
        .form-column input[type="date"] {
            width: 100%;
            padding: 10px 12px;
            border: 1.5px solid #d1d5db;
            border-radius: 10px;
            font-size: 13.5px;
            color: #111827;
            background: #fff;
            transition: border-color 0.2s, box-shadow 0.2s;
            outline: none;
            box-sizing: border-box;
        }
        .form-column .form-control:focus,
        .form-column input:focus {
            border-color: #6366f1;
            box-shadow: 0 0 0 3px rgba(99,102,241,.1);
        }
        .form-column .form-control.is-invalid,
        .form-column input.is-invalid {
            border-color: #ef4444;
            box-shadow: 0 0 0 3px rgba(239,68,68,.08);
        }
        .form-column .form-control.is-valid,
        .form-column input.is-valid {
            border-color: #10b981;
            box-shadow: 0 0 0 3px rgba(16,185,129,.08);
        }

        /* Password toggle inside columns */
        .form-column .password-input {
            position: relative;
        }
        .form-column .password-input input {
            padding-right: 38px !important;
        }
        .form-column .toggle-password {
            position: absolute;
            right: 12px;
            top: 50%;
            transform: translateY(-50%);
            cursor: pointer;
            color: #9ca3af;
            font-size: 13px;
            transition: color 0.2s;
        }
        .form-column .toggle-password:hover { color: #6366f1; }

        /* Password requirements */
        .password-requirements {
            background: #f0f7ff !important;
            border-left: 3px solid #3b82f6 !important;
            border-radius: 8px !important;
            padding: 8px 12px !important;
            font-size: 11.5px !important;
            color: #374151 !important;
            margin-top: 4px !important;
        }
        .password-requirements ul { margin: 4px 0 0 16px; padding: 0; }
        .password-requirements li { margin-bottom: 2px; }

        /* Password strength bar */
        .password-strength {
            height: 4px;
            border-radius: 2px;
            background: #e5e7eb;
            margin-top: 6px;
            overflow: hidden;
        }
        .password-strength__bar {
            height: 100%;
            width: 0%;
            border-radius: 2px;
            transition: width 0.3s ease, background 0.3s ease;
        }
        .strength-weak   { width: 25%;  background: #ef4444; }
        .strength-fair   { width: 55%;  background: #f59e0b; }
        .strength-good   { width: 80%;  background: #3b82f6; }
        .strength-strong { width: 100%; background: #10b981; }

        .strength-label {
            font-size: 10.5px;
            font-weight: 600;
            margin-top: 3px;
        }
        .strength-label.weak   { color: #ef4444; }
        .strength-label.fair   { color: #f59e0b; }
        .strength-label.good   { color: #3b82f6; }
        .strength-label.strong { color: #10b981; }

        /* Form errors */
        .form-column .form-error,
        .form-column .invalid-feedback,
        .form-column ul.form-errors {
            font-size: 11.5px;
            color: #ef4444;
            list-style: none;
            padding: 0; margin: 0;
        }

        /* =========================================================
           BOTTOM SECTION (captcha + terms + submit)
        ========================================================= */
        .form-bottom {
            background: #f9fafb;
            border: 1.5px solid #e5e7eb;
            border-radius: 16px;
            padding: 20px;
            display: flex;
            flex-direction: column;
            gap: 18px;
            margin-bottom: 20px;
        }

        .bottom-row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
            align-items: start;
        }
        @media (max-width: 680px) {
            .bottom-row { grid-template-columns: 1fr; }
        }

        /* CAPTCHA */
        .captcha-widget {
            display: flex;
            flex-direction: column;
            gap: 8px;
        }
        .captcha-canvas-row {
            display: flex;
            align-items: center;
            gap: 10px;
        }
        .captcha-canvas-container {
            border-radius: 10px;
            overflow: hidden;
            border: 2px solid #334155;
            background: #0f172a;
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 4px 14px rgba(0,0,0,.18);
        }
        #captchaCanvas { display: block; }
        .captcha-refresh-btn {
            width: 38px; height: 38px;
            display: flex; align-items: center; justify-content: center;
            background: #f1f5f9;
            border: 1.5px solid #e2e8f0;
            border-radius: 10px;
            cursor: pointer;
            color: #475569;
            font-size: 14px;
            transition: all 0.25s ease;
            flex-shrink: 0;
        }
        .captcha-refresh-btn:hover {
            background: #e0e7ff;
            border-color: #6366f1;
            color: #4f46e5;
            transform: rotate(180deg);
        }
        .captcha-input-row {
            display: flex;
            align-items: center;
            gap: 10px;
        }
        .captcha-eq {
            font-size: 18px;
            font-weight: 800;
            color: #374151;
            flex-shrink: 0;
        }
        .captcha-input-row .form-control {
            max-width: 110px;
            text-align: center;
            font-size: 17px;
            font-weight: 700;
            letter-spacing: 3px;
            padding: 9px 12px;
            border: 1.5px solid #d1d5db;
            border-radius: 10px;
            outline: none;
            transition: border-color 0.2s, box-shadow 0.2s;
        }
        .captcha-input-row .form-control:focus {
            border-color: #6366f1;
            box-shadow: 0 0 0 3px rgba(99,102,241,.1);
        }
        .captcha-lbl {
            font-size: 11px;
            color: #6b7280;
        }
        .captcha-section-label {
            font-size: 12px;
            font-weight: 700;
            color: #374151;
            display: flex; align-items: center; gap: 6px;
            margin-bottom: 4px;
        }
        .captcha-section-label i { color: #6366f1; }

        /* TERMS */
        .terms-group { display: flex; flex-direction: column; gap: 4px; }
        .terms-section-label {
            font-size: 12px;
            font-weight: 700;
            color: #374151;
            display: flex; align-items: center; gap: 6px;
            margin-bottom: 4px;
        }
        .terms-section-label i { color: #10b981; }

        .terms-card {
            background: #ecfdf5;
            border: 1.5px solid #a7f3d0;
            border-radius: 10px;
            padding: 14px 14px;
            display: flex;
            flex-direction: column;
            gap: 10px;
        }
        .terms-line {
            display: flex;
            align-items: center;
            gap: 10px;
            flex-wrap: wrap;
        }
        .terms-line input[type="checkbox"] {
            width: 17px; height: 17px;
            accent-color: #10b981;
            cursor: pointer;
            flex-shrink: 0;
        }
        .terms-line label {
            font-size: 12.5px;
            color: #065f46;
            font-weight: 500;
            cursor: pointer;
            flex: 1;
            line-height: 1.4;
        }
        .terms-link {
            background: none;
            border: none;
            color: #059669;
            font-weight: 700;
            font-size: 12.5px;
            text-decoration: underline;
            cursor: pointer;
            padding: 0;
            transition: color 0.2s;
        }
        .terms-link:hover { color: #047857; }

        /* SUBMIT */
        .signup-submit {
            background: linear-gradient(135deg, #4f46e5 0%, #6366f1 100%);
            color: #fff;
            border: none;
            border-radius: 12px;
            padding: 14px 30px;
            font-size: 15px;
            font-weight: 700;
            cursor: pointer;
            width: 100%;
            letter-spacing: .02em;
            transition: all 0.25s ease;
            box-shadow: 0 4px 16px rgba(99,102,241,.3);
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
        }
        .signup-submit:hover {
            background: linear-gradient(135deg, #4338ca 0%, #4f46e5 100%);
            transform: translateY(-2px);
            box-shadow: 0 8px 24px rgba(99,102,241,.35);
        }
        .signup-submit:active {
            transform: translateY(0);
        }

        /* =========================================================
           TERMS MODAL
        ========================================================= */
        .terms-modal {
            position: fixed;
            inset: 0;
            background: rgba(0,0,0,.5);
            display: flex;
            align-items: center;
            justify-content: center;
            opacity: 0;
            pointer-events: none;
            transition: opacity 0.22s ease;
            z-index: 999;
            padding: 16px;
        }
        .terms-modal.is-open {
            opacity: 1;
            pointer-events: auto;
        }
        .terms-modal__dialog {
            background: #fff;
            border-radius: 16px;
            max-width: 720px;
            width: 100%;
            max-height: 82vh;
            overflow: hidden;
            display: flex;
            flex-direction: column;
            padding: 22px 24px 0;
            box-shadow: 0 25px 60px rgba(15,23,42,.22);
        }
        .terms-modal__header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 8px;
            margin-bottom: 12px;
            flex-shrink: 0;
        }
        .terms-modal__header h3 {
            font-size: 16px;
            color: #111827;
            font-weight: 700;
        }
        .terms-modal__close {
            background: #f3f4f6;
            border: none;
            font-size: 18px;
            cursor: pointer;
            line-height: 1;
            color: #374151;
            padding: 7px 11px;
            border-radius: 10px;
            transition: background 0.2s;
        }
        .terms-modal__close:hover { background: #e5e7eb; }

        .terms-modal__body {
            line-height: 1.7;
            font-size: 13.5px;
            color: #374151;
            overflow-y: auto;
            flex: 1 1 auto;
            padding-right: 6px;
        }
        .terms-modal__list {
            padding-left: 18px;
            margin: 8px 0;
        }
        .terms-section-block {
            margin-bottom: 16px;
            padding: 12px 14px;
            background: #f8fafc;
            border-radius: 10px;
            border-left: 4px solid #6366f1;
        }
        .terms-section-block h4 {
            margin: 0 0 6px;
            font-size: 13px;
            font-weight: 700;
            color: #1e40af;
            display: flex;
            align-items: center;
            gap: 7px;
        }
        .terms-footer {
            background: #fff;
            padding: 14px 0 18px;
            border-top: 1.5px solid #e5e7eb;
            margin-top: 12px;
            flex-shrink: 0;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 8px;
        }
        .terms-scroll-hint {
            font-size: 12px;
            color: #6b7280;
            display: none;
        }
        .terms-accept-btn {
            background: linear-gradient(135deg, #10b981 0%, #059669 100%);
            color: #fff;
            border: none;
            border-radius: 10px;
            padding: 12px 36px;
            font-size: 14px;
            font-weight: 700;
            cursor: pointer;
            transition: all 0.2s ease;
            box-shadow: 0 4px 12px rgba(16,185,129,.25);
        }
        .terms-accept-btn:hover:not(:disabled) {
            transform: translateY(-1px);
            box-shadow: 0 8px 20px rgba(16,185,129,.3);
        }
        .terms-accept-btn:disabled { opacity: 0.45; cursor: not-allowed; }
    </style>
{% endblock %}

{% block auth_content %}
    <div class="auth-form" id="signUpForm">

        {# ── Top actions ── #}
        <div class="auth-top-actions">
            <a href="{{ path('app_home') }}" class="auth-home-btn">
                <i class="fas fa-home"></i> Accueil
            </a>
        </div>

        {# ── Title ── #}
        <h1>
            <span class="title-icon"><i class="fas fa-user-plus"></i></span>
            Créer un compte
        </h1>
        <p class="subtitle">Rejoignez SANTÉA et prenez soin de votre santé au quotidien.</p>

        {# ── Social login ── #}
        <div class="social-buttons">
            <a href="{{ path('connect_google_start') }}" class="social-btn google-btn">
                <i class="fab fa-google"></i> S'inscrire avec Google
            </a>
            <a href="{{ path('connect_facebook_start') }}" class="social-btn facebook-btn">
                <i class="fab fa-facebook-f"></i> S'inscrire avec Facebook
            </a>
        </div>

        <div class="divider"><span>OU</span></div>

        {# ── Flash messages ── #}
        {% for message in app.flashes('success') %}
            <div class="alert alert-success">{{ message }}</div>
        {% endfor %}
        {% for message in app.flashes('error') %}
            <div class="alert alert-danger">{{ message }}</div>
        {% endfor %}

        {{ form_start(registration_form, {
            action: path('app_register'),
            attr: { id: 'registerForm', novalidate: 'novalidate', 'data-skip-client-validation': '1' }
        }) }}

            {# ════════════════════ TWO COLUMNS ════════════════════ #}
            <div class="form-columns">

                {# ── LEFT COLUMN: Identité ── #}
                <div class="form-column">
                    <div class="column-header">
                        <span class="column-header__icon blue"><i class="fas fa-id-card"></i></span>
                        <div>
                            <div class="column-header__title">Informations personnelles</div>
                            <div class="column-header__sub">Votre identité sur la plateforme</div>
                        </div>
                    </div>

                    {# USERNAME #}
                    <div class="form-group">
                        <label for="{{ registration_form.username.vars.id }}">
                            <i class="fas fa-at field-icon"></i>
                            {{ registration_form.username.vars.label }}&nbsp;<span style="color:#ef4444">*</span>
                        </label>
                        <div class="input-wrapper">
                            <i class="fas fa-user input-icon"></i>
                            {{ form_widget(registration_form.username, {'attr': {'class': 'form-control', 'placeholder': "Nom d'utilisateur"}}) }}
                        </div>
                        {{ form_errors(registration_form.username) }}
                    </div>

                    {# EMAIL #}
                    <div class="form-group">
                        <label for="{{ registration_form.email.vars.id }}">
                            <i class="fas fa-envelope field-icon"></i>
                            {{ registration_form.email.vars.label }}&nbsp;<span style="color:#ef4444">*</span>
                        </label>
                        <div class="input-wrapper">
                            <i class="fas fa-envelope input-icon"></i>
                            {{ form_widget(registration_form.email, {'attr': {'class': 'form-control', 'placeholder': 'exemple@email.com'}}) }}
                        </div>
                        {{ form_errors(registration_form.email) }}
                    </div>

                    {# NOM #}
                    <div class="form-group">
                        <label for="{{ registration_form.nom.vars.id }}">
                            <i class="fas fa-signature field-icon"></i>
                            {{ registration_form.nom.vars.label }}&nbsp;<span style="color:#ef4444">*</span>
                        </label>
                        <div class="input-wrapper">
                            <i class="fas fa-font input-icon"></i>
                            {{ form_widget(registration_form.nom, {'attr': {'class': 'form-control', 'placeholder': 'Votre nom de famille'}}) }}
                        </div>
                        {{ form_errors(registration_form.nom) }}
                    </div>

                    {# PRENOM #}
                    <div class="form-group">
                        <label for="{{ registration_form.prenom.vars.id }}">
                            <i class="fas fa-smile field-icon"></i>
                            {{ registration_form.prenom.vars.label }}&nbsp;<span style="color:#ef4444">*</span>
                        </label>
                        <div class="input-wrapper">
                            <i class="fas fa-font input-icon"></i>
                            {{ form_widget(registration_form.prenom, {'attr': {'class': 'form-control', 'placeholder': 'Votre prénom'}}) }}
                        </div>
                        {{ form_errors(registration_form.prenom) }}
                    </div>

                    {# DATE DE NAISSANCE #}
                    <div class="form-group">
                        <label for="{{ registration_form.dateNaissance.vars.id }}">
                            <i class="fas fa-birthday-cake field-icon"></i>
                            {{ registration_form.dateNaissance.vars.label }}&nbsp;<span style="color:#ef4444">*</span>
                        </label>
                        <div class="input-wrapper">
                            <i class="fas fa-calendar input-icon"></i>
                            {{ form_widget(registration_form.dateNaissance, {'attr': {'class': 'form-control date-picker'}}) }}
                        </div>
                        <span style="font-size:11px;color:#6b7280;">{{ registration_form.dateNaissance.vars.help }}</span>
                        {{ form_errors(registration_form.dateNaissance) }}
                    </div>
                </div>

                {# ── RIGHT COLUMN: Sécurité & Contact ── #}
                <div class="form-column">
                    <div class="column-header">
                        <span class="column-header__icon indigo"><i class="fas fa-shield-alt"></i></span>
                        <div>
                            <div class="column-header__title">Sécurité &amp; Contact</div>
                            <div class="column-header__sub">Mot de passe et coordonnées</div>
                        </div>
                    </div>

                    {# MOT DE PASSE #}
                    <div class="form-group">
                        <label for="users_plainPassword_first">
                            <i class="fas fa-lock field-icon"></i>
                            Mot de passe&nbsp;<span style="color:#ef4444">*</span>
                        </label>
                        <div class="password-input">
                            {{ form_widget(registration_form.plainPassword.first, {
                                'attr': {'class': 'form-control', 'id': 'users_plainPassword_first', 'placeholder': '••••••••'}
                            }) }}
                            <i class="fas fa-eye-slash toggle-password" onclick="togglePassword('users_plainPassword_first')"></i>
                        </div>
                        {{ form_errors(registration_form.plainPassword.first) }}
                        <div class="password-strength">
                            <div class="password-strength__bar" id="strengthBar"></div>
                        </div>
                        <span class="strength-label" id="strengthLabel"></span>
                        <div class="password-requirements">
                            <strong>Le mot de passe doit contenir :</strong>
                            <ul>
                                <li>Au moins 8 caractères</li>
                                <li>Une lettre majuscule &amp; minuscule</li>
                                <li>Un chiffre</li>
                            </ul>
                        </div>
                    </div>

                    {# CONFIRMATION #}
                    <div class="form-group">
                        <label for="users_plainPassword_second">
                            <i class="fas fa-lock field-icon"></i>
                            Confirmer le mot de passe&nbsp;<span style="color:#ef4444">*</span>
                        </label>
                        <div class="password-input">
                            {{ form_widget(registration_form.plainPassword.second, {
                                'attr': {'class': 'form-control', 'id': 'users_plainPassword_second', 'placeholder': '••••••••'}
                            }) }}
