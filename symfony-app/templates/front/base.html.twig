    {% block javascripts %}
        <script>
            (function () {
                const showToast = (type, message) => {
                    const container = document.getElementById('toastContainer');
                    if (!container || !message) return;
                    const toast = document.createElement('div');
                    toast.className = `toast toast-${type || 'info'}`;
                    toast.innerHTML = `<span>${message}</span>`;
                    container.appendChild(toast);
                    requestAnimationFrame(() => toast.classList.add('show'));
                    setTimeout(() => {
                        toast.classList.remove('show');
                        setTimeout(() => toast.remove(), 300);
                    }, 3000);
                };

                window.showToast = showToast;

                const originalFetch = window.fetch.bind(window);
                window.fetch = async (...args) => {
                    const options = args[1] || {};
                    const method = (options.method || 'GET').toUpperCase();
                    const skipToast = options.toast === false;
                    const showLoader = options.loading === true && typeof window.setLoading === 'function';
                    if (showLoader) window.setLoading(true);
                    let response;
                    try {
                        response = await originalFetch(...args);
                    } finally {
                        if (showLoader) window.setLoading(false);
                    }

                    if (!skipToast && method !== 'GET' && !response.ok) {
                        const contentType = response.headers.get('content-type') || '';
                        let payload = null;
                        if (contentType.includes('application/json')) {
                            try {
                                payload = await response.clone().json();
                            } catch (_) {}
                        }
                        const msg = payload?.message || payload?.error || response.statusText || 'Erreur.';
                        showToast('error', msg);
                    }

                    return response;
                };
            })();

            (function () {
                const loader = document.getElementById('globalLoader');
                if (!loader) return;
                const show = () => {
                    loader.classList.add('show');
                    loader.setAttribute('aria-hidden', 'false');
                };
                const hide = () => {
                    loader.classList.remove('show');
                    loader.setAttribute('aria-hidden', 'true');
                };
                window.setLoading = (on) => (on ? show() : hide());

                document.querySelectorAll('form').forEach((form) => {
                    if (form.dataset.ajax === '1') return;
                    form.addEventListener('submit', () => {
                        show();
                    });
                });

                document.querySelectorAll('a[href]').forEach((link) => {
                    if (link.target === '_blank' || link.hasAttribute('download')) return;
                    link.addEventListener('click', (e) => {
                        const href = link.getAttribute('href');
                        if (!href || href.startsWith('#') || href.startsWith('javascript:')) return;
                        // Skip loader for same-page hash navigation (e.g. /dashboard#panel)
                        try {
                            const linkUrl = new URL(link.href, location.href);
                            if (linkUrl.pathname === location.pathname && linkUrl.hash) return;
                        } catch (_) {}
                        show();
                    });
                });

                window.addEventListener('pageshow', (e) => {
                    if (e.persisted) hide();
                });

                window.addEventListener('load', hide);
            })();
            function __santea_initNav() {

            // ─── Generic dropdown helpers ─────────────────────────────────────────
            const allDropdowns = [];

            function closeAllDropdowns(except) {
                allDropdowns.forEach(({ btn, dropdown }) => {
                    if (dropdown === except) return;
                    dropdown.classList.remove('show');
                    btn.setAttribute('aria-expanded', 'false');
                });
            }

            function setupDropdown(btnId, dropdownId, onOpen) {
                const btn      = document.getElementById(btnId);
                const dropdown = document.getElementById(dropdownId);
                if (!btn || !dropdown) return;
                allDropdowns.push({ btn, dropdown });
                btn.addEventListener('click', (e) => {
                    e.stopPropagation();
                    const isOpen = dropdown.classList.contains('show');
                    closeAllDropdowns();
                    closeAllSubmenus();
                    if (!isOpen) {
                        dropdown.classList.add('show');
                        btn.setAttribute('aria-expanded', 'true');
                        if (onOpen) onOpen();
                    }
                });
                dropdown.addEventListener('click', (e) => e.stopPropagation());
            }

            // Single persistent document click listener — updated on each Turbo re-init
            if (!window.__navClickBound) {
                window.__navClickBound = true;
                document.addEventListener('click', () => window.__navCloseAll && window.__navCloseAll());
            }
            window.__navCloseAll = () => { closeAllDropdowns(); closeAllSubmenus(); };

            // ─── Account dropdown submenus ─────────────────────────────────────
            const accountDropdown      = document.getElementById('accountDropdown');
            const sectionsWithSubmenu  = accountDropdown ? accountDropdown.querySelectorAll('.dropdown-section.has-submenu') : [];
            const submenuToggles       = accountDropdown ? accountDropdown.querySelectorAll('.dropdown-section-toggle') : [];
            const submenuPanels        = accountDropdown ? accountDropdown.querySelectorAll('.dropdown-submenu') : [];

            function closeAllSubmenus() {
                sectionsWithSubmenu.forEach(s => s.classList.remove('open'));
                submenuToggles.forEach(t  => t.setAttribute('aria-expanded', 'false'));
                submenuPanels.forEach(p   => p.setAttribute('aria-hidden', 'true'));
            }
            closeAllSubmenus();

            submenuToggles.forEach((toggle) => {
                toggle.addEventListener('click', (event) => {
                    event.stopPropagation();
                    const section  = toggle.closest('.dropdown-section');
                    const isActive = section.classList.contains('open');
                    closeAllSubmenus();
                    if (!isActive) {
                        section.classList.add('open');
                        toggle.setAttribute('aria-expanded', 'true');
                        const panelId = toggle.getAttribute('aria-controls');
                        const panel   = panelId ? document.getElementById(panelId) : null;
                        if (panel) panel.setAttribute('aria-hidden', 'false');
                    }
                });
            });
            submenuPanels.forEach(s => s.addEventListener('click', e => e.stopPropagation()));

            // ─── Utility ──────────────────────────────────────────────────────────
            function timeAgo(dateStr) {
                const diff = Math.floor((Date.now() - new Date(dateStr).getTime()) / 1000);
                if (diff < 60)    return 'À l\'instant';
                if (diff < 3600)  return Math.floor(diff / 60) + ' min';
                if (diff < 86400) return Math.floor(diff / 3600) + ' h';
                return Math.floor(diff / 86400) + ' j';
            }

            function notifTypeIcon(type) {
                const map = { message:'fa-envelope', appointment:'fa-calendar-check', document:'fa-file-medical', system:'fa-bell', alert:'fa-exclamation-triangle' };
                return map[type] || 'fa-bell';
            }

            // ─── Notifications ─────────────────────────────────────────────────
            const notifBadge = document.getElementById('notifBadge');
            const notifList  = document.getElementById('notifList');
            const markAllBtn = document.getElementById('markAllReadBtn');

            async function loadNotifications() {
                try {
                    const res  = await fetch('/api/notification/mine', { toast: false });
                    const data = await res.json();
                    const count = data.unread || 0;
                    if (notifBadge) {
                        notifBadge.textContent = count > 9 ? '9+' : count;
                        notifBadge.hidden = count === 0;
                    }
                    if (!notifList) return;
                    if (!data.notifications || data.notifications.length === 0) {
                        notifList.innerHTML = '<div class="notif-empty"><i class="fas fa-bell-slash" style="font-size:22px;display:block;margin-bottom:8px;opacity:.4;"></i>Aucune notification</div>';
                        return;
                    }
                    notifList.innerHTML = data.notifications.map(n => {
                        const tag  = n.lien ? `a href="${n.lien}"` : 'div';
                        const end  = n.lien ? 'a' : 'div';
                        return `<${tag} class="notif-item ${n.lu ? '' : 'unread'}">
                            <div class="notif-icon"><i class="fas ${notifTypeIcon(n.type)}"></i></div>
                            <div class="notif-body">
                                <div class="notif-title">${n.titre}</div>
                                <div class="notif-msg">${n.message}</div>
                            </div>
                            <div class="notif-time">${timeAgo(n.createdAt)}</div>
                        </${end}>`;
                    }).join('');
                } catch (_) {}
            }

            if (markAllBtn) {
                markAllBtn.addEventListener('click', async (e) => {
                    e.stopPropagation();
                    try {
                        await fetch('/api/notification/read-all', { method: 'POST', toast: false });
                        await loadNotifications();
                    } catch (_) {}
                });
            }

            setupDropdown('notifBtn', 'notifDropdown', loadNotifications);
            loadNotifications();
            setInterval(loadNotifications, 60000);

            // ─── Messages ──────────────────────────────────────────────────────
            const msgBadge = document.getElementById('msgBadge');
            const convList = document.getElementById('convList');

            async function loadConversations() {
                try {
                    const res  = await fetch('/messages/api/conversations', { toast: false });
                    const data = await res.json();
                    const count = data.unread || 0;
                    if (msgBadge) {
                        msgBadge.textContent = count > 9 ? '9+' : count;
                        msgBadge.hidden = count === 0;
                    }
                    if (!convList) return;
                    if (!data.conversations || data.conversations.length === 0) {
                        convList.innerHTML = '<div class="conv-empty"><i class="fas fa-comments" style="font-size:22px;display:block;margin-bottom:8px;opacity:.4;"></i>Aucune conversation</div>';
                        return;
                    }
                    convList.innerHTML = data.conversations.map(c => `
                        <div class="conv-item" data-conv-id="${c.id}" data-user-id="${c.otherUserId}"
                             data-user-name="${c.otherUserName.replace(/"/g,'&quot;')}" data-user-avatar="${c.otherUserAvatar}">
                            <img src="${c.otherUserAvatar}" alt="" class="conv-avatar"
                                 onerror="this.src='https://ui-avatars.com/api/?name=${encodeURIComponent('User')}&background=0D8ABC&color=fff&size=40'">
                            <div class="conv-info">
                                <div class="conv-name">${c.otherUserName}</div>
                                <div class="conv-time">${c.lastMessageAt ? timeAgo(c.lastMessageAt) : ''}</div>
                            </div>
                            <i class="fas fa-chevron-right" style="color:#cbd5e1;font-size:12px;flex-shrink:0;"></i>
                        </div>
                    `).join('');
                    convList.querySelectorAll('.conv-item').forEach(item => {
                        item.addEventListener('click', () => {
                            openChatPopup(item.dataset.convId, item.dataset.userId, item.dataset.userName, item.dataset.userAvatar);
                            closeAllDropdowns();
                        });
                    });
                } catch (_) {}
            }

            setupDropdown('msgNavBtn', 'msgDropdown', loadConversations);
            loadConversations();
            setInterval(loadConversations, 30000);

            // ─── Account button ─────────────────────────────────────────────────
            setupDropdown('accountBtn', 'accountDropdown');

            // ─── Portal Nav Dropdowns to <body> ──────────────────────────────────
            // backdrop-filter on <header> creates a stacking context that traps
            // children regardless of z-index. Moving dropdowns to <body> (portal
            // pattern) keeps them in the root stacking context and above everything.
            (function portalNavDropdowns() {
                const pairs = [
                    { btnId: 'notifBtn',  dropId: 'notifDropdown'  },
                    { btnId: 'msgNavBtn', dropId: 'msgDropdown'     },
                    { btnId: 'accountBtn',dropId: 'accountDropdown' },
                ];
                pairs.forEach(({ btnId, dropId }) => {
                    const btn  = document.getElementById(btnId);
                    const drop = document.getElementById(dropId);
                    if (!btn || !drop) return;

                    // Detach from header and attach to body
                    document.body.appendChild(drop);

                    // Override CSS positioning to fixed so it's viewport-relative
                    Object.assign(drop.style, {
                        position : 'fixed',
                        top      : '-9999px',
                        left     : '-9999px',
                        right    : 'auto',
                        bottom   : 'auto',
                        margin   : '0',
                        zIndex   : '99999',
                    });

                    function reposition() {
                        const r    = btn.getBoundingClientRect();
                        const dropW = drop.offsetWidth  || 360;
                        const dropH = drop.scrollHeight || 500;
                        const vw   = window.innerWidth;
                        const vh   = window.innerHeight;
                        const gap  = 8;

                        // Align right edge of dropdown with right edge of button
                        let left = r.right - dropW;
                        if (left < gap)              left = gap;
                        if (left + dropW > vw - gap) left = vw - dropW - gap;

                        // Open downward; flip upward if it would bleed off-screen
                        const top = (r.bottom + gap + dropH > vh - gap)
                            ? Math.max(gap, r.top - dropH - gap)
                            : r.bottom + gap;

                        drop.style.top  = top  + 'px';
                        drop.style.left = left + 'px';
                    }

                    // Reposition every time .show is toggled
                    new MutationObserver(() => {
                        if (drop.classList.contains('show')) {
                            reposition();
                        } else {
                            drop.style.top  = '-9999px';
                            drop.style.left = '-9999px';
                        }
                    }).observe(drop, { attributes: true, attributeFilter: ['class'] });

                    window.addEventListener('resize', () => {
                        if (drop.classList.contains('show')) reposition();
                    }, { passive: true });
                });
            })();
            // ─────────────────────────────────────────────────────────────────────

            // ─── Messenger Popup ────────────────────────────────────────────────
            const messengerContainer = document.getElementById('messengerContainer');
            const openPopups = new Map();

            function openChatPopup(convId, recipientId, recipientName, avatarUrl) {
                if (openPopups.has(convId)) {
                    const existing = openPopups.get(convId);
                    existing.classList.remove('minimized');
                    existing.querySelector('.chat-popup-input')?.focus();
                    return;
                }
                if (!messengerContainer) return;

                const safeAvatar = avatarUrl || `https://ui-avatars.com/api/?name=${encodeURIComponent(recipientName)}&background=0D8ABC&color=fff&size=40`;

                const popup = document.createElement('div');
                popup.className = 'chat-popup';
                popup.dataset.convId = convId;
                popup.innerHTML = `
                    <div class="chat-popup-header">
                        <img src="${safeAvatar}" alt="" class="chat-popup-avatar"
                             onerror="this.src='https://ui-avatars.com/api/?name=${encodeURIComponent(recipientName)}&background=0D8ABC&color=fff&size=40'">
                        <span class="chat-popup-name">${recipientName}</span>
                        <div class="chat-popup-actions">
                            <button class="chat-popup-btn" title="Minimiser" data-action="minimize"><i class="fas fa-minus"></i></button>
                            <a href="/messages/conversation/${convId}" class="chat-popup-btn" title="Ouvrir" style="text-decoration:none;"><i class="fas fa-external-link-alt"></i></a>
                            <button class="chat-popup-btn" title="Fermer" data-action="close"><i class="fas fa-times"></i></button>
                        </div>
                    </div>
                    <div class="chat-popup-messages" id="popupMessages-${convId}">
                        <div class="popup-loading"><i class="fas fa-spinner fa-spin"></i>&nbsp;Chargement…</div>
                    </div>
                    <div class="chat-popup-footer">
                        <input type="text" class="chat-popup-input" placeholder="Écrire un message…" id="popupInput-${convId}" autocomplete="off">
                        <button class="chat-popup-send" id="popupSend-${convId}"><i class="fas fa-paper-plane"></i></button>
                    </div>
                `;
                messengerContainer.appendChild(popup);
                openPopups.set(convId, popup);

                popup.querySelector('.chat-popup-header').addEventListener('click', (e) => {
                    if (e.target.closest('[data-action]') || e.target.closest('a')) return;
                    popup.classList.toggle('minimized');
                });
                popup.querySelector('[data-action="minimize"]').addEventListener('click', (e) => {
                    e.stopPropagation(); popup.classList.toggle('minimized');
                });
                popup.querySelector('[data-action="close"]').addEventListener('click', (e) => {
                    e.stopPropagation();
                    clearInterval(pollInterval);
                    popup.remove();
                    openPopups.delete(convId);
                });

                const msgArea = popup.querySelector(`#popupMessages-${convId}`);
                const input   = popup.querySelector(`#popupInput-${convId}`);
                const sendBtn = popup.querySelector(`#popupSend-${convId}`);

                function renderMessages(messages) {
                    if (!messages || messages.length === 0) {
                        msgArea.innerHTML = '<div class="conv-empty" style="font-size:12px;padding:20px;">Aucun message encore.</div>';
                    } else {
                        // Sort oldest → newest so conversation reads top-to-bottom
                        const sorted = [...messages].sort((a, b) => new Date(a.createdAt) - new Date(b.createdAt));
                        let lastDate = null;
                        const html = sorted.map(m => {
                            let dateSep = '';
                            const d = m.createdAt ? m.createdAt.slice(0, 10) : null;
                            if (d && d !== lastDate) {
                                lastDate = d;
                                dateSep = `<div class="popup-date-sep">${d}</div>`;
                            }
                            return dateSep + `<div class="popup-msg ${m.isOwn ? 'own' : 'other'}">
                                ${m.content.replace(/</g,'&lt;').replace(/>/g,'&gt;')}
                                <span class="popup-msg-time">${m.createdAt ? m.createdAt.slice(11,16) : ''}</span>
                            </div>`;
                        }).join('');
                        msgArea.innerHTML = html;
                        msgArea.scrollTop = msgArea.scrollHeight;
                    }
                }

                let lastMsgCount = 0;
                async function fetchHistory() {
                    try {
                        const res  = await fetch('/messages/history/' + recipientId + '?page=1', { toast: false });
                        const data = await res.json();
                        const msgs = data.messages || [];
                        if (msgs.length !== lastMsgCount) {
                            lastMsgCount = msgs.length;
                            renderMessages(msgs);
                        }
                    } catch (_) {}
                }
                fetchHistory();

                const pollInterval = setInterval(() => {
                    if (!openPopups.has(convId)) { clearInterval(pollInterval); return; }
                    fetchHistory();
                }, 5000);

                async function sendMessage() {
                    const content = input.value.trim();
                    if (!content) return;
                    input.value = '';
                    try {
                        await fetch('/messages/send', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ recipientId: parseInt(recipientId), content }),
                            toast: false,
                        });
                        lastMsgCount = 0; // force re-render
                        await fetchHistory();
                    } catch (_) {}
                }

                sendBtn.addEventListener('click', sendMessage);
                input.addEventListener('keydown', (e) => {
                    if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); sendMessage(); }
                });
                setTimeout(() => input.focus(), 100);
            }

            window.openChatPopup = openChatPopup;

        } // end __santea_initNav

        document.addEventListener("DOMContentLoaded", __santea_initNav);
        document.addEventListener("turbo:load", __santea_initNav);

        const form = document.getElementById("registerForm");
        if (form) {
        form.addEventListener("submit", async function(e) {
            e.preventDefault();

            // vider anciennes erreurs
            document.querySelectorAll(".error-message").forEach(el => el.innerHTML = "");

            const formData = new FormData(form);

            try {
                const response = await fetch(form.action, {
                    method: "POST",
                    headers: { "X-Requested-With": "XMLHttpRequest" },
                    body: formData
                });

                const data = await response.json();

                if (data.success) {
                    window.showToast?.('success', data.message || 'Inscription réussie.');
                    window.location.href = data.redirect || "/";
                }

            } catch (error) {

                const response = await error.response?.json?.();

                if (response && response.errors) {
                    for (const field in response.errors) {
                        const div = document.getElementById("error-" + field);
                        if (div) {
                            div.innerHTML = response.errors[field].join("<br>");
                        }
                    }
                }
                window.showToast?.('error', 'Erreur lors de l’inscription.');
            }
        });
        }
        (function () {
            const disableHtml5Validation = (root = document) => {
                root.querySelectorAll('form').forEach((formEl) => {
                    formEl.setAttribute('novalidate', 'novalidate');
                    formEl.noValidate = true;
                });
            };
            disableHtml5Validation();
            document.addEventListener('invalid', (e) => e.preventDefault(), true);
            const observer = new MutationObserver((mutations) => {
                mutations.forEach((mutation) => {
                    mutation.addedNodes.forEach((node) => {
                        if (!(node instanceof HTMLElement)) return;
                        if (node.tagName === 'FORM') {
                            node.setAttribute('novalidate', 'novalidate');
                            node.noValidate = true;
                        } else {
                            disableHtml5Validation(node);
                        }
                    });
                });
            });
            observer.observe(document.documentElement, { childList: true, subtree: true });
        })();
        </script>
    {% endblock %}
    
    {% block footer %}
        <!-- Footer -->
        <footer>
            <div class="container">
                <p>{{ 'now'|date('Y') }} SANTÉA - All Rights Reserved</p>
            </div>
        </footer>
    {% endblock %}

    {{ importmap('app') }}

    {# ──── SANTÉA 3D Layer ────────────────────────────────────────── #}
    {# Three.js WebGL background (async, idle-loaded) #}
    <script type="module" src="{{ asset('js/santea-3d-engine.js') }}?v=1"></script>
    {# Interactions: scroll reveal, tilt, parallax, counters #}
    <script defer src="{{ asset('js/santea-3d-interactions.js') }}?v=1"></script>

    {# Toast container — last in DOM so z-index is always above modals #}
    <div id="toastContainer" class="toast-container" aria-live="polite" aria-atomic="true"></div>

</body>
</html>
