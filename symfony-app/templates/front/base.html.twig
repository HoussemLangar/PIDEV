<!DOCTYPE html>
<html lang="{{ app.request.locale }}" dir="{{ app.request.locale == 'ar' ? 'rtl' : 'ltr' }}">
<head>
     <meta charset="UTF-8">

    <!-- Responsive & Mobile -->
    <meta name="format-detection" content="telephone=no">

    <!-- SEO -->
    <title>{% block title %}SANTÉA - Healthcare Solutions{% endblock %}</title>
    <meta name="description" content="SANTÉA est une plateforme de santé moderne reliant médecins, pharmaciens, coachs sportifs, nutritionnistes et patients.">
    <meta name="keywords" content="santé, médecin, nutrition, pharmacie, coaching sportif, rendez-vous médical, abonnement santé">
    <meta name="author" content="SANTÉA">
    <meta name="robots" content="index, follow">

    <!-- Theme & Browser UI -->
    <meta name="theme-color" content="#0D8ABC">
    <meta name="color-scheme" content="light dark">

    <!-- Open Graph (Facebook, LinkedIn, WhatsApp…) -->
    <meta property="og:type" content="website">
    <meta property="og:title" content="SANTÉA - Healthcare Solutions">
    <meta property="og:description" content="Une solution complète pour la gestion de la santé et du bien-être.">
    <meta property="og:image" content="{{ asset('logo.png') }}">
    <meta property="og:url" content="{{ app.request.uri }}">
    <meta property="og:site_name" content="SANTÉA">

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="SANTÉA - Healthcare Solutions">
    <meta name="twitter:description" content="Plateforme santé intelligente et sécurisée.">
    <meta name="twitter:image" content="{{ asset('logo.png') }}">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    
    {% block stylesheets %}
        <link rel="stylesheet" href="{{ asset('style.css') }}?v=10002">
        <link rel="stylesheet" href="{{ asset('css/santea-3d.css') }}?v=1">
        <link rel="SHORTCUT ICON" type="image/x-icon" href="{{ asset('logo.png') }}">
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
        <style>
        /* ─── Nav Pharmacien submenu ─────────────────────────── */
        .nav-links .nav-has-sub { position:relative; }
        .nav-links .nav-has-sub > a .nav-caret {
            font-size:.6rem;
            margin-left:3px;
            opacity:.7;
            transition:transform .2s;
            display:inline-block;
        }
        .nav-links .nav-has-sub:hover > a .nav-caret,
        .nav-links .nav-has-sub:focus-within > a .nav-caret { transform:rotate(180deg); }
        .nav-links .nav-sub {
            position:absolute;
            top:calc(100% + 8px);
            left:50%;
            transform:translateX(-50%) translateY(-6px);
            min-width:210px;
            background:#fff;
            border:1px solid #e2e8f0;
            border-radius:14px;
            box-shadow:0 16px 40px rgba(15,23,42,.14);
            opacity:0;
            visibility:hidden;
            transition:opacity .2s,transform .2s,visibility .2s;
            z-index:999;
            overflow:hidden;
            list-style:none;
            padding:6px 0;
            margin:0;
        }
        [data-theme="dark"] .nav-links .nav-sub {
            background:#1e293b;
            border-color:#334155;
        }
        .nav-links .nav-has-sub:hover .nav-sub,
        .nav-links .nav-has-sub:focus-within .nav-sub {
            opacity:1;
            visibility:visible;
            transform:translateX(-50%) translateY(0);
        }
        .nav-links .nav-sub li a {
            display:flex;
            align-items:center;
            gap:9px;
            padding:9px 16px;
            font-size:.87rem;
            font-weight:600;
            color:#374151;
            text-decoration:none;
            transition:background .15s,color .15s;
            white-space:nowrap;
        }
        [data-theme="dark"] .nav-links .nav-sub li a { color:#cbd5e1; }
        .nav-links .nav-sub li a:hover {
            background:rgba(13,138,188,.08);
            color:#0D8ABC;
        }
        .nav-links .nav-sub li a i {
            width:18px;
            text-align:center;
            color:#0D8ABC;
            font-size:.8rem;
        }
        .nav-links .nav-sub li a::after { display:none; }
        .nav-links .nav-sub .nav-sub-divider {
            height:1px;
            background:#e2e8f0;
            margin:4px 0;
        }
        [data-theme="dark"] .nav-links .nav-sub .nav-sub-divider { background:#334155; }

        /* ─── Nav Icons ─────────────────────────────────────────── */
        .nav-icons { display:flex; align-items:center; gap:6px; }
        .nav-icon-wrap { position:relative; }
        .nav-icon-btn {
            position:relative; width:40px; height:40px; border:none; border-radius:12px;
            background:rgba(13,138,188,.08); cursor:pointer; display:flex; align-items:center;
            justify-content:center; color:#0D8ABC; font-size:16px;
            transition:background .2s,color .2s,transform .15s,box-shadow .2s;
        }
        .nav-icon-btn:hover { background:rgba(13,138,188,.18); transform:translateY(-1px); box-shadow:0 4px 12px rgba(13,138,188,.2); }
        .nav-icon-btn:active { transform:translateY(0); }
        .nav-avatar-btn { background:transparent; border:2px solid #e2e8f0; border-radius:50%; width:38px; height:38px; padding:0; overflow:hidden; }
        .nav-avatar-btn:hover { border-color:#0D8ABC; box-shadow:0 0 0 3px rgba(13,138,188,.2); transform:none; }
        .nav-avatar-img { width:100%; height:100%; object-fit:cover; border-radius:50%; display:block; }
        .nav-badge {
            position:absolute; top:-4px; right:-4px; min-width:18px; height:18px;
            background:linear-gradient(135deg,#ef4444,#dc2626); color:#fff; font-size:10px; font-weight:800;
            border-radius:50px; display:flex; align-items:center; justify-content:center;
            padding:0 4px; border:2px solid white; line-height:1; pointer-events:none;
            box-shadow:0 2px 6px rgba(239,68,68,.4);
        }

        /* ─── Nav Dropdown – shared ──────────────────────────────── */
        .nav-dropdown {
            position:absolute; top:calc(100% + 12px); right:0; width:360px;
            background:#fff; border-radius:18px;
            box-shadow:0 20px 60px rgba(15,23,42,.18),0 4px 16px rgba(15,23,42,.08);
            border:1px solid rgba(226,232,240,.8);
            z-index:1000; opacity:0; visibility:hidden; transform:translateY(-10px) scale(.97);
            transition:opacity .22s cubic-bezier(.4,0,.2,1),visibility .22s,transform .22s cubic-bezier(.4,0,.2,1);
            /* overflow is NOT hidden so account submenu can open inline */
        }
        [data-theme="dark"] .nav-dropdown { background:#1e293b; border-color:#334155; }
        .nav-dropdown.show { opacity:1; visibility:visible; transform:translateY(0) scale(1); }

        /* Account dropdown viewport cap */
        #accountDropdown { max-height:calc(100vh - 100px); }

        .nav-dropdown-header {
            display:flex; align-items:center; justify-content:space-between;
            padding:16px 20px 12px; border-bottom:1px solid #f1f5f9;
        }
        .nav-dropdown-title { font-weight:800; font-size:15px; color:#1a1a2e; display:flex; align-items:center; gap:8px; }
        [data-theme="dark"] .nav-dropdown-title { color:#e2e8f0; }
        [data-theme="dark"] .nav-dropdown-header { border-color:#334155; }
        .nav-dropdown-action {
            font-size:12px; color:#0D8ABC; cursor:pointer; background:rgba(13,138,188,.1); border:none;
            padding:4px 10px; border-radius:20px; font-weight:600; text-decoration:none; transition:all .2s;
        }
        .nav-dropdown-action:hover { background:rgba(13,138,188,.2); color:#0a6d96; }

        /* ─── Notification list ──────────────────────────────────── */
        .notif-list { max-height:360px; overflow-y:auto; }
        .conv-list  { max-height:360px; overflow-y:auto; }
        .notif-list::-webkit-scrollbar,.conv-list::-webkit-scrollbar { width:4px; }
        .notif-list::-webkit-scrollbar-thumb,.conv-list::-webkit-scrollbar-thumb { background:#e2e8f0; border-radius:4px; }
        .notif-item {
            display:flex; align-items:flex-start; gap:12px; padding:12px 20px;
            border-bottom:1px solid #f8fafc; text-decoration:none; color:inherit; transition:background .15s;
        }
        .notif-item:last-child { border-bottom:none; }
        .notif-item:hover { background:#f8fafc; }
        .notif-item.unread { background:linear-gradient(to right,#eff6ff,#f8faff); border-left:3px solid #3b82f6; padding-left:17px; }
        [data-theme="dark"] .notif-item:hover { background:#0f172a; }
        [data-theme="dark"] .notif-item.unread { background:linear-gradient(to right,#1e3a5f,#1e293b); border-color:#3b82f6; }
        .notif-icon {
            width:38px; height:38px; border-radius:10px;
            background:linear-gradient(135deg,#dbeafe,#bfdbfe);
            display:flex; align-items:center; justify-content:center;
            flex-shrink:0; color:#3b82f6; font-size:14px;
        }
        .notif-body { flex:1; min-width:0; }
        .notif-title { font-weight:700; font-size:13px; color:#1a1a2e; margin-bottom:3px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
        [data-theme="dark"] .notif-title { color:#e2e8f0; }
        .notif-msg { font-size:12px; color:#64748b; line-height:1.4; display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden; }
        .notif-time { font-size:11px; color:#94a3b8; white-space:nowrap; flex-shrink:0; margin-top:2px; background:#f1f5f9; padding:2px 6px; border-radius:50px; }
        .notif-empty,.conv-empty { padding:36px 20px; text-align:center; color:#94a3b8; font-size:13px; }
        .notif-empty i,.conv-empty i { font-size:32px; opacity:.3; margin-bottom:10px; display:block; }

        /* ─── Conversation list ──────────────────────────────────── */
        .conv-item {
            display:flex; align-items:center; gap:12px; padding:12px 20px;
            border-bottom:1px solid #f8fafc; cursor:pointer; transition:background .15s;
        }
        .conv-item:last-child { border-bottom:none; }
        .conv-item:hover { background:#f8fafc; }
        [data-theme="dark"] .conv-item:hover { background:#0f172a; }
        .conv-avatar { width:42px; height:42px; border-radius:50%; object-fit:cover; flex-shrink:0; border:2px solid #e2e8f0; }
        .conv-info { flex:1; min-width:0; }
        .conv-name { font-weight:700; font-size:13px; color:#1a1a2e; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
        [data-theme="dark"] .conv-name { color:#e2e8f0; }
        .conv-time { font-size:11px; color:#94a3b8; margin-top:2px; }
        .conv-arrow { color:#cbd5e1; font-size:12px; flex-shrink:0; transition:transform .15s; }
        .conv-item:hover .conv-arrow { transform:translateX(3px); color:#0D8ABC; }

        /* ─── Override submenu to be accordion (fixes overflow:hidden clipping) ── */
        #accountDropdown .dropdown-section.has-submenu { margin:0; }
        #accountDropdown .dropdown-submenu {
            position:static !important;
            width:100% !important;
            right:auto !important; top:auto !important;
            box-shadow:none !important;
            transform:none !important;
            max-height:0;
            overflow:hidden !important;
            opacity:1 !important;
            visibility:visible !important;
            padding:0 0 0 24px !important;
            margin:0 !important;
            border-radius:0 0 8px 8px !important;
            background:rgba(13,138,188,.04) !important;
            border-left:3px solid rgba(13,138,188,.25) !important;
            transition:max-height .25s ease, padding .25s ease !important;
            pointer-events:none;
        }
        #accountDropdown .dropdown-section.has-submenu.open > .dropdown-submenu {
            max-height:300px !important;
            padding:6px 0 6px 24px !important;
            pointer-events:auto;
        }
        [data-theme="dark"] #accountDropdown .dropdown-submenu { background:rgba(13,138,188,.06) !important; border-color:rgba(13,138,188,.3) !important; }

        /* ══════════════════════════════════════════════════════════
           ▌ ACCOUNT DROPDOWN — Enhanced Design
           ══════════════════════════════════════════════════════════ */

        /* ─ Container ─────────────────────────────────────────────── */
        #accountDropdown {
            width: 300px;
            border-radius: 20px;
            padding: 0;
            max-height: calc(100vh - 100px);
            display: flex;
            flex-direction: column;
            overflow: hidden;
            border: 1px solid rgba(226,232,240,.6);
        }
        [data-theme="dark"] #accountDropdown { border-color: rgba(51,65,85,.8); }

        /* ─ Header banner ─────────────────────────────────────────── */
        #accountDropdown .account-header {
            background: linear-gradient(135deg, #0D8ABC 0%, #0a6d96 55%, #1e40af 100%);
            padding: 22px 20px 18px;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 8px;
            position: relative;
            overflow: hidden;
        }
        #accountDropdown .account-header::before {
            content: '';
            position: absolute; top: -30px; right: -20px;
            width: 100px; height: 100px;
            background: rgba(255,255,255,.08);
            border-radius: 50%;
        }
        #accountDropdown .account-header::after {
            content: '';
            position: absolute; bottom: -20px; left: 10px;
            width: 70px; height: 70px;
            background: rgba(255,255,255,.06);
            border-radius: 50%;
        }
        #accountDropdown .acc-avatar-ring {
            width: 66px; height: 66px;
            border-radius: 50%;
            padding: 3px;
            background: linear-gradient(135deg, rgba(255,255,255,.9), rgba(255,255,255,.4));
            box-shadow: 0 4px 18px rgba(0,0,0,.25);
            flex-shrink: 0;
            position: relative; z-index:1;
        }
        #accountDropdown .acc-avatar-ring img {
            width: 100%; height: 100%;
            border-radius: 50%;
            object-fit: cover;
            display: block;
        }
        #accountDropdown .acc-name {
            font-weight: 800; font-size: 15px; color: #fff;
            text-shadow: 0 1px 4px rgba(0,0,0,.2);
            position: relative; z-index:1;
            line-height: 1.2;
        }
        #accountDropdown .acc-email {
            font-size: 11.5px; color: rgba(255,255,255,.75);
            position: relative; z-index:1;
        }
        #accountDropdown .acc-role-badge {
            display: inline-flex; align-items: center; gap: 5px;
            background: rgba(255,255,255,.2);
            border: 1px solid rgba(255,255,255,.35);
            color: #fff; font-size: 11px; font-weight: 700;
            padding: 3px 10px; border-radius: 50px;
            letter-spacing: .4px; text-transform: uppercase;
            position: relative; z-index:1;
        }
        #accountDropdown .acc-role-badge i { font-size: 9px; opacity: .85; }

        /* ─ Body ───────────────────────────────────────────────────── */
        #accountDropdown .acc-body {
            padding: 8px 0 6px;
            overflow-y: auto;
            min-height: 0;
            overscroll-behavior: contain;
            -webkit-overflow-scrolling: touch;
        }

        /* ─ Items ───────────────────────────────────────────────────── */
        #accountDropdown .dropdown-item {
            display: flex; align-items: center; gap: 11px;
            padding: 10px 18px; margin: 1px 8px;
            border-radius: 12px;
            font-size: 13.5px; font-weight: 600;
            color: #1a1a2e; text-decoration: none;
            transition: background .15s, color .15s, transform .12s;
            position: relative;
        }
        [data-theme="dark"] #accountDropdown .dropdown-item { color: #cbd5e1; }
        #accountDropdown .dropdown-item:hover {
            background: rgba(13,138,188,.09);
            color: #0D8ABC;
            transform: translateX(2px);
        }
        [data-theme="dark"] #accountDropdown .dropdown-item:hover {
            background: rgba(13,138,188,.15);
            color: #38bdf8;
        }
        #accountDropdown .dropdown-item i:first-child {
            width: 30px; height: 30px; border-radius: 9px; flex-shrink: 0;
            display: flex; align-items: center; justify-content: center;
            background: rgba(13,138,188,.1); color: #0D8ABC;
            font-size: 12.5px; transition: background .15s;
        }
        [data-theme="dark"] #accountDropdown .dropdown-item i:first-child {
            background: rgba(13,138,188,.2); color: #38bdf8;
        }
        #accountDropdown .dropdown-item:hover i:first-child {
            background: rgba(13,138,188,.18);
        }
        /* danger item */
        #accountDropdown .dropdown-item.danger {
            color: #dc2626;
            margin-top: 2px;
        }
        [data-theme="dark"] #accountDropdown .dropdown-item.danger { color: #f87171; }
        #accountDropdown .dropdown-item.danger i:first-child {
            background: rgba(220,38,38,.1); color: #dc2626;
        }
        [data-theme="dark"] #accountDropdown .dropdown-item.danger i:first-child {
            background: rgba(248,113,113,.15); color: #f87171;
        }
        #accountDropdown .dropdown-item.danger:hover {
            background: rgba(220,38,38,.08); color: #b91c1c; transform: translateX(2px);
        }
        [data-theme="dark"] #accountDropdown .dropdown-item.danger:hover {
            background: rgba(248,113,113,.12); color: #fca5a5;
        }

        /* ─ Submenu toggle button ───────────────────────────────────── */
        #accountDropdown .dropdown-section-toggle {
            display: flex; align-items: center; gap: 11px;
            width: calc(100% - 16px); margin: 1px 8px;
            padding: 10px 18px 10px 18px;
            border: none; border-radius: 12px;
            background: rgba(13,138,188,.06);
            color: #1a1a2e; font-size: 13.5px; font-weight: 600;
            cursor: pointer; transition: background .15s, color .15s;
            box-sizing: border-box;
        }
        [data-theme="dark"] #accountDropdown .dropdown-section-toggle {
            background: rgba(13,138,188,.1); color: #cbd5e1;
        }
        #accountDropdown .dropdown-section-toggle:hover {
            background: rgba(13,138,188,.12); color: #0D8ABC;
        }
        [data-theme="dark"] #accountDropdown .dropdown-section-toggle:hover { color: #38bdf8; }
        #accountDropdown .dropdown-section-toggle i:first-child {
            width: 30px; height: 30px; border-radius: 9px; flex-shrink: 0;
            display: flex; align-items: center; justify-content: center;
            background: rgba(13,138,188,.12); color: #0D8ABC; font-size: 12.5px;
        }
        [data-theme="dark"] #accountDropdown .dropdown-section-toggle i:first-child {
            background: rgba(13,138,188,.2); color: #38bdf8;
        }
        #accountDropdown .dropdown-section-toggle span { flex: 1; text-align: left; }
        #accountDropdown .toggle-indicator {
            font-size: 11px; color: #94a3b8; transition: transform .25s;
            width: auto !important; height: auto !important;
            background: none !important;
        }
        #accountDropdown .dropdown-section.has-submenu.open .toggle-indicator { transform: rotate(90deg); }

        /* ─ Divider ─────────────────────────────────────────────────── */
        #accountDropdown .dropdown-divider {
            height: 1px; background: rgba(226,232,240,.7);
            margin: 6px 18px;
        }
        [data-theme="dark"] #accountDropdown .dropdown-divider { background: rgba(51,65,85,.7); }

        /* ─ Inline rows (theme / lang) ──────────────────────────────── */
        #accountDropdown .dropdown-inline {
            display: flex; align-items: center; justify-content: space-between;
            padding: 8px 18px; margin: 1px 8px;
            color: #64748b; font-size: 12.5px; font-weight: 600;
            border-radius: 10px;
            cursor: default;
        }
        [data-theme="dark"] #accountDropdown .dropdown-inline { color: #94a3b8; }
        #accountDropdown .inline-actions { display: flex; gap: 5px; }
        #accountDropdown .mini-pill {
            padding: 3px 10px; border-radius: 50px;
            font-size: 11.5px; font-weight: 700;
            background: rgba(13,138,188,.08); color: #0D8ABC;
            border: 1px solid rgba(13,138,188,.2);
            text-decoration: none; transition: all .15s;
        }
        #accountDropdown .mini-pill:hover {
            background: #0D8ABC; color: #fff;
            border-color: #0D8ABC;
        }
        [data-theme="dark"] #accountDropdown .mini-pill {
            background: rgba(13,138,188,.15); color: #38bdf8; border-color: rgba(56,189,248,.25);
        }
        [data-theme="dark"] #accountDropdown .mini-pill:hover { background: #0D8ABC; color: #fff; }

        /* ─── Messenger popup ────────────────────────────────────── */
        #messengerContainer {
            position:fixed; bottom:0; right:24px;
            display:flex; align-items:flex-end; gap:10px;
            z-index:2000; pointer-events:none;
            max-width:calc(100vw - 48px);
        }
        #messengerSliderBtn {
            display:none; position:fixed; bottom:16px; right:0;
            width:32px; height:54px; background:rgba(13,138,188,.9); color:white;
            border:none; cursor:pointer; z-index:2001; border-radius:8px 0 0 8px;
            font-size:14px; pointer-events:all; transition:background .15s;
        }
        #messengerSliderBtn:hover { background:#0D8ABC; }
        .chat-popup {
            width:360px; background:#fff; border-radius:16px 16px 0 0;
            box-shadow:0 -4px 40px rgba(15,23,42,.18),0 0 0 1px rgba(15,23,42,.05);
            display:flex; flex-direction:column; overflow:hidden;
            height:500px; transition:height .25s cubic-bezier(.4,0,.2,1); pointer-events:all;
        }
        [data-theme="dark"] .chat-popup { background:#1e293b; }
        .chat-popup.minimized { height:52px; }
        .chat-popup-header {
            background:linear-gradient(135deg,#0D8ABC 0%,#0862a0 100%);
            padding:12px 14px; display:flex; align-items:center; gap:10px;
            cursor:pointer; flex-shrink:0; user-select:none;
        }
        .chat-popup-avatar { width:32px; height:32px; border-radius:50%; object-fit:cover; border:2px solid rgba(255,255,255,.4); flex-shrink:0; }
        .chat-popup-name { flex:1; font-weight:700; font-size:13px; color:#fff; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
        .chat-popup-status { font-size:11px; color:rgba(255,255,255,.7); display:block; margin-top:1px; }
        .chat-popup-actions { display:flex; gap:3px; flex-shrink:0; }
        .chat-popup-btn {
            width:28px; height:28px; border:none; background:rgba(255,255,255,.15); border-radius:8px;
            color:#fff; cursor:pointer; font-size:12px; display:flex; align-items:center; justify-content:center;
            transition:background .15s; text-decoration:none;
        }
        .chat-popup-btn:hover { background:rgba(255,255,255,.3); color:#fff; }
        .chat-popup-messages {
            flex:1; overflow-y:auto; padding:14px 12px 8px; display:flex; flex-direction:column;
            gap:8px; background:#f8fafc; min-height:0;
        }
        [data-theme="dark"] .chat-popup-messages { background:#0f172a; }
        .chat-popup-messages::-webkit-scrollbar { width:4px; }
        .chat-popup-messages::-webkit-scrollbar-thumb { background:#cbd5e1; border-radius:4px; }
        .popup-msg {
            max-width:78%; padding:9px 13px; border-radius:16px; font-size:13px;
            line-height:1.45; word-break:break-word;
        }
        .popup-msg.own { background:linear-gradient(135deg,#0D8ABC,#0862a0); color:#fff; align-self:flex-end; border-bottom-right-radius:4px; }
        .popup-msg.other { background:#fff; color:#1a1a2e; align-self:flex-start; border-bottom-left-radius:4px; border:1px solid #e2e8f0; box-shadow:0 1px 4px rgba(15,23,42,.06); }
        [data-theme="dark"] .popup-msg.other { background:#1e293b; color:#e2e8f0; border-color:#334155; }
        .popup-msg-time { font-size:10px; opacity:.6; margin-top:3px; display:block; }
        .popup-date-sep { text-align:center; font-size:11px; color:#94a3b8; padding:4px 0; }
        .chat-popup-footer {
            padding:10px 12px; background:#fff; border-top:1px solid #f1f5f9;
            display:flex; gap:8px; flex-shrink:0; align-items:center;
        }
        [data-theme="dark"] .chat-popup-footer { background:#1e293b; border-color:#334155; }
        .chat-popup-input {
            flex:1; padding:9px 14px; border:1.5px solid #e2e8f0; border-radius:22px;
            font-size:13px; outline:none; transition:border-color .2s,background .2s; background:#f8fafc; resize:none;
        }
        [data-theme="dark"] .chat-popup-input { background:#0f172a; color:#e2e8f0; border-color:#334155; }
        .chat-popup-input:focus { border-color:#0D8ABC; background:#fff; }
        .chat-popup-send {
            width:36px; height:36px; flex-shrink:0; border:none; border-radius:50%;
            background:linear-gradient(135deg,#0D8ABC,#0862a0); color:#fff;
            cursor:pointer; font-size:13px; display:flex; align-items:center; justify-content:center;
            transition:transform .15s,box-shadow .15s;
        }
        .chat-popup-send:hover { transform:scale(1.1); box-shadow:0 4px 14px rgba(13,138,188,.4); }
        .popup-loading { display:flex; align-items:center; justify-content:center; padding:32px; color:#94a3b8; font-size:13px; gap:8px; }
