{% block javascripts %}
    {{ parent() }}
    {% set pendingReservationsJs = 0 %}
    {% set lowStockCountJs = 0 %}
    {% for r in reservations %}
        {% if r.statut == 'en_attente' %}
            {% set pendingReservationsJs = pendingReservationsJs + 1 %}
        {% endif %}
    {% endfor %}
    {% for s in stocks %}
        {% if s.quantite <= 10 %}
            {% set lowStockCountJs = lowStockCountJs + 1 %}
        {% endif %}
    {% endfor %}
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script src="https://unpkg.com/@zxing/library@0.19.1/umd/index.min.js"></script>
    <script>
        (function () {
            const apiFetch = (url, options = {}) => fetch(url, { ...options, loading: true });

            /* ── Modal open / close ── */
            const openModal = (id) => {
                const m = document.getElementById(id);
                if (!m) return;
                m.classList.add('is-open');
                m.setAttribute('aria-hidden', 'false');
                document.body.style.overflow = 'hidden';
                if (id === 'modal-create-pharmacy') setTimeout(initPharmMap, 310);
            };
            const closeModal = (id) => {
                const m = document.getElementById(id);
                if (!m) return;
                m.classList.remove('is-open');
                m.setAttribute('aria-hidden', 'true');
                document.body.style.overflow = '';
            };
            document.addEventListener('click', (e) => {
                const openBtn = e.target.closest('[data-open-modal]');
                if (openBtn) { openModal(openBtn.dataset.openModal); return; }
                const closeBtn = e.target.closest('[data-close-modal]');
                if (closeBtn) { closeModal(closeBtn.dataset.closeModal); return; }
                /* backdrop click */
                if (e.target.classList.contains('pharma-modal')) closeModal(e.target.id);
            });
            document.addEventListener('keydown', (e) => {
                if (e.key === 'Escape') {
                    document.querySelectorAll('.pharma-modal.is-open').forEach((m) => closeModal(m.id));
                }
            });

            /* ── Navigate to a panel then reload to refresh data ── */
            const reloadTo = (panelId) => {
                history.replaceState(null, '', '#' + panelId);
                location.reload();
            };

            /* ── Custom confirmation dialog (promise-based, replaces confirm()) ── */
            const askConfirm = (msg, title = 'Confirmer la suppression', okLabel = 'Supprimer') => new Promise((resolve) => {
                const dlg  = document.getElementById('confirmDialog');
                const msgEl   = document.getElementById('confirmDlgMsg');
                const titleEl = document.getElementById('confirmDlgTitle');
                const okBtn   = document.getElementById('confirmOk');
                const cancelBtn = document.getElementById('confirmCancel');
                if (!dlg) { resolve(window.confirm(msg)); return; }
                titleEl.textContent = title;
                msgEl.textContent   = msg;
                okBtn.innerHTML = `<i class="fas fa-trash-alt"></i> ${okLabel}`;
                dlg.setAttribute('aria-hidden', 'false');
                dlg.classList.add('is-open');
                const cleanup = (result) => {
                    dlg.classList.remove('is-open');
                    dlg.setAttribute('aria-hidden', 'true');
                    okBtn.onclick = null;
                    cancelBtn.onclick = null;
                    resolve(result);
                };
                okBtn.onclick    = () => cleanup(true);
                cancelBtn.onclick = () => cleanup(false);
                /* Close on backdrop click */
                const backdropHandler = (e) => { if (e.target === dlg) { dlg.removeEventListener('click', backdropHandler); cleanup(false); } };
                dlg.addEventListener('click', backdropHandler);
            });

            /* ── Image upload helpers ── */
            const previewFile = (inputEl, previewEl) => {
                if (!inputEl || !previewEl) return;
                inputEl.addEventListener('change', () => {
                    const file = inputEl.files[0];
                    if (!file) return;
                    const url = URL.createObjectURL(file);
                    previewEl.innerHTML = `<img src="${url}" alt="Aperçu">`;
                });
            };
            const uploadImage = async (file, endpoint) => {
                if (!file) return null;
                const fd = new FormData();
                fd.append('image', file);
                const res = await apiFetch(endpoint, { method: 'POST', body: fd });
                let d = null;
                try { d = await res.json(); } catch (_) {}
                return d?.imageUrl ?? null;
            };

            previewFile(document.getElementById('pharmacyImageInput'), document.getElementById('pharmacyImgPreview'));
            previewFile(document.getElementById('medImageInput'), document.getElementById('medImgPreview'));
            previewFile(document.getElementById('editPharmImgInput'), document.getElementById('editPharmImgPreview'));
            previewFile(document.getElementById('editMedImgInput'), document.getElementById('editMedImgPreview'));
            /* Clear red outline on input */
            document.getElementById('editPharmNom')?.addEventListener('input', (e) => e.target.style.outline = '');
            document.getElementById('editMedNom')?.addEventListener('input', (e) => e.target.style.outline = '');
            const dashboardContext = {
                pharmacies: {{ pharmacies|length }},
                medicaments: {{ medicaments|length }},
                stocks: {{ stocks|length }},
                reservations: {{ reservations|length }},
                pendingReservations: {{ pendingReservationsJs }},
                lowStockCount: {{ lowStockCountJs }}
            };
            const hoursInput = document.getElementById('pharmacyHours');
            const scheduleGrid = document.getElementById('scheduleGrid');
            const dayLabels = {
                mon: 'Lun', tue: 'Mar', wed: 'Mer', thu: 'Jeu', fri: 'Ven', sat: 'Sam', sun: 'Dim'
            };
            const buildSchedule = () => {
                if (!scheduleGrid || !hoursInput) return;
                const rows = scheduleGrid.querySelectorAll('.schedule-row');
                const parts = [];
                rows.forEach((row) => {
                    const day = row.dataset.day;
                    const isOpen = row.querySelector('.schedule-open').checked;
                    const from = row.querySelector('.schedule-from').value;
                    const to = row.querySelector('.schedule-to').value;
                    parts.push(`${dayLabels[day]} ${isOpen ? `${from}-${to}` : 'Fermé'}`);
                    row.classList.toggle('is-closed', !isOpen);
                });
                hoursInput.value = parts.join('; ');
            };
            scheduleGrid?.addEventListener('change', buildSchedule);
            buildSchedule();

            /* ── Edit-pharmacy schedule grid ── */
            const editScheduleGrid = document.getElementById('editScheduleGrid');
            const editHoursInput   = document.getElementById('editPharmHoraires');
            const buildEditSchedule = () => {
                if (!editScheduleGrid || !editHoursInput) return;
                const parts = [];
                editScheduleGrid.querySelectorAll('.schedule-row').forEach((row) => {
                    const day    = row.dataset.day;
                    const isOpen = row.querySelector('.schedule-open').checked;
                    const from   = row.querySelector('.schedule-from').value;
                    const to     = row.querySelector('.schedule-to').value;
                    parts.push(`${dayLabels[day]} ${isOpen ? `${from}-${to}` : 'Fermé'}`);
                    row.classList.toggle('is-closed', !isOpen);
                });
                editHoursInput.value = parts.join('; ');
            };
            editScheduleGrid?.addEventListener('change', buildEditSchedule);

            const parseScheduleToGrid = (horaires) => {
                if (!editScheduleGrid) return;
                const map = {};
                (horaires || '').split(';').forEach((part) => {
                    const p     = part.trim();
                    if (!p) return;
                    const label = p.substring(0, 3);
                    const rest  = p.substring(4).trim();
                    if (rest === 'Fermé' || rest === 'Ferme') {
                        map[label] = { open: false, from: '08:00', to: '18:00' };
                    } else {
                        const [from, to] = rest.split('-');
                        map[label] = { open: true, from: (from || '08:00').trim(), to: (to || '18:00').trim() };
                    }
                });
                editScheduleGrid.querySelectorAll('.schedule-row').forEach((row) => {
                    const label = dayLabels[row.dataset.day];
                    const info  = map[label];
                    const cb    = row.querySelector('.schedule-open');
                    const f     = row.querySelector('.schedule-from');
                    const t     = row.querySelector('.schedule-to');
                    cb.checked = info ? info.open : true;
                    f.value    = info ? info.from : '08:00';
                    t.value    = info ? info.to   : '18:00';
                    row.classList.toggle('is-closed', !cb.checked);
                });
                buildEditSchedule();
            };

            const mapEl = document.getElementById('pharmacyMap');
            const latInput = document.getElementById('pharmacyLat');
            const lngInput = document.getElementById('pharmacyLng');
            let pharmMap = null;
            let pharmMapInited = false;
            const initPharmMap = () => {
                if (!window.L) return;
                /* Ensure the container has a real height before Leaflet reads it */
                if (!mapEl) return;
                mapEl.style.height = '320px';

                const doInvalidate = () => {
                    if (!pharmMap) return;
                    requestAnimationFrame(() => {
                        pharmMap.invalidateSize({ animate: false });
                        /* second pass after the next paint */
                        requestAnimationFrame(() => pharmMap.invalidateSize({ animate: false }));
                    });
                };

                if (pharmMap) {
                    doInvalidate();
                    return;
                }

                const defaultLat = 36.8065;
                const defaultLng = 10.1815;
                pharmMap = L.map(mapEl, { preferCanvas: true }).setView([defaultLat, defaultLng], 12);
                L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                    maxZoom: 19,
                    attribution: '&copy; OpenStreetMap'
                }).addTo(pharmMap);

                let marker = L.marker([defaultLat, defaultLng], { draggable: true }).addTo(pharmMap);

                const syncInputs = (latlng) => {
                    if (latInput) latInput.value = latlng.lat.toFixed(6);
                    if (lngInput) lngInput.value = latlng.lng.toFixed(6);
                    const badge = document.getElementById('pharmacyCoordsText');
                    if (badge) badge.textContent = `${latlng.lat.toFixed(5)}, ${latlng.lng.toFixed(5)}`;
                };
                syncInputs(marker.getLatLng());

                pharmMap.on('click', (e) => { marker.setLatLng(e.latlng); syncInputs(e.latlng); });
                marker.on('dragend', () => syncInputs(marker.getLatLng()));

                /* Multiple invalidateSize passes to handle modal transition delay */
                doInvalidate();
                setTimeout(doInvalidate, 150);
                setTimeout(doInvalidate, 400);
                setTimeout(doInvalidate, 800);

                if (navigator.geolocation) {
                    navigator.geolocation.getCurrentPosition((pos) => {
                        const coords = [pos.coords.latitude, pos.coords.longitude];
                        pharmMap.setView(coords, 14);
                        marker.setLatLng(coords);
                        syncInputs(marker.getLatLng());
                        doInvalidate();
                    }, () => { /* geoloc denied — keep Tunis default */ });
                }
            };

            const panels = document.querySelectorAll('.dash-panel');
            const buttons = document.querySelectorAll('.dash-nav');
            const activatePanel = (id) => {
                panels.forEach((p) => p.classList.toggle('is-active', p.id === id));
                buttons.forEach((b) => b.classList.toggle('is-active', b.dataset.target === id));
                const target = document.getElementById(id);
                if (target) target.scrollIntoView({ behavior: 'smooth', block: 'start' });
/* map is lazy-inited via openModal('modal-create-pharmacy') */
            };
            buttons.forEach((btn) => {
                btn.addEventListener('click', () => activatePanel(btn.dataset.target));
            });
            const _hashToModal = { 'create-pharmacy': 'modal-create-pharmacy', 'create-medicament': 'modal-create-medicament', 'create-stock': 'modal-create-stock' };
            const handleHash = () => {
                const h = location.hash ? location.hash.replace('#', '') : null;
                if (!h) return;
                history.replaceState(null, '', location.pathname);
                if (_hashToModal[h]) {
                    openModal(_hashToModal[h]);
                } else if (document.getElementById(h)) {
                    activatePanel(h);
                }
            };
            window.addEventListener('hashchange', handleHash);
            if (!document.querySelector('.dash-panel.is-active')) {
                const hash = location.hash ? location.hash.replace('#', '') : null;
                if (hash && _hashToModal[hash]) {
                    activatePanel('list-pharmacies');
                    setTimeout(() => openModal(_hashToModal[hash]), 80);
                } else if (hash && document.getElementById(hash)) {
                    activatePanel(hash);
                } else {
                    activatePanel('list-pharmacies');
                }
            }

            /* data-toggle-edit removed — edits now use modals */

            const aiChatLog = document.getElementById('aiChatLog');
            const aiChatForm = document.getElementById('aiChatForm');
            const aiChatInput = document.getElementById('aiChatInput');
            const aiPromptButtons = document.querySelectorAll('.ai-prompt');
            const escapeHtml = (text) => (text || '')
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;')
                .replace(/'/g, '&#039;');

            const appendAiMessage = (type, text) => {
                if (!aiChatLog) return;
                const item = document.createElement('div');
                item.className = `ai-msg ${type === 'user' ? 'ai-msg-user' : 'ai-msg-bot'}`;
                const safeText = escapeHtml(text);
                const time = new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
                item.innerHTML = type === 'user'
                    ? `<i class="fas fa-user"></i><div><p>${safeText}</p><small>${time}</small></div>`
                    : `<i class="fas fa-robot"></i><div><p>${safeText}</p><small>${time}</small></div>`;
                aiChatLog.appendChild(item);
                aiChatLog.scrollTop = aiChatLog.scrollHeight;
            };

            const appendTyping = () => {
                if (!aiChatLog) return null;
                const item = document.createElement('div');
                item.className = 'ai-msg ai-msg-bot ai-msg-typing';
                item.innerHTML = '<i class="fas fa-robot"></i><div><span></span><span></span><span></span></div>';
                aiChatLog.appendChild(item);
                aiChatLog.scrollTop = aiChatLog.scrollHeight;
                return item;
            };

            const getAiReply = (question) => {
                const q = (question || '').toLowerCase();
                if (q.includes('priorit') || q.includes('aujourd')) {
                    return `Priorités du jour : 1) traiter ${dashboardContext.pendingReservations} réservation(s) en attente, 2) vérifier ${dashboardContext.lowStockCount} stock(s) faible(s), 3) valider les prix sur les produits les plus demandés.`;
                }
                if (q.includes('stock') || q.includes('rupture') || q.includes('quantit')) {
                    if (dashboardContext.lowStockCount > 0) {
                        return `Vous avez ${dashboardContext.lowStockCount} stock(s) avec quantité ≤ 10. Je recommande un réassort par criticité (médicaments à forte rotation d'abord) et une vérification des seuils d'alerte.`;
                    }
                    return 'Aucun stock critique détecté (≤ 10) actuellement. Vous pouvez optimiser les prix et anticiper les besoins saisonniers.';
                }
                if (q.includes('reservation') || q.includes('attente') || q.includes('patient')) {
                    return `Il y a ${dashboardContext.pendingReservations} réservation(s) en attente sur ${dashboardContext.reservations} au total. Traitez d’abord les demandes anciennes, puis confirmez selon disponibilité réelle du stock.`;
                }
                if (q.includes('médicament') || q.includes('medicament') || q.includes('catalogue') || q.includes('prix')) {
                    return `Votre catalogue lié au dashboard contient ${dashboardContext.medicaments} médicament(s). Pensez à harmoniser dosage/forme/prix pour faciliter la recherche et limiter les erreurs de dispensation.`;
                }
                if (q.includes('pharmacie') || q.includes('horaire') || q.includes('localisation')) {
                    return `Vous gérez ${dashboardContext.pharmacies} pharmacie(s). Vérifiez les horaires et la géolocalisation pour réduire les annulations et améliorer la fiabilité côté patient.`;
                }
                return `Résumé actuel : ${dashboardContext.pharmacies} pharmacie(s), ${dashboardContext.medicaments} médicament(s), ${dashboardContext.stocks} ligne(s) de stock, ${dashboardContext.pendingReservations} réservation(s) en attente. Demandez "priorités", "stock" ou "réservations" pour une recommandation ciblée.`;
            };

            const handleAiQuestion = (question) => {
                const cleanQuestion = (question || '').trim();
                if (!cleanQuestion) return;
                appendAiMessage('user', cleanQuestion);
                const reply = getAiReply(cleanQuestion);
                const typingNode = appendTyping();
                window.setTimeout(() => {
                    typingNode?.remove();
                    appendAiMessage('bot', reply);
                }, 420);
            };

            aiChatForm?.addEventListener('submit', (event) => {
                event.preventDefault();
                const question = aiChatInput?.value || '';
                handleAiQuestion(question);
                if (aiChatInput) aiChatInput.value = '';
            });

            aiPromptButtons.forEach((button) => {
                button.addEventListener('click', () => {
                    const question = button.dataset.prompt || '';
                    handleAiQuestion(question);
                });
            });

            const toLower = (val) => (val || '').toString().toLowerCase();
            const filterCards = (cards, predicate) => {
                cards.forEach((card) => {
                    card.style.display = predicate(card) ? '' : 'none';
                });
            };

            const pharmacyList = document.querySelectorAll('#pharmaciesList .pharmacy-card');
            const pharmacyName = document.getElementById('pharmacyFilterName');
            const pharmacyAddress = document.getElementById('pharmacyFilterAddress');
            const pharmacyStatus = document.getElementById('pharmacyFilterActive');
            const applyPharmacyFilter = () => {
                const name = toLower(pharmacyName?.value);
                const address = toLower(pharmacyAddress?.value);
                const status = toLower(pharmacyStatus?.value);
                filterCards(pharmacyList, (card) => {
                    const matchesName = !name || card.dataset.name.includes(name);
                    const matchesAddress = !address || card.dataset.address.includes(address);
                    const matchesStatus = !status || card.dataset.active === status;
                    return matchesName && matchesAddress && matchesStatus;
                });
            };
            pharmacyName?.addEventListener('input', applyPharmacyFilter);
            pharmacyAddress?.addEventListener('input', applyPharmacyFilter);
            pharmacyStatus?.addEventListener('change', applyPharmacyFilter);

            const medList = document.querySelectorAll('#medicamentsList .medicament-card');
            const medName = document.getElementById('medFilterName');
            const medType = document.getElementById('medFilterType');
            const applyMedFilter = () => {
                const name = toLower(medName?.value);
                const type = toLower(medType?.value);
                filterCards(medList, (card) => {
                    const matchesName = !name || card.dataset.name.includes(name);
                    const matchesType = !type || card.dataset.type.includes(type);
                    return matchesName && matchesType;
                });
            };
            medName?.addEventListener('input', applyMedFilter);
            medType?.addEventListener('input', applyMedFilter);

            const stockList = document.querySelectorAll('#stocksList .stock-card');
            const stockMed = document.getElementById('stockFilterMed');
            const stockPharmacy = document.getElementById('stockFilterPharmacy');
            const applyStockFilter = () => {
                const med = toLower(stockMed?.value);
                const pharmacy = toLower(stockPharmacy?.value);
                filterCards(stockList, (card) => {
                    const matchesMed = !med || card.dataset.med.includes(med);
                    const matchesPharmacy = !pharmacy || card.dataset.pharmacy.includes(pharmacy);
                    return matchesMed && matchesPharmacy;
                });
            };
            stockMed?.addEventListener('input', applyStockFilter);
            stockPharmacy?.addEventListener('input', applyStockFilter);

            const resList = document.querySelectorAll('#list-reservations .reservation-card');
            const resMed = document.getElementById('resFilterMed');
            const resPatient = document.getElementById('resFilterPatient');
            const resStatus = document.getElementById('resFilterStatus');
            const applyResFilter = () => {
                const med = toLower(resMed?.value);
                const patient = toLower(resPatient?.value);
                const status = toLower(resStatus?.value);
                filterCards(resList, (card) => {
                    const matchesMed = !med || card.dataset.med.includes(med);
                    const matchesPatient = !patient || card.dataset.patient.includes(patient);
                    const matchesStatus = !status || card.dataset.status === status;
                    return matchesMed && matchesPatient && matchesStatus;
                });
            };
            resMed?.addEventListener('input', applyResFilter);
            resPatient?.addEventListener('input', applyResFilter);
            resStatus?.addEventListener('change', applyResFilter);

            /* ── pharmacy edit btn: open modal + populate fields ── */
            document.addEventListener('click', async (e) => {
                /* ── PHARMACY: open edit modal ── */
                const pharmEditBtn = e.target.closest('.pharmacy-edit-btn');
                if (pharmEditBtn) {
                    const card = pharmEditBtn.closest('.pharmacy-card');
                    document.getElementById('editPharmNom').value       = pharmEditBtn.dataset.nom || '';
                    document.getElementById('editPharmAdresse').value   = pharmEditBtn.dataset.adresse || '';
                    document.getElementById('editPharmTel').value       = pharmEditBtn.dataset.telephone || '';
                    document.getElementById('editPharmEmail').value     = pharmEditBtn.dataset.email || '';
                    document.getElementById('editPharmLat').value       = pharmEditBtn.dataset.latitude || '';
                    document.getElementById('editPharmLng').value       = pharmEditBtn.dataset.longitude || '';
                    document.getElementById('editPharmStatus').value    = pharmEditBtn.dataset.isActive || '1';
                    parseScheduleToGrid(pharmEditBtn.dataset.horaires || '');
                    const prevEl = document.getElementById('editPharmImgPreview');
                    const img = pharmEditBtn.dataset.image;
                    prevEl.innerHTML = img ? `<img src="/images/pharmacies/${img}" alt="Photo">` : '<i class="fas fa-clinic-medical"></i>';
                    document.getElementById('modal-edit-pharmacy').dataset.pharmacyId = card.dataset.id;
                    openModal('modal-edit-pharmacy');
                    return;
                }

                /* ── PHARMACY: save from edit modal ── */
                if (e.target.id === 'editPharmSave' || e.target.closest('#editPharmSave')) {
                    const modal = document.getElementById('modal-edit-pharmacy');
                    const nomEl = document.getElementById('editPharmNom');
                    if (!nomEl.value.trim()) { nomEl.style.outline = '2px solid #ef4444'; nomEl.focus(); return; }
                    nomEl.style.outline = '';
                    const id = modal.dataset.pharmacyId;
                    buildEditSchedule(); /* sync hidden horaires input before reading payload */
                    const payload = {};
                    modal.querySelectorAll('[data-field]').forEach((el) => { payload[el.dataset.field] = el.value; });
                    const res = await apiFetch(`/api/pharmacien/pharmacies/${id}`, {
                        method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload),
                    });
                    let resData = null;
                    try { resData = await res.clone().json(); } catch (_) {}
                    if (res.ok) {
                        const imgFile = document.getElementById('editPharmImgInput')?.files?.[0];
                        if (imgFile) await uploadImage(imgFile, `/api/pharmacien/pharmacies/${id}/image`);
                        window.showToast?.('success', 'Pharmacie modifiée avec succès.');
                        closeModal('modal-edit-pharmacy'); reloadTo('list-pharmacies');
                    } else {
                        window.showToast?.('error', resData?.message || 'Erreur lors de la modification.');
                    }
                    return;
                }

                /* ── PHARMACY: delete ── */
                const pharmacyDelete = e.target.closest('.pharmacy-delete');
                if (pharmacyDelete) {
                    const card = pharmacyDelete.closest('.pharmacy-card');
                    const ok = await askConfirm(
                        'La pharmacie et toutes ses données associées seront définitivement supprimées.',
                        'Supprimer la pharmacie'
                    );
                    if (!ok) return;
                    await apiFetch(`/api/pharmacien/pharmacies/${card.dataset.id}/delete`, { method: 'POST' });
                    reloadTo('list-pharmacies');
                    return;
                }

                /* ── MEDICAMENT: open edit modal ── */
                const medEditBtn = e.target.closest('.med-edit-btn');
                if (medEditBtn) {
                    const card = medEditBtn.closest('.medicament-card');
                    document.getElementById('editMedNom').value        = medEditBtn.dataset.nom || '';
                    document.getElementById('editMedType').value       = medEditBtn.dataset.type || '';
                    document.getElementById('editMedForme').value      = medEditBtn.dataset.forme || '';
                    document.getElementById('editMedDosage').value     = medEditBtn.dataset.dosage || '';
                    document.getElementById('editMedLab').value        = medEditBtn.dataset.laboratoire || '';
                    document.getElementById('editMedCode').value       = medEditBtn.dataset.codeBarre || '';
                    document.getElementById('editMedPrix').value       = medEditBtn.dataset.prix || '';
                    const prevEl = document.getElementById('editMedImgPreview');
                    const img = medEditBtn.dataset.image;
                    prevEl.innerHTML = img ? `<img src="/images/medicaments/${img}" alt="Photo">` : '<i class="fas fa-pills"></i>';
                    document.getElementById('modal-edit-medicament').dataset.medId = card.dataset.id;
                    openModal('modal-edit-medicament');
                    return;
                }

                /* ── MEDICAMENT: save from edit modal ── */
                if (e.target.id === 'editMedSave' || e.target.closest('#editMedSave')) {
                    const modal = document.getElementById('modal-edit-medicament');
                    const nomEl = document.getElementById('editMedNom');
                    if (!nomEl.value.trim()) { nomEl.style.outline = '2px solid #ef4444'; nomEl.focus(); return; }
                    nomEl.style.outline = '';
                    const id = modal.dataset.medId;
                    const payload = {};
                    modal.querySelectorAll('[data-field]').forEach((el) => { payload[el.dataset.field] = el.value; });
                    const res = await apiFetch(`/api/pharmacien/medicaments/${id}`, {
                        method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload),
                    });
                    const imgFile = document.getElementById('editMedImgInput')?.files?.[0];
                    if (imgFile) await uploadImage(imgFile, `/api/pharmacien/medicaments/${id}/image`);
                    if (res.ok) { closeModal('modal-edit-medicament'); reloadTo('list-medicaments'); }
                    return;
                }

                /* ── MEDICAMENT: delete ── */
                const medDelete = e.target.closest('.med-delete');
                if (medDelete) {
                    const card = medDelete.closest('.medicament-card');
                    const ok = await askConfirm(
                        'Ce médicament sera définitivement supprimé du catalogue. Cette action est irréversible.',
                        'Supprimer le médicament'
                    );
                    if (!ok) return;
                    await apiFetch(`/api/pharmacien/medicaments/${card.dataset.id}/delete`, { method: 'POST' });
                    reloadTo('list-medicaments');
                    return;
                }

                /* ── STOCK: open edit modal ── */
                const stockEditBtn = e.target.closest('.stock-edit-btn');
                if (stockEditBtn) {
                    const card = stockEditBtn.closest('[data-stock-id]');
                    document.getElementById('editStockQty').value   = stockEditBtn.dataset.qty || '';
                    document.getElementById('editStockPrice').value = stockEditBtn.dataset.price || '';
                    document.getElementById('modal-edit-stock').dataset.stockId = card.dataset.stockId;
                    openModal('modal-edit-stock');
                    return;
                }

                /* ── STOCK: save from edit modal ── */
                if (e.target.id === 'editStockSave' || e.target.closest('#editStockSave')) {
                    const modal = document.getElementById('modal-edit-stock');
                    const id = modal.dataset.stockId;
                    const qty   = document.getElementById('editStockQty').value;
                    const price = document.getElementById('editStockPrice').value;
                    const res = await apiFetch(`/api/pharmacien/stocks/${id}`, {
                        method: 'POST', headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ quantite: qty, prix: price }),
                    });
                    if (res.ok) { closeModal('modal-edit-stock'); reloadTo('list-stocks'); }
                    return;
                }

                /* ── STOCK: delete ── */
                const stockDeleteBtn = e.target.closest('.stock-delete');
                if (stockDeleteBtn) {
                    const card = stockDeleteBtn.closest('[data-stock-id]');
                    const ok = await askConfirm(
                        'Cette ligne de stock sera définitivement supprimée. Cette action est irréversible.',
                        'Supprimer le stock'
                    );
                    if (!ok) return;
                    await apiFetch(`/api/pharmacien/stocks/${card.dataset.stockId}/delete`, { method: 'POST' });
                    reloadTo('list-stocks');
                    return;
                }

                /* ── RESERVATIONS ── */
                const confirmBtn = e.target.closest('.res-confirm');
                if (confirmBtn) {
                    const card = confirmBtn.closest('[data-reservation-id]');
                    await apiFetch(`/api/pharmacien/reservations/${card.dataset.reservationId}/confirm`, { method: 'POST' });
                }
                const rejectBtn = e.target.closest('.res-reject');
                if (rejectBtn) {
                    const card = rejectBtn.closest('[data-reservation-id]');
                    await apiFetch(`/api/pharmacien/reservations/${card.dataset.reservationId}/reject`, { method: 'POST' });
                }
            });

            document.getElementById('medCreate')?.addEventListener('click', async () => {
                const nomInput = document.getElementById('medName');
                if (!nomInput?.value.trim()) {
                    window.showToast?.('error', 'Le nom du médicament est obligatoire.');
                    nomInput?.focus();
                    return;
                }
                const payload = {
                    nom: nomInput.value.trim(),
                    type: document.getElementById('medType').value,
                    forme: document.getElementById('medForme').value,
                    dosage: document.getElementById('medDosage').value,
                    laboratoire: document.getElementById('medLab').value,
                    code_barre: document.getElementById('medCode').value,
                    prix: document.getElementById('medPrice').value,
                };
                const res = await apiFetch('/api/pharmacien/medicaments', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload),
                });
                let data = null;
                try { data = await res.json(); } catch (_) {}
                if (res.ok && (data?.success ?? true)) {
                    const imgFile = document.getElementById('medImageInput')?.files?.[0];
                    if (imgFile && data?.id) {
                        await uploadImage(imgFile, `/api/pharmacien/medicaments/${data.id}/image`);
                    }
                    closeModal('modal-create-medicament');
                    reloadTo('list-medicaments');
                } else {
                    window.showToast?.('error', data?.message || "Erreur lors de l'ajout du médicament.");
                }
            });

            const scanBtn = document.getElementById('scanCodeBtn');
            const scanPanel = document.getElementById('scanPanel');
            const scanVideo = document.getElementById('scanVideo');
            const scanHint = document.getElementById('scanHint');
            const stopScanBtn = document.getElementById('stopScanBtn');
            const closeScanBtn = document.getElementById('closeScanBtn');
            const codeInput = document.getElementById('medCode');
            let scanStream = null;
            let zxingReader = null;

            const stopScan = () => {
                if (zxingReader) { try { zxingReader.reset(); } catch (_) {} zxingReader = null; }
                if (scanStream) {
                    scanStream.getTracks().forEach((t) => t.stop());
                    scanStream = null;
                }
                if (scanVideo) { scanVideo.srcObject = null; }
                scanPanel?.classList.remove('is-active');
                scanPanel?.setAttribute('aria-hidden', 'true');
            };

            const startScan = async () => {
                scanPanel.classList.add('is-active');
                scanPanel.setAttribute('aria-hidden', 'false');

                // ZXing (cross-browser: Chrome, Firefox, Safari)
                if (window.ZXing) {
                    try {
                        zxingReader = new ZXing.BrowserMultiFormatReader();
                        scanHint.textContent = 'Pointez la caméra sur le code barre / QR…';
                        await zxingReader.decodeFromVideoDevice(null, scanVideo, (result, err) => {
                            if (result) {
                                codeInput.value = result.getText();
                                scanHint.textContent = '✓ Code détecté : ' + result.getText();
                                stopScan();
                            } else if (err && !(err.name === 'NotFoundException')) {
                                scanHint.textContent = 'Erreur de lecture, réessayez.';
                            }
                        });
                    } catch (err) {
                        scanHint.textContent = 'Accès caméra refusé : ' + (err.message || err);
                    }
                    return;
                }
                // Fallback: BarcodeDetector (Chrome only)
                if (!('BarcodeDetector' in window)) {
                    scanHint.textContent = 'Scanner non supporté. Entrez le code manuellement.';
                    return;
                }
                scanHint.textContent = 'Recherche du code…';
                try {
                    scanStream = await navigator.mediaDevices.getUserMedia({ video: { facingMode: 'environment' } });
                } catch (err) {
                    scanHint.textContent = 'Accès caméra refusé : ' + (err.message || err);
                    return;
                }
                scanVideo.srcObject = scanStream;
                await scanVideo.play();
                const detector = new BarcodeDetector({ formats: ['qr_code', 'ean_13', 'code_128', 'ean_8', 'upc_a', 'upc_e'] });
                let scanning = true;
                const loop = async () => {
                    if (!scanning) return;
                    try {
                        const barcodes = await detector.detect(scanVideo);
                        if (barcodes.length) {
                            codeInput.value = barcodes[0].rawValue || '';
                            scanHint.textContent = '✓ Code détecté.';
                            scanning = false;
                            stopScan();
                            return;
                        }
                    } catch (_) {}
                    requestAnimationFrame(loop);
                };
                requestAnimationFrame(loop);
            };

            scanBtn?.addEventListener('click', startScan);
            stopScanBtn?.addEventListener('click', stopScan);
            closeScanBtn?.addEventListener('click', stopScan);
            scanPanel?.addEventListener('click', (e) => {
                if (e.target?.dataset?.close === 'scan') {
                    stopScan();
                }
            });

            document.getElementById('stockCreate')?.addEventListener('click', async () => {
                const pharmacyId = document.getElementById('stockPharmacyId').value;
                const medId = document.getElementById('stockMedId').value;
                const qty = document.getElementById('stockQty').value;
                const price = document.getElementById('stockPrice').value;
                if (!pharmacyId) { window.showToast?.('error', 'Veuillez sélectionner une pharmacie.'); return; }
                if (!medId)       { window.showToast?.('error', 'Veuillez sélectionner un médicament.'); return; }
                if (!qty)         { window.showToast?.('error', 'Veuillez saisir une quantité.'); return; }
                const res = await apiFetch('/api/pharmacien/stocks', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ pharmacy_id: pharmacyId, medicament_id: medId, quantite: qty, prix: price }),
                });
                let data = null;
                try { data = await res.json(); } catch (_) {}
                if (res.ok && (data?.success ?? true)) {
                    closeModal('modal-create-stock');
                    reloadTo('list-stocks');
                } else {
                    window.showToast?.('error', data?.message || "Erreur lors de l'ajout du stock.");
                }
            });
        })();
    </script>
{% endblock %}
