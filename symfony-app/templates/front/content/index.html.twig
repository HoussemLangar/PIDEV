{% extends 'front/base.html.twig' %}

{% block title %}Forum & Contenus{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .content-pill.status-pending {
            background-color: #ffc107;
            color: #000;
        }
        .content-pill.status-published {
            background-color: #28a745;
            color: #fff;
        }
        .content-pill.status-rejected {
            background-color: #dc3545;
            color: #fff;
        }
    </style>
{% endblock %}

{% block body %}
<section class="content-page">
    <div class="content-hero">
        <div class="content-header">
            <div>
                <div class="profile-badge">Contenus</div>
                <h1>Forum, Articles & Guides</h1>
                <p>Explorez les contenus validés, échangez et laissez vos commentaires.</p>
            </div>
            <div>
                {% if canCreate %}
                    <a href="{{ path('front_content_create') }}" class="btn btn-primary">Ajouter un contenu</a>
                {% endif %}
            </div>
        </div>
        <div class="content-filters">
            <input type="text" id="contentSearch" placeholder="Rechercher un contenu...">
            <select id="contentTypeFilter">
                <option value="">Tous les types</option>
                <option value="article">Article</option>
                <option value="video">Vidéo</option>
                <option value="pdf">PDF</option>
                <option value="lien">Lien</option>
            </select>
            <select id="contentCategoryFilter">
                <option value="">Toutes les catégories</option>
                <option value="Santé mentale">Santé mentale</option>
                <option value="Général">Général</option>
                <option value="Médicaments">Médicaments</option>
                <option value="Sport">Sport</option>
                <option value="Nutrition">Nutrition</option>
                <option value="Bien-être">Bien-être</option>
                <option value="Prévention">Prévention</option>
                <option value="Maladies chroniques">Maladies chroniques</option>
                <option value="Grossesse">Grossesse</option>
                <option value="Pédiatrie">Pédiatrie</option>
                <option value="Gériatrie">Gériatrie</option>
                <option value="Urgences">Urgences</option>
                <option value="Dermatologie">Dermatologie</option>
                <option value="Cardiologie">Cardiologie</option>
                <option value="Dentaire">Dentaire</option>
                <option value="Ophtalmologie">Ophtalmologie</option>
                <option value="Sexualité">Sexualité</option>
                <option value="Addictions">Addictions</option>
                <option value="Sommeil">Sommeil</option>
                <option value="Stress">Stress</option>
                <option value="Alimentation">Alimentation</option>
                <option value="Vaccination">Vaccination</option>
                <option value="Thérapies">Thérapies</option>
                <option value="Médicaments génériques">Médicaments génériques</option>
                <option value="Médecine douce">Médecine douce</option>
            </select>
            {% if app.user.role != 'ROLE_PATIENT' %}
                <button class="btn btn-secondary btn-xs" id="contentMine">Mon contenu</button>
            {% endif %}
            <button class="btn btn-secondary btn-xs" id="contentReset">Réinitialiser</button>
        </div>
    </div>

    <div class="content-section">
        <div>
        <div class="content-section-header">
            <div class="content-section-title">
                <h3>Recommandé pour vous</h3>
                <p>Basé sur votre profil et vos interactions.</p>
            </div>
            <span class="content-pill">Personnalisé</span>
        </div>
        <div class="content-grid" id="recommendedGrid">
            {% for item in recommended %}
                {% set isLiked = item.id in likedIds %}
                {% set isOwner = item.auteur and app.user and item.auteur.id == app.user.id %}
                <div class="content-card" data-content-id="{{ item.id }}">
                    <div class="content-meta">
                        <span class="content-pill">{{ item.type|upper }}</span>
                        {% if isOwner and item.statut %}
                            {% set statutClass = 'content-pill' %}
                            {% set statutLabel = '' %}
                            {% if item.statut == 'en_attente' %}
                                {% set statutClass = statutClass ~ ' status-pending' %}
                                {% set statutLabel = 'En attente' %}
                            {% elseif item.statut == 'publie' %}
                                {% set statutClass = statutClass ~ ' status-published' %}
                                {% set statutLabel = 'Publié' %}
                            {% elseif item.statut == 'rejete' %}
                                {% set statutClass = statutClass ~ ' status-rejected' %}
                                {% set statutLabel = 'Rejeté' %}
                            {% else %}
                                {% set statutClass = statutClass ~ ' status-pending' %}
                                {% set statutLabel = item.statut %}
                            {% endif %}
                            {% if statutLabel %}
                                <span class="{{ statutClass }}">{{ statutLabel }}</span>
                            {% endif %}
                        {% endif %}
                        <span>{{ (item.datePublication ?? item.createdAt)|date('d/m/Y') }}</span>
                        <span>{{ item.auteur ? (item.auteur.fullName ?? item.auteur.email) : 'Anonyme' }}</span>
                    </div>
                    <h3>{{ item.titre }}</h3>
                    <p>{{ item.description ?? item.contenu|striptags|slice(0, 140) }}</p>
                    <div class="content-actions">
                        <button class="like-btn {{ isLiked ? 'active' : '' }}" data-liked="{{ isLiked ? '1' : '0' }}">
                            <i class="fas fa-heart"></i>
                            <span class="like-count">{{ item.likes|length }}</span>
                        </button>
                        <button class="btn btn-secondary btn-xs comment-toggle">
                            Commentaires (<span class="comment-count">{{ item.commentaires|length }}</span>)
                        </button>
                        <a class="btn btn-primary btn-xs" href="{{ path('front_content_show', {id: item.id}) }}">Voir</a>
                    </div>
                    <div class="comment-panel" hidden>
                        <div class="comment-list"></div>
                        <form class="comment-form" data-ajax="1">
                            <textarea rows="2" placeholder="Ajouter un commentaire..."></textarea>
                            <div class="content-actions">
                                <button type="submit" class="btn btn-primary btn-xs">Publier</button>
                                <div class="form-error" data-comment-error></div>
                            </div>
                        </form>
                    </div>
                </div>
            {% else %}
                <p>Aucune recommandation disponible.</p>
            {% endfor %}
        </div>
    </div>

    <div class="content-section">
        <div class="content-section-header">
            <div class="content-section-title">
                <h3>Tous les contenus</h3>
                <p>Liste filtrable et mise à jour en temps réel.</p>
            </div>
        </div>
        <div id="contentAlert" class="appointment-alert" hidden></div>
        <div class="content-grid" id="contentGrid"></div>
        <div class="content-load-more">
            <button class="btn btn-secondary" id="loadMoreBtn">Charger plus</button>
        </div>
    </div>
</section>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        (function () {
            const grid = document.getElementById('contentGrid');
            const recommendedGrid = document.getElementById('recommendedGrid');
            const loadMoreBtn = document.getElementById('loadMoreBtn');
            const searchInput = document.getElementById('contentSearch');
            const typeFilter = document.getElementById('contentTypeFilter');
            const categoryFilter = document.getElementById('contentCategoryFilter');
            const resetBtn = document.getElementById('contentReset');
            const mineBtn = document.getElementById('contentMine');
            const alertBox = document.getElementById('contentAlert');
            const csrfToken = '{{ csrf_token('content_action') }}';
            const currentUserId = {{ app.user ? app.user.id : 'null' }};
            let onlyMine = false;
            
            // Vérification des éléments DOM
            console.log('Éléments trouvés:', {
                grid: !!grid,
                searchInput: !!searchInput,
                typeFilter: !!typeFilter,
                categoryFilter: !!categoryFilter,
                resetBtn: !!resetBtn,
                mineBtn: !!mineBtn
            });
            
            if (!grid || !searchInput || !typeFilter || !categoryFilter) {
                console.error('Éléments manquants dans le DOM!');
                return;
            }

            let page = 1;
            let loading = false;
            let hasMore = true;

            const showAlert = (message, type = 'error') => {
                if (!alertBox) return;
                alertBox.textContent = message;
                alertBox.classList.remove('error', 'success');
                alertBox.classList.add(type);
                alertBox.hidden = false;
            };

            const hideAlert = () => {
                if (alertBox) alertBox.hidden = true;
            };

            const buildCard = (item) => {
                const likedClass = item.liked ? 'active' : '';
                
                // Déterminer la couleur du badge de statut
                let statutBadge = '';
                if (item.isOwner && item.statut) {
                    let statutClass = 'content-pill';
                    let statutLabel = '';
                    
                    switch(item.statut) {
                        case 'en_attente':
                            statutClass += ' status-pending';
                            statutLabel = 'En attente';
                            break;
                        case 'publie':
                            statutClass += ' status-published';
                            statutLabel = 'Publié';
                            break;
                        case 'rejete':
                            statutClass += ' status-rejected';
                            statutLabel = 'Rejeté';
                            break;
                        default:
                            statutClass += ' status-pending';
                            statutLabel = item.statut; // Afficher le statut brut si inconnu
                            break;
                    }
                    
                    if (statutLabel) {
                        statutBadge = `<span class="${statutClass}">${statutLabel}</span>`;
                    }
                }
                
                return `
                <div class="content-card" data-content-id="${item.id}">
                    <div class="content-meta">
                        <span class="content-pill">${item.type.toUpperCase()}</span>
                        ${statutBadge}
                        <span>${item.date}</span>
                        <span>${item.auteur}</span>
                    </div>
                    <h3>${item.titre}</h3>
                    <p>${item.description ?? ''}</p>
                    <div class="content-actions">
                        <button class="like-btn ${likedClass}" data-liked="${item.liked ? '1' : '0'}">
                            <i class="fas fa-heart"></i>
                            <span class="like-count">${item.likes}</span>
                        </button>
                        <button class="btn btn-secondary btn-xs comment-toggle">
                            Commentaires (<span class="comment-count">${item.commentaires}</span>)
                        </button>
                        <a class="btn btn-primary btn-xs" href="/contenus/${item.id}">Voir</a>
                    </div>
                    <div class="comment-panel" hidden>
                        <div class="comment-list"></div>
                        <form class="comment-form" data-ajax="1">
                            <textarea rows="2" placeholder="Ajouter un commentaire..."></textarea>
                            <div class="content-actions">
                                <button type="submit" class="btn btn-primary btn-xs">Publier</button>
                                <div class="form-error" data-comment-error></div>
                            </div>
                        </form>
                    </div>
                </div>`;
            };

            const loadContents = async (reset = false) => {
                if (loading || (!hasMore && !reset)) return;
                loading = true;
                hideAlert();

                if (reset) {
                    page = 1;
                    hasMore = true;
                    grid.innerHTML = '';
                }

                const params = new URLSearchParams({
                    page: String(page),
                    limit: '8',
                    q: searchInput.value.trim(),
                    type: typeFilter.value,
                    category: categoryFilter.value.trim(),
                });
                if (onlyMine) {
                    params.set('owner', 'me');
                }
                
                console.log('Filtres appliqués:', {
                    search: searchInput.value.trim(),
                    type: typeFilter.value,
                    category: categoryFilter.value.trim(),
                    onlyMine: onlyMine
                });
                console.log('URL de requête:', `{{ path('api_content_list') }}?${params.toString()}`);

                try {
                    const res = await fetch(`{{ path('api_content_list') }}?${params.toString()}`);
                    const data = await res.json();
                    if (!data.items) throw new Error('Erreur');
                    
                    console.log('Résultats API:', {
                        itemsCount: data.items.length,
                        currentPage: data.page,
                        totalPages: data.pages,
                        totalItems: data.total
                    });

                    data.items.forEach((item) => {
                        grid.insertAdjacentHTML('beforeend', buildCard(item));
                    });

                    hasMore = data.page < data.pages;
                    loadMoreBtn.style.display = hasMore ? 'inline-flex' : 'none';
                    page += 1;
                } catch (e) {
                    showAlert('Impossible de charger les contenus.');
                } finally {
                    loading = false;
                }
            };

            const fetchComments = async (contentId, listEl) => {
                const res = await fetch(`{{ path('api_content_list') }}/${contentId}/comments`);
                const data = await res.json();
                listEl.innerHTML = '';
                (data.items || []).forEach((comment) => {
                    const canDelete = currentUserId && comment.user_id === currentUserId;
                    const deleteBtn = canDelete ? `<button class="btn btn-secondary btn-xs comment-delete" data-comment-id="${comment.id}">Supprimer</button>` : '';
                    listEl.insertAdjacentHTML('beforeend', `
                        <div class="comment-item" data-comment-id="${comment.id}">
                            <div class="comment-meta">${comment.user} • ${comment.date}</div>
                            <div>${comment.message}</div>
                            ${deleteBtn}
                        </div>
                    `);
                });
            };

            const toggleLike = async (contentId, btn, countEl) => {
                const res = await fetch(`{{ path('api_content_list') }}/${contentId}/like`, {
                    method: 'POST',
                    headers: {
                        'X-Requested-With': 'XMLHttpRequest',
                        'X-CSRF-TOKEN': csrfToken,
                    },
                });
                const data = await res.json();
                if (!data.success) {
                    showAlert(data.message || 'Action impossible.');
                    return;
                }
                btn.classList.toggle('active', data.liked);
                btn.dataset.liked = data.liked ? '1' : '0';
                countEl.textContent = data.count;
            };

            const submitComment = async (contentId, textarea, errorEl, listEl, countEl) => {
                errorEl.textContent = '';
                const message = textarea.value.trim();
                if (!message) {
                    errorEl.textContent = 'Le commentaire est obligatoire.';
                    return;
                }
                const res = await fetch(`{{ path('api_content_list') }}/${contentId}/comment`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'X-Requested-With': 'XMLHttpRequest',
                        'X-CSRF-TOKEN': csrfToken,
                    },
                    body: JSON.stringify({ message }),
                });
                const data = await res.json();
                if (!data.success) {
                    errorEl.textContent = data.message || (data.errors ? data.errors.join(', ') : 'Erreur.');
                    return;
                }
                textarea.value = '';
                const comment = data.comment;
                listEl.insertAdjacentHTML('afterbegin', `
                    <div class="comment-item" data-comment-id="${comment.id}">
                        <div class="comment-meta">${comment.user} • ${comment.date}</div>
                        <div>${comment.message}</div>
                        <button class="btn btn-secondary btn-xs comment-delete" data-comment-id="${comment.id}">Supprimer</button>
                    </div>
                `);
                countEl.textContent = data.count;
            };

            const deleteComment = async (commentId, itemEl, countEl) => {
                const res = await fetch(`{{ path('api_content_list') }}/comments/${commentId}/delete`, {
                    method: 'POST',
                    headers: {
                        'X-Requested-With': 'XMLHttpRequest',
                        'X-CSRF-TOKEN': csrfToken,
                    },
                });
                const data = await res.json();
                if (!data.success) {
                    showAlert(data.message || 'Suppression impossible.');
                    return;
                }
                itemEl.remove();
                if (countEl && data.count !== undefined) {
                    countEl.textContent = data.count;
                }
            };

            document.addEventListener('click', async (e) => {
                const likeBtn = e.target.closest('.like-btn');
                if (likeBtn) {
                    const card = likeBtn.closest('.content-card');
                    if (!card) return;
                    const contentId = card.dataset.contentId;
                    const countEl = likeBtn.querySelector('.like-count');
                    await toggleLike(contentId, likeBtn, countEl);
                    return;
                }

                const toggleBtn = e.target.closest('.comment-toggle');
                if (toggleBtn) {
                    const card = toggleBtn.closest('.content-card');
                    const panel = card.querySelector('.comment-panel');
                    const listEl = panel.querySelector('.comment-list');
                    panel.hidden = !panel.hidden;
                    if (!panel.hidden) {
                        await fetchComments(card.dataset.contentId, listEl);
                    }
                    return;
                }

                const deleteBtn = e.target.closest('.comment-delete');
                if (deleteBtn) {
                    const itemEl = deleteBtn.closest('.comment-item');
                    const card = deleteBtn.closest('.content-card');
                    const countEl = card.querySelector('.comment-count');
                    if (confirm('Supprimer ce commentaire ?')) {
                        await deleteComment(deleteBtn.dataset.commentId, itemEl, countEl);
                    }
                }
            });

            document.addEventListener('submit', async (e) => {
                const form = e.target.closest('.comment-form');
                if (!form) return;
                e.preventDefault();
                const card = form.closest('.content-card');
                const textarea = form.querySelector('textarea');
                const errorEl = form.querySelector('[data-comment-error]');
                const listEl = card.querySelector('.comment-list');
                const countEl = card.querySelector('.comment-count');
                await submitComment(card.dataset.contentId, textarea, errorEl, listEl, countEl);
            });

            loadMoreBtn.addEventListener('click', () => loadContents(false));
            resetBtn.addEventListener('click', () => {
                searchInput.value = '';
                typeFilter.value = '';
                categoryFilter.value = '';
                onlyMine = false;
                if (mineBtn) mineBtn.classList.remove('active');
                loadContents(true);
            });
            
            if (mineBtn) {
                mineBtn.addEventListener('click', () => {
                    onlyMine = !onlyMine;
                    mineBtn.classList.toggle('active', onlyMine);
                    loadContents(true);
                });
            }
            
            // Recherche en temps réel avec 'input'
            if (searchInput) {
                searchInput.addEventListener('input', () => {
                    console.log('Event input déclenché, valeur:', searchInput.value);
                    loadContents(true);
                });
            }
            
            // Changement de filtres
            if (typeFilter) {
                typeFilter.addEventListener('change', () => {
                    console.log('Event change type déclenché, valeur:', typeFilter.value);
                    loadContents(true);
                });
            }
            if (categoryFilter) {
                categoryFilter.addEventListener('change', () => {
                    console.log('Event change category déclenché, valeur:', categoryFilter.value);
                    loadContents(true);
                });
            }

            loadContents(true);
        })();
    </script>
{% endblock %}
