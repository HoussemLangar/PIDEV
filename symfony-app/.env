###> Hugging Face Emotion (CamemBERT) ###
# API token Hugging Face (Settings > Access Tokens)
HF_EMOTION_API_TOKEN=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
# Laisser vide pour endpoint standard api-inference + model ci-dessous
HF_EMOTION_API_URL=
# Modele emotion francais base CamemBERT (modifiable)
HF_EMOTION_MODEL=astrosbd/french_emotion_camembert
# Classification intent (zero-shot)
HF_INTENT_API_URL=
HF_INTENT_MODEL=MoritzLaurer/mDeBERTa-v3-base-mnli-xnli
# Generation de reponse empathique
HF_CHAT_API_URL=
HF_CHAT_MODEL=google/flan-t5-base
HF_EMOTION_TIMEOUT=8
###< Hugging Face Emotion (CamemBERT) ###

###> AI Disease Risk (Hybrid) ###
RISK_AI_API_TOKEN=${HF_EMOTION_API_TOKEN}
RISK_AI_API_URL=
RISK_AI_MODEL=MoritzLaurer/mDeBERTa-v3-base-mnli-xnli
# Poids IA dans score final (0.0 a 0.8)
RISK_AI_WEIGHT=0.00
RISK_AI_TIMEOUT=8
###< AI Disease Risk (Hybrid) ###
