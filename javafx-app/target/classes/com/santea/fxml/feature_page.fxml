<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.santea.controller.FeaturePageController"
            styleClass="feature-page-root">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="14" styleClass="feature-top-bar">
            <padding>
                <Insets top="16" right="22" bottom="16" left="22"/>
            </padding>
            <Button text="Retour" styleClass="feature-back-btn" onAction="#handleBackHome"/>
            <Label text="SANTEA" styleClass="feature-brand"/>
        </HBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED" styleClass="feature-scroll">
            <content>
                <VBox spacing="14" styleClass="feature-shell">
                    <padding>
                        <Insets top="24" right="24" bottom="24" left="24"/>
                    </padding>
                    <Label fx:id="pageTitleLabel" text="Module" styleClass="feature-title"/>
                    <Label fx:id="pageSubtitleLabel" text="Description" styleClass="feature-subtitle"/>
                    <VBox fx:id="contentListBox" spacing="10"/>
                </VBox>
            </content>
        </ScrollPane>
    </center>
</BorderPane>
