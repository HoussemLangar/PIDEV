<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<HBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.santea.controller.HomeViewController"
      alignment="CENTER_LEFT" spacing="34" styleClass="home-nav">
    <padding>
        <Insets top="16" right="34" bottom="16" left="34"/>
    </padding>

    <Label text="SANTÉA" styleClass="home-brand"/>

    <HBox spacing="24" alignment="CENTER_LEFT">
        <Hyperlink text="Accueil" styleClass="home-nav-link" onAction="#handleScrollToTop"/>
        <Hyperlink text="À propos" styleClass="home-nav-link" onAction="#handleScrollToAbout"/>
        <Hyperlink text="Services" styleClass="home-nav-link" onAction="#handleScrollToServices"/>
        <Hyperlink text="Blog" styleClass="home-nav-link" onAction="#handleScrollToBlog"/>
        <Hyperlink text="Contact" styleClass="home-nav-link" onAction="#handleScrollToContact"/>
    </HBox>

    <StackPane fx:id="accountStack" alignment="TOP_RIGHT" HBox.hgrow="ALWAYS" pickOnBounds="false">
        <HBox spacing="10" alignment="CENTER_RIGHT">
            <Button fx:id="loginButton" text="Se connecter" styleClass="home-register-btn" onAction="#handleOpenLogin"/>
            <Button fx:id="registerButton" text="Créer un compte" styleClass="home-register-outline-btn" onAction="#handleOpenRegister"/>
            <Button fx:id="adminDashboardButton" text="Dashboard Admin" visible="false" managed="false" styleClass="home-admin-btn" onAction="#handleOpenAdminDashboard"/>

            <StackPane fx:id="notifWrap" visible="false" managed="false">
                <Button fx:id="notifButton" styleClass="home-icon-btn" onAction="#handleOpenNotifications">
                    <graphic>
                        <FontIcon iconLiteral="fas-bell" iconSize="15" iconColor="#0d8abc"/>
                    </graphic>
                </Button>
                <Label fx:id="notifBadgeLabel" text="0" styleClass="home-badge-dot" visible="false" managed="false" StackPane.alignment="TOP_RIGHT"/>
            </StackPane>

            <StackPane fx:id="msgWrap" visible="false" managed="false">
                <Button fx:id="msgButton" styleClass="home-icon-btn" onAction="#handleOpenMessages">
                    <graphic>
                        <FontIcon iconLiteral="fas-comments" iconSize="15" iconColor="#0d8abc"/>
                    </graphic>
                </Button>
                <Label fx:id="msgBadgeLabel" text="0" styleClass="home-badge-dot" visible="false" managed="false" StackPane.alignment="TOP_RIGHT"/>
            </StackPane>

            <Button fx:id="accountAvatarButton" text="LH" visible="false" managed="false" styleClass="home-avatar-btn" onAction="#handleToggleAccountDropdown"/>
        </HBox>
    </StackPane>
</HBox>
