<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.santea.controller.SanteQuotidienneAdminViewController"
      styleClass="admin-root" spacing="18">

    <!-- Topbar -->
    <HBox alignment="CENTER_LEFT" spacing="10" styleClass="admin-topbar">
        <padding>
            <Insets top="14" right="20" bottom="14" left="20"/>
        </padding>
        <Button text="&lt; Retour" styleClass="admin-btn-secondary" onAction="#handleGoBack"/>
        <Button text="Rafraichir" styleClass="admin-btn-secondary" onAction="#handleRefresh"/>
        <Label text="Santé Quotidienne - Administration" styleClass="admin-title"/>
    </HBox>

    <!-- Scroll Container -->
    <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED" styleClass="admin-scroll" VBox.vgrow="ALWAYS">
        <content>
            <VBox spacing="16" styleClass="admin-shell">
                <padding>
                    <Insets top="18" right="18" bottom="20" left="18"/>
                </padding>

                <!-- Statistics Cards -->
                <Label text="Statistiques" styleClass="admin-section-title"/>
                <FlowPane hgap="12" vgap="12" prefWrapLength="1200">
                    <VBox spacing="4" styleClass="admin-card stat-blue">
                        <Label text="Total Entrées" styleClass="admin-card-label"/>
                        <Label fx:id="totalEntriesLabel" text="0" styleClass="admin-card-value"/>
                    </VBox>
                    <VBox spacing="4" styleClass="admin-card stat-green">
                        <Label text="Utilisateurs Actifs" styleClass="admin-card-label"/>
                        <Label fx:id="totalUsersLabel" text="0" styleClass="admin-card-value"/>
                    </VBox>
                    <VBox spacing="4" styleClass="admin-card stat-orange">
                        <Label text="Poids Moyen" styleClass="admin-card-label"/>
                        <Label fx:id="avgWeightLabel" text="0.00 kg" styleClass="admin-card-value"/>
                    </VBox>
                    <VBox spacing="4" styleClass="admin-card stat-purple">
                        <Label text="Sommeil Moyen" styleClass="admin-card-label"/>
                        <Label fx:id="avgSleepLabel" text="0.00 h" styleClass="admin-card-value"/>
                    </VBox>
                    <VBox spacing="4" styleClass="admin-card stat-red">
                        <Label text="Entrées Aujourd'hui" styleClass="admin-card-label"/>
                        <Label fx:id="todayEntriesLabel" text="0" styleClass="admin-card-value"/>
                    </VBox>
                    <VBox spacing="4" styleClass="admin-card stat-indigo">
                        <Label text="Entrées Cette Semaine" styleClass="admin-card-label"/>
                        <Label fx:id="weekEntriesLabel" text="0" styleClass="admin-card-value"/>
                    </VBox>
                </FlowPane>

                <!-- Tabs -->
                <TabPane fx:id="statsTabPane" tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">
                    <!-- Tab 1: Données détaillées -->
                    <Tab text="Données Détaillées">
                        <VBox spacing="12">
                            <padding>
                                <Insets top="12" right="12" bottom="12" left="12"/>
                            </padding>

                            <!-- Filters -->
                            <VBox spacing="8" styleClass="filter-box">
                                <Label text="Filtres" styleClass="admin-subsection-title"/>
                                <HBox spacing="10">
                                    <TextField fx:id="searchEmailField" promptText="Rechercher par email..."
                                               HBox.hgrow="ALWAYS" styleClass="filter-input"/>
                                    <Label text="Du:"/>
                                    <DatePicker fx:id="startDatePicker" styleClass="filter-input"/>
                                    <Label text="Au:"/>
                                    <DatePicker fx:id="endDatePicker" styleClass="filter-input"/>
                                    <Button fx:id="searchButton" text="Rechercher" styleClass="admin-btn-primary"/>
                                    <Button fx:id="exportButton" text="Exporter CSV" styleClass="admin-btn-secondary"/>
                                    <Button fx:id="refreshButton" text="Actualiser" styleClass="admin-btn-secondary"/>
                                </HBox>
                            </VBox>

                            <!-- Table -->
                            <Label text="Résultats" styleClass="admin-subsection-title"/>
                            <TableView fx:id="dataTable" VBox.vgrow="ALWAYS" styleClass="admin-table">
                                <columns>
                                    <TableColumn fx:id="emailColumn" text="Email" minWidth="150" prefWidth="150"/>
                                    <TableColumn fx:id="prenomColumn" text="Prénom" minWidth="80" prefWidth="80"/>
                                    <TableColumn fx:id="nomColumn" text="Nom" minWidth="80" prefWidth="80"/>
                                    <TableColumn fx:id="dateColumn" text="Date" minWidth="100" prefWidth="100"/>
                                    <TableColumn fx:id="poidsColumn" text="Poids (kg)" minWidth="80" prefWidth="80"/>
                                    <TableColumn fx:id="sommeilColumn" text="Sommeil (h)" minWidth="80" prefWidth="80"/>
                                    <TableColumn fx:id="humeurColumn" text="Humeur" minWidth="80" prefWidth="80"/>
                                    <TableColumn fx:id="activiteColumn" text="Activité (min)" minWidth="90" prefWidth="90"/>
                                    <TableColumn fx:id="alimentationColumn" text="Alimentation" minWidth="90" prefWidth="90"/>
                                    <TableColumn fx:id="eauColumn" text="Eau (L)" minWidth="70" prefWidth="70"/>
                                    <TableColumn fx:id="tensionColumn" text="Tension" minWidth="80" prefWidth="80"/>
                                </columns>
                            </TableView>

                            <!-- Pagination -->
                            <HBox spacing="10" alignment="CENTER">
                                <Pagination fx:id="pagination" pageCount="1"/>
                                <Label fx:id="pageInfoLabel" text="Page 1 de 1"/>
                            </HBox>
                        </VBox>
                    </Tab>

                    <!-- Tab 2: Statistiques par utilisateur -->
                    <Tab text="Statistiques Utilisateurs">
                        <VBox spacing="12">
                            <padding>
                                <Insets top="12" right="12" bottom="12" left="12"/>
                            </padding>

                            <Label text="Classement des utilisateurs par activité" styleClass="admin-subsection-title"/>
                            <TableView fx:id="userStatsTable" VBox.vgrow="ALWAYS" styleClass="admin-table">
                                <columns>
                                    <TableColumn text="Email" minWidth="150" prefWidth="150">
                                        <cellValueFactory>
                                            <PropertyValueFactory property="value"/>
                                        </cellValueFactory>
                                    </TableColumn>
                                    <TableColumn text="Nombre d'entrées" minWidth="100" prefWidth="100">
                                        <cellValueFactory>
                                            <PropertyValueFactory property="value"/>
                                        </cellValueFactory>
                                    </TableColumn>
                                    <TableColumn text="Dernière entrée" minWidth="100" prefWidth="100">
                                        <cellValueFactory>
                                            <PropertyValueFactory property="value"/>
                                        </cellValueFactory>
                                    </TableColumn>
                                    <TableColumn text="Poids moyen" minWidth="100" prefWidth="100">
                                        <cellValueFactory>
                                            <PropertyValueFactory property="value"/>
                                        </cellValueFactory>
                                    </TableColumn>
                                    <TableColumn text="Sommeil moyen" minWidth="100" prefWidth="100">
                                        <cellValueFactory>
                                            <PropertyValueFactory property="value"/>
                                        </cellValueFactory>
                                    </TableColumn>
                                </columns>
                            </TableView>
                        </VBox>
                    </Tab>
                </TabPane>
            </VBox>
        </content>
    </ScrollPane>
</VBox>
