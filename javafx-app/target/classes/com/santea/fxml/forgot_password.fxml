<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.santea.controller.ForgotPasswordViewController"
      spacing="0" styleClass="auth-form login-form" maxWidth="470">

    <padding>
        <Insets top="0" right="0" bottom="0" left="0"/>
    </padding>

    <HBox alignment="CENTER_RIGHT" styleClass="auth-top-actions">
        <Button text="Accueil" styleClass="auth-home-btn" onAction="#handleOpenHome"/>
    </HBox>

    <HBox spacing="10" alignment="CENTER_LEFT" styleClass="auth-title-row">
        <Label text="⌁" styleClass="title-icon-label"/>
        <Label text="Mot de passe oublié ?" styleClass="login-title"/>
    </HBox>
    <Label text="Entrez votre email pour recevoir un lien de réinitialisation de mot de passe." styleClass="login-subtitle" wrapText="true"/>

    <Label fx:id="feedbackLabel" text="" visible="false" managed="false" wrapText="true" styleClass="alert"/>

    <VBox spacing="16" styleClass="login-card">
        <HBox spacing="10" alignment="CENTER_LEFT" styleClass="card-header-row">
            <Label text="✉" styleClass="card-header-icon"/>
            <VBox spacing="1">
                <Label text="Votre adresse email" styleClass="card-header-title"/>
                <Label text="Associée à votre compte SANTÉA" styleClass="card-header-sub"/>
            </VBox>
        </HBox>

        <VBox spacing="6">
            <HBox spacing="4" alignment="CENTER_LEFT">
                <Label text="Adresse email" styleClass="field-label"/>
                <Label text="*" styleClass="required-star"/>
            </HBox>
            <TextField fx:id="emailField" promptText="exemple@email.com" styleClass="form-control"/>
        </VBox>

        <Label text="Si cet email existe dans notre système, vous recevrez un lien de réinitialisation." wrapText="true" styleClass="field-hint"/>
    </VBox>

    <Button text="Envoyer le lien" styleClass="login-submit" maxWidth="1.7976931348623157E308" onAction="#handleSendResetLink"/>

    <HBox alignment="CENTER" spacing="4" styleClass="auth-switch-row">
        <Label text="Retour à la connexion" styleClass="auth-switch-label"/>
        <Hyperlink text="Se connecter" onAction="#handleBackToLogin" styleClass="auth-switch-link"/>
    </HBox>

</VBox>
