<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.santea.controller.RegisterViewController"
      spacing="0" styleClass="auth-form register-form" maxWidth="760.0">
    
    <padding><Insets top="0" right="0" bottom="0" left="0"/></padding>
    
    <!-- TOP ACTIONS: Home Button -->
    <HBox alignment="CENTER_RIGHT" style="-fx-padding: 0 0 18 0;">
        <Button text="🏠 Accueil" styleClass="auth-home-btn" onAction="#handleOpenHome"/>
    </HBox>
    
    <!-- TITLE -->
    <HBox spacing="10" alignment="CENTER_LEFT" style="-fx-padding: 0 0 6 0;">
        <Label text="📝" style="-fx-font-size: 28; -fx-text-fill: #4f46e5;"/>
        <Label text="Créer un Compte" styleClass="login-title"/>
    </HBox>
    <Label text="Rejoignez SANTÉA et gérez votre santé en confiance." styleClass="login-subtitle" style="-fx-padding: 0 0 22 0;"/>
    
    <!-- SOCIAL BUTTONS -->
    <HBox spacing="12" style="-fx-padding: 0 0 18 0;">
        <Button text="🔵 S'inscrire avec Google" styleClass="social-btn google-btn" maxWidth="1.7976931348623157E308" HBox.hgrow="ALWAYS"/>
        <Button text="🔵 S'inscrire avec Facebook" styleClass="social-btn facebook-btn" maxWidth="1.7976931348623157E308" HBox.hgrow="ALWAYS"/>
    </HBox>
    
    <!-- DIVIDER -->
    <HBox alignment="CENTER" style="-fx-padding: 12 0 12 0;">
        <Separator HBox.hgrow="ALWAYS"/>
        <Label text=" OU " style="-fx-padding: 0 8; -fx-text-fill: #6b7280; -fx-font-size: 12;"/>
        <Separator HBox.hgrow="ALWAYS"/>
    </HBox>
    
    <!-- FEEDBACK -->
    <Label fx:id="registerFeedbackLabel" text="" visible="false" managed="false" wrapText="true" 
            style="-fx-padding: 11 14 11 14; -fx-font-size: 13; -fx-border-radius: 10; -fx-margin: 0 0 12 0;"/>
    
    <!-- REGISTRATION FORM CARD -->
    <VBox spacing="16" styleClass="login-card" style="-fx-padding: 24 22 20 22; -fx-margin: 0 0 18 0; -fx-border-color: #e5e7eb; -fx-border-width: 1.5; -fx-border-radius: 16;">
        
        <!-- CARD HEADER -->
        <HBox spacing="10" alignment="CENTER_LEFT" style="-fx-padding: 0 0 14 0; -fx-border-color: #e5e7eb; -fx-border-width: 0 0 1.5 0;">
            <Label text="👤" style="-fx-font-size: 16;"/>
            <VBox spacing="2">
                <Label text="Vos informations personnelles" styleClass="card-header-title"/>
                <Label text="Créez votre compte SANTÉA" styleClass="card-header-sub"/>
            </VBox>
        </HBox>
        
        <!-- 2-COLUMN GRID LAYOUT -->
        <GridPane hgap="14.0" vgap="14.0">
            <columnConstraints>
                <ColumnConstraints percentWidth="50.0"/>
                <ColumnConstraints percentWidth="50.0"/>
            </columnConstraints>
            
            <!-- ROW 1: USERNAME & EMAIL -->
            <VBox spacing="6" GridPane.columnIndex="0" GridPane.rowIndex="0">
                <HBox spacing="4" alignment="CENTER_LEFT">
                    <Label text="👤" style="-fx-font-size: 11; -fx-text-fill: #9ca3af;"/>
                    <Label text="Nom d'utilisateur" styleClass="field-label"/>
                    <Label text="*" style="-fx-text-fill: #ef4444;"/>
                </HBox>
                <HBox spacing="0" style="-fx-padding: 0;">
                    <Label text="👤" style="-fx-font-size: 13; -fx-text-fill: #9ca3af; -fx-padding: 0 12 0 12; -fx-alignment: CENTER;"/>
                    <TextField fx:id="usernameField" promptText="nom_utilisateur" HBox.hgrow="ALWAYS" styleClass="form-control" style="-fx-padding: 11 14 11 14; -fx-font-size: 13.5;"/>
                </HBox>
            </VBox>
            
            <VBox spacing="6" GridPane.columnIndex="1" GridPane.rowIndex="0">
                <HBox spacing="4" alignment="CENTER_LEFT">
                    <Label text="✉" style="-fx-font-size: 11; -fx-text-fill: #9ca3af;"/>
                    <Label text="Adresse email" styleClass="field-label"/>
                    <Label text="*" style="-fx-text-fill: #ef4444;"/>
                </HBox>
                <HBox spacing="0" style="-fx-padding: 0;">
                    <Label text="✉" style="-fx-font-size: 13; -fx-text-fill: #9ca3af; -fx-padding: 0 12 0 12; -fx-alignment: CENTER;"/>
                    <TextField fx:id="emailField" promptText="exemple@email.com" HBox.hgrow="ALWAYS" styleClass="form-control" style="-fx-padding: 11 14 11 14; -fx-font-size: 13.5;"/>
                </HBox>
            </VBox>
            
            <!-- ROW 2: NOM & PRENOM -->
            <VBox spacing="6" GridPane.columnIndex="0" GridPane.rowIndex="1">
                <HBox spacing="4" alignment="CENTER_LEFT">
                    <Label text="📝" style="-fx-font-size: 11; -fx-text-fill: #9ca3af;"/>
                    <Label text="Nom" styleClass="field-label"/>
                    <Label text="*" style="-fx-text-fill: #ef4444;"/>
                </HBox>
                <HBox spacing="0" style="-fx-padding: 0;">
                    <Label text="📝" style="-fx-font-size: 13; -fx-text-fill: #9ca3af; -fx-padding: 0 12 0 12; -fx-alignment: CENTER;"/>
                    <TextField fx:id="nomField" promptText="Votre nom de famille" HBox.hgrow="ALWAYS" styleClass="form-control" style="-fx-padding: 11 14 11 14; -fx-font-size: 13.5;"/>
                </HBox>
            </VBox>
            
            <VBox spacing="6" GridPane.columnIndex="1" GridPane.rowIndex="1">
                <HBox spacing="4" alignment="CENTER_LEFT">
                    <Label text="😊" style="-fx-font-size: 11; -fx-text-fill: #9ca3af;"/>
                    <Label text="Prénom" styleClass="field-label"/>
                    <Label text="*" style="-fx-text-fill: #ef4444;"/>
                </HBox>
                <HBox spacing="0" style="-fx-padding: 0;">
                    <Label text="😊" style="-fx-font-size: 13; -fx-text-fill: #9ca3af; -fx-padding: 0 12 0 12; -fx-alignment: CENTER;"/>
                    <TextField fx:id="prenomField" promptText="Votre prénom" HBox.hgrow="ALWAYS" styleClass="form-control" style="-fx-padding: 11 14 11 14; -fx-font-size: 13.5;"/>
                </HBox>
            </VBox>
            
            <!-- ROW 3: DATE DE NAISSANCE & ADRESSE -->
            <VBox spacing="6" GridPane.columnIndex="0" GridPane.rowIndex="2">
                <HBox spacing="4" alignment="CENTER_LEFT">
                    <Label text="🎂" style="-fx-font-size: 11; -fx-text-fill: #9ca3af;"/>
                    <Label text="Date de naissance" styleClass="field-label"/>
                    <Label text="*" style="-fx-text-fill: #ef4444;"/>
                </HBox>
                <HBox spacing="0" style="-fx-padding: 0;">
                    <Label text="📅" style="-fx-font-size: 13; -fx-text-fill: #9ca3af; -fx-padding: 0 12 0 12; -fx-alignment: CENTER;"/>
                    <DatePicker fx:id="dateNaissancePicker" HBox.hgrow="ALWAYS" styleClass="form-control" style="-fx-padding: 11 14 11 14; -fx-font-size: 13.5;"/>
                </HBox>
            </VBox>
            
            <VBox spacing="6" GridPane.columnIndex="1" GridPane.rowIndex="2">
                <HBox spacing="4" alignment="CENTER_LEFT">
                    <Label text="📍" style="-fx-font-size: 11; -fx-text-fill: #9ca3af;"/>
                    <Label text="Adresse" styleClass="field-label"/>
                </HBox>
                <HBox spacing="0" style="-fx-padding: 0;">
                    <Label text="📍" style="-fx-font-size: 13; -fx-text-fill: #9ca3af; -fx-padding: 0 12 0 12; -fx-alignment: CENTER;"/>
                    <TextField fx:id="adresseField" promptText="Rue, ville, code postal" HBox.hgrow="ALWAYS" styleClass="form-control" style="-fx-padding: 11 14 11 14; -fx-font-size: 13.5;"/>
                </HBox>
            </VBox>
            
            <!-- ROW 4: TELEPHONE & (EMPTY) -->
            <VBox spacing="6" GridPane.columnIndex="0" GridPane.rowIndex="3">
                <HBox spacing="4" alignment="CENTER_LEFT">
                    <Label text="📱" style="-fx-font-size: 11; -fx-text-fill: #9ca3af;"/>
                    <Label text="Téléphone" styleClass="field-label"/>
                </HBox>
                <HBox spacing="0" style="-fx-padding: 0;">
                    <Label text="📱" style="-fx-font-size: 13; -fx-text-fill: #9ca3af; -fx-padding: 0 12 0 12; -fx-alignment: CENTER;"/>
                    <TextField fx:id="telephoneField" promptText="+216 XX XXX XXXX" HBox.hgrow="ALWAYS" styleClass="form-control" style="-fx-padding: 11 14 11 14; -fx-font-size: 13.5;"/>
                </HBox>
            </VBox>
            
            <!-- ROW 5: MOT DE PASSE & CONFIRMER MOT DE PASSE -->
            <VBox spacing="6" GridPane.columnIndex="0" GridPane.rowIndex="4">
                <HBox spacing="4" alignment="CENTER_LEFT">
                    <Label text="🔒" style="-fx-font-size: 11; -fx-text-fill: #9ca3af;"/>
                    <Label text="Mot de passe" styleClass="field-label"/>
                    <Label text="*" style="-fx-text-fill: #ef4444;"/>
                </HBox>
                <HBox spacing="0" style="-fx-padding: 0;">
                    <Label text="🔒" style="-fx-font-size: 13; -fx-text-fill: #9ca3af; -fx-padding: 0 12 0 12; -fx-alignment: CENTER;"/>
                    <StackPane HBox.hgrow="ALWAYS">
                        <PasswordField fx:id="passwordField" promptText="••••••••" styleClass="form-control" style="-fx-padding: 11 14 11 14; -fx-font-size: 13.5;"/>
                        <TextField fx:id="visiblePasswordField" promptText="••••••••" visible="false" managed="false" styleClass="form-control" style="-fx-padding: 11 14 11 14; -fx-font-size: 13.5;"/>
                    </StackPane>
                    <Button text="👁" styleClass="toggle-password" onAction="#togglePasswordVisibility" style="-fx-padding: 0 12 0 12; -fx-font-size: 14; -fx-background-color: transparent;"/>
                </HBox>
            </VBox>
            
            <VBox spacing="6" GridPane.columnIndex="1" GridPane.rowIndex="4">
                <HBox spacing="4" alignment="CENTER_LEFT">
                    <Label text="🔐" style="-fx-font-size: 11; -fx-text-fill: #9ca3af;"/>
                    <Label text="Confirmer mot de passe" styleClass="field-label"/>
                    <Label text="*" style="-fx-text-fill: #ef4444;"/>
                </HBox>
                <HBox spacing="0" style="-fx-padding: 0;">
                    <Label text="🔐" style="-fx-font-size: 13; -fx-text-fill: #9ca3af; -fx-padding: 0 12 0 12; -fx-alignment: CENTER;"/>
                    <StackPane HBox.hgrow="ALWAYS">
                        <PasswordField fx:id="confirmPasswordField" promptText="••••••••" styleClass="form-control" style="-fx-padding: 11 14 11 14; -fx-font-size: 13.5;"/>
                        <TextField fx:id="visibleConfirmPasswordField" promptText="••••••••" visible="false" managed="false" styleClass="form-control" style="-fx-padding: 11 14 11 14; -fx-font-size: 13.5;"/>
                    </StackPane>
                    <Button text="👁" styleClass="toggle-password" onAction="#toggleConfirmPasswordVisibility" style="-fx-padding: 0 12 0 12; -fx-font-size: 14; -fx-background-color: transparent;"/>
                </HBox>
            </VBox>
            
            <!-- ROW 6: CAPTCHA (Full Width) -->
            <VBox spacing="6" GridPane.columnIndex="0" GridPane.columnSpan="2" GridPane.rowIndex="5">
                <HBox spacing="4" alignment="CENTER_LEFT">
                    <Label text="🔢" style="-fx-font-size: 11; -fx-text-fill: #9ca3af;"/>
                    <Label text="Captcha Mathématique" styleClass="field-label"/>
                    <Label text="*" style="-fx-text-fill: #ef4444;"/>
                </HBox>
                <HBox spacing="12">
                    <Label fx:id="captchaQuestionLabel" text="5 + 3 = ?" style="-fx-font-size: 13; -fx-font-weight: bold; -fx-text-fill: #374151;"/>
                    <HBox spacing="0" style="-fx-padding: 0;">
                        <TextField fx:id="captchaField" promptText="Réponse" prefWidth="100" styleClass="form-control" style="-fx-padding: 11 14 11 14; -fx-font-size: 13.5;"/>
                    </HBox>
                </HBox>
            </VBox>
            
            <!-- ROW 7: TERMS & CONDITIONS (Full Width) -->
            <VBox spacing="6" GridPane.columnIndex="0" GridPane.columnSpan="2" GridPane.rowIndex="6">
                <CheckBox fx:id="termsAcceptedCheckBox" text="J'accepte les conditions d'utilisation et la politique de confidentialité" 
                         styleClass="remember-me" style="-fx-font-size: 13; -fx-padding: 6;"/>
            </VBox>
        </GridPane>
    </VBox>
    
    <!-- SUBMIT BUTTON -->
    <Button text="✅ Créer mon compte" styleClass="login-submit" maxWidth="1.7976931348623157E308" 
            onAction="#handleCreateAccount" style="-fx-padding: 13 30 13 30; -fx-font-size: 14.5; -fx-font-weight: bold;"/>
    
    <!-- SWITCH TO LOGIN -->
    <HBox alignment="CENTER" spacing="4" style="-fx-padding: 18 0 0 0;">
        <Label text="Vous avez déjà un compte ?" style="-fx-text-fill: #374151; -fx-font-size: 14;"/>
        <Hyperlink text="Se connecter" onAction="#handleOpenLogin" style="-fx-font-size: 14; -fx-text-fill: #6366f1; -fx-font-weight: bold; -fx-padding: 0;"/>
    </HBox>
    
</VBox>
