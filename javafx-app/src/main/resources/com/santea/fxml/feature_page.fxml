<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.santea.controller.FeaturePageController"
            styleClass="feature-page-root">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="14" styleClass="feature-top-bar">
            <padding>
                <Insets top="16" right="22" bottom="16" left="22"/>
            </padding>
            <Button text="Retour" styleClass="feature-back-btn" onAction="#handleBackHome"/>
            <Label text="SANTEA" styleClass="feature-brand"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Accueil" styleClass="feature-nav-btn" onAction="#handleOpenHome"/>
            <Button text="Pharmacie" styleClass="feature-nav-btn feature-nav-btn-accent" onAction="#handleOpenPharmacy"/>
        </HBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" pannable="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED" styleClass="feature-scroll">
            <content>
                <StackPane alignment="TOP_CENTER" styleClass="feature-center-wrap">
                    <VBox spacing="14" styleClass="feature-shell" maxWidth="1280">
                        <padding>
                            <Insets top="24" right="24" bottom="24" left="24"/>
                        </padding>

                        <VBox spacing="10" styleClass="feature-hero-card">
                            <HBox alignment="CENTER_LEFT" spacing="10">
                                <Label text="MODULE" styleClass="feature-chip"/>
                                <Label fx:id="lineCountLabel" text="0 point" styleClass="feature-chip-secondary"/>
                            </HBox>
                            <Label fx:id="pageTitleLabel" text="Module" styleClass="feature-title"/>
                            <Label fx:id="pageSubtitleLabel" text="Description" styleClass="feature-subtitle"/>
                            <Label fx:id="sectionSummaryLabel" text="Resume" styleClass="feature-summary" wrapText="true"/>
                        </VBox>

                        <VBox spacing="10" styleClass="feature-section-card">
                            <Label text="Points cles" styleClass="feature-section-title"/>
                            <FlowPane fx:id="keyPointsPane" hgap="10" vgap="10" prefWrapLength="1180"/>
                        </VBox>

                        <VBox spacing="10" styleClass="feature-section-card">
                            <Label text="Details" styleClass="feature-section-title"/>
                            <VBox fx:id="contentListBox" spacing="10"/>
                        </VBox>
                    </VBox>
                </StackPane>
            </content>
        </ScrollPane>
    </center>
</BorderPane>
