<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.santea.controller.AiDocumentScannerController"
            fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
            styleClass="ait-scroll">
    <content>
        <VBox spacing="18" styleClass="ait-page-root ait-tool-indigo">
            <VBox spacing="8" styleClass="ait-tool-hero">
                <padding>
                    <Insets top="34" right="24" bottom="40" left="24"/>
                </padding>
                <Button text="← Outils IA" styleClass="ait-back-btn" onAction="#handleBack"/>
                <Label text="Scanner de document" styleClass="ait-tool-title"/>
                <Label text="Collez du texte medical ou chargez un fichier, puis l IA extrait resume, valeurs et actions." wrapText="true" styleClass="ait-tool-sub" maxWidth="700"/>
            </VBox>

            <VBox spacing="14" styleClass="ait-form-card" maxWidth="860">
                <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>

                <Label text="Contenu du document" styleClass="ait-field-label"/>
                <TextArea fx:id="contentArea" prefRowCount="9" wrapText="true" styleClass="ait-input-area"
                          promptText="Collez ici le contenu medical (ordonnance, bilan sanguin, compte-rendu...)"/>

                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Button text="Choisir un fichier" styleClass="ait-btn-soft" onAction="#handleChooseFile"/>
                    <Label fx:id="fileLabel" text="Aucun fichier choisi" styleClass="ait-muted"/>
                </HBox>

                <Button fx:id="analyzeButton" text="Analyser le document" styleClass="ait-btn-primary" onAction="#handleAnalyze"/>

                <HBox fx:id="warningBox" spacing="8" alignment="CENTER_LEFT" styleClass="ait-warning-box">
                    <Label text="!" styleClass="ait-warning-icon"/>
                    <Label fx:id="warningLabel" text="" wrapText="true" styleClass="ait-warning-text"/>
                </HBox>
            </VBox>

            <VBox fx:id="resultsBox" spacing="12" styleClass="ait-results-card" maxWidth="860">
                <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>
                <Label text="Resultats IA" styleClass="ait-section-title"/>

                <Label text="Resume" styleClass="ait-block-title"/>
                <Label fx:id="summaryLabel" text="" wrapText="true" styleClass="ait-item-text"/>

                <Label text="Prediction d analyse" styleClass="ait-block-title"/>
                <Label fx:id="predictionLabel" text="" wrapText="true" styleClass="ait-item-text"/>

                <Label text="Ecarts detectes" styleClass="ait-block-title"/>
                <VBox fx:id="abnormalBox" spacing="6"/>

                <Label text="Points cles" styleClass="ait-block-title"/>
                <VBox fx:id="keyPointsBox" spacing="6"/>

                <Label text="Valeurs extraites" styleClass="ait-block-title"/>
                <VBox fx:id="valuesRowsBox" spacing="6"/>

                <Label text="Actions suggerees" styleClass="ait-block-title"/>
                <VBox fx:id="actionsBox" spacing="6"/>
            </VBox>
        </VBox>
    </content>
</ScrollPane>
