<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.PieChart?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.santea.controller.SanteQuotidienneAdminViewController"
      styleClass="admin-root" spacing="18">

    <HBox alignment="CENTER_LEFT" spacing="10" styleClass="admin-topbar">
        <padding>
            <Insets top="14" right="20" bottom="14" left="20"/>
        </padding>
        <Button text="< Retour" styleClass="admin-btn-secondary" onAction="#handleGoBack"/>
        <Button fx:id="refreshButton" text="Rafraichir" styleClass="admin-btn-secondary"/>
        <Label text="Santé Quotidienne - Administration" styleClass="admin-title"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="autoRefreshStatusLabel" text="Actualisation auto inactive" styleClass="admin-line"/>
    </HBox>

    <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED" styleClass="admin-scroll" VBox.vgrow="ALWAYS">
        <content>
            <VBox spacing="16" styleClass="admin-shell">
                <padding>
                    <Insets top="18" right="18" bottom="20" left="18"/>
                </padding>

                <Label text="Vue globale" styleClass="admin-section-title"/>
                <FlowPane hgap="12" vgap="12" prefWrapLength="1200">
                    <VBox spacing="4" styleClass="admin-card stat-blue">
                        <Label text="Total des entrées" styleClass="admin-card-label"/>
                        <Label fx:id="totalEntriesLabel" text="0" styleClass="admin-card-value"/>
                    </VBox>
                    <VBox spacing="4" styleClass="admin-card stat-green">
                        <Label text="Patients actifs sur Santé Quotidienne" styleClass="admin-card-label"/>
                        <Label fx:id="activeUsersLabel" text="0" styleClass="admin-card-value"/>
                    </VBox>
                    <VBox spacing="4" styleClass="admin-card stat-orange">
                        <Label text="Total patients" styleClass="admin-card-label"/>
                        <Label fx:id="totalPatientsLabel" text="0" styleClass="admin-card-value"/>
                    </VBox>
                    <VBox spacing="4" styleClass="admin-card stat-red">
                        <Label text="Patients sans entrée" styleClass="admin-card-label"/>
                        <Label fx:id="patientsWithoutEntriesLabel" text="0" styleClass="admin-card-value"/>
                    </VBox>
                </FlowPane>

                <HBox spacing="16" alignment="TOP_LEFT">
                    <VBox spacing="8" HBox.hgrow="ALWAYS">
                        <Label text="Recherche et filtres" styleClass="admin-subsection-title"/>
                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <TextField fx:id="searchField" promptText="Rechercher par email, nom ou prénom..." HBox.hgrow="ALWAYS" styleClass="filter-input"/>
                            <Label text="Du:"/>
                            <DatePicker fx:id="startDatePicker" styleClass="filter-input"/>
                            <Label text="Au:"/>
                            <DatePicker fx:id="endDatePicker" styleClass="filter-input"/>
                            <Button fx:id="searchButton" text="Rechercher" styleClass="admin-btn-primary"/>
                            <Button fx:id="exportButton" text="Exporter CSV" styleClass="admin-btn-secondary"/>
                        </HBox>
                    </VBox>
                </HBox>

                <HBox spacing="16" alignment="TOP_LEFT">
                    <VBox spacing="8" HBox.hgrow="ALWAYS">
                        <Label text="Répartition des patients" styleClass="admin-subsection-title"/>
                        <PieChart fx:id="usagePieChart" prefHeight="320" labelsVisible="true" legendVisible="true"/>
                    </VBox>
                </HBox>

                <Label text="Historique des entrées (chaque nouvelle entrée doit s'afficher ici)" styleClass="admin-subsection-title"/>
                <TableView fx:id="dataTable" VBox.vgrow="ALWAYS" styleClass="admin-table" prefHeight="320">
                    <columns>
                        <TableColumn fx:id="emailColumn" text="Email utilisateur" minWidth="220" prefWidth="220"/>
                        <TableColumn fx:id="prenomColumn" text="Prénom" minWidth="110" prefWidth="110"/>
                        <TableColumn fx:id="nomColumn" text="Nom" minWidth="110" prefWidth="110"/>
                        <TableColumn fx:id="dateColumn" text="Date entrée" minWidth="120" prefWidth="120"/>
                        <TableColumn fx:id="poidsColumn" text="Poids" minWidth="90" prefWidth="90"/>
                        <TableColumn fx:id="sommeilColumn" text="Sommeil" minWidth="90" prefWidth="90"/>
                        <TableColumn fx:id="humeurColumn" text="Humeur" minWidth="120" prefWidth="120"/>
                        <TableColumn fx:id="activiteColumn" text="Activité" minWidth="90" prefWidth="90"/>
                        <TableColumn fx:id="alimentationColumn" text="Alimentation" minWidth="120" prefWidth="120"/>
                        <TableColumn fx:id="eauColumn" text="Eau" minWidth="80" prefWidth="80"/>
                        <TableColumn fx:id="tensionColumn" text="Tension" minWidth="110" prefWidth="110"/>
                    </columns>
                </TableView>

                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label fx:id="pageInfoLabel" text="0 entrée(s) affichée(s)"/>
                </HBox>

                <Label text="Statistiques par utilisateur" styleClass="admin-subsection-title"/>
                <TableView fx:id="userStatsTable" VBox.vgrow="ALWAYS" styleClass="admin-table" prefHeight="260">
                    <columns>
                        <TableColumn fx:id="statsEmailColumn" text="Email" minWidth="220" prefWidth="220"/>
                        <TableColumn fx:id="statsPrenomColumn" text="Prénom" minWidth="120" prefWidth="120"/>
                        <TableColumn fx:id="statsNomColumn" text="Nom" minWidth="120" prefWidth="120"/>
                        <TableColumn fx:id="statsCountColumn" text="Nombre d'enregistrements" minWidth="180" prefWidth="180"/>
                    </columns>
                </TableView>
            </VBox>
        </content>
    </ScrollPane>
</VBox>
