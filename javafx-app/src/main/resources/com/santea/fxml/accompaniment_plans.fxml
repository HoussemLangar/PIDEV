<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.santea.controller.AccompanimentPlansController"
      spacing="20" styleClass="plan-root">
    <children>
        <HBox alignment="CENTER_LEFT" styleClass="plan-header">
            <HBox alignment="CENTER_LEFT" spacing="16">
                <StackPane styleClass="plan-index-icon">
                    <Label text="PLAN" styleClass="plan-index-icon-text"/>
                </StackPane>
                <VBox spacing="4">
                    <Label fx:id="pageTitleLabel" text="Plans d'accompagnement" styleClass="page-title"/>
                    <Label fx:id="pageSubtitleLabel" text="Suivez vos programmes personnalisés" styleClass="section-subtitle"/>
                </VBox>
            </HBox>
            <Region HBox.hgrow="ALWAYS"/>
        </HBox>

        <FlowPane hgap="16" vgap="16" styleClass="plan-stats-grid">
            <children>
                <VBox spacing="6">
                    <styleClass>
                        <String fx:value="plan-stat-card"/>
                        <String fx:value="plan-stat-active"/>
                    </styleClass>
                    <Label text="Actifs" styleClass="tele-stat-badge"/>
                    <Label fx:id="activeCountLabel" text="0" styleClass="tele-stat-value"/>
                    <Label text="Plans en cours" styleClass="tele-stat-caption"/>
                </VBox>
                <VBox spacing="6">
                    <styleClass>
                        <String fx:value="plan-stat-card"/>
                        <String fx:value="plan-stat-secondary"/>
                    </styleClass>
                    <Label text="Suivi" styleClass="tele-stat-badge"/>
                    <Label fx:id="secondaryCountLabel" text="0" styleClass="tele-stat-value"/>
                    <Label fx:id="secondaryCaptionLabel" text="Patients suivis" styleClass="tele-stat-caption"/>
                </VBox>
                <VBox spacing="6">
                    <styleClass>
                        <String fx:value="plan-stat-card"/>
                        <String fx:value="plan-stat-tertiary"/>
                    </styleClass>
                    <Label text="Historique" styleClass="tele-stat-badge"/>
                    <Label fx:id="tertiaryCountLabel" text="0" styleClass="tele-stat-value"/>
                    <Label fx:id="tertiaryCaptionLabel" text="Plans complétés" styleClass="tele-stat-caption"/>
                </VBox>
            </children>
        </FlowPane>

        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" VBox.vgrow="ALWAYS" styleClass="doc-scroll">
            <content>
                <VBox spacing="20">
                    <children>
                        <VBox fx:id="createSection" spacing="12" styleClass="plan-create-section">
                            <padding>
                                <Insets top="4" right="4" bottom="4" left="4"/>
                            </padding>
                            <children>
                                <Label text="Créer un nouveau plan" styleClass="panel-title"/>
                                <VBox fx:id="patientCreateContainer" spacing="10"/>
                            </children>
                        </VBox>
                        <VBox spacing="12" styleClass="plan-list-section">
                            <children>
                                <Label text="Plans visibles" styleClass="panel-title"/>
                                <VBox fx:id="plansContainer" spacing="12"/>
                            </children>
                        </VBox>
                    </children>
                    <padding>
                        <Insets top="12" right="12" bottom="12" left="12"/>
                    </padding>
                </VBox>
            </content>
        </ScrollPane>
    </children>
</VBox>
