<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.santea.controller.LoginViewController"
      spacing="0" styleClass="auth-form login-form" maxWidth="460.0">
    
    <padding><Insets top="0" right="0" bottom="0" left="0"/></padding>
    
    <!-- TOP ACTIONS: Home Button -->
    <HBox alignment="CENTER_RIGHT" style="-fx-padding: 0 0 18 0;">
        <Button text="🏠 Accueil" styleClass="auth-home-btn" onAction="#handleOpenHome"/>
    </HBox>
    
    <!-- TITLE -->
    <HBox spacing="10" alignment="CENTER_LEFT" style="-fx-padding: 0 0 6 0;">
        <Label text="🔓" style="-fx-font-size: 28; -fx-text-fill: #4f46e5;"/>
        <Label text="Se Connecter" styleClass="login-title"/>
    </HBox>
    <Label text="Bon retour ! Connectez-vous à votre espace SANTÉA." styleClass="login-subtitle" style="-fx-padding: 0 0 22 0;"/>
    
    <!-- SOCIAL BUTTONS -->
    <HBox spacing="12" style="-fx-padding: 0 0 18 0;">
        <Button text="🔵 Se connecter avec Google" styleClass="social-btn google-btn" maxWidth="1.7976931348623157E308" HBox.hgrow="ALWAYS"/>
        <Button text="🔵 Se connecter avec Facebook" styleClass="social-btn facebook-btn" maxWidth="1.7976931348623157E308" HBox.hgrow="ALWAYS"/>
    </HBox>
    
    <!-- DIVIDER -->
    <HBox alignment="CENTER" style="-fx-padding: 12 0 12 0;">
        <Separator HBox.hgrow="ALWAYS"/>
        <Label text=" OU " style="-fx-padding: 0 8; -fx-text-fill: #6b7280; -fx-font-size: 12;"/>
        <Separator HBox.hgrow="ALWAYS"/>
    </HBox>
    
    <!-- ALERTS -->
    <Label fx:id="feedbackLabel" text="" visible="false" managed="false" wrapText="true" 
            style="-fx-padding: 11 14 11 14; -fx-font-size: 13; -fx-border-radius: 10; -fx-margin: 0 0 12 0;"/>
    
    <!-- LOGIN FORM CARD -->
    <VBox spacing="16" styleClass="login-card" style="-fx-padding: 24 22 20 22; -fx-margin: 0 0 18 0; -fx-border-color: #e5e7eb; -fx-border-width: 1.5; -fx-border-radius: 16;">
        
        <!-- CARD HEADER -->
        <HBox spacing="10" alignment="CENTER_LEFT" style="-fx-padding: 0 0 14 0; -fx-border-color: #e5e7eb; -fx-border-width: 0 0 1.5 0;">
            <Label text="🛡" style="-fx-font-size: 16;"/>
            <VBox spacing="2">
                <Label text="Vos identifiants" styleClass="card-header-title"/>
                <Label text="Email et mot de passe de votre compte" styleClass="card-header-sub"/>
            </VBox>
        </HBox>
        
        <!-- EMAIL FIELD -->
        <VBox spacing="6">
            <HBox spacing="4" alignment="CENTER_LEFT">
                <Label text="✉" style="-fx-font-size: 11; -fx-text-fill: #9ca3af;"/>
                <Label text="Adresse email" styleClass="field-label"/>
                <Label text="*" style="-fx-text-fill: #ef4444;"/>
            </HBox>
            <HBox spacing="0" style="-fx-padding: 0;">
                <Label text="✉" style="-fx-font-size: 13; -fx-text-fill: #9ca3af; -fx-padding: 0 12 0 12; -fx-alignment: CENTER;"/>
                <TextField fx:id="emailField" promptText="exemple@email.com" HBox.hgrow="ALWAYS" styleClass="form-control" style="-fx-padding: 11 14 11 14; -fx-font-size: 13.5;"/>
            </HBox>
        </VBox>
        
        <!-- PASSWORD FIELD -->
        <VBox spacing="6">
            <HBox spacing="4" alignment="CENTER_LEFT">
                <Label text="🔒" style="-fx-font-size: 11; -fx-text-fill: #9ca3af;"/>
                <Label text="Mot de passe" styleClass="field-label"/>
                <Label text="*" style="-fx-text-fill: #ef4444;"/>
            </HBox>
            <HBox spacing="0" style="-fx-padding: 0;">
                <Label text="🔒" style="-fx-font-size: 13; -fx-text-fill: #9ca3af; -fx-padding: 0 12 0 12; -fx-alignment: CENTER;"/>
                <StackPane HBox.hgrow="ALWAYS">
                    <PasswordField fx:id="passwordField" promptText="••••••••" styleClass="form-control" style="-fx-padding: 11 14 11 14; -fx-font-size: 13.5;"/>
                    <TextField fx:id="visiblePasswordField" promptText="••••••••" visible="false" managed="false" styleClass="form-control" style="-fx-padding: 11 14 11 14; -fx-font-size: 13.5;"/>
                </StackPane>
                <Button fx:id="togglePasswordButton" text="👁" styleClass="toggle-password" onAction="#togglePasswordVisibility" style="-fx-padding: 0 12 0 12; -fx-font-size: 14; -fx-background-color: transparent;"/>
            </HBox>
        </VBox>
        
        <!-- OPTIONS: Remember Me & Forgot Password -->
        <HBox alignment="CENTER_LEFT" spacing="20" style="-fx-padding: 0;">
            <CheckBox text="Se souvenir de moi" styleClass="remember-me" style="-fx-font-size: 12.5;"/>
            <HBox HBox.hgrow="ALWAYS"/>
            <Hyperlink text="🔑 Mot de passe oublié ?" styleClass="forgot-password" style="-fx-font-size: 12.5; -fx-text-fill: #6366f1; -fx-padding: 0;"/>
        </HBox>
    </VBox>
    
    <!-- SUBMIT BUTTON -->
    <Button text="🔓 Se Connecter" styleClass="login-submit" maxWidth="1.7976931348623157E308" 
            onAction="#handleLogin" style="-fx-padding: 13 30 13 30; -fx-font-size: 14.5; -fx-font-weight: bold;"/>
    
    <!-- SWITCH TO REGISTER -->
    <HBox alignment="CENTER" spacing="4" style="-fx-padding: 18 0 0 0;">
        <Label text="Vous n'avez pas de compte ?" style="-fx-text-fill: #374151; -fx-font-size: 14;"/>
        <Hyperlink text="Créer un compte" onAction="#handleOpenRegister" style="-fx-font-size: 14; -fx-text-fill: #6366f1; -fx-font-weight: bold; -fx-padding: 0;"/>
    </HBox>
    
</VBox>
