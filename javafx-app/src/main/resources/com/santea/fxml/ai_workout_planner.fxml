<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.santea.controller.AiWorkoutPlannerController"
            fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
            styleClass="ait-scroll">
    <content>
        <VBox spacing="18" styleClass="ait-page-root ait-tool-orange">
            <VBox spacing="8" styleClass="ait-tool-hero">
                <padding>
                    <Insets top="34" right="24" bottom="40" left="24"/>
                </padding>
                <Button text="← Outils IA" styleClass="ait-back-btn" onAction="#handleBack"/>
                <Label text="Assistant Exercice" styleClass="ait-tool-title"/>
                <Label text="Generez un programme d entrainement sur mesure adapte a votre niveau et vos objectifs." wrapText="true" styleClass="ait-tool-sub" maxWidth="700"/>
            </VBox>

            <VBox spacing="12" styleClass="ait-form-card" maxWidth="860">
                <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>
                <Label text="Objectif sportif" styleClass="ait-field-label"/>
                <TextField fx:id="goalField" styleClass="ait-input" promptText="Ex: endurance, prise de muscle"/>

                <HBox spacing="10">
                    <VBox spacing="6" HBox.hgrow="ALWAYS">
                        <Label text="Niveau" styleClass="ait-field-label"/>
                        <ComboBox fx:id="levelCombo" styleClass="ait-input" maxWidth="1.7976931348623157E308"/>
                    </VBox>
                    <VBox spacing="6" HBox.hgrow="ALWAYS">
                        <Label text="Seances / semaine" styleClass="ait-field-label"/>
                        <Spinner fx:id="daysSpinner" styleClass="ait-input" editable="true"/>
                    </VBox>
                    <VBox spacing="6" HBox.hgrow="ALWAYS">
                        <Label text="Minutes / seance" styleClass="ait-field-label"/>
                        <Spinner fx:id="minutesSpinner" styleClass="ait-input" editable="true"/>
                    </VBox>
                </HBox>

                <Label text="Contraintes physiques" styleClass="ait-field-label"/>
                <TextField fx:id="constraintsField" styleClass="ait-input" promptText="Ex: douleur genou, dos fragile"/>

                <Button text="Generer le programme" styleClass="ait-btn-primary" onAction="#handleGenerate"/>
            </VBox>

            <VBox fx:id="resultsBox" spacing="12" styleClass="ait-results-card" maxWidth="980">
                <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>
                <Label text="Programme IA" styleClass="ait-section-title"/>
                <Label fx:id="overviewLabel" text="" wrapText="true" styleClass="ait-item-text"/>

                <Label text="Seances d entrainement" styleClass="ait-block-title"/>
                <VBox fx:id="sessionsBox" spacing="8"/>

                <Label text="Consignes de securite" styleClass="ait-block-title"/>
                <VBox fx:id="safetyBox" spacing="8"/>
            </VBox>
        </VBox>
    </content>
</ScrollPane>
