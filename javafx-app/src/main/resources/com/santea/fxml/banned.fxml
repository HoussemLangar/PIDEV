<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.santea.controller.BannedViewController"
           fx:id="rootPane"
           styleClass="banned-container">

    <VBox spacing="0" styleClass="banned-background" mouseTransparent="true">
        <StackPane styleClass="banned-shape banned-shape-1"/>
        <StackPane styleClass="banned-shape banned-shape-2"/>
        <StackPane styleClass="banned-shape banned-shape-3"/>
    </VBox>

    <VBox fx:id="bannedCard" maxWidth="620" styleClass="banned-card-modern">
        <padding>
            <Insets top="48" right="40" bottom="40" left="40"/>
        </padding>

        <VBox alignment="CENTER" spacing="20">
            <StackPane styleClass="banned-icon-circle">
                <StackPane styleClass="banned-icon-inner">
                    <Label text="⛔" styleClass="banned-icon-symbol"/>
                </StackPane>
            </StackPane>

            <HBox alignment="CENTER" spacing="8" styleClass="banned-status-badge">
                <Label text="⚠"/>
                <Label text="Compte Suspendu"/>
            </HBox>

            <VBox alignment="CENTER" spacing="8">
                <Label text="Accès Temporairement Restreint" styleClass="banned-title"/>
                <Label text="Votre compte SANTEA a ete suspendu temporairement. Nous vous invitons a contacter notre support pour plus d'informations."
                       wrapText="true" styleClass="banned-subtitle"/>
            </VBox>
        </VBox>

        <VBox spacing="0" styleClass="banned-info-card">
            <HBox alignment="CENTER_LEFT" spacing="10" styleClass="banned-info-header">
                <Label text="ℹ"/>
                <Label text="Informations sur la Suspension"/>
            </HBox>
            <VBox spacing="10" styleClass="banned-info-body">
                <HBox spacing="12" styleClass="banned-info-item">
                    <StackPane styleClass="info-item-icon">
                        <Label text="📋"/>
                    </StackPane>
                    <VBox spacing="4">
                        <Label text="Raison" styleClass="info-label"/>
                        <Label fx:id="banReasonLabel" text="-" styleClass="info-value" wrapText="true"/>
                    </VBox>
                </HBox>

                <HBox spacing="12" styleClass="banned-info-item">
                    <StackPane styleClass="info-item-icon">
                        <Label text="🕒"/>
                    </StackPane>
                    <VBox spacing="4">
                        <Label text="Fin de Suspension" styleClass="info-label"/>
                        <Label fx:id="banUntilLabel" text="-" styleClass="info-value" wrapText="true"/>
                    </VBox>
                </HBox>
            </VBox>
        </VBox>

        <HBox alignment="CENTER_LEFT" spacing="16" styleClass="banned-support-card">
            <StackPane styleClass="support-icon"><Label text="🎧"/></StackPane>
            <VBox spacing="8">
                <Label text="Besoin d'aide ?" styleClass="support-title"/>
                <Label text="Contactez notre equipe de support pour discuter de votre situation" styleClass="support-subtitle" wrapText="true"/>
                <Label text="support@santea.tn" styleClass="support-link"/>
                <Label text="+216 50 396 182" styleClass="support-link"/>
            </VBox>
        </HBox>

        <HBox alignment="CENTER" spacing="12" styleClass="banned-actions-modern">
            <Button text="Se Deconnecter" styleClass="btn-banned-logout" onAction="#handleLogout"/>
        </HBox>
    </VBox>

    <StackPane fx:id="memeOverlay" styleClass="meme-popup">
        <VBox alignment="CENTER" spacing="10" styleClass="meme-popup-content">
            <ImageView fx:id="memeImageView" fitWidth="560" preserveRatio="true" smooth="true"/>
        </VBox>
    </StackPane>
</StackPane>
