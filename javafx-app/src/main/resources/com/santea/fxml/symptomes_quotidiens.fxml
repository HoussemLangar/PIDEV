<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.santea.controller.SymptomesQuotidiensViewController"
           styleClass="profile-page-root">
    <ScrollPane fx:id="pageScrollPane" fitToWidth="true" pannable="true" vbarPolicy="ALWAYS" hbarPolicy="NEVER" styleClass="home-scroll">
        <AnchorPane.topAnchor>0.0</AnchorPane.topAnchor>
        <AnchorPane.rightAnchor>0.0</AnchorPane.rightAnchor>
        <AnchorPane.bottomAnchor>0.0</AnchorPane.bottomAnchor>
        <AnchorPane.leftAnchor>0.0</AnchorPane.leftAnchor>
        <content>
            <VBox spacing="16" alignment="TOP_CENTER" styleClass="profile-content-shell">
                <padding>
                    <Insets top="26" right="18" bottom="30" left="18"/>
                </padding>

                <HBox alignment="CENTER_LEFT" spacing="10" maxWidth="1100">
                    <Label text="Mes symptomes" styleClass="profile-chip"/>
                </HBox>

                <VBox spacing="8" styleClass="profile-hero-shell" maxWidth="1100">
                    <Label text="Declaration de Symptomes Quotidiens" styleClass="profile-title"/>
                    <Label text="Selectionne plusieurs symptomes depuis la base et gere ton historique (modifier, supprimer, exporter)." styleClass="profile-subtitle" wrapText="true"/>
                </VBox>

                <Label fx:id="feedbackLabel" text="" visible="false" managed="false" wrapText="true" styleClass="alert" maxWidth="1100"/>

                <HBox spacing="16" maxWidth="1100" alignment="TOP_CENTER">
                    <VBox spacing="12" styleClass="profile-card" HBox.hgrow="ALWAYS" minWidth="0.0">
                        <Label text="Symptomes a declarer" styleClass="profile-section-title"/>
                        <Label text="Astuce: maintiens Ctrl (ou Cmd) pour selectionner plusieurs elements." styleClass="sub-checkout-help"/>
                        <ListView fx:id="symptomsListView" prefHeight="280"/>

                        <HBox spacing="12" alignment="CENTER_LEFT">
                            <VBox spacing="6" HBox.hgrow="ALWAYS">
                                <Label text="Date du symptome" styleClass="field-label"/>
                                <DatePicker fx:id="symptomDatePicker"/>
                            </VBox>
                            <VBox spacing="6" HBox.hgrow="ALWAYS">
                                <Label text="Intensite (1-10)" styleClass="field-label"/>
                                <ComboBox fx:id="intensityCombo" prefWidth="180"/>
                            </VBox>
                            <VBox spacing="6" HBox.hgrow="ALWAYS">
                                <Label text="Duree" styleClass="field-label"/>
                                <TextField fx:id="durationField" styleClass="form-control" promptText="Ex: 2 heures"/>
                            </VBox>
                        </HBox>

                        <VBox spacing="6">
                            <Label text="Notes" styleClass="field-label"/>
                            <TextArea fx:id="notesArea" promptText="Details complementaires..." prefRowCount="4" wrapText="true"/>
                        </VBox>

                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <Label fx:id="selectedCountLabel" text="0 symptome(s) selectionne(s)" styleClass="sub-checkout-help"/>
                        </HBox>
                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <Label fx:id="selectedHistoryLabel" text="Aucune ligne selectionnee." styleClass="sub-checkout-help" wrapText="true"/>
                        </HBox>

                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <Button text="Enregistrer" styleClass="sub-primary-button" onAction="#handleSaveSymptoms"/>
                            <Button text="Modifier la ligne selectionnee" styleClass="sub-outline-button" onAction="#handleUpdateSelected"/>
                            <Button text="Supprimer la ligne selectionnee" styleClass="sub-danger-button" onAction="#handleDeleteSelected"/>
                        </HBox>

                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <Button text="Actualiser" styleClass="sub-outline-button" onAction="#handleRefreshSymptoms"/>
                            <Button text="Vider" styleClass="sub-outline-button" onAction="#handleClearForm"/>
                        </HBox>
                    </VBox>

                    <VBox spacing="10" styleClass="profile-card" prefWidth="420" minWidth="0.0" HBox.hgrow="SOMETIMES">
                        <Label text="Historique" styleClass="profile-section-title"/>

                        <HBox spacing="8" alignment="CENTER_LEFT">
                            <Label text="Filtre periode" styleClass="field-label"/>
                            <ComboBox fx:id="periodFilterCombo" prefWidth="180"/>
                        </HBox>

                        <Label fx:id="historyInfoLabel" text="Aucun symptome enregistre pour le moment." styleClass="sub-checkout-help" wrapText="true"/>
                        <ListView fx:id="historyListView" prefHeight="395"/>

                        <Button text="Exporter historique CSV" styleClass="sub-outline-button" onAction="#handleExportHistoryCsv"/>
                    </VBox>
                </HBox>

                <VBox spacing="10" styleClass="profile-card" maxWidth="1100">
                    <Label text="Prédiction & tendances (basé sur tes données)" styleClass="profile-section-title"/>
                    <Label text="Analyse automatique des symptômes + journal santé (hydratation, sommeil, activité)."
                           styleClass="sub-checkout-help" wrapText="true"/>
                    <Label fx:id="predictionLabel" text="Chargement..." wrapText="true" styleClass="sub-checkout-help"/>
                </VBox>

                <VBox spacing="10" styleClass="profile-card" maxWidth="1100">
                    <Label text="Chatbot sante (Ollama local)" styleClass="profile-section-title"/>
                    <Label text="Parle de tes symptomes: le chatbot t'aide avec des conseils generaux personnalises." styleClass="sub-checkout-help" wrapText="true"/>
                    <ListView fx:id="chatbotMessagesListView" prefHeight="220"/>
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <TextField fx:id="chatbotInputField" promptText="Ex: J'ai de la fievre et mal a la gorge depuis 2 jours..." HBox.hgrow="ALWAYS" styleClass="form-control"/>
                        <Button fx:id="chatbotVoiceButton" text="🎤" styleClass="sub-outline-button" onAction="#handleVoiceInput">
                            <tooltip>
                                <Tooltip text="Clique pour enregistrer, reclique pour envoyer"/>
                            </tooltip>
                        </Button>
                        <Button text="Envoyer" styleClass="sub-primary-button" onAction="#handleSendChatbotMessage"/>
                    </HBox>
                </VBox>

                <HBox alignment="CENTER_RIGHT" spacing="10" maxWidth="980">
                    <Button text="Retour accueil" styleClass="sub-outline-button" onAction="#handleBackHome"/>
                </HBox>
            </VBox>
        </content>
    </ScrollPane>
</AnchorPane>
