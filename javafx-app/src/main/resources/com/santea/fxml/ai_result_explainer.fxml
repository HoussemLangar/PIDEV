<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.santea.controller.AiResultExplainerController"
            fitToWidth="true" pannable="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
            styleClass="ait-scroll">
    <content>
        <VBox spacing="18" styleClass="ait-page-root ait-tool-blue">
            <VBox spacing="8" styleClass="ait-tool-hero">
                <padding>
                    <Insets top="34" right="24" bottom="40" left="24"/>
                </padding>
                <HBox alignment="CENTER" spacing="10" styleClass="ait-hero-top-row">
                    <Button text="← Outils IA" styleClass="ait-back-btn" onAction="#handleBack"/>
                    <Label text="LAB" styleClass="ait-tool-icon-badge"/>
                </HBox>
                <Label text="Explicateur de resultat" styleClass="ait-tool-title"/>
                <Label text="Entrez une valeur medicale ou biologique et l IA vous l explique en langage simple." wrapText="true" styleClass="ait-tool-sub" maxWidth="700"/>
            </VBox>

            <VBox spacing="12" styleClass="ait-form-card" maxWidth="860">
                <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>

                <Label text="Nom du test / analyse" styleClass="ait-field-label"/>
                <TextField fx:id="testNameField" styleClass="ait-input" promptText="Ex: Glycemie, TSH, Creatinine"/>

                <HBox spacing="10">
                    <VBox spacing="6" HBox.hgrow="ALWAYS">
                        <Label text="Valeur obtenue" styleClass="ait-field-label"/>
                        <TextField fx:id="valueField" styleClass="ait-input" promptText="Ex: 1.26"/>
                    </VBox>
                    <VBox spacing="6" HBox.hgrow="ALWAYS">
                        <Label text="Unite" styleClass="ait-field-label"/>
                        <TextField fx:id="unitField" styleClass="ait-input" promptText="Ex: g/L"/>
                    </VBox>
                </HBox>

                <Label text="Intervalle de reference" styleClass="ait-field-label"/>
                <TextField fx:id="referenceRangeField" styleClass="ait-input" promptText="Ex: 0.70 - 1.10 g/L"/>

                <HBox alignment="CENTER_RIGHT">
                    <Button text="Expliquer ce resultat" styleClass="ait-btn-primary" onAction="#handleExplain"/>
                </HBox>
            </VBox>

            <VBox fx:id="resultsBox" spacing="12" styleClass="ait-results-card" maxWidth="980">
                <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>
                <Label text="Explication IA" styleClass="ait-section-title"/>

                <Label text="Explication simple" styleClass="ait-block-title"/>
                <Label fx:id="plainExplanationLabel" text="" wrapText="true" styleClass="ait-item-text"/>

                <Label text="Interpretations possibles" styleClass="ait-block-title"/>
                <VBox fx:id="meaningBox" spacing="8"/>

                <Label text="Prochaines etapes" styleClass="ait-block-title"/>
                <VBox fx:id="nextStepsBox" spacing="8"/>

                <HBox spacing="8" styleClass="ait-warning-box" alignment="CENTER_LEFT">
                    <Label text="!" styleClass="ait-warning-icon"/>
                    <Label fx:id="warningLabel" text="" wrapText="true" styleClass="ait-warning-text"/>
                </HBox>
            </VBox>
        </VBox>
    </content>
</ScrollPane>
